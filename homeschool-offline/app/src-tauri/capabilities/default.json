{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:scope-appdata",
    "fs:scope-appdata-recursive",
    "fs:scope-appcache",
    "fs:scope-appcache-recursive",
    "fs:scope-temp",
    "fs:scope-temp-recursive",
    "fs:allow-read-text-file",
    "os:allow-platform",
    "fs:allow-picture-read",
    "fs:allow-picture-read-recursive",
    "fs:allow-video-read",
    "fs:allow-video-read-recursive",
    "fs:allow-audio-read",
    "fs:allow-audio-read-recursive",
    "fs:allow-download-read",
    "fs:allow-download-read-recursive",
    "fs:scope-picture",
    "fs:scope-picture-recursive",
    "fs:scope-video",
    "fs:scope-video-recursive",
    "fs:scope-audio",
    "fs:scope-audio-recursive",
    "fs:scope-download",
    "fs:scope-download-recursive"
  ]
}
