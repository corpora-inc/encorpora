{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homeschool Offline",
  "version": "0.1.9",
  "identifier": "com.corpora.homeschool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Homeschool Offline",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": "F9AV5HKF6N",
      "template": "ios/project.yml"
    },
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "3rd Party Mac Developer Application: Corpora Inc (F9AV5HKF6N)"
    }
  }
}
