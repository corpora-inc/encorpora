{
  "name": "maint-app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tsc": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test:ui": "node scripts/verify-ui.mjs",
    "shots": "node scripts/verify-ui.mjs --shots-only",
    "dev:b": "MAINT_PORT=4343 MAINT_ENGINE=http://127.0.0.1:4320 vite --host 127.0.0.1 --bypass-lock",
    "engines": "scripts/loop.sh",
    "test:flow": "node scripts/verify-flow.mjs",
    "dev:c": "MAINT_PORT=4345 MAINT_ENGINE=http://127.0.0.1:4323 vite --host 127.0.0.1 --bypass-lock",
    "tauri": "tauri",
    "build:mac": "scripts/build-mac.sh"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "@tauri-apps/cli": "2.11.4"
  }
}
