        <choice nextActionRefId="end-0003">Loose</choice>
        <choice nextActionRefId="end-0004">Broken</choice>
       </listOfChoices></isolationStepAnswer></isolationStep>
      <isolationProcedureEnd id="end-0001"><action>Clean the intake strainer.</action></isolationProcedureEnd>
      <isolationProcedureEnd id="end-0002"><action>Internal cooling fault. Report to the field maintenance shop.</action></isolationProcedureEnd>
      <isolationProcedureEnd id="end-0003"><action>Adjust the belt tension.</action></isolationProcedureEnd>
      <isolationProcedureEnd id="end-0004"><action>Replace the cooling fan belt.</action></isolationProcedureEnd>
