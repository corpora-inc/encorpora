{
  "name": "@dynawalla/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dynawalla learner model. Pure TypeScript: no IO, no DOM, no clock, no randomness, no app imports.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "tsc": "tsc --noEmit",
    "bench": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/dw-bench.mjs",
    "harness": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/dw-harness.mjs smoke",
    "harness:pilot": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/dw-harness.mjs pilot",
    "harness:nightly": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/dw-harness.mjs nightly"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "typescript": "^6.0.0"
  }
}
