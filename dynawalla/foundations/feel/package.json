{
  "name": "@dynawalla/feel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Game-feel foundation for the Dynawalla Bazaar. One call, excellent feel.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tsc": "tsc --noEmit",
