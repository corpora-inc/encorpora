    "bench": "node --experimental-strip-types --no-warnings=ExperimentalWarning bench/cpu.mjs",
    "bench:frames": "node bench/frames.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
