{
  "name": "@dynawalla/game-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ARENA — a bioluminescent growth arena. You are a number. Eat what is smaller. Flee what is not.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
