{
  "name": "@dynawalla/game-slice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MATH NINJA — a night-market slicer with an order to fill. The plate reads 10 + 15 + □ = 33; you cut the fruit that fills it, and telling a helpful gourd from a decoy is arithmetic.",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4317",
    "tsc": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "build:pack": "vite build --config vite.pack.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "typescript": "^6.0.0",
    "vite": "^8.1.5"
  }
}
