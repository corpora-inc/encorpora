<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by `tauri android init` and then TRACKED, unmodified.

  It is committed so the permission surface is reviewable in a diff. Dynawalla
  declares "no data collected, no data shared" to Play, and a dependency can
  add a permission the app never wrote — so this file is the source side of
  that claim and the release workflow asserts the same thing on the MERGED
  manifest of the finished AAB (docs/STORE.md G-06). The forbidden set:
  com.google.android.gms.permission.AD_ID, any ACCESS_*_LOCATION,
  READ_PHONE_STATE, READ_PHONE_NUMBERS.

  `tauri android init` does not overwrite an existing file, so this survives
  the CI re-init. The same DRIFT WARNING as app/build.gradle.kts applies: a
  Tauri CLI upgrade that changes the template will not reach this copy.

  Deliberately unchanged for now: `configChanges`. Corpán's is longer, which
  is its defence against Android recreating the Activity. Widening it here is
  a runtime behaviour change that wants a device to verify, not a build-
  viability spike.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.dynawalla"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
