{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Import style. Source imports carry the `.ts`/`.tsx` extension so the same
       files run unmodified under `node --experimental-strip-types --test`,
       which resolves ESM specifiers literally. `verbatimModuleSyntax` keeps
       type-only imports erasable, and `erasableSyntaxOnly` fails the build on
       enums / namespaces / parameter properties — the constructs Node's type
       stripper cannot handle. Without it a test file compiles here and then
       dies in the runner. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
