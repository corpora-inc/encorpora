{
  "name": "@dynawalla/bazaar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The bazaar — the endless minaret-punk marketplace the games are stalls in.",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bazaar.css": "./src/tokens/bazaar.css"
  },
  "scripts": {
