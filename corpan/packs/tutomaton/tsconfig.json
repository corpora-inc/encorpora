{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@corpan/sdk": ["../sdk/src/index.ts"],
      "@shared/monetization": ["../shared/monetization/index.ts"]
    }
  },
  "include": ["src/**/*", "languages/**/retrieval/*.ts"]
}
