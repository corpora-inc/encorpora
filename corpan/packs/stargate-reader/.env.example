# Stargate Reader pack environment — copy to .env and fill in values.
# .env is gitignored so local endpoints don't leak into published bundles
# without conscious rebuild.

# IAP purchase verification endpoint (AWS Lambda + API Gateway).
# Used by shared/catalog/installManager.ts:getSignedDownloadUrl() to request
# a signed CloudFront URL for premium narration downloads. MUST be set at
# `npm run build` time or the reader pack cannot download paid content
# (install fails silently with "No verify URL configured").
VITE_GAME_VERIFY_URL=https://dzxrs4szm7.execute-api.us-east-2.amazonaws.com/prod
