{
  "name": "corpan-city",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "pack": "node scripts/pack.mjs",
    "pack:all": "npm run build && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check-translations": "python3 tools/check_translations.py",
    "check-translations:fix": "python3 tools/check_translations.py --fix",
    "dev:corpan": "node scripts/dev-corpan.mjs",
    "preview": "vite preview",
    "server": "npm --prefix server run server",
    "server:install": "npm --prefix server install",
    "server:typecheck": "npm --prefix server run typecheck",
    "qa:mp": "node qa/mp-presence.mjs",
    "qa:mp-interaction": "node qa/mp-interaction.mjs",
    "qa:restation": "node qa/restation.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/gui": "^9.11.0",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/loaders": "^9.11.0",
    "colyseus.js": "^0.16.22",
    "recast-detour": "^1.6.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "happy-dom": "^20.10.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
