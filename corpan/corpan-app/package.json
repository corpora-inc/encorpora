{
  "name": "corpan",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run check:recommendations && tsc && vite build",
    "preview": "vite preview",
    "tauri": "bash scripts/ios-privacy-preflight.sh && tauri",
    "tailwind:init": "tailwindcss init -p",
    "tsc": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:recommendations": "node scripts/check-recommendations.mjs",
    "ios:redeploy": "npm run tauri ios dev",
    "dev:console-server": "node ../scripts/dev/console-server.js",
    "dev:tail": "bash ../scripts/dev/tail-device-log.sh",
    "dev:loop": "echo 'See corpan/DEV_LOOP.md. Run these in separate terminals: dev:console-server, dev:tail, ios:redeploy.'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.12.1",
    "i18next": "^25.3.2",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.510.0",
    "npx": "^10.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.6.1",
    "tailwind-merge": "^3.3.0",
    "ts-fsrs": "5.4.1",
    "url": "^0.11.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.0",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.2.9",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
