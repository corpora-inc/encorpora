# i18next@25 declares `peerOptional typescript@"^5"`, but the app is on the latest
# stable typescript@^6 (TS is only an OPTIONAL, build-time peer of i18next — no
# runtime impact). Strict `npm ci` aborts on that benign mismatch with ERESOLVE, so
# relax peer resolution here for BOTH CI and local installs. Revisit/remove once
# i18next widens its typescript peer range to include ^6.
legacy-peer-deps=true
