# Signing material never enters this repository. The repo is public.
# Mirrors dynawalla-app/src-tauri/.gitignore. This is the backstop that gives
# feedback at `git add` time; the hygiene job's signing-material guard is the
# one that fails the PR, and corpan-app/vite.config.ts keeps the same material
# off the LAN dev server. Signing material belongs outside the repo entirely —
# see RELEASE_SETUP.md.
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
*service-account*.json
keystore.properties

# Generated by Tauri
# Keep a small, curated Android scaffold; ignore everything else in gen/.
/gen/**
!/gen/android/
!/gen/android/gradle/
!/gen/android/gradle/wrapper/
!/gen/android/gradle/wrapper/gradle-wrapper.properties
!/gen/android/gradle/wrapper/gradle-wrapper.jar
!/gen/android/gradlew
!/gen/android/gradlew.bat
!/gen/android/gradle.properties
!/gen/android/settings.gradle
!/gen/android/build.gradle.kts
!/gen/android/app/
!/gen/android/app/build.gradle.kts
!/gen/android/app/src/
!/gen/android/app/src/main/
!/gen/android/app/src/main/AndroidManifest.xml
!/gen/android/app/src/main/java/
!/gen/android/app/src/main/java/**/MainActivity.kt
# Generated by Cargo
# will have compiled files and executables
/target/

