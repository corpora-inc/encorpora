<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional speech-to-text dictation (tauri-plugin-asr-native +
         tauri-plugin-stt). Also declared in those plugins' manifests; listed
         here too so the app-level permission is explicit. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.corpan"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
             Launcher trampoline. Verifies a usable Android System WebView
             exists BEFORE MainActivity (and therefore the wry/Tauri stack)
             is created. On devices with a missing/disabled/updating System
             WebView, wry's startup version probe aborts the process from
             native code (release builds are panic="abort", so it is
             uncatchable) before any UI exists. The gate cannot live inside
             MainActivity: WryActivity.onCreate registers the lifecycle
             observer that synchronously starts the native build, so the
             abort races super.onCreate(). The gate uses a translucent theme
             and a plain Activity, so the happy path renders nothing and just
             forwards to MainActivity. See LaunchGateActivity.kt.
        -->
        <activity
            android:name=".LaunchGateActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             configChanges: the only thing that stops Android from destroying
             and recreating the Activity at all. Keep this list long, and read
             the history before shortening it.

             History. In 0.13.1 the app aborted on Activity recreation with
             "assertion failed: previous.is_none()" — 7+ users on Play
             Console. The abort lived in tao <= 0.34.x, which depended on
             ndk-context and called ndk_context::initialize_android_context
             from tao::ndk_glue::create on WryActivity.onCreate. That
             function stored the Activity in a single global slot and
             assert!-ed the slot was empty, so a second onCreate in a
             surviving process killed the process. Two fixes shipped
             together: a vendored ndk-context fork that made re-init a no-op
             replace, and this configChanges list, which absorbs config
             changes so the Activity is not destroyed and recreated at all.
             The 0.13.1 list stopped at uiMode. All ten of fontScale,
             density, layoutDirection, navigation, mcc, mnc, touchscreen,
             colorMode, fontWeightAdjustment (API 31) and grammaticalGender
             (API 34) were added in that one commit. fontScale is the entry
             tied to the reports (language-learning users adjust system font
             size), but none of the ten is filler — each is a config change
             Android can deliver at runtime.

             Why the fork is gone. tao 0.35.3 (shipped since app 0.16.0)
             dropped the ndk-context dependency entirely: the single global
             slot became a per-Activity BTreeMap whose insert is idempotent,
             and onActivityDestroy now checks isChangingConfigurations
             before tearing the context down. The upstream abort no longer
             exists, so the vendored fork was inert and has been retired.

             Consequence: nothing else now prevents the Activity from being
             destroyed and recreated. Removing an entry from this list re-
             exposes the Activity to destroy/recreate cycles that upstream is
             only assumed to handle. Do not trim it for tidiness.

             Different crash clusters, same trigger: prevent_exit()
             (src/lib.rs) covers the process::exit teardown abort that
             follows an Activity destroy — including a config recreate — not
             the onCreate re-init abort this list is about. So a recreate is
             not wholly unguarded; it is unguarded at onCreate.
             LaunchGateActivity covers a missing/updating System WebView at
             init.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density|layoutDirection|navigation|mcc|mnc|touchscreen|colorMode|fontWeightAdjustment|grammaticalGender"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name="com.corpora.audio_keepalive.AudioKeepAliveService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
