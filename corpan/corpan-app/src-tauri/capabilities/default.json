{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "tts:allow-speak",
    "tts:default",
    "audio-keepalive:default",
    "radio-stream:default",
    "iap:default",
