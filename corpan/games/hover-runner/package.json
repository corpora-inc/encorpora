    "dev:corpan": "node scripts/dev-corpan.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "^6.48.0",
    "@babylonjs/loaders": "^6.48.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
