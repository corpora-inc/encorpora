{
  "0": {
    "text": "ಮುಚ್ಚುವ ಮೊದಲು ಫೈಲ್ ಸೇವ್ ಮಾಡಿ.",
    "romanization": "Muccuva modalū phail sēv māḍi."
  },
  "1": {
    "text": "ಆ ಡಾಕ್ಯುಮೆಂಟ್ ನನಗೆ ಕಳುಹಿಸಬಹುದಾ?",
    "romanization": "Ā ḍākyūmeṇṭ nanage kaḷuhisabahudā?"
  },
  "2": {
    "text": "ಆ ಫೋಲ್ಡರ್ ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಲ್ಲಿದೆ.",
    "romanization": "Ā phōlḍar ḍeskṭāpnallide."
  },
  "3": {
    "text": "ನಿನ್ನೆ ಸೇವ್ ಮಾಡಿದ ಫೈಲ್ ಸಿಗುತ್ತಿಲ್ಲ.",
    "romanization": "Ninne sēv māḍida phail siguttilla."
  },
  "4": {
    "text": "ಆ ಹೆಸರಿನಿಂದ ಇಡೀ ಡ್ರೈವ್‌ನಲ್ಲಿ ಹುಡುಕಿ.",
    "romanization": "Ā hesarininda iḍī ḍraivnalli huḍuki."
  },
  "5": {
    "text": "ಅವನು ತಪ್ಪಾಗಿ ಫೈಲ್‌ನ ಹೆಸರನ್ನು ಬದಲಾಯಿಸಿದ.",
    "romanization": "Avanu tappāgi phailna hesarannu badalāyisida."
  },
  "6": {
    "text": "ಡೌನ್‌ಲೋಡ್ ತಪ್ಪಾದ ಫೋಲ್ಡರ್‌ಗೆ ಹೋಗಿದೆ.",
    "romanization": "Ḍaunlōḍ tappāda phōlḍarge hōgide."
  },
  "7": {
    "text": "ಈ ಫೈಲ್ ಇಮೇಲ್ ಮಾಡಲು ತುಂಬಾ ದೊಡ್ಡದಾಗಿದೆ.",
    "romanization": "Ī phail imēl māḍalu tumbā doḍḍadāgide."
  },
  "8": {
    "text": "ಅದನ್ನು ಜಿಪ್ ಮಾಡಿ ಕಳುಹಿಸಬಹುದಾ?",
    "romanization": "Adannu jip māḍi kaḷuhisabahudā?"
  },
  "9": {
    "text": "ಕ್ಲೌಡ್ ಫೋಲ್ಡರ್ ತಾನಾಗಿಯೇ ಸಿಂಕ್ ಆಗುತ್ತದೆ.",
    "romanization": "Klaud phōlḍar tānāgiyē siṅk āguttade."
  },
  "10": {
    "text": "ಅವಳು ಎಲ್ಲವನ್ನೂ ದಿನಾಂಕದ ಉಪ-ಫೋಲ್ಡರ್‌ಗಳಲ್ಲಿ ವ್ಯವಸ್ಥಿತವಾಗಿ ಇಡುತ್ತಾಳೆ.",
    "romanization": "Avaḷu ellavannū dināṅkada upa-phōlḍargaḷalli vyavastitavāgi iḍuttāḷe."
  },
  "11": {
    "text": "ಟ್ರ್ಯಾಶ್ ಡ್ರೈವ್‌ನ ಉಳಿದ ಭಾಗಕ್ಕಿಂತ ತುಂಬಿದೆ.",
    "romanization": "Trāś ḍraivna uḷida bhāgakkinta tumbide."
  },
  "12": {
    "text": "ಅವನು ಪ್ರತಿ ಪ್ರಾಜೆಕ್ಟ್‌ನ ಬ್ಯಾಕಪ್ ಇಟ್ಟುಕೊಳ್ಳುತ್ತಾನೆ.",
    "romanization": "Avanu prati prājekṭna byākapp iṭṭukoḷḷuttāne."
  },
  "13": {
    "text": "ಹಂಚಿದ ಫೋಲ್ಡರ್ ಎಲ್ಲರಿಗೂ ಅಪ್‌ಡೇಟ್ ಆಗಿದೆ.",
    "romanization": "Hañcida phōlḍar ellarigū ap-ḍēṭ āgide."
  },
  "14": {
    "text": "ಸಿಗದ ಫೈಲ್ ಇಲ್ಲದಂತೆಯೇ.",
    "romanization": "Sigada phail illadanteyē."
  },
  "15": {
    "text": "ನಾನು ನನ್ನ ಪಾಸ್‌ವರ್ಡ್ ಮರೆತಿದ್ದೇನೆ.",
    "romanization": "Nānu nanna pāsparḍ maretiddēne."
  },
  "16": {
    "text": "ಲಾಗಿನ್ ಸ್ಕ್ರೀನ್‌ನಿಂದ ಪಾಸ್‌ವರ್ಡ್ ರೀಸೆಟ್ ಮಾಡಿ.",
    "romanization": "Lāgin skrīnininda pāsparḍ rīseṭ māḍi."
  },
  "17": {
    "text": "ಎಲ್ಲದಕ್ಕೂ ಒಂದೇ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಬೇಡಿ.",
    "romanization": "Elladakkū ondē pāsparḍ baḷasabēḍi."
  },
  "18": {
    "text": "ಪಾಸ್‌ವರ್ಡ್ ಮ್ಯಾನೇಜರ್ ನಿಮಗಾಗಿ ಅವುಗಳನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳುತ್ತದೆ.",
    "romanization": "Pāsparḍ myānējar nimagāgi avugaḷannu nenapiṭṭukoḷḷuttade."
  },
  "19": {
    "text": "ಟೂ-ಫ್ಯಾಕ್ಟರ್ ಒಂದು ಹೆಜ್ಜೆ ಹೆಚ್ಚಾದರೂ, ಸುರಕ್ಷತೆ ಹೆಚ್ಚು.",
    "romanization": "Ṭū-fyākṭar ondu hejje heccādaru, surakṣate heccu."
  },
  "20": {
    "text": "ಪರಿಶೀಲನಾ ಕೋಡ್‌ಗಾಗಿ ನಿಮ್ಮ ಇಮೇಲ್ ಪರಿಶೀಲಿಸಿ.",
    "romanization": "Pariśīlanā kōḍgāgi nimma imēl pariśīlisi."
  },
  "21": {
    "text": "ಆ ಲಿಂಕ್ ಹದಿನೈದು ನಿಮಿಷಗಳಲ್ಲಿ ಮುಕ್ತಾಯವಾಯಿತು.",
    "romanization": "Ā liṅk hadinaidu nimiṣagaḷalli muktāyavāyitu."
  },
  "22": {
    "text": "ಅವಳು ಪ್ರಾಜೆಕ್ಟ್‌ಗಾಗಿ ಹೊಸ ಅಕೌಂಟ್ ಸೃಷ್ಟಿಸಿದಳು.",
    "romanization": "Avaḷu prājekṭgāgi hosa akaunṭ sr̥ṣṭisidaḷu."
  },
  "23": {
    "text": "ಅವನು ಹಂಚಿದ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಸೈನ್ ಔಟ್ ಮಾಡುತ್ತಾನೆ.",
    "romanization": "Avanu hañcida kampyūṭargaḷalli sain auṭ māḍuttāne."
  },
  "24": {
    "text": "ಆ ಯೂಸರ್‌ನೇಮ್ ಈಗಾಗಲೇ ಬಳಕೆಯಲ್ಲಿದೆ.",
    "romanization": "Ā yūsarnēm īgāgale baḷakeyallide."
  },
  "25": {
    "text": "ರಿಕವರಿ ಕೋಡ್ ಅನ್ನು ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಉಳಿಸಿ.",
    "romanization": "Rīkavari kōḍ annu surakṣita sthaḷadalli uḷisi."
  },
  "26": {
    "text": "ಅನುಮಾನಾಸ್ಪದ ಲಾಗಿನ್ ಲಿಂಕ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡಬೇಡಿ.",
    "romanization": "Anumānāspada lāgin liṅkgaḷannu klik māḍabēḍi."
  },
  "27": {
    "text": "ನೀವು ಸ್ಥಳಾಂತರಗೊಂಡಾಗ ರಿಕವರಿ ಇಮೇಲ್ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ.",
    "romanization": "Nīvu sthaḷāntaragoṇḍāga rīkavari imēl ap-ḍēṭ māḍi."
  },
  "28": {
    "text": "ಪಾಸ್‌ಕೀ ಪಾಸ್‌ವರ್ಡ್‌ಗಿಂತ ವೇಗವಾಗಿದೆ.",
    "romanization": "Pāskī pāsparḍginta vēgavāgide."
  },
  "29": {
    "text": "ಇತ್ತೀಚಿಗೆ ನಿಮ್ಮ ಫೋನ್ ಕೂಡ ಒಂದು ಅಕೌಂಟ್ ಆಗಿದೆ.",
    "romanization": "Ittīcige nimma phōn kūḍa ondu akaunṭ āgide."
  },
  "30": {
    "text": "ಅದನ್ನು ರೀಸ್ಟಾರ್ಟ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿದ್ದೀರಾ?",
    "romanization": "Adannu rīsṭārṭ māḍalu prayatnisiddīrā?"
  },
  "31": {
    "text": "ಕೇಬಲ್ ಸಡಿಲವಾಗಿತ್ತು.",
    "romanization": "Kēbal saḍilavāgittu."
  },
  "32": {
    "text": "ಸ್ಕ್ರೀನ್ ಒಂದು ನಿಮಿಷ ಫ್ರೀಜ್ ಆಗಿತ್ತು.",
    "romanization": "Skrīn ondu nimiṣa phrīj āgittu."
  },
  "33": {
    "text": "ಎಲ್ಲಾ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.",
    "romanization": "Ellā ṭyābgalaḷannu mucci matte prayatnisi."
  },
  "34": {
    "text": "ನೀವು ಸರಿಯಾದ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಸಂಪರ್ಕಗೊಂಡಿದ್ದೀರಾ ಎಂದು ಪರಿಶೀಲಿಸಿ.",
    "romanization": "Nīvu sariyāda neṭvarkge samparkagoṇḍiddīrā endu pariśīlisi."
  },
  "35": {
    "text": "ಕೀಬೋರ್ಡ್ ಪ್ರತಿಕ್ರಿಯಿಸುತ್ತಿಲ್ಲ.",
    "romanization": "Kīborḍ pratikriyisuttilla."
  },
  "36": {
    "text": "ಫ್ಯಾನ್ ಎಂದಿಗಿಂತ ಜೋರಾಗಿದೆ.",
    "romanization": "Fyān endiginta jōrāgide."
  },
  "37": {
    "text": "ಕ್ಯಾಶ್ ಕ್ಲಿಯರ್ ಮಾಡಿ ಮತ್ತೆ ಲೋಡ್ ಮಾಡಿ.",
    "romanization": "Kyāś kliyar māḍi matte lōḍ māḍi."
  },
  "38": {
    "text": "ಬೇರೆ ಬ್ರೌಸರ್ ಪ್ರಯತ್ನಿಸಿ.",
    "romanization": "Bēre brausar prayatnisi."
  },
  "39": {
    "text": "ಅಪ್‌ಡೇಟ್ ಆ ಬಗ್ ಅನ್ನು ಸರಿಪಡಿಸಿತು.",
    "romanization": "Ap-ḍēṭ ā bag annu saripaḍisitu."
  },
  "40": {
    "text": "ಬ್ಯಾಟರಿ ರಾತ್ರಿಯಿಡೀ ಖಾಲಿಯಾಗಿದೆ.",
    "romanization": "Byāṭari rātriyiḍī khāliyāgide."
  },
  "41": {
    "text": "ಅಪ್‌ಡೇಟ್ ಆದ ಮೇಲೆ ವೆಬ್‌ಕ್ಯಾಮ್ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿತು.",
    "romanization": "Ap-ḍēṭ āda mēle vebkām kelasa māḍuvudannu nillisitu."
  },
  "42": {
    "text": "ಕೆಲವೊಮ್ಮೆ ಸರಳ ಪರಿಹಾರವೆಂದರೆ ಒಂದು ನಿಮಿಷ ಕಾಯುವುದು.",
    "romanization": "Kelavomme saraḷ parihāravendare ondu nimiṣa kāyuvudu."
  },
  "43": {
    "text": "ರೀಬೂಟ್ ಜನರು ಒಪ್ಪಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಹೆಚ್ಚು ಸಮಸ್ಯೆಗಳನ್ನು ಪರಿಹರಿಸುತ್ತದೆ.",
    "romanization": "Rībūṭ janaru oppikoḷḷuvudakkinta heccu samasyegaḷannu pariharisuttade."
  },
  "44": {
    "text": "ಅವನು ಎರರ್ ಮೆಸೇಜ್ ಅನ್ನು ಸರಳ ಪದಗಳಲ್ಲಿ ವಿವರಿಸಿದ.",
    "romanization": "Avanu erar mesēj annu saraḷ padagaḷalli vivarisida."
  },
  "45": {
    "text": "ಪೇಜ್ ಲೋಡ್ ಆಗಲು ತುಂಬಾ ಸಮಯ ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದೆ.",
    "romanization": "Pēj lōḍ āgalu tumbā samaya tegedukoḷḷuttide."
  },
  "46": {
    "text": "ಸೈಟ್ ಎಲ್ಲರಿಗೂ ಡೌನ್ ಆಗಿದೆ.",
    "romanization": "Saiṭ ellarigū ḍaun āgide."
  },
  "47": {
    "text": "ಅದನ್ನು ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡಿ, ಇದರಿಂದ ಮತ್ತೆ ಹುಡುಕಬಹುದು.",
    "romanization": "Adannu buk-mārk māḍi, idarinda matte huḍukabahudu."
  },
  "48": {
    "text": "ಇಮೇಲ್‌ನಲ್ಲಿರುವ ಲಿಂಕ್ ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ.",
    "romanization": "Imēlnalliruva liṅk hosa ṭyābnalli tereyuttade."
  },
  "49": {
    "text": "ವಿಡಿಯೋ ಬಫರಿಂಗ್ ಆಗುತ್ತಲೇ ಇದೆ.",
    "romanization": "Viḍiyō baphariṅg āguttalē ide."
  },
  "50": {
    "text": "ಹಿಂದಿನ ಕೋಣೆಯಲ್ಲಿ ಸಿಗ್ನಲ್ ದುರ್ಬಲವಾಗಿದೆ.",
    "romanization": "Hindina kōṇeyalli signāl durbaḷavāgide."
  },
  "51": {
    "text": "ಆ ಲಿಂಕ್ ನನಗೆ ಶೇರ್ ಮಾಡಬಹುದಾ?",
    "romanization": "Ā liṅk nanage śēr māḍabahudā?"
  },
  "52": {
    "text": "ಮೊಬೈಲ್‌ನಲ್ಲಿ ವೆಬ್‌ಸೈಟ್ ಬೇರೆಯಾಗಿ ಕಾಣುತ್ತದೆ.",
    "romanization": "Mobailnalli vebsaiṭ bēreyāgi kāṇuttade."
  },
  "53": {
    "text": "ಪಾಪ್-ಅಪ್ ಕುಕೀಸ್ ಸ್ವೀಕರಿಸಲು ಕೇಳಿತು.",
    "romanization": "Pāp-ap kukīs svīkarisalu kēḷitu."
  },
  "54": {
    "text": "ಆ ಜಾಹೀರಾತನ್ನು ಮುಚ್ಚುವುದು ಕಷ್ಟ.",
    "romanization": "Ā jāhīrātannu muccuvudu kaṣṭa."
  },
  "55": {
    "text": "ಅವನು ಪ್ರತಿ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಆಡ್ ಬ್ಲಾಕರ್ ಬಳಸುತ್ತಾನೆ.",
    "romanization": "Avanu prati kampyūṭarnalli āḍ blākar baḷasuttāne."
  },
  "56": {
    "text": "ಹುಡುಕಾಟವು ತುಂಬಾ ಫಲಿತಾಂಶಗಳನ್ನು ನೀಡಿತು.",
    "romanization": "Huḍukāṭavu tumbā phalitāṁśagaḷannu nīḍitu."
  },
  "57": {
    "text": "ಉದ್ಧರಣ ಚಿಹ್ನೆಗಳನ್ನು ಬಳಸಿ ಹುಡುಕಾಟವನ್ನು ಪರಿಷ್ಕರಿಸಿ.",
    "romanization": "Uddharaṇa cihnegaḷannu baḷasi huḍukāṭavannu pariṣkarisi."
  },
  "58": {
    "text": "ಆ ಲೇಖನ ಪೇವಾಲ್ ಹಿಂದೆ ಹೋಗಿದೆ.",
    "romanization": "Ā lēkhana pēvāl hinde hōgide."
  },
  "59": {
    "text": "ಈ ಪೇಜ್ ನಾನು ನಂಬುವ ವೆಬ್‌ಸೈಟ್‌ನಿಂದ ಬಂದಿದೆ.",
    "romanization": "Ī pēj nānu nambuva vebsaiṭnininda bandide."
  },
  "60": {
    "text": "ಆ ಆಪ್ ರಾತ್ರಿಯಿಡೀ ಅಪ್‌ಡೇಟ್ ಆಗಿದೆ.",
    "romanization": "Ā āp rātriyiḍī ap-ḍēṭ āgide."
  },
  "61": {
    "text": "ಹೊಸ ಆವೃತ್ತಿ ಸಂಪೂರ್ಣವಾಗಿ ವಿಭಿನ್ನವಾಗಿ ಕಾಣುತ್ತದೆ.",
    "romanization": "Hosa āvr̥tti sampūrṇavāgi vibhinnvavāgi kāṇuttade."
  },
  "62": {
    "text": "ಅವಳು ಎಂದಿಗೂ ತೆರೆಯದ ಆಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿದಳು.",
    "romanization": "Avaḷu endigū tereyada āpgaḷannu tegeduhākidaḷu."
  },
  "63": {
    "text": "ನೋಟಿಫಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮೆನುವಿನಲ್ಲಿ ಆಳವಾಗಿ ಅಡಗಿವೆ.",
    "romanization": "Nōṭiphikēśan seṭṭiṅggaḷu menuvinalli āḷavāgi aḍagive."
  },
  "64": {
    "text": "ಮೀಟಿಂಗ್ ಸಮಯದಲ್ಲಿ ಅದನ್ನು ಮ್ಯೂಟ್ ಮಾಡಿ.",
    "romanization": "Mīṭiṅg samayadalli adannu myūṭ māḍi."
  },
  "65": {
    "text": "ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಮೆನುವಿಗಿಂತ ವೇಗವಾಗಿದೆ.",
    "romanization": "Kīborḍ śārṭkaṭ menuviginta vēgavāgide."
  },
  "66": {
    "text": "ರಾತ್ರಿ ಡಾರ್ಕ್ ಮೋಡ್ ಕಣ್ಣುಗಳಿಗೆ ಹೆಚ್ಚು ಆರಾಮದಾಯಕ.",
    "romanization": "Rātri ḍārk mōḍ kaṇṇugaḷige heccu ārāmadāyaka."
  },
  "67": {
    "text": "ಆಟೋ-ಪ್ಲೇ ಆಫ್ ಮಾಡಿ.",
    "romanization": "Āṭō-plē āph māḍi."
  },
  "68": {
    "text": "ನೋಟಿಫಿಕೇಶನ್ ಬ್ಯಾಡ್ಜ್ ಎಂದಿಗೂ ಹೋಗುವುದಿಲ್ಲ.",
    "romanization": "Nōṭiphikēśan byāḍj endigū hōguvudilla."
  },
  "69": {
    "text": "ಅವನು ತನಗೆ ಇಷ್ಟವಾದ ರೀತಿಯಲ್ಲಿ ಲ್ಯಾಪ್‌ಟಾಪ್ ಸೆಟ್ ಅಪ್ ಮಾಡಿಕೊಂಡಿದ್ದಾನೆ.",
    "romanization": "Avanu tanage iṣṭavāda rītiyalli lyāpṭāp seṭ ap māḍikoṇḍiddāne."
  },
  "70": {
    "text": "ಅಪರಿಚಿತ ಕಳುಹಿಸುವವರಿಂದ ಬಂದ ಅಟ್ಯಾಚ್‌ಮೆಂಟ್‌ಗಳನ್ನು ತೆರೆಯಬೇಡಿ.",
    "romanization": "Aparicita kaḷuhisuvavarinda banda aṭyācmenṭgaḷannu tereyabēḍi."
  },
  "71": {
    "text": "ಆ ಮೆಸೇಜ್‌ನಲ್ಲಿರುವ ಲಿಂಕ್ ಅನುಮಾನಾಸ್ಪದವಾಗಿ ಕಾಣುತ್ತದೆ.",
    "romanization": "Ā mesējnalḷiruva liṅk anumānāspadavāgi kāṇuttade."
  },
  "72": {
    "text": "ಕಳುಹಿಸುವವರ ಪೂರ್ಣ ವಿಳಾಸವನ್ನು ಪರಿಶೀಲಿಸಿ.",
    "romanization": "Kaḷuhisuvavara pūrṇa viḷāsavannu pariśīlisi."
  },
  "73": {
    "text": "ಏರ್‌ಪೋರ್ಟ್‌ನಲ್ಲಿರುವ ಉಚಿತ ವೈ-ಫೈ ಖಾಸಗಿಯಲ್ಲ.",
    "romanization": "Ērporṭnalliruva ucita vai-phai khāsagiyalla."
  },
  "74": {
    "text": "ಕ್ಯಾಮೆರಾ ಬಳಸದಿದ್ದಾಗ ಅದನ್ನು ಮುಚ್ಚಿ.",
    "romanization": "Kyāmerā baḷasadiddāga adannu mucci."
  },
  "75": {
    "text": "ನೀವು ದೂರ ಹೋದಾಗ ಸ್ಕ್ರೀನ್ ಲಾಕ್ ಮಾಡಿ.",
    "romanization": "Nīvu dūra hōdāga skrīn lāk māḍi."
  },
  "76": {
    "text": "ಹಿಂಪಡೆಯಲು ಸಾಧ್ಯವಾಗದ ಮಾಹಿತಿಯ ಬಗ್ಗೆ ಎಚ್ಚರವಿರಲಿ.",
    "romanization": "Himpaḍeyalu sādhyavāgada māhitiya bagge eccaravirali."
  },
  "77": {
    "text": "ನೀವು ಯಾವುದಕ್ಕೆ ಒಪ್ಪಿಗೆ ನೀಡುತ್ತಿದ್ದೀರಿ ಎಂಬುದನ್ನು ಓದಿ.",
    "romanization": "Nīvu yāvudakke oppige nīḍuttiddīri embudannu ōdi."
  },
  "78": {
    "text": "ಹೆಚ್ಚಿನ ಡೇಟಾ ಸೋರಿಕೆಗಳು ಮರುಬಳಕೆಯ ಪಾಸ್‌ವರ್ಡ್‌ಗಳಿಂದ ಬರುತ್ತವೆ.",
    "romanization": "Heccina ḍēṭā sōrikegaḷu marubaḷakeya pāsparḍgaḷinda baruttave."
  },
  "79": {
    "text": "ಸರಳವಾದ ಸ್ಕ್ಯಾಮ್‌ಗಳು ಸರಳವಾಗಿರುವುದರಿಂದಲೇ ಇನ್ನೂ ಕೆಲಸ ಮಾಡುತ್ತವೆ.",
    "romanization": "Saraḷavāda skyāmgaḷu saraḷavāgiruvudarindalē innū kelasa māḍuttave."
  },
  "80": {
    "text": "ಕೊನೆಯ ಅಪ್‌ಡೇಟ್‌ನಿಂದ ಲ್ಯಾಪ್‌ಟಾಪ್ ನಿಧಾನವಾಗಿದೆ.",
    "romanization": "Koney ap-ḍēṭnininda lyāpṭāp nidānavāgide."
  },
  "81": {
    "text": "ಸ್ಕ್ರೀನ್ ಒಡೆದಿದೆ ಆದರೆ ಇನ್ನೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ.",
    "romanization": "Skrīn oḍedide ādare innū kelasa māḍuttade."
  },
  "82": {
    "text": "ಹೊಸ ಮಾನಿಟರ್ ಇಂದು ಬೆಳಿಗ್ಗೆ ಬಂದಿದೆ.",
    "romanization": "Hosa māniṭar indu beḷigge bandide."
  },
  "83": {
    "text": "ಸರಿಯಾದ ಕೇಬಲ್ ಸಿಗುವ ಮೊದಲು ಅವನು ಮೂರು ಕೇಬಲ್‌ಗಳನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿದ.",
    "romanization": "Sariyāda kēbal siguva modalū avanu mūru kēbalgaḷannu plag in māḍida."
  },
  "84": {
    "text": "ಬ್ಯಾಟರಿ ಮೊದಲಿನಂತೆ ಬಾಳಿಕೆ ಬರುತ್ತಿಲ್ಲ.",
    "romanization": "Byāṭari modalinante bāḷike baruttilla."
  },
  "85": {
    "text": "ವರ್ಷಗಳಿಂದ ಕೀಬೋರ್ಡ್‌ನಲ್ಲಿ ಕಣಗಳು ಸಂಗ್ರಹವಾಗಿವೆ.",
    "romanization": "Varṣagaḷinda kīborḍnalli kaṇagaḷu saṅgrahvāgive."
  },
  "86": {
    "text": "ಕೋಣೆ ಬಿಸಿಯಾದಾಗ ಫ್ಯಾನ್ ಆನ್ ಆಗುತ್ತದೆ.",
    "romanization": "Kōṇe bisiyādāga fyān ān āguttade."
  },
  "87": {
    "text": "ಪ್ರಿಂಟರ್ ಮತ್ತೆ ಆಫ್‌ಲೈನ್ ಆಗಿದೆ.",
    "romanization": "Prinṭar matte āphlain āgide."
  },
  "88": {
    "text": "ಹೆಡ್‌ಫೋನ್‌ಗಳು ಒಂದು ಕಡೆ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿವೆ.",
    "romanization": "Heḍphōngaḷu ondu kaḍe kelasa māḍuvudannu nillisive."
  },
  "89": {
    "text": "ಅವನು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಮೃದುವಾದ ಬಟ್ಟೆಯಿಂದ ಸ್ವಚ್ಛಗೊಳಿಸುತ್ತಾನೆ.",
    "romanization": "Avanu skrīn annu mr̥duvāda baṭṭeyinda svacchagoḷisuttāne."
  },
  "90": {
    "text": "ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆದುಕೊಳ್ಳಬಹುದಾ?",
    "romanization": "Skrīnśāṭ tegedukoḷḷabahudā?"
  },
  "91": {
    "text": "ಆ ಫೈಲ್ ಮಧ್ಯರಾತ್ರಿ ಕಳುಹಿಸಲಾಗಿದೆ.",
    "romanization": "Ā phail madhyarātri kaḷuhisalāgide."
  },
  "92": {
    "text": "ಕ್ಯಾಲೆಂಡರ್ ಇನ್ವೈಟ್ ಎರಡು ಬಾರಿ ಬಂದಿದೆ.",
    "romanization": "Kyālenḍar invaiṭ eraḍu bāri bandide."
  },
  "93": {
    "text": "ಫೈಲ್ ಅನ್ನು ವಿಂಡೋಗೆ ಡ್ರ್ಯಾಗ್ ಮಾಡಿ.",
    "romanization": "Phail annu viṇḍōge ḍryāg māḍi."
  },
  "94": {
    "text": "ಹೆಚ್ಚಿನ ಆಯ್ಕೆಗಳನ್ನು ನೋಡಲು ರೈಟ್-ಕ್ಲಿಕ್ ಮಾಡಿ.",
    "romanization": "Heccina āykeḷannu nōḍalu raiṭ-klik māḍi."
  },
  "95": {
    "text": "ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಆಯ್ಕೆ ಮಾಡಲು ಶಿಫ್ಟ್ ಒತ್ತಿ ಹಿಡಿಯಿರಿ.",
    "romanization": "Ondakkinta heccu āyke māḍalu śiphṭ otti hiḍiyiri."
  },
  "96": {
    "text": "ಅಂಡು ಬಟನ್ ನನ್ನನ್ನು ಹಲವು ಬಾರಿ ಉಳಿಸಿದೆ.",
    "romanization": "Aṇḍu baṭan nannannu halavu bāri uḷiside."
  },
  "97": {
    "text": "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ನೀವು ಕೊನೆಯದಾಗಿ ಕಾಪಿ ಮಾಡಿದ ವಿಷಯವನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳುತ್ತದೆ.",
    "romanization": "Klipborḍ nīvu koneydāgi kāpi māḍida viṣayavannu nenapiṭṭukoḷḷuttade."
  },
  "98": {
    "text": "ಆಟೋಕರೆಕ್ಟ್ ಸಹಾಯಕವಾಗಿದೆ ಮತ್ತು ಕೆಲವೊಮ್ಮೆ ಮುಜುಗರವನ್ನುಂಟುಮಾಡುತ್ತದೆ.",
    "romanization": "Āṭōkarekṭ sahāyakavāgide mattu kelavomme mujugaravannuṇṭumāḍuttade."
  },
  "99": {
    "text": "ಸ್ವಚ್ಛವಾದ ಡೆಸ್ಕ್‌ಟಾಪ್ ಎಲ್ಲವನ್ನೂ ಸುಲಭವಾಗಿ ಹುಡುಕಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.",
    "romanization": "Svacchavāda ḍeskṭāp ellavannū sulabhavāgi huḍukalu sahāya māḍuttade."
  }
}