{
  "0": {
    "text": "Mkutano unaanza baada ya dakika kumi.",
    "romanization": null
  },
  "1": {
    "text": "Unaweza kushiriki skrini yako?",
    "romanization": null
  },
  "2": {
    "text": "Samahani, nilikuwa nimenyamazisha kipaza sauti.",
    "romanization": null
  },
  "3": {
    "text": "Tunapitiliza muda.",
    "romanization": null
  },
  "4": {
    "text": "Hebu tuhamishie hilo kwenye mkutano ujao.",
    "romanization": null
  },
  "5": {
    "text": "Nitaandika muhtasari.",
    "romanization": null
  },
  "6": {
    "text": "Tunaweza kupitia kila mmoja wetu?",
    "romanization": null
  },
  "7": {
    "text": "Ajenda iko kwenye mwaliko wa kalenda.",
    "romanization": null
  },
  "8": {
    "text": "Nani anaongoza hili?",
    "romanization": null
  },
  "9": {
    "text": "Tunarekodi hili?",
    "romanization": null
  },
  "10": {
    "text": "Simu ilikata katikati.",
    "romanization": null
  },
  "11": {
    "text": "Tunaweza kusogeza hili mbele kwa dakika kumi na tano?",
    "romanization": null
  },
  "12": {
    "text": "Aliingia akiwa amechelewa lakini kimya kimya.",
    "romanization": null
  },
  "13": {
    "text": "Chumba kimepangwa mara mbili tena.",
    "romanization": null
  },
  "14": {
    "text": "Hebu tuweke hilo kando na tulirudie baadaye.",
    "romanization": null
  },
  "15": {
    "text": "Nina kikomo cha muda saa tisa kamili.",
    "romanization": null
  },
  "16": {
    "text": "Unaweza kubaki kwa dakika mbili baada ya hapo?",
    "romanization": null
  },
  "17": {
    "text": "Ubao mweupe umejaa.",
    "romanization": null
  },
  "18": {
    "text": "Unaweza kufupisha mambo ya kufanya?",
    "romanization": null
  },
  "19": {
    "text": "Mikutano ya kusimama huisha haraka ajabu.",
    "romanization": null
  },
  "20": {
    "text": "Nitakujibu kabla ya mwisho wa siku.",
    "romanization": null
  },
  "21": {
    "text": "Barua pepe yangu ya mwisho ilifika?",
    "romanization": null
  },
  "22": {
    "text": "Samahani kwa kuchelewa kujibu.",
    "romanization": null
  },
  "23": {
    "text": "Namjumuisha Sara kwenye hili.",
    "romanization": null
  },
  "24": {
    "text": "Kiambatisho hakikufika.",
    "romanization": null
  },
  "25": {
    "text": "Niliiweka alama ya dharura.",
    "romanization": null
  },
  "26": {
    "text": "Unaweza kutuma tena faili hilo?",
    "romanization": null
  },
  "27": {
    "text": "Mjadala umekuwa mrefu, hebu nifupishe.",
    "romanization": null
  },
  "28": {
    "text": "Tumia kichwa cha habari ili niweze kukipata.",
    "romanization": null
  },
  "29": {
    "text": "Alimaliza barua pepe zake zote mwishoni mwa wiki.",
    "romanization": null
  },
  "30": {
    "text": "Tafadhali jibu kabla ya Ijumaa.",
    "romanization": null
  },
  "31": {
    "text": "Nitatuma ujumbe mfupi itakapokamilika.",
    "romanization": null
  },
  "32": {
    "text": "Jibu la kiotomatiki linasema yuko safarini.",
    "romanization": null
  },
  "33": {
    "text": "Alinakili mtu asiyefaa kimakosa.",
    "romanization": null
  },
  "34": {
    "text": "Vikumbusho vitatu vinatosha.",
    "romanization": null
  },
  "35": {
    "text": "Unaweza kunisambazia mjadala huo?",
    "romanization": null
  },
  "36": {
    "text": "Gumzo linaenda haraka kuliko barua pepe kwa hili.",
    "romanization": null
  },
  "37": {
    "text": "Ujumbe wako ulinipita kutokana na kelele nyingi.",
    "romanization": null
  },
  "38": {
    "text": "Kiungo kwenye barua pepe yako kinaelekeza kwenye ukurasa usiopatikana.",
    "romanization": null
  },
  "39": {
    "text": "Tafadhali thibitisha umepokea hili.",
    "romanization": null
  },
  "40": {
    "text": "Tarehe ya mwisho ni Ijumaa saa sita mchana.",
    "romanization": null
  },
  "41": {
    "text": "Nitakuwa na rasimu ya kwanza kufikia Jumatano.",
    "romanization": null
  },
  "42": {
    "text": "Tunahitaji kutoa kitu wiki hii.",
    "romanization": null
  },
  "43": {
    "text": "Mradi ulichelewa kwa siku moja.",
    "romanization": null
  },
  "44": {
    "text": "Unaweza kukagua hili kabla sijatuma?",
    "romanization": null
  },
  "45": {
    "text": "Ninakudai taarifa ya maendeleo.",
    "romanization": null
  },
  "46": {
    "text": "Namba hazilingani na nilichotuma wiki iliyopita.",
    "romanization": null
  },
  "47": {
    "text": "Tumekwama kusubiri uamuzi kutoka kwa mteja.",
    "romanization": null
  },
  "48": {
    "text": "Alifanya kazi wakati wa chakula cha mchana ili kumaliza.",
    "romanization": null
  },
  "49": {
    "text": "Ripoti hatimaye imetoka mikononi mwangu.",
    "romanization": null
  },
  "50": {
    "text": "Nitaanza mara tu nitakapopata idhini.",
    "romanization": null
  },
  "51": {
    "text": "Unaweza kuidhinisha toleo hili?",
    "romanization": null
  },
  "52": {
    "text": "Aligundua kosa la kuandika kabla hatujatoa.",
    "romanization": null
  },
  "53": {
    "text": "Tumehamishia uzinduzi Jumanne ijayo.",
    "romanization": null
  },
  "54": {
    "text": "Makadirio yalikosea kwa mara mbili.",
    "romanization": null
  },
  "55": {
    "text": "Alifuta ratiba yake ya mchana ili aweze kuzingatia.",
    "romanization": null
  },
  "56": {
    "text": "Mkataba ulirudi ukiwa umetiwa saini.",
    "romanization": null
  },
  "57": {
    "text": "Hebu tuseme imekamilika na tuendelee.",
    "romanization": null
  },
  "58": {
    "text": "Toleo la kwanza ni gumu lakini linafanya kazi.",
    "romanization": null
  },
  "59": {
    "text": "Alikamilisha mapema kwa mara moja.",
    "romanization": null
  },
  "60": {
    "text": "Karibu kwenye timu.",
    "romanization": null
  },
  "61": {
    "text": "Nitakutambulisha kwa wengine.",
    "romanization": null
  },
  "62": {
    "text": "Amerudi tu kutoka likizo.",
    "romanization": null
  },
  "63": {
    "text": "Yeye ndiye mtu wa kumuuliza kuhusu hili.",
    "romanization": null
  },
  "64": {
    "text": "Tunashiriki dawati Jumanne.",
    "romanization": null
  },
  "65": {
    "text": "Nani anajua zaidi kuhusu bei?",
    "romanization": null
  },
  "66": {
    "text": "Yeye huleta kahawa kwa timu kila wakati.",
    "romanization": null
  },
  "67": {
    "text": "Mfanyakazi mpya anajifunza haraka.",
    "romanization": null
  },
  "68": {
    "text": "Anafanya kazi kwa karibu na idara ya masoko.",
    "romanization": null
  },
  "69": {
    "text": "Amekaa hapa muda mrefu kuliko mtu mwingine yeyote.",
    "romanization": null
  },
  "70": {
    "text": "Waligawana kazi sawasawa.",
    "romanization": null
  },
  "71": {
    "text": "Tulikula chakula cha mchana na kukichora.",
    "romanization": null
  },
  "72": {
    "text": "Alinishughulikia nilipokuwa mgonjwa.",
    "romanization": null
  },
  "73": {
    "text": "Timu ilikusanyika karibu na kompyuta mpakato.",
    "romanization": null
  },
  "74": {
    "text": "Anakumbuka siku za kuzaliwa za kila mtu.",
    "romanization": null
  },
  "75": {
    "text": "Nitajiunga nikiwa mbali kesho.",
    "romanization": null
  },
  "76": {
    "text": "Ofisi huwa tupu zaidi Ijumaa.",
    "romanization": null
  },
  "77": {
    "text": "Intaneti yangu haiko imara leo.",
    "romanization": null
  },
  "78": {
    "text": "Anafanya kazi kutoka jiji tofauti.",
    "romanization": null
  },
  "79": {
    "text": "Timu hukutana ana kwa ana mara moja kwa mwezi.",
    "romanization": null
  },
  "80": {
    "text": "Aliweka kona ya chumba cha kulala kama dawati.",
    "romanization": null
  },
  "81": {
    "text": "Ofisi ya nyumbani hatimaye imepangika.",
    "romanization": null
  },
  "82": {
    "text": "Unaweza kuwasha kamera yako?",
    "romanization": null
  },
  "83": {
    "text": "Kelele za nyuma hazina shida, usijali.",
    "romanization": null
  },
  "84": {
    "text": "Tunafanya ukaguzi mfupi kila asubuhi.",
    "romanization": null
  },
  "85": {
    "text": "Printa imekwama tena.",
    "romanization": null
  },
  "86": {
    "text": "Mashine ya kahawa haina maharagwe.",
    "romanization": null
  },
  "87": {
    "text": "Unaweza kufungua mlango?",
    "romanization": null
  },
  "88": {
    "text": "Dirisha la chumba cha mikutano halifunguki.",
    "romanization": null
  },
  "89": {
    "text": "Mtu fulani aliacha chakula chake cha mchana kwenye friji kwa wiki nzima.",
    "romanization": null
  },
  "90": {
    "text": "Jikoni huwa kimya saa tisa kamili.",
    "romanization": null
  },
  "91": {
    "text": "Alitumia ngazi ili kutuliza akili yake.",
    "romanization": null
  },
  "92": {
    "text": "Mmea kwenye kingo cha dirisha unaendelea vizuri.",
    "romanization": null
  },
  "93": {
    "text": "Unaweza kusaini kifurushi kwenye dawati la mapokezi?",
    "romanization": null
  },
  "94": {
    "text": "Kisoma beji kinafanya matatizo.",
    "romanization": null
  },
  "95": {
    "text": "Mwisho wa siku huja ghafla kila wakati.",
    "romanization": null
  },
  "96": {
    "text": "Anafanya kazi vizuri zaidi akiwa na dirisha moja wazi kwa wakati mmoja.",
    "romanization": null
  },
  "97": {
    "text": "Anawasha mshumaa kuashiria mwanzo wa siku.",
    "romanization": null
  },
  "98": {
    "text": "Kutembea kidogo baada ya chakula cha mchana kunanisaidia kufikiri.",
    "romanization": null
  },
  "99": {
    "text": "Baadhi ya Jumatatu huanza na ushindi mdogo.",
    "romanization": null
  }
}