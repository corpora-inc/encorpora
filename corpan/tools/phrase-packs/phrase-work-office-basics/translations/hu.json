  "47": {
    "text": "Egy ügyfél döntése miatt áll a munka.",
    "romanization": null
  },
  "48": {
    "text": "Ebédidőben is dolgozott, hogy befejezze.",
    "romanization": null
  },
  "49": {
    "text": "A jelentés végre lekerült a vállamról.",
