{
  "0": {
    "text": "Sestanek se začne čez deset minut.",
    "romanization": null
  },
  "1": {
    "text": "Bi lahko delili svoj zaslon?",
    "romanization": null
  },
  "2": {
    "text": "Oprostite, bil sem utišan.",
    "romanization": null
  },
  "3": {
    "text": "Smo že čez čas.",
    "romanization": null
  },
  "4": {
    "text": "To prestavimo na naslednji sestanek.",
    "romanization": null
  },
  "5": {
    "text": "Jaz bom delal zapiske.",
    "romanization": null
  },
  "6": {
    "text": "Bi lahko šli po vrsti?",
    "romanization": null
  },
  "7": {
    "text": "Dnevni red je v vabilu v koledarju.",
    "romanization": null
  },
  "8": {
    "text": "Kdo vodi tole?",
    "romanization": null
  },
  "9": {
    "text": "Ali to snemamo?",
    "romanization": null
  },
  "10": {
    "text": "Klic se je prekinil na sredi.",
    "romanization": null
  },
  "11": {
    "text": "Lahko to prestavimo za petnajst minut?",
    "romanization": null
  },
  "12": {
    "text": "Prišel je pozno, a tiho.",
    "romanization": null
  },
  "13": {
    "text": "Soba je spet dvakrat rezervirana.",
    "romanization": null
  },
  "14": {
    "text": "To odložimo in se vrnemo k temu pozneje.",
    "romanization": null
  },
  "15": {
    "text": "Ob treh moram nujno končati.",
    "romanization": null
  },
  "16": {
    "text": "Lahko ostaneš še dve minuti?",
    "romanization": null
  },
  "17": {
    "text": "Bela tabla je polna.",
    "romanization": null
  },
  "18": {
    "text": "Bi lahko povzeli naslednje korake?",
    "romanization": null
  },
  "19": {
    "text": "Stoječi sestanki so presenetljivo hitri.",
    "romanization": null
  },
  "20": {
    "text": "Oglasil se ti bom do konca dneva.",
    "romanization": null
  },
  "21": {
    "text": "Je moje zadnje sporočilo prišlo?",
    "romanization": null
  },
  "22": {
    "text": "Oprostite za pozen odgovor.",
    "romanization": null
  },
  "23": {
    "text": "Vključujem Saro v to.",
    "romanization": null
  },
  "24": {
    "text": "Priloga ni prišla.",
    "romanization": null
  },
  "25": {
    "text": "Označil sem kot nujno.",
    "romanization": null
  },
  "26": {
    "text": "Bi lahko ponovno poslali to datoteko?",
    "romanization": null
  },
  "27": {
    "text": "Pogovor se je razvlekel, naj povzamem.",
    "romanization": null
  },
  "28": {
    "text": "Uporabi zadevo, da jo bom lahko našel.",
    "romanization": null
  },
  "29": {
    "text": "Čez vikend je počistil svoj nabiralnik.",
    "romanization": null
  },
  "30": {
    "text": "Prosim, odgovorite do petka.",
    "romanization": null
  },
  "31": {
    "text": "Poslal bom kratko sporočilo, ko bo končano.",
    "romanization": null
  },
  "32": {
    "text": "Avtomatski odgovor pravi, da potuje.",
    "romanization": null
  },
  "33": {
    "text": "Pomotoma je kopirala napačno osebo.",
    "romanization": null
  },
  "34": {
    "text": "Trije opomniki so dovolj.",
    "romanization": null
  },
  "35": {
    "text": "Bi mi lahko posredovali pogovor?",
    "romanization": null
  },
  "36": {
    "text": "Za to je klepet hitrejši kot e-pošta.",
    "romanization": null
  },
  "37": {
    "text": "V vsem tem hrupu sem spregledal tvoje sporočilo.",
    "romanization": null
  },
  "38": {
    "text": "Povezava v tvojem e-poštnem sporočilu vodi na manjkajočo stran.",
    "romanization": null
  },
  "39": {
    "text": "Prosim, potrdite, da ste to prejeli.",
    "romanization": null
  },
  "40": {
    "text": "Rok je v petek opoldne.",
    "romanization": null
  },
  "41": {
    "text": "Prvi osnutek bom imel do srede.",
    "romanization": null
  },
  "42": {
    "text": "Ta teden moramo nekaj dostaviti.",
    "romanization": null
  },
  "43": {
    "text": "Projekt se je zamaknil za en dan.",
    "romanization": null
  },
  "44": {
    "text": "Bi lahko to lektorirali, preden pošljem?",
    "romanization": null
  },
  "45": {
    "text": "Dolgujem ti posodobitev stanja.",
    "romanization": null
  },
  "46": {
    "text": "Številke se ne ujemajo s tistim, kar sem poslal prejšnji teden.",
    "romanization": null
  },
  "47": {
    "text": "Čakamo na odločitev stranke.",
    "romanization": null
  },
  "48": {
    "text": "Delal je med kosilom, da bi končal.",
    "romanization": null
  },
  "49": {
    "text": "Poročilo je končno iz mojih rok.",
    "romanization": null
  },
  "50": {
    "text": "Začel bom takoj, ko dobim odobritev.",
    "romanization": null
  },
  "51": {
    "text": "Bi lahko potrdili to različico?",
    "romanization": null
  },
  "52": {
    "text": "Ujela je tipkarsko napako tik preden smo izdali.",
    "romanization": null
  },
  "53": {
    "text": "Zagon smo prestavili na naslednji torek.",
    "romanization": null
  },
  "54": {
    "text": "Ocena je bila napačna za faktor dva.",
    "romanization": null
  },
  "55": {
    "text": "Popoldne si je sprostil, da bi se lahko osredotočil.",
    "romanization": null
  },
  "56": {
    "text": "Pogodba se je vrnila podpisana.",
    "romanization": null
  },
  "57": {
    "text": "Recimo, da je končano, in gremo naprej.",
    "romanization": null
  },
  "58": {
    "text": "Prva različica je groba, a deluje.",
    "romanization": null
  },
  "59": {
    "text": "Tokrat je dostavil prej.",
    "romanization": null
  },
  "60": {
    "text": "Dobrodošel v ekipi.",
    "romanization": null
  },
  "61": {
    "text": "Predstavil te bom ostalim.",
    "romanization": null
  },
  "62": {
    "text": "Ravno se je vrnila z dopusta.",
    "romanization": null
  },
  "63": {
    "text": "On je prava oseba za vprašanja o tem.",
    "romanization": null
  },
  "64": {
    "text": "Ob torkih si delimo mizo.",
    "romanization": null
  },
  "65": {
    "text": "Kdo ve največ o določanju cen?",
    "romanization": null
  },
  "66": {
    "text": "Vedno prinese kavo za ekipo.",
    "romanization": null
  },
  "67": {
    "text": "Nov zaposleni se hitro uči.",
    "romanization": null
  },
  "68": {
    "text": "Tesno sodeluje z marketingom.",
    "romanization": null
  },
  "69": {
    "text": "Tukaj je dlje kot kdorkoli drug.",
    "romanization": null
  },
  "70": {
    "text": "Delo sta si razdelila točno na pol.",
    "romanization": null
  },
  "71": {
    "text": "Pojedli smo kosilo in to skicirali.",
    "romanization": null
  },
  "72": {
    "text": "Nadomeščal me je, ko sem bil bolan.",
    "romanization": null
  },
  "73": {
    "text": "Ekipa se je zbrala okoli prenosnika.",
    "romanization": null
  },
  "74": {
    "text": "Spomni se vseh rojstnih dni.",
    "romanization": null
  },
  "75": {
    "text": "Jutri se bom pridružil na daljavo.",
    "romanization": null
  },
  "76": {
    "text": "Pisarna je ob petkih večinoma prazna.",
    "romanization": null
  },
  "77": {
    "text": "Moj internet je danes nestabilen.",
    "romanization": null
  },
  "78": {
    "text": "Dela iz drugega mesta.",
    "romanization": null
  },
  "79": {
    "text": "Ekipa se sreča v živo enkrat mesečno.",
    "romanization": null
  },
  "80": {
    "text": "Kot pisarno si je uredila kotiček spalnice.",
    "romanization": null
  },
  "81": {
    "text": "Domača pisarna je končno pospravljena.",
    "romanization": null
  },
  "82": {
    "text": "Bi lahko vklopili kamero?",
    "romanization": null
  },
  "83": {
    "text": "Hrup v ozadju je v redu, ne skrbite.",
    "romanization": null
  },
  "84": {
    "text": "Vsako jutro se hitro slišimo.",
    "romanization": null
  },
  "85": {
    "text": "Tiskalnik se je spet zataknil.",
    "romanization": null
  },
  "86": {
    "text": "Aparatu za kavo je zmanjkalo zrnja.",
    "romanization": null
  },
  "87": {
    "text": "Bi lahko odprli vrata?",
    "romanization": null
  },
  "88": {
    "text": "Okno v konferenčni sobi se ne odpre.",
    "romanization": null
  },
  "89": {
    "text": "Nekdo je pustil svoje kosilo v hladilniku za en teden.",
    "romanization": null
  },
  "90": {
    "text": "Kuhinja je ob treh tiha.",
    "romanization": null
  },
  "91": {
    "text": "Šel je po stopnicah, da si zbistri glavo.",
    "romanization": null
  },
  "92": {
    "text": "Rastlina na okenski polici dobro uspeva.",
    "romanization": null
  },
  "93": {
    "text": "Bi lahko podpisali za paket na recepciji?",
    "romanization": null
  },
  "94": {
    "text": "Čitalec kartic nagaja.",
    "romanization": null
  },
  "95": {
    "text": "Konec dneva se vedno prikrade.",
    "romanization": null
  },
  "96": {
    "text": "Najbolje dela z enim odprtim oknom naenkrat.",
    "romanization": null
  },
  "97": {
    "text": "Prižge svečo, da označi začetek dneva.",
    "romanization": null
  },
  "98": {
    "text": "Kratek sprehod po kosilu mi pomaga razmišljati.",
    "romanization": null
  },
  "99": {
    "text": "Nekateri ponedeljki se začnejo z majhno zmago.",
    "romanization": null
  }
}