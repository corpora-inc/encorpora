{
  "0": {
    "text": "Toplantı on dakikaya başlar.",
    "romanization": null
  },
  "1": {
    "text": "Ekranınızı paylaşabilir misiniz?",
    "romanization": null
  },
  "2": {
    "text": "Üzgünüm, sesim kapalıymış.",
    "romanization": null
  },
  "3": {
    "text": "Süreyi aşıyoruz.",
    "romanization": null
  },
  "4": {
    "text": "Bunu bir sonraki toplantıda konuşalım.",
    "romanization": null
  },
  "5": {
    "text": "Notları ben alırım.",
    "romanization": null
  },
  "6": {
    "text": "Sırayla konuşabilir miyiz?",
    "romanization": null
  },
  "7": {
    "text": "Gündem, takvim davetiyesinde.",
    "romanization": null
  },
  "8": {
    "text": "Bu toplantıyı kim idare ediyor?",
    "romanization": null
  },
  "9": {
    "text": "Kayıt alıyor muyuz?",
    "romanization": null
  },
  "10": {
    "text": "Görüşme yarıda kesildi.",
    "romanization": null
  },
  "11": {
    "text": "Bunu on beş dakika ileri alabilir miyiz?",
    "romanization": null
  },
  "12": {
    "text": "Geç geldi ama kimseyi rahatsız etmedi.",
    "romanization": null
  },
  "13": {
    "text": "Oda yine çakışmış.",
    "romanization": null
  },
  "14": {
    "text": "Bunu şimdilik bir kenara bırakalım, sonra tekrar konuşuruz.",
    "romanization": null
  },
  "15": {
    "text": "Saat üçte kesin ayrılmam lazım.",
    "romanization": null
  },
  "16": {
    "text": "İki dakika daha kalabilir misin?",
    "romanization": null
  },
  "17": {
    "text": "Beyaz tahta dolu.",
    "romanization": null
  },
  "18": {
    "text": "Yapılacakları özetleyebilir misin?",
    "romanization": null
  },
  "19": {
    "text": "Ayakta yapılan toplantılar şaşırtıcı derecede hızlı bitiyor.",
    "romanization": null
  },
  "20": {
    "text": "Gün sonuna kadar size dönerim.",
    "romanization": null
  },
  "21": {
    "text": "Son e-postam ulaştı mı?",
    "romanization": null
  },
  "22": {
    "text": "Geç cevap verdiğim için üzgünüm.",
    "romanization": null
  },
  "23": {
    "text": "Sara'yı da bu e-postaya ekliyorum.",
    "romanization": null
  },
  "24": {
    "text": "Ek ulaşmadı.",
    "romanization": null
  },
  "25": {
    "text": "Acil olarak işaretledim.",
    "romanization": null
  },
  "26": {
    "text": "O dosyayı tekrar gönderebilir misin?",
    "romanization": null
  },
  "27": {
    "text": "E-posta zinciri uzadı, özetleyeyim.",
    "romanization": null
  },
  "28": {
    "text": "Konu kısmına yaz ki bulabileyim.",
    "romanization": null
  },
  "29": {
    "text": "Hafta sonu e-postalarını halletmiş.",
    "romanization": null
  },
  "30": {
    "text": "Lütfen Cuma gününe kadar cevap verin.",
    "romanization": null
  },
  "31": {
    "text": "Bitince kısa bir not gönderirim.",
    "romanization": null
  },
  "32": {
    "text": "Otomatik yanıtında seyahatte olduğu yazıyor.",
    "romanization": null
  },
  "33": {
    "text": "Yanlışlıkla yanlış kişiyi e-postaya eklemiş.",
    "romanization": null
  },
  "34": {
    "text": "Üç hatırlatma yeterli.",
    "romanization": null
  },
  "35": {
    "text": "Bana o e-posta zincirini iletebilir misin?",
    "romanization": null
  },
  "36": {
    "text": "Bu konuda e-postadan çok chat daha hızlı.",
    "romanization": null
  },
  "37": {
    "text": "Bu kadar mesaj arasında seninkini görmemişim.",
    "romanization": null
  },
  "38": {
    "text": "E-postandaki bağlantı bulunamayan bir sayfaya yönlendiriyor.",
    "romanization": null
  },
  "39": {
    "text": "Ulaştığını teyit eder misin?",
    "romanization": null
  },
  "40": {
    "text": "Son teslim tarihi Cuma öğlen.",
    "romanization": null
  },
  "41": {
    "text": "Çarşamba'ya kadar ilk taslağı hazırlarım.",
    "romanization": null
  },
  "42": {
    "text": "Bu hafta bir şeyler çıkarmamız gerekiyor.",
    "romanization": null
  },
  "43": {
    "text": "Proje bir gün gecikti.",
    "romanization": null
  },
  "44": {
    "text": "Göndermeden önce bir göz atabilir misin?",
    "romanization": null
  },
  "45": {
    "text": "Sana bir durum güncellemesi yapmam gerekiyor.",
    "romanization": null
  },
  "46": {
    "text": "Rakamlar geçen hafta gönderdiğimle uyuşmuyor.",
    "romanization": null
  },
  "47": {
    "text": "Müşterinin kararı yüzünden ilerleyemiyoruz.",
    "romanization": null
  },
  "48": {
    "text": "Bitirmek için öğle yemeği molası vermedi.",
    "romanization": null
  },
  "49": {
    "text": "Rapor sonunda elimden çıktı.",
    "romanization": null
  },
  "50": {
    "text": "Onayı alır almaz başlarım.",
    "romanization": null
  },
  "51": {
    "text": "Bu versiyonu onaylayabilir misin?",
    "romanization": null
  },
  "52": {
    "text": "Ürünü çıkarmadan hemen önce bir yazım hatası fark etti.",
    "romanization": null
  },
  "53": {
    "text": "Lansmanı gelecek Salı'ya erteledik.",
    "romanization": null
  },
  "54": {
    "text": "Tahminimiz iki kat farklı çıktı.",
    "romanization": null
  },
  "55": {
    "text": "Odaklanmak için öğleden sonrasını kendine ayırdı.",
    "romanization": null
  },
  "56": {
    "text": "Sözleşme imzalanmış olarak geri geldi.",
    "romanization": null
  },
  "57": {
    "text": "Tamamlandı diyelim ve bir sonrakine geçelim.",
    "romanization": null
  },
  "58": {
    "text": "İlk sürüm biraz ham ama iş görüyor.",
    "romanization": null
  },
  "59": {
    "text": "Bu sefer erken teslim etti.",
    "romanization": null
  },
  "60": {
    "text": "Ekibe hoş geldin.",
    "romanization": null
  },
  "61": {
    "text": "Seni diğerleriyle tanıştırırım.",
    "romanization": null
  },
  "62": {
    "text": "Az önce izinden döndü.",
    "romanization": null
  },
  "63": {
    "text": "Bu konuda ona danışmalısın.",
    "romanization": null
  },
  "64": {
    "text": "Salı günleri aynı masayı paylaşıyoruz.",
    "romanization": null
  },
  "65": {
    "text": "Fiyatlandırma konusunda en bilgili kim?",
    "romanization": null
  },
  "66": {
    "text": "Takıma her zaman kahve getirir.",
    "romanization": null
  },
  "67": {
    "text": "Yeni çalışan çabuk öğreniyor.",
    "romanization": null
  },
  "68": {
    "text": "Pazarlama ile yakın çalışıyor.",
    "romanization": null
  },
  "69": {
    "text": "Burada herkesten daha eski.",
    "romanization": null
  },
  "70": {
    "text": "İşi eşit olarak paylaştılar.",
    "romanization": null
  },
  "71": {
    "text": "Öğle yemeğinde bir araya gelip taslağını çıkardık.",
    "romanization": null
  },
  "72": {
    "text": "Ben hastayken işlerimi o halletti.",
    "romanization": null
  },
  "73": {
    "text": "Ekip dizüstü bilgisayarın etrafında toplandı.",
    "romanization": null
  },
  "74": {
    "text": "Herkesin doğum gününü hatırlıyor.",
    "romanization": null
  },
  "75": {
    "text": "Yarın uzaktan katılacağım.",
    "romanization": null
  },
  "76": {
    "text": "Cuma günleri ofis çoğunlukla boş oluyor.",
    "romanization": null
  },
  "77": {
    "text": "İnternetim bugün stabil değil.",
    "romanization": null
  },
  "78": {
    "text": "Farklı bir şehirden çalışıyor.",
    "romanization": null
  },
  "79": {
    "text": "Ekip ayda bir yüz yüze görüşüyor.",
    "romanization": null
  },
  "80": {
    "text": "Yatak odasının bir köşesini kendine çalışma alanı yaptı.",
    "romanization": null
  },
  "81": {
    "text": "Evdeki çalışma alanı sonunda toplandı.",
    "romanization": null
  },
  "82": {
    "text": "Kameranı açabilir misin?",
    "romanization": null
  },
  "83": {
    "text": "Arka plandaki sesler sorun değil, dert etme.",
    "romanization": null
  },
  "84": {
    "text": "Her sabah kısa bir durum değerlendirmesi yapıyoruz.",
    "romanization": null
  },
  "85": {
    "text": "Yazıcı yine kağıt sıkıştırdı.",
    "romanization": null
  },
  "86": {
    "text": "Kahve makinesinde kahve kalmamış.",
    "romanization": null
  },
  "87": {
    "text": "Kapıya bakabilir misin?",
    "romanization": null
  },
  "88": {
    "text": "Toplantı odasının penceresi açılmıyor.",
    "romanization": null
  },
  "89": {
    "text": "Biri öğle yemeğini buzdolabında bir hafta unutmuş.",
    "romanization": null
  },
  "90": {
    "text": "Saat üçte mutfak sessiz oluyor.",
    "romanization": null
  },
  "91": {
    "text": "Kafasını dinlemek için merdivenlerden çıktı.",
    "romanization": null
  },
  "92": {
    "text": "Pencere kenarındaki çiçek iyi büyüyor.",
    "romanization": null
  },
  "93": {
    "text": "Danışmada bir paket için imza atabilir misin?",
    "romanization": null
  },
  "94": {
    "text": "Kart okuyucu yine sorun çıkarıyor.",
    "romanization": null
  },
  "95": {
    "text": "Gün sonu hep beklenmedik bir anda gelir.",
    "romanization": null
  },
  "96": {
    "text": "Aynı anda tek bir pencere açıkken daha verimli çalışıyor.",
    "romanization": null
  },
  "97": {
    "text": "Güne başlarken bir mum yakar.",
    "romanization": null
  },
  "98": {
    "text": "Öğle yemeği sonrası kısa bir yürüyüş iyi düşünmemi sağlıyor.",
    "romanization": null
  },
  "99": {
    "text": "Bazı Pazartesiler küçük bir başarıyla başlar.",
    "romanization": null
  }
}