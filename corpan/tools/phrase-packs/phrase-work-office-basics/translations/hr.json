{
  "0": {
    "text": "Sastanak počinje za deset minuta.",
    "romanization": null
  },
  "1": {
    "text": "Možeš li podijeliti ekran?",
    "romanization": null
  },
  "2": {
    "text": "Oprosti, bio/bila sam isključenog mikrofona.",
    "romanization": null
  },
  "3": {
    "text": "Prekoračujemo predviđeno vrijeme.",
    "romanization": null
  },
  "4": {
    "text": "Prebacimo to na sljedeći sastanak.",
    "romanization": null
  },
  "5": {
    "text": "Ja ću bilježiti.",
    "romanization": null
  },
  "6": {
    "text": "Možemo li proći redom?",
    "romanization": null
  },
  "7": {
    "text": "Dnevni red je u pozivnici u kalendaru.",
    "romanization": null
  },
  "8": {
    "text": "Tko vodi ovo?",
    "romanization": null
  },
  "9": {
    "text": "Snimamo li ovo?",
    "romanization": null
  },
  "10": {
    "text": "Poziv se prekinuo na pola.",
    "romanization": null
  },
  "11": {
    "text": "Možemo li ovo pomaknuti za petnaest minuta?",
    "romanization": null
  },
  "12": {
    "text": "Došao je kasno, ali tiho.",
    "romanization": null
  },
  "13": {
    "text": "Soba je opet dvostruko rezervirana.",
    "romanization": null
  },
  "14": {
    "text": "Stavimo to sa strane pa ćemo se vratiti.",
    "romanization": null
  },
  "15": {
    "text": "Moram završiti točno u tri.",
    "romanization": null
  },
  "16": {
    "text": "Možeš li ostati dvije minute nakon?",
    "romanization": null
  },
  "17": {
    "text": "Ploča je puna.",
    "romanization": null
  },
  "18": {
    "text": "Možeš li sažeti dogovorene korake?",
    "romanization": null
  },
  "19": {
    "text": "Stojeći sastanci su iznenađujuće brzi.",
    "romanization": null
  },
  "20": {
    "text": "Javit ću ti se do kraja dana.",
    "romanization": null
  },
  "21": {
    "text": "Je li stigao moj zadnji e-mail?",
    "romanization": null
  },
  "22": {
    "text": "Oprosti na kasnom odgovoru.",
    "romanization": null
  },
  "23": {
    "text": "Uključujem Saru u ovo.",
    "romanization": null
  },
  "24": {
    "text": "Prilog nije stigao.",
    "romanization": null
  },
  "25": {
    "text": "Označio/Označila sam to kao hitno.",
    "romanization": null
  },
  "26": {
    "text": "Možeš li ponovno poslati tu datoteku?",
    "romanization": null
  },
  "27": {
    "text": "Prepiska je postala duga, dopusti da sažmem.",
    "romanization": null
  },
  "28": {
    "text": "Koristi naslov poruke da bih ga/je mogao/mogla pronaći.",
    "romanization": null
  },
  "29": {
    "text": "Očistio je svoj inbox preko vikenda.",
    "romanization": null
  },
  "30": {
    "text": "Molim te, odgovori do petka.",
    "romanization": null
  },
  "31": {
    "text": "Poslat ću kratku obavijest kad bude gotovo.",
    "romanization": null
  },
  "32": {
    "text": "Automatski odgovor kaže da putuje.",
    "romanization": null
  },
  "33": {
    "text": "Slučajno je kopirala krivu osobu.",
    "romanization": null
  },
  "34": {
    "text": "Tri podsjetnika su dovoljna.",
    "romanization": null
  },
  "35": {
    "text": "Možeš li mi proslijediti tu prepisku?",
    "romanization": null
  },
  "36": {
    "text": "Za ovo je chat brži od e-maila.",
    "romanization": null
  },
  "37": {
    "text": "Propustio/Propustila sam tvoju poruku u svoj toj gužvi.",
    "romanization": null
  },
  "38": {
    "text": "Link u tvom e-mailu vodi na nepostojeću stranicu.",
    "romanization": null
  },
  "39": {
    "text": "Molim te, potvrdi da si ovo primio/primila.",
    "romanization": null
  },
  "40": {
    "text": "Rok je u petak u podne.",
    "romanization": null
  },
  "41": {
    "text": "Imat ću prvu verziju do srijede.",
    "romanization": null
  },
  "42": {
    "text": "Moramo nešto isporučiti ovaj tjedan.",
    "romanization": null
  },
  "43": {
    "text": "Projekt je kasnio dan.",
    "romanization": null
  },
  "44": {
    "text": "Možeš li ovo lektorirati prije nego što pošaljem?",
    "romanization": null
  },
  "45": {
    "text": "Dugujem ti ažuriranje statusa.",
    "romanization": null
  },
  "46": {
    "text": "Brojke se ne podudaraju s onim što sam poslao/poslala prošli tjedan.",
    "romanization": null
  },
  "47": {
    "text": "Blokirani smo zbog odluke klijenta.",
    "romanization": null
  },
  "48": {
    "text": "Radio je za vrijeme ručka da bi to završio.",
    "romanization": null
  },
  "49": {
    "text": "Izvještaj je napokon gotov s moje strane.",
    "romanization": null
  },
  "50": {
    "text": "Počet ću čim dobijem odobrenje.",
    "romanization": null
  },
  "51": {
    "text": "Možeš li odobriti ovu verziju?",
    "romanization": null
  },
  "52": {
    "text": "Uhvatila je tipfeler neposredno prije nego što smo objavili.",
    "romanization": null
  },
  "53": {
    "text": "Odgodili smo lansiranje za sljedeći utorak.",
    "romanization": null
  },
  "54": {
    "text": "Procjena je bila dvostruko pogrešna.",
    "romanization": null
  },
  "55": {
    "text": "Oslobodio je poslijepodne da bi se mogao fokusirati.",
    "romanization": null
  },
  "56": {
    "text": "Ugovor se vratio potpisan.",
    "romanization": null
  },
  "57": {
    "text": "Proglasimo to završenim i idemo dalje.",
    "romanization": null
  },
  "58": {
    "text": "Prva verzija je gruba, ali radi.",
    "romanization": null
  },
  "59": {
    "text": "Jednom je isporučio ranije.",
    "romanization": null
  },
  "60": {
    "text": "Dobrodošao/Dobrodošla u tim.",
    "romanization": null
  },
  "61": {
    "text": "Predstavit ću te ostalima.",
    "romanization": null
  },
  "62": {
    "text": "Upravo se vratila s dopusta.",
    "romanization": null
  },
  "63": {
    "text": "On je osoba koju treba pitati o ovome.",
    "romanization": null
  },
  "64": {
    "text": "Dijelimo stol utorkom.",
    "romanization": null
  },
  "65": {
    "text": "Tko zna najviše o cijenama?",
    "romanization": null
  },
  "66": {
    "text": "Uvijek donosi kavu za tim.",
    "romanization": null
  },
  "67": {
    "text": "Novi zaposlenik brzo uči.",
    "romanization": null
  },
  "68": {
    "text": "Blisko surađuje s marketingom.",
    "romanization": null
  },
  "69": {
    "text": "On je ovdje duže od svih.",
    "romanization": null
  },
  "70": {
    "text": "Podijelili su posao točno na pola.",
    "romanization": null
  },
  "71": {
    "text": "Pojeli smo ručak i skicirali to.",
    "romanization": null
  },
  "72": {
    "text": "Mijenjao me dok sam bio/bila bolestan/bolesna.",
    "romanization": null
  },
  "73": {
    "text": "Tim se okupio oko laptopa.",
    "romanization": null
  },
  "74": {
    "text": "Sjeća se svačijeg rođendana.",
    "romanization": null
  },
  "75": {
    "text": "Pridružit ću se na daljinu sutra.",
    "romanization": null
  },
  "76": {
    "text": "Ured je uglavnom prazan petkom.",
    "romanization": null
  },
  "77": {
    "text": "Moj internet je danas nestabilan.",
    "romanization": null
  },
  "78": {
    "text": "Radi iz drugog grada.",
    "romanization": null
  },
  "79": {
    "text": "Tim se sastaje uživo jednom mjesečno.",
    "romanization": null
  },
  "80": {
    "text": "Uredila je kut spavaće sobe kao radni stol.",
    "romanization": null
  },
  "81": {
    "text": "Kućni ured je napokon uredan.",
    "romanization": null
  },
  "82": {
    "text": "Možeš li uključiti kameru?",
    "romanization": null
  },
  "83": {
    "text": "Pozadinska buka je u redu, ne brini.",
    "romanization": null
  },
  "84": {
    "text": "Svako jutro imamo kratku provjeru.",
    "romanization": null
  },
  "85": {
    "text": "Pisač se opet zaglavio.",
    "romanization": null
  },
  "86": {
    "text": "Aparat za kavu je ostao bez zrna.",
    "romanization": null
  },
  "87": {
    "text": "Možeš li otvoriti vrata?",
    "romanization": null
  },
  "88": {
    "text": "Prozor u konferencijskoj sobi se ne otvara.",
    "romanization": null
  },
  "89": {
    "text": "Netko je ostavio ručak u hladnjaku tjedan dana.",
    "romanization": null
  },
  "90": {
    "text": "Kuhinja je tiha u tri sata.",
    "romanization": null
  },
  "91": {
    "text": "Išao je stepenicama da razbistri glavu.",
    "romanization": null
  },
  "92": {
    "text": "Biljka na prozorskoj dasci dobro napreduje.",
    "romanization": null
  },
  "93": {
    "text": "Možeš li potpisati za paket na recepciji?",
    "romanization": null
  },
  "94": {
    "text": "Čitač kartica ne radi kako treba.",
    "romanization": null
  },
  "95": {
    "text": "Kraj dana uvijek nekako dođe iznenada.",
    "romanization": null
  },
  "96": {
    "text": "Najbolje radi s jednim otvorenim prozorom istovremeno.",
    "romanization": null
  },
  "97": {
    "text": "Pali svijeću da označi početak dana.",
    "romanization": null
  },
  "98": {
    "text": "Kratka šetnja nakon ručka mi pomaže razmišljati.",
    "romanization": null
  },
  "99": {
    "text": "Neki ponedjeljci počinju malom pobjedom.",
    "romanization": null
  }
}