{
  "0": {
    "text": "Posėdis prasideda po dešimties minučių.",
    "romanization": null
  },
  "1": {
    "text": "Ar galėtumėte pasidalinti savo ekranu?",
    "romanization": null
  },
  "2": {
    "text": "Atsiprašau, buvau išjungęs mikrofoną.",
    "romanization": null
  },
  "3": {
    "text": "Užtrunkame ilgiau, nei planavome.",
    "romanization": null
  },
  "4": {
    "text": "Perkelkime tai į kitą susitikimą.",
    "romanization": null
  },
  "5": {
    "text": "Aš užsirašysiu.",
    "romanization": null
  },
  "6": {
    "text": "Ar galėtume pasisakyti paeiliui?",
    "romanization": null
  },
  "7": {
    "text": "Darbotvarkė yra kalendoriaus kvietime.",
    "romanization": null
  },
  "8": {
    "text": "Kas veda šį susitikimą?",
    "romanization": null
  },
  "9": {
    "text": "Ar mes tai įrašinėjame?",
    "romanization": null
  },
  "10": {
    "text": "Ryšys nutrūko įpusėjus pokalbiui.",
    "romanization": null
  },
  "11": {
    "text": "Ar galime tai pavėlinti penkiolika minučių?",
    "romanization": null
  },
  "12": {
    "text": "Jis atėjo vėlai, bet tyliai.",
    "romanization": null
  },
  "13": {
    "text": "Kambarys vėl rezervuotas dviem susitikimams.",
    "romanization": null
  },
  "14": {
    "text": "Atidėkime tai ir grįšime prie to vėliau.",
    "romanization": null
  },
  "15": {
    "text": "Turiu baigti lygiai trečią.",
    "romanization": null
  },
  "16": {
    "text": "Ar galėtumėte pasilikti dar dviem minutėms?",
    "romanization": null
  },
  "17": {
    "text": "Lenta pilna.",
    "romanization": null
  },
  "18": {
    "text": "Ar galėtumėte apibendrinti veiksmų punktus?",
    "romanization": null
  },
  "19": {
    "text": "Stovimi susitikimai stebėtinai greiti.",
    "romanization": null
  },
  "20": {
    "text": "Atsakysiu jums iki dienos pabaigos.",
    "romanization": null
  },
  "21": {
    "text": "Ar mano paskutinis el. laiškas pasiekė?",
    "romanization": null
  },
  "22": {
    "text": "Atsiprašau už vėlyvą atsakymą.",
    "romanization": null
  },
  "23": {
    "text": "Įtraukiu Sarą į šį pokalbį.",
    "romanization": null
  },
  "24": {
    "text": "Priedas nepasiekė.",
    "romanization": null
  },
  "25": {
    "text": "Pažymėjau tai kaip skubų.",
    "romanization": null
  },
  "26": {
    "text": "Ar galėtumėte persiųsti tą failą?",
    "romanization": null
  },
  "27": {
    "text": "Pokalbis užsitęsė, leiskite apibendrinti.",
    "romanization": null
  },
  "28": {
    "text": "Naudokite temos eilutę, kad galėčiau tai rasti.",
    "romanization": null
  },
  "29": {
    "text": "Jis išvalė savo pašto dėžutę per savaitgalį.",
    "romanization": null
  },
  "30": {
    "text": "Prašau atsakyti iki penktadienio.",
    "romanization": null
  },
  "31": {
    "text": "Atsiųsiu trumpą pranešimą, kai bus padaryta.",
    "romanization": null
  },
  "32": {
    "text": "Automatinis atsakymas sako, kad jis keliauja.",
    "romanization": null
  },
  "33": {
    "text": "Ji netyčia nukopijavo ne tą asmenį.",
    "romanization": null
  },
  "34": {
    "text": "Trijų priminimų pakanka.",
    "romanization": null
  },
  "35": {
    "text": "Ar galėtumėte persiųsti man tą pokalbį?",
    "romanization": null
  },
  "36": {
    "text": "Šiam reikalui pokalbis greitesnis nei el. paštas.",
    "romanization": null
  },
  "37": {
    "text": "Nepastebėjau jūsų žinutės per visą tą triukšmą.",
    "romanization": null
  },
  "38": {
    "text": "Nuoroda jūsų el. laiške veda į neegzistuojantį puslapį.",
    "romanization": null
  },
  "39": {
    "text": "Prašau patvirtinti, kad gavote.",
    "romanization": null
  },
  "40": {
    "text": "Terminas yra penktadienį vidurdienį.",
    "romanization": null
  },
  "41": {
    "text": "Pirmąjį juodraštį turėsiu iki trečiadienio.",
    "romanization": null
  },
  "42": {
    "text": "Šią savaitę turime kažką pristatyti.",
    "romanization": null
  },
  "43": {
    "text": "Projektas vėlavo viena diena.",
    "romanization": null
  },
  "44": {
    "text": "Ar galėtumėte tai peržiūrėti prieš man išsiunčiant?",
    "romanization": null
  },
  "45": {
    "text": "Esu jums skolingas būsenos atnaujinimą.",
    "romanization": null
  },
  "46": {
    "text": "Skaičiai nesutampa su tuo, ką siunčiau praėjusią savaitę.",
    "romanization": null
  },
  "47": {
    "text": "Negalime judėti toliau, kol klientas nepriims sprendimo.",
    "romanization": null
  },
  "48": {
    "text": "Jis dirbo per pietus, kad tai užbaigtų.",
    "romanization": null
  },
  "49": {
    "text": "Ataskaita pagaliau atiduota.",
    "romanization": null
  },
  "50": {
    "text": "Pradėsiu, kai tik gausiu patvirtinimą.",
    "romanization": null
  },
  "51": {
    "text": "Ar galėtumėte patvirtinti šią versiją?",
    "romanization": null
  },
  "52": {
    "text": "Ji pastebėjo klaidą prieš pat išleidžiant.",
    "romanization": null
  },
  "53": {
    "text": "Paleidimą perkėlėme į kitą antradienį.",
    "romanization": null
  },
  "54": {
    "text": "Įvertinimas skyrėsi dvigubai.",
    "romanization": null
  },
  "55": {
    "text": "Jis atlaisvino savo popietę, kad galėtų susikoncentruoti.",
    "romanization": null
  },
  "56": {
    "text": "Sutartis grįžo pasirašyta.",
    "romanization": null
  },
  "57": {
    "text": "Laikykime tai padarytu ir judėkime toliau.",
    "romanization": null
  },
  "58": {
    "text": "Pirmoji versija yra grubi, bet veikia.",
    "romanization": null
  },
  "59": {
    "text": "Jis vieną kartą pristatė anksčiau laiko.",
    "romanization": null
  },
  "60": {
    "text": "Sveiki atvykę į komandą.",
    "romanization": null
  },
  "61": {
    "text": "Pristatysiu jus kitiems.",
    "romanization": null
  },
  "62": {
    "text": "Ji ką tik grįžo iš atostogų.",
    "romanization": null
  },
  "63": {
    "text": "Jis yra tas žmogus, kurio reikia klausti apie tai.",
    "romanization": null
  },
  "64": {
    "text": "Antradieniais dalijamės stalu.",
    "romanization": null
  },
  "65": {
    "text": "Kas geriausiai išmano kainodarą?",
    "romanization": null
  },
  "66": {
    "text": "Jis visada atneša kavos komandai.",
    "romanization": null
  },
  "67": {
    "text": "Naujas darbuotojas greitai mokosi.",
    "romanization": null
  },
  "68": {
    "text": "Ji glaudžiai bendradarbiauja su rinkodara.",
    "romanization": null
  },
  "69": {
    "text": "Jis čia dirba ilgiau nei bet kas kitas.",
    "romanization": null
  },
  "70": {
    "text": "Jie pasidalino darbą perpus.",
    "romanization": null
  },
  "71": {
    "text": "Pietavome ir nubraižėme eskizą.",
    "romanization": null
  },
  "72": {
    "text": "Jis mane pavadavo, kol sirgau.",
    "romanization": null
  },
  "73": {
    "text": "Komanda susirinko aplink nešiojamąjį kompiuterį.",
    "romanization": null
  },
  "74": {
    "text": "Ji prisimena visų gimtadienius.",
    "romanization": null
  },
  "75": {
    "text": "Rytoj prisijungsiu nuotoliu.",
    "romanization": null
  },
  "76": {
    "text": "Penktadieniais biuras dažniausiai tuščias.",
    "romanization": null
  },
  "77": {
    "text": "Mano internetas šiandien nestabilus.",
    "romanization": null
  },
  "78": {
    "text": "Jis dirba iš kito miesto.",
    "romanization": null
  },
  "79": {
    "text": "Komanda susitinka gyvai kartą per mėnesį.",
    "romanization": null
  },
  "80": {
    "text": "Ji įrengė miegamojo kampą kaip darbo stalą.",
    "romanization": null
  },
  "81": {
    "text": "Namų biuras pagaliau tvarkingas.",
    "romanization": null
  },
  "82": {
    "text": "Ar galėtumėte įjungti kamerą?",
    "romanization": null
  },
  "83": {
    "text": "Fono triukšmas gerai, nesijaudinkite.",
    "romanization": null
  },
  "84": {
    "text": "Kiekvieną rytą trumpai aptariame reikalus.",
    "romanization": null
  },
  "85": {
    "text": "Spausdintuvas vėl užstrigo.",
    "romanization": null
  },
  "86": {
    "text": "Kavos aparate baigėsi pupelės.",
    "romanization": null
  },
  "87": {
    "text": "Ar galėtumėte prilaikyti duris?",
    "romanization": null
  },
  "88": {
    "text": "Konferencijų salės langas neatsidaro.",
    "romanization": null
  },
  "89": {
    "text": "Kažkas paliko savo pietus šaldytuve savaitei.",
    "romanization": null
  },
  "90": {
    "text": "Virtuvė tyli trečią valandą.",
    "romanization": null
  },
  "91": {
    "text": "Jis ėjo laiptais, kad išvėdintų galvą.",
    "romanization": null
  },
  "92": {
    "text": "Augalas ant palangės gerai auga.",
    "romanization": null
  },
  "93": {
    "text": "Ar galėtumėte pasirašyti už siuntinį registratūroje?",
    "romanization": null
  },
  "94": {
    "text": "Ženkliuko skaitytuvas streikuoja.",
    "romanization": null
  },
  "95": {
    "text": "Dienos pabaiga visada ateina netikėtai.",
    "romanization": null
  },
  "96": {
    "text": "Jis geriausiai dirba, kai vienu metu atidarytas tik vienas langas.",
    "romanization": null
  },
  "97": {
    "text": "Ji uždega žvakę, kad pažymėtų dienos pradžią.",
    "romanization": null
  },
  "98": {
    "text": "Trumpas pasivaikščiojimas po pietų padeda man mąstyti.",
    "romanization": null
  },
  "99": {
    "text": "Kai kurie pirmadieniai prasideda maža pergale.",
    "romanization": null
  }
