{
  "0": {
    "text": "Kukka aukeaa auringonnousussa.",
    "romanization": null
  },
  "1": {
    "text": "Lehdet kellastuvat syksyllä.",
    "romanization": null
  },
  "2": {
    "text": "Kastele kasvi kerran viikossa.",
    "romanization": null
  },
  "3": {
    "text": "Siemen tarvitsee lämpöä itääkseen.",
    "romanization": null
  },
  "4": {
    "text": "Juuret kasvavat syvälle maaperään.",
    "romanization": null
  },
  "5": {
    "text": "Puu on taloa korkeampi.",
    "romanization": null
  },
  "6": {
    "text": "Mehiläiset pölyttävät kukkia.",
    "romanization": null
  },
  "7": {
    "text": "Fotosynteesi muuntaa auringonvalon energiaksi.",
    "romanization": null
  },
  "8": {
    "text": "Hän hoitaa puutarhaansa joka aamu.",
    "romanization": null
  },
  "9": {
    "text": "Istuta siemen noin senttimetrin syvyyteen.",
    "romanization": null
  },
  "10": {
    "text": "Useimmat kasvit tarvitsevat valoa, vettä ja maaperää kasvaakseen.",
    "romanization": null
  },
  "11": {
    "text": "Varsi pitää kasvin pystyssä.",
    "romanization": null
  },
  "12": {
    "text": "Männyt säilyttävät neulasensa koko talven.",
    "romanization": null
  },
  "13": {
    "text": "Ruusuilla on piikkejä varsiensa suojelemiseksi.",
    "romanization": null
  },
  "14": {
    "text": "Hän leikkasi omenapuuta varhaiskeväällä.",
    "romanization": null
  },
  "15": {
    "text": "Sammalet viihtyvät kosteissa, varjoisissa paikoissa.",
    "romanization": null
  },
  "16": {
    "text": "Sienet eivät ole kasveja, vaan oma eliökuntansa.",
    "romanization": null
  },
  "17": {
    "text": "Metsänpohja on peittynyt pudonneisiin lehtiin.",
    "romanization": null
  },
  "18": {
    "text": "Istutimme vihanneksia kohopenkkeihin tänä vuonna.",
    "romanization": null
  },
  "19": {
    "text": "Kaktus varastoi vettä paksussa varressaan.",
    "romanization": null
  },
  "20": {
    "text": "Madot ilmastoivat maaperää kaivaessaan tunneleita.",
    "romanization": null
  },
  "21": {
    "text": "Komposti ravitsee seuraavan kauden kasveja.",
    "romanization": null
  },
  "22": {
    "text": "Auringonkukat kääntävät kasvonsa aurinkoa kohti.",
    "romanization": null
  },
  "23": {
    "text": "Laventeli houkuttelee sekä mehiläisiä että perhosia.",
    "romanization": null
  },
  "24": {
    "text": "Hän poimi kypsän tomaatin köynnöksestä.",
    "romanization": null
  },
  "25": {
    "text": "Mansikat leviävät rönsyjen avulla.",
    "romanization": null
  },
  "26": {
    "text": "Orkidea pitää kosteasta ilmasta ja epäsuorasta valosta.",
    "romanization": null
  },
  "27": {
    "text": "Bambu voi kasvaa yli metrin yhdessä päivässä.",
    "romanization": null
  },
  "28": {
    "text": "Sieniä ilmestyy pitkän syyssateen jälkeen.",
    "romanization": null
  },
  "29": {
    "text": "Siitepöly tarttuu mehiläisen karvaisiin jalkoihin.",
    "romanization": null
  },
  "30": {
    "text": "Kasvihuone pitää herkät taimet lämpiminä.",
    "romanization": null
  },
  "31": {
    "text": "Rosmariini tuoksuu voimakkaimmin, kun sitä hipaisee.",
    "romanization": null
  },
  "32": {
    "text": "Yksivuotiset kasvit elävät koko elinkaarensa yhden vuoden aikana.",
    "romanization": null
  },
  "33": {
    "text": "Monivuotiset kasvit palaavat itsestään joka kevät.",
    "romanization": null
  },
  "34": {
    "text": "Hän leikkasi yhden daalian pöydällä olevaan maljakkoon.",
    "romanization": null
  },
  "35": {
    "text": "Pajun oksat kaartuvat matalalle joen ylle.",
    "romanization": null
  },
  "36": {
    "text": "Porkkanat varastoivat sokeria pitkiin oransseihin juuriinsa.",
    "romanization": null
  },
  "37": {
    "text": "Minttu valtaa puutarhan, jos sitä ei rajoita.",
    "romanization": null
  },
  "38": {
    "text": "Pensasaita pitää leikata kaksi kertaa vuodessa.",
    "romanization": null
  },
  "39": {
    "text": "Hän merkitsi jokaiseen taimeen lajikkeen ja päivämäärän.",
    "romanization": null
  },
  "40": {
    "text": "Tammenterhot putoavat tammesta varhaissyksyllä.",
    "romanization": null
  },
  "41": {
    "text": "Vaahteran lehdet muuttuvat kirkkaanpunaisiksi.",
    "romanization": null
  },
  "42": {
    "text": "Keräsimme luonnonmustikoita rinteeltä.",
    "romanization": null
  },
  "43": {
    "text": "Kasvimaa on aidattu pitämään peurat loitolla.",
    "romanization": null
  },
  "44": {
    "text": "Pavut kiipeävät ylös puutarhan puupylväitä pitkin.",
    "romanization": null
  },
  "45": {
    "text": "Useimmat saniaiset pitävät kosteasta varjosta.",
    "romanization": null
  },
  "46": {
    "text": "Muratti voi vahingoittaa tiilien välistä laastia.",
    "romanization": null
  },
  "47": {
    "text": "Liljat aukeavat nopeasti, kun nuppu on täysin kehittynyt.",
    "romanization": null
  },
  "48": {
    "text": "Hän järjestelee kuivakukkia talvella, kun puutarha on paljas.",
    "romanization": null
  },
  "49": {
    "text": "Vanha omenapuu tuottaa edelleen hedelmää joka toinen vuosi.",
    "romanization": null
  },
  "50": {
    "text": "Hän varttoi uuden oksan päärynäpuuhun.",
    "romanization": null
  },
  "51": {
    "text": "Lihansyöjäkasvit pyydystävät hyönteisiä typen saamiseksi.",
    "romanization": null
  },
  "52": {
    "text": "Luonnonkukat leviävät nopeasti tienvarsilla.",
    "romanization": null
  },
  "53": {
    "text": "Jäkälät kasvavat jopa paljaalla kalliolla.",
    "romanization": null
  },
  "54": {
    "text": "Sipulit istutetaan syksyllä kevään kukintaa varten.",
    "romanization": null
  },
  "55": {
    "text": "Hän teki teetä kuivatusta mintusta ja kamomillasta.",
    "romanization": null
  },
  "56": {
    "text": "Kompostikasa lämpenee lehtien hajotessa.",
    "romanization": null
  },
  "57": {
    "text": "Multasimme penkit pitääksemme maan kosteana.",
    "romanization": null
  },
  "58": {
    "text": "Kolibrit juovat mettä trumpetinmuotoisista kukista.",
    "romanization": null
  },
  "59": {
    "text": "Taimet tarvitsevat suojaa ankaralta talvituulelta.",
    "romanization": null
  },
  "60": {
    "text": "Köynnös tuottaa pieniä vihreitä rypäleitä keskikesään mennessä.",
    "romanization": null
  },
  "61": {
    "text": "Ruusut kukkivat aalloittain lämpimämpien kuukausien ajan.",
    "romanization": null
  },
  "62": {
    "text": "Hän istutti pistokkaat ruukkuihin ja asetti ne ikkunalaudalle.",
    "romanization": null
  },
  "63": {
    "text": "Taimet nuutuivat kuumuudessa iltapäivään mennessä.",
    "romanization": null
  },
  "64": {
    "text": "Kasvitieteilijät luokittelevat kasveja kukan, lehden ja siemenen perusteella.",
    "romanization": null
  },
  "65": {
    "text": "Mangrovepuut vakauttavat rannikkoa eroosiota vastaan.",
    "romanization": null
  },
  "66": {
    "text": "Sademetsän latvusto saa suurimman osan auringonvalosta.",
    "romanization": null
  },
  "67": {
    "text": "Pienet sammalitiöt kulkeutuvat tuulen mukana kilometrejä.",
    "romanization": null
  },
  "68": {
    "text": "Puutarhamyymälä myy joka kevät yksivuotisten kukkien taimia.",
    "romanization": null
  },
  "69": {
    "text": "Hän seurasi pavun elinkaarta siemenestä sadonkorjuuseen.",
    "romanization": null
  },
  "70": {
    "text": "Halla vaurioitti herkkiä versoja yön aikana.",
    "romanization": null
  },
  "71": {
    "text": "Narsissit puskevat esiin viimeisten lumien läpi.",
    "romanization": null
  },
  "72": {
    "text": "Kurpitsaköynnös levisi koko penkin yli.",
    "romanization": null
  },
  "73": {
    "text": "Kirvat kerääntyvät ruusupensaan uusiin versoihin.",
    "romanization": null
  },
  "74": {
    "text": "Leppäkertut syövät kirvoja, joten puutarhuri toivottaa ne tervetulleiksi.",
    "romanization": null
  },
  "75": {
    "text": "Hän käyttää suurennuslasia tarkastellakseen lehtien alapuolta.",
    "romanization": null
  },
  "76": {
    "text": "Trooppiset kasvit kärsivät kuivassa sisäilmassa.",
    "romanization": null
  },
  "77": {
    "text": "Kasvitieteellinen puutarha merkitsee jokaiseen puuhun sen latinankielisen nimen.",
    "romanization": null
  },
  "78": {
    "text": "Perintötomaatteja on monenmuotoisia ja -värisiä.",
    "romanization": null
  },
  "79": {
    "text": "Ensimmäinen krookus on hiljainen merkki kevään tulosta.",
    "romanization": null
  }
}