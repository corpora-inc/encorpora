{
  "0": {
    "text": "Postavíme stan, než se setmí.",
    "romanization": null
  },
  "1": {
    "text": "Kam jsem si sbalil zapalovač?",
    "romanization": null
  },
  "2": {
    "text": "Kolíky ke stanu jsou v boční kapse.",
    "romanization": null
  },
  "3": {
    "text": "Můj spacák je dobrý do nuly.",
    "romanization": null
  },
  "4": {
    "text": "Nafoukni karimatku, než ji rozložíš.",
    "romanization": null
  },
  "5": {
    "text": "Lucerna potřebuje nové baterky.",
    "romanization": null
  },
  "6": {
    "text": "Napni šňůry ke stanu, než půjdeš spát.",
    "romanization": null
  },
  "7": {
    "text": "Tropiko se dává švy ven.",
    "romanization": null
  },
  "8": {
    "text": "Postav stan na rovném místě.",
    "romanization": null
  },
  "9": {
    "text": "Jídlo drž dál od stanu.",
    "romanization": null
  },
  "10": {
    "text": "Přinesl si jeden luxus: malý polštářek.",
    "romanization": null
  },
  "11": {
    "text": "Čelovka ušetří spoustu tápání.",
    "romanization": null
  },
  "12": {
    "text": "Kemp je hned za druhým potokem.",
    "romanization": null
  },
  "13": {
    "text": "Chladicí box zůstane ve stínu.",
    "romanization": null
  },
  "14": {
    "text": "Skládací židle už má to nejlepší za sebou.",
    "romanization": null
  },
  "15": {
    "text": "Batoh je těžší, než vypadá.",
    "romanization": null
  },
  "16": {
    "text": "Mapa šla do boční kapsy batohu.",
    "romanization": null
  },
  "17": {
    "text": "Vodní filtr je v malém suchém vaku.",
    "romanization": null
  },
  "18": {
    "text": "Sekerka má ochranný kryt.",
    "romanization": null
  },
  "19": {
    "text": "Zase jsme zapomněli otvírák na konzervy.",
    "romanization": null
  },
  "20": {
    "text": "Nasbírej suché troud, než to zapálíš.",
    "romanization": null
  },
  "21": {
    "text": "Ohniště už je postavené.",
    "romanization": null
  },
  "22": {
    "text": "Potřebujeme víc podpalu.",
    "romanization": null
  },
  "23": {
    "text": "Nedávej na oheň zelené dřevo.",
    "romanization": null
  },
  "24": {
    "text": "Uhlíky jsou žhavější než plameny.",
    "romanization": null
  },
  "25": {
    "text": "Vodu převař, než ji vypiješ.",
    "romanization": null
  },
  "26": {
    "text": "Slanina se venku vaří déle.",
    "romanization": null
  },
  "27": {
    "text": "Než odejdeš, polej uhlíky vodou.",
    "romanization": null
  },
  "28": {
    "text": "Přinesl si malý vařič na chladná rána.",
    "romanization": null
  },
  "29": {
    "text": "Káva chutná venku líp.",
    "romanization": null
  },
  "30": {
    "text": "Rukojeť pánve se rychle zahřeje.",
    "romanization": null
  },
  "31": {
    "text": "Večeři jsme vařili na plochém kameni.",
    "romanization": null
  },
  "32": {
    "text": "Marshmallow zase chytlo.",
    "romanization": null
  },
  "33": {
    "text": "Opékej to pomalu, jen na okraji plamene.",
    "romanization": null
  },
  "34": {
    "text": "Odnes všechno, co jsi přinesl.",
    "romanization": null
  },
  "35": {
    "text": "Předpověď hlásí déšť po půlnoci.",
    "romanization": null
  },
  "36": {
    "text": "Vítr se náhle zvedl.",
    "romanization": null
  },
  "37": {
    "text": "Mraky se převalily přes hřeben.",
    "romanization": null
  },
  "38": {
    "text": "Teplota po západu slunce rychle klesla.",
    "romanization": null
  },
  "39": {
    "text": "Ranní mráz zmizel do deseti.",
    "romanization": null
  },
  "40": {
    "text": "Kvůli mlze bylo těžké sledovat stezku.",
    "romanization": null
  },
  "41": {
    "text": "Komáři se objevili za soumraku.",
    "romanization": null
  },
  "42": {
    "text": "Obloha je tady venku větší.",
    "romanization": null
  },
  "43": {
    "text": "Blesky jsou ještě míle daleko.",
    "romanization": null
  },
  "44": {
    "text": "Odpolední slunce je nejsilnější.",
    "romanization": null
  },
  "45": {
    "text": "Stezka vede podél řeky dva míle.",
    "romanization": null
  },
  "46": {
    "text": "Zůstaň na značené cestě.",
    "romanization": null
  },
  "47": {
    "text": "Začátek stezky je tři míle po silnici.",
    "romanization": null
  },
  "48": {
    "text": "Na rozcestí jsme zabočili špatně.",
    "romanization": null
  },
  "49": {
    "text": "Mapa ukazuje přístřešek blízko vrcholu.",
    "romanization": null
  },
  "50": {
    "text": "Nastavil si stálé tempo a udržel ho.",
    "romanization": null
  },
  "51": {
    "text": "Serpentiny usnadňují výstup.",
    "romanization": null
  },
  "52": {
    "text": "Výhled nahoře stál za ten výstup.",
    "romanization": null
  },
  "53": {
    "text": "Dávej pozor na volné kameny při sestupu.",
    "romanization": null
  },
  "54": {
    "text": "Viděli jsme stopy jelenů v měkké zemi.",
    "romanization": null
  },
  "55": {
    "text": "Pij vodu, než pocítíš žízeň.",
    "romanization": null
  },
  "56": {
    "text": "Stromy prořídly blízko vrcholu.",
    "romanization": null
  },
  "57": {
    "text": "Sedli jsme si na padlý kmen, abychom si odpočinuli.",
    "romanization": null
  },
  "58": {
    "text": "Most přes potok vypadal starší než stezka.",
    "romanization": null
  },
  "59": {
    "text": "Do kempu jsme se vrátili do západu slunce.",
    "romanization": null
  },
  "60": {
    "text": "Mléčná dráha je dnes v noci jasná.",
    "romanization": null
  },
  "61": {
    "text": "Ukázal na Velký vůz.",
    "romanization": null
  },
  "62": {
    "text": "Oblohou proletěla padající hvězda.",
    "romanization": null
  },
  "63": {
    "text": "Oheň praskal, zatímco jsme si povídali.",
    "romanization": null
  },
  "64": {
    "text": "Hvězdy jsou na jižní polokouli jiné.",
    "romanization": null
  },
  "65": {
    "text": "Někde ve stromech houkala sova.",
    "romanization": null
  },
  "66": {
    "text": "Měsíc vyšel pozdě a oranžový.",
    "romanization": null
  },
  "67": {
    "text": "Vyprávěli jsme si příběhy u ohně až do půlnoci.",
    "romanization": null
  },
  "68": {
    "text": "Noc je hlučnější, než bys čekal.",
    "romanization": null
  },
  "69": {
    "text": "Spali jsme s otevřeným vchodem do stanu.",
    "romanization": null
  },
  "70": {
    "text": "Za úsvitu prošel táborem jelen.",
    "romanization": null
  },
  "71": {
    "text": "Veverky si svačiny stejně našly.",
    "romanization": null
  },
  "72": {
    "text": "Na vzdáleném břehu jsme viděli bobra.",
    "romanization": null
  },
  "73": {
    "text": "Jídlo měj zabalené a pověšené přes noc.",
    "romanization": null
  },
  "74": {
    "text": "Vak na jídlo proti medvědům se dává vysoko na strom.",
    "romanization": null
  },
  "75": {
    "text": "Nenechávej boty venku, pokud nechceš překvapení.",
    "romanization": null
  },
  "76": {
    "text": "Žába skočila přímo kolem mé nohy.",
    "romanization": null
  },
  "77": {
    "text": "Ptáci nás vzbudili dřív než slunce.",
    "romanization": null
  },
  "78": {
    "text": "Chvíli jsme sledovali stopy ve sněhu.",
    "romanization": null
  },
  "79": {
    "text": "V jezeře nebyly žádné ryby, ale spousta vážek.",
    "romanization": null
  },
  "80": {
    "text": "Děti běžely celou cestu k jezeru.",
    "romanization": null
  },
  "81": {
    "text": "Nekempoval od dětství.",
    "romanization": null
  },
  "82": {
    "text": "Ukázala mi, jak číst mapu.",
    "romanization": null
  },
  "83": {
    "text": "Kemp jsme sdíleli s jinou rodinou.",
    "romanization": null
  },
  "84": {
    "text": "Dva dny venku všechno resetují.",
    "romanization": null
  },
  "85": {
    "text": "Telefon nemá signál a je to tak správně.",
    "romanization": null
  },
  "86": {
    "text": "Hodiny jsme neviděli nikoho jiného.",
    "romanization": null
  },
  "87": {
    "text": "Usnul, než oheň dohořel.",
    "romanization": null
  },
  "88": {
    "text": "První ráno je vždycky chladné a pomalé.",
    "romanization": null
  },
  "89": {
    "text": "Sbalili jsme se a místo opustili čistší, než jsme ho našli.",
    "romanization": null
  },
  "90": {
    "text": "Kde je nejbližší zdroj vody?",
    "romanization": null
  },
  "91": {
    "text": "Suchý záchod je dál po cestě.",
    "romanization": null
  },
  "92": {
    "text": "Zahrab zbytky jídla daleko od tábora.",
    "romanization": null
  },
  "93": {
    "text": "Pověs mokré oblečení u ohně, aby uschlo.",
    "romanization": null
  },
  "94": {
    "text": "Lékárnička je nahoře v batohu.",
    "romanization": null
  },
  "95": {
    "text": "Kompas ukazuje na magnetický sever.",
    "romanization": null
  },
  "96": {
    "text": "Píšťalka je hlasitější než tvůj hlas.",
    "romanization": null
  },
  "97": {
    "text": "Řekni někomu, kam jdeš.",
    "romanization": null
  },
  "98": {
    "text": "Mobil patří do suchého vaku.",
    "romanization": null
  },
  "99": {
    "text": "Vezmi si víc vrstev, než si myslíš, že potřebuješ.",
    "romanization": null
  }
}