{
  "0": {
    "text": "Pastatykime palapinę, kol dar nesutemo.",
    "romanization": null
  },
  "1": {
    "text": "Kur aš įsidėjau žiebtuvėlį?",
    "romanization": null
  },
  "2": {
    "text": "Palapinės kuoliukai yra šoninėje kišenėje.",
    "romanization": null
  },
  "3": {
    "text": "Mano miegmaišis tinka iki nulio laipsnių.",
    "romanization": null
  },
  "4": {
    "text": "Pripūsk miegmaišio kilimėlį prieš jį tiesdamas.",
    "romanization": null
  },
  "5": {
    "text": "Žibintuvėliui reikia naujų baterijų.",
    "romanization": null
  },
  "6": {
    "text": "Priveržk palapinės atotampas prieš eidamas miegoti.",
    "romanization": null
  },
  "7": {
    "text": "Apsauginis tentas dedamas siūlėmis į išorę.",
    "romanization": null
  },
  "8": {
    "text": "Statyk palapinę ant lygios žemės.",
    "romanization": null
  },
  "9": {
    "text": "Laikyk maistą toliau nuo palapinės.",
    "romanization": null
  },
  "10": {
    "text": "Jis atsivežė vieną prabangos daiktą: mažą pagalvėlę.",
    "romanization": null
  },
  "11": {
    "text": "Galvos žibintuvėlis labai palengvina reikalus tamsoje.",
    "romanization": null
  },
  "12": {
    "text": "Stovyklavietė yra iškart už antrojo upelio.",
    "romanization": null
  },
  "13": {
    "text": "Šaldymo dėžė turi būti pavėsyje.",
    "romanization": null
  },
  "14": {
    "text": "Šis sulankstomas krėslas jau matė geresnių dienų.",
    "romanization": null
  },
  "15": {
    "text": "Kuprinė sunkesnė, nei atrodo.",
    "romanization": null
  },
  "16": {
    "text": "Žemėlapis atsidūrė kuprinės šoninėje kišenėje.",
    "romanization": null
  },
  "17": {
    "text": "Vandens filtras yra mažame neperšlampamame maišelyje.",
    "romanization": null
  },
  "18": {
    "text": "Kirvukas turi apsauginį dėklą.",
    "romanization": null
  },
  "19": {
    "text": "Vėl pamiršome konservų atidarytuvą.",
    "romanization": null
  },
  "20": {
    "text": "Surink sausų pakurų prieš uždegdamas.",
    "romanization": null
  },
  "21": {
    "text": "Laužavietė jau įrengta.",
    "romanization": null
  },
  "22": {
    "text": "Mums reikia daugiau malkų pakūrai.",
    "romanization": null
  },
  "23": {
    "text": "Nedėk žalios medienos į ugnį.",
    "romanization": null
  },
  "24": {
    "text": "Žarijos karštesnės už liepsnas.",
    "romanization": null
  },
  "25": {
    "text": "Užvirink vandenį prieš gerdamas.",
    "romanization": null
  },
  "26": {
    "text": "Šoninė lauke kepa ilgiau.",
    "romanization": null
  },
  "27": {
    "text": "Užpilk vandens ant žarijų prieš išvykdamas.",
    "romanization": null
  },
  "28": {
    "text": "Jis atsivežė mažą viryklę šaltiems rytams.",
    "romanization": null
  },
  "29": {
    "text": "Kava lauke skanesnė.",
    "romanization": null
  },
  "30": {
    "text": "Keptuvės rankena greitai įkaista.",
    "romanization": null
  },
  "31": {
    "text": "Vakarienę gaminome ant plokščio akmens.",
    "romanization": null
  },
  "32": {
    "text": "Zefyras vėl užsidegė.",
    "romanization": null
  },
  "33": {
    "text": "Kepk lėtai, tiesiog prie liepsnos krašto.",
    "romanization": null
  },
  "34": {
    "text": "Išsinešk viską, ką atsinešei.",
    "romanization": null
  },
  "35": {
    "text": "Prognozė sako, kad po vidurnakčio lis.",
    "romanization": null
  },
  "36": {
    "text": "Vėjas staiga sustiprėjo.",
    "romanization": null
  },
  "37": {
    "text": "Debesys atsirito virš kalvagūbrio.",
    "romanization": null
  },
  "38": {
    "text": "Temperatūra greitai nukrito po saulėlydžio.",
    "romanization": null
  },
  "39": {
    "text": "Ryto šalna išnyko iki dešimtos.",
    "romanization": null
  },
  "40": {
    "text": "Dėl rūko taku buvo sunku sekti.",
    "romanization": null
  },
  "41": {
    "text": "Uodai pasirodė sutemus.",
    "romanization": null
  },
  "42": {
    "text": "Čia dangus atrodo didesnis.",
    "romanization": null
  },
  "43": {
    "text": "Žaibai dar už daugelio kilometrų.",
    "romanization": null
  },
  "44": {
    "text": "Popietės saulė yra stipriausia.",
    "romanization": null
  },
  "45": {
    "text": "Takas eina palei upę du kilometrus.",
    "romanization": null
  },
  "46": {
    "text": "Laikykitės pažymėto tako.",
    "romanization": null
  },
  "47": {
    "text": "Tako pradžia yra už trijų kilometrų keliu.",
    "romanization": null
  },
  "48": {
    "text": "Kryžkelėje pasukome ne ten.",
    "romanization": null
  },
  "49": {
    "text": "Žemėlapyje rodoma pastogė netoli viršūnės.",
    "romanization": null
  },
  "50": {
    "text": "Jis palaikė tolygų tempą.",
    "romanization": null
  },
  "51": {
    "text": "Serpentinai palengvina kopimą.",
    "romanization": null
  },
  "52": {
    "text": "Vaizdas viršuje buvo vertas kopimo.",
    "romanization": null
  },
  "53": {
    "text": "Nusileidžiant saugokis palaidų akmenų.",
    "romanization": null
  },
  "54": {
    "text": "Minkštoje žemėje matėme elnių pėdsakus.",
    "romanization": null
  },
  "55": {
    "text": "Gerk vandenį, kol dar nepajutai troškulio.",
    "romanization": null
  },
  "56": {
    "text": "Medžiai išretėjo netoli viršūnės.",
    "romanization": null
  },
  "57": {
    "text": "Atsisėdome ant nuvirtusio rąsto pailsėti.",
    "romanization": null
  },
  "58": {
    "text": "Tiltas per upelį atrodė senesnis už taką.",
    "romanization": null
  },
  "59": {
    "text": "Į stovyklą grįžome iki saulėlydžio.",
    "romanization": null
  },
  "60": {
    "text": "Paukščių Takas šiąnakt ryškus.",
    "romanization": null
  },
  "61": {
    "text": "Jis parodė Didžiuosius Grįžulo Ratus.",
    "romanization": null
  },
  "62": {
    "text": "Per dangų praskriejo krintanti žvaigždė.",
    "romanization": null
  },
  "63": {
    "text": "Laužas traškėjo, kol mes kalbėjomės.",
    "romanization": null
  },
  "64": {
    "text": "Pietų pusrutulyje žvaigždės kitokios.",
    "romanization": null
  },
  "65": {
    "text": "Kažkur medžiuose šaukė pelėda.",
    "romanization": null
  },
  "66": {
    "text": "Mėnulis pakilo vėlai ir buvo oranžinis.",
    "romanization": null
  },
  "67": {
    "text": "Pasakojome istorijas prie laužo iki vidurnakčio.",
    "romanization": null
  },
  "68": {
    "text": "Naktis yra triukšmingesnė, nei galėtum pagalvoti.",
    "romanization": null
  },
  "69": {
    "text": "Miegojome atidarę palapinės angą.",
    "romanization": null
  },
  "70": {
    "text": "Auštant per stovyklą praėjo elnias.",
    "romanization": null
  },
  "71": {
    "text": "Voverės vis tiek rado užkandžius.",
    "romanization": null
  },
  "72": {
    "text": "Kitame krante matėme bebrą.",
    "romanization": null
  },
  "73": {
    "text": "Laikyk maistą sandariai uždarytą ir pakabintą per naktį.",
    "romanization": null
  },
  "74": {
    "text": "Maisto maišas nuo lokių kabinamas aukštai medyje.",
    "romanization": null
  },
  "75": {
    "text": "Nepalik batų lauke, jei nenori staigmenų.",
    "romanization": null
  },
  "76": {
    "text": "Varlė peršoko tiesiai pro mano koją.",
    "romanization": null
  },
  "77": {
    "text": "Paukščiai mus pažadino anksčiau nei saulė.",
    "romanization": null
  },
  "78": {
    "text": "Kurį laiką sekėme pėdsakais sniege.",
    "romanization": null
  },
  "79": {
    "text": "Ežere nebuvo žuvų, bet daug laumžirgių.",
    "romanization": null
  },
  "80": {
    "text": "Vaikai bėgo visą kelią iki ežero.",
    "romanization": null
  },
  "81": {
    "text": "Jis nestovyklavo nuo vaikystės.",
    "romanization": null
  },
  "82": {
    "text": "Ji parodė man, kaip skaityti žemėlapį.",
    "romanization": null
  },
  "83": {
    "text": "Stovyklaviete dalijomės su kita šeima.",
    "romanization": null
  },
  "84": {
    "text": "Dvi dienos gamtoje viską atstato.",
    "romanization": null
  },
  "85": {
    "text": "Telefonas neturi ryšio ir tai atrodo teisinga.",
    "romanization": null
  },
  "86": {
    "text": "Valandų valandas nematėme nė vieno žmogaus.",
    "romanization": null
  },
  "87": {
    "text": "Jis užmigo, kol ugnis dar nebuvo užgesusi.",
    "romanization": null
  },
  "88": {
    "text": "Pirmasis rytas visada būna šaltas ir lėtas.",
    "romanization": null
  },
  "89": {
    "text": "Susipakavome ir palikome vietą švaresnę, nei radome.",
    "romanization": null
  },
  "90": {
    "text": "Kur yra artimiausias vandens šaltinis?",
    "romanization": null
  },
  "91": {
    "text": "Lauko tualetas yra toliau taku.",
    "romanization": null
  },
  "92": {
    "text": "Užkask maisto likučius toli nuo stovyklos.",
    "romanization": null
  },
  "93": {
    "text": "Pakabink šlapius drabužius prie laužo, kad išdžiūtų.",
    "romanization": null
  },
  "94": {
    "text": "Pirmosios pagalbos vaistinėlė yra kuprinės viršuje.",
    "romanization": null
  },
  "95": {
    "text": "Kompasas rodo į magnetinę šiaurę.",
    "romanization": null
  },
  "96": {
    "text": "Švilpukas garsesnis už tavo balsą.",
    "romanization": null
  },
  "97": {
    "text": "Pasakyk kam nors, kur eini.",
    "romanization": null
  },
  "98": {
    "text": "Mobilusis telefonas dedamas į neperšlampamą maišelį.",
    "romanization": null
  },
  "99": {
    "text": "Pasiimk daugiau sluoksnių, nei manai, kad prireiks.",
    "romanization": null
  }
}