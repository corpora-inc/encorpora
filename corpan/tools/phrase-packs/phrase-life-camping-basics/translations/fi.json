{
  "0": {
    "text": "Pystytetään teltta ennen kuin pimenee.",
    "romanization": null
  },
  "1": {
    "text": "Minne pakkasin sytyttimen?",
    "romanization": null
  },
  "2": {
    "text": "Telttakepit ovat sivutaskussa.",
    "romanization": null
  },
  "3": {
    "text": "Makuupussini kestää nolla astetta.",
    "romanization": null
  },
  "4": {
    "text": "Täytä makuualusta ennen kuin levität sen.",
    "romanization": null
  },
  "5": {
    "text": "Lyhtyyn tarvitaan uudet paristot.",
    "romanization": null
  },
  "6": {
    "text": "Kiristä myrskynarut ennen nukkumaanmenoa.",
    "romanization": null
  },
  "7": {
    "text": "Sadesuoja laitetaan saumat ulospäin.",
    "romanization": null
  },
  "8": {
    "text": "Pystytä teltta tasaiselle maalle.",
    "romanization": null
  },
  "9": {
    "text": "Pidä ruoka poissa teltan luota.",
    "romanization": null
  },
  "10": {
    "text": "Hänellä oli mukanaan yksi luksustuote: pieni tyyny.",
    "romanization": null
  },
  "11": {
    "text": "Otsalamppu säästää paljon pimeässä hapuilua.",
    "romanization": null
  },
  "12": {
    "text": "Leiripaikka on heti toisen puron jälkeen.",
    "romanization": null
  },
  "13": {
    "text": "Kylmälaukku pysyy varjossa.",
    "romanization": null
  },
  "14": {
    "text": "Taitettava tuoli on nähnyt parempiakin päiviä.",
    "romanization": null
  },
  "15": {
    "text": "Reppu on painavampi kuin miltä se näyttää.",
    "romanization": null
  },
  "16": {
    "text": "Kartta meni repun sivutaskuun.",
    "romanization": null
  },
  "17": {
    "text": "Vesipuhdistin on pienessä kuivapussissa.",
    "romanization": null
  },
  "18": {
    "text": "Kirveessä on suojus.",
    "romanization": null
  },
  "19": {
    "text": "Unohdimme taas tölkinavaajan.",
    "romanization": null
  },
  "20": {
    "text": "Kerää kuivaa sytykettä ennen kuin sytytät tulen.",
    "romanization": null
  },
  "21": {
    "text": "Nuotiopaikka on jo rakennettu.",
    "romanization": null
  },
  "22": {
    "text": "Tarvitsemme lisää sytykkeitä.",
    "romanization": null
  },
  "23": {
    "text": "Älä laita märkää puuta tuleen.",
    "romanization": null
  },
  "24": {
    "text": "Hiillos on kuumempi kuin liekit.",
    "romanization": null
  },
  "25": {
    "text": "Keitä vesi ennen kuin juot sen.",
    "romanization": null
  },
  "26": {
    "text": "Pekonin kypsyminen kestää kauemmin ulkona.",
    "romanization": null
  },
  "27": {
    "text": "Kaada vettä hiilloksen päälle ennen lähtöä.",
    "romanization": null
  },
  "28": {
    "text": "Hänellä oli mukanaan pieni retkikeitin kylmiä aamuja varten.",
    "romanization": null
  },
  "29": {
    "text": "Kahvi maistuu paremmalta ulkona.",
    "romanization": null
  },
  "30": {
    "text": "Pannun kahva kuumenee nopeasti.",
    "romanization": null
  },
  "31": {
    "text": "Teimme illallisen tasaisella kivellä.",
    "romanization": null
  },
  "32": {
    "text": "Vaahterakarkki syttyi taas tuleen.",
    "romanization": null
  },
  "33": {
    "text": "Paahda se hitaasti, aivan liekin reunalla.",
    "romanization": null
  },
  "34": {
    "text": "Vie mukanasi kaikki, mitä toit mukanasi.",
    "romanization": null
  },
  "35": {
    "text": "Ennuste lupaa sadetta keskiyön jälkeen.",
    "romanization": null
  },
  "36": {
    "text": "Tuuli yltyi yhtäkkiä.",
    "romanization": null
  },
  "37": {
    "text": "Pilvet vyöryivät harjanteen yli.",
    "romanization": null
  },
  "38": {
    "text": "Lämpötila laski nopeasti auringonlaskun jälkeen.",
    "romanization": null
  },
  "39": {
    "text": "Aamun kuura suli pois kymmeneen mennessä.",
    "romanization": null
  },
  "40": {
    "text": "Sumu teki polusta vaikeasti seurattavan.",
    "romanization": null
  },
  "41": {
    "text": "Hyttyset tulivat esiin hämärässä.",
    "romanization": null
  },
  "42": {
    "text": "Täällä taivas tuntuu suuremmalta.",
    "romanization": null
  },
  "43": {
    "text": "Salama on vielä kilometrien päässä.",
    "romanization": null
  },
  "44": {
    "text": "Iltapäivän aurinko on voimakkain.",
    "romanization": null
  },
  "45": {
    "text": "Polku seuraa jokea kahden kilometrin matkan.",
    "romanization": null
  },
  "46": {
    "text": "Pysy merkityllä polulla.",
    "romanization": null
  },
  "47": {
    "text": "Polun alkupää on kolmen kilometrin päässä tietä pitkin.",
    "romanization": null
  },
  "48": {
    "text": "Käännyimme väärään suuntaan risteyksessä.",
    "romanization": null
  },
  "49": {
    "text": "Kartta näyttää laavun huipun lähellä.",
    "romanization": null
  },
  "50": {
    "text": "Hän piti tasaista tahtia.",
    "romanization": null
  },
  "51": {
    "text": "Serpentiinit tekevät noususta helpomman.",
    "romanization": null
  },
  "52": {
    "text": "Näkymä huipulta oli kiipeämisen arvoinen.",
    "romanization": null
  },
  "53": {
    "text": "Varo irtonaisia kiviä laskeutuessa.",
    "romanization": null
  },
  "54": {
    "text": "Näimme peuran jälkiä pehmeässä maassa.",
    "romanization": null
  },
  "55": {
    "text": "Juo vettä ennen kuin tunnet janoa.",
    "romanization": null
  },
  "56": {
    "text": "Puut harvenivat lähellä huippua.",
    "romanization": null
  },
  "57": {
    "text": "Istahdimme kaatuneelle tukille lepäämään.",
    "romanization": null
  },
  "58": {
    "text": "Puron ylittävä silta näytti vanhemmalta kuin polku.",
    "romanization": null
  },
  "59": {
    "text": "Olimme takaisin leirissä auringonlaskuun mennessä.",
    "romanization": null
  },
  "60": {
    "text": "Linnunrata on kirkas tänä yönä.",
    "romanization": null
  },
  "61": {
    "text": "Hän osoitti Otavan.",
    "romanization": null
  },
  "62": {
    "text": "Tähtilento kiiti taivaan poikki.",
    "romanization": null
  },
  "63": {
    "text": "Tuli rätisi, kun juttelimme.",
    "romanization": null
  },
  "64": {
    "text": "Tähdet ovat erilaisia eteläisellä pallonpuoliskolla.",
    "romanization": null
  },
  "65": {
    "text": "Pöllö huhuili jossain puiden seassa.",
    "romanization": null
  },
  "66": {
    "text": "Kuu nousi myöhään ja oranssina.",
    "romanization": null
  },
  "67": {
    "text": "Kerroimme tarinoita nuotion äärellä keskiyöhön asti.",
    "romanization": null
  },
  "68": {
    "text": "Yö on äänekkäämpi kuin luulisi.",
    "romanization": null
  },
  "69": {
    "text": "Nukuimme teltan oviaukko auki.",
    "romanization": null
  },
  "70": {
    "text": "Peura käveli leirin läpi aamunkoitteessa.",
    "romanization": null
  },
  "71": {
    "text": "Oravat löysivät herkut joka tapauksessa.",
    "romanization": null
  },
  "72": {
    "text": "Näimme majavan vastarannalla.",
    "romanization": null
  },
  "73": {
    "text": "Pidä ruoka suljettuna ja ripustettuna yön yli.",
    "romanization": null
  },
  "74": {
    "text": "Karhupussi ripustetaan korkealle puuhun.",
    "romanization": null
  },
  "75": {
    "text": "Älä jätä kenkiä ulos, jos et halua yllätyksiä.",
    "romanization": null
  },
  "76": {
    "text": "Sammakko hyppäsi aivan jalkani ohi.",
    "romanization": null
  },
  "77": {
    "text": "Linnut herättivät meidät ennen aurinkoa.",
    "romanization": null
  },
  "78": {
    "text": "Seurasimme jälkiä lumessa jonkin aikaa.",
    "romanization": null
  },
  "79": {
    "text": "Järvessä ei ollut kaloja, mutta paljon sudenkorentoja.",
    "romanization": null
  },
  "80": {
    "text": "Lapset juoksivat koko matkan järvelle.",
    "romanization": null
  },
  "81": {
    "text": "Hän ei ollut retkeillyt lapsuuden jälkeen.",
    "romanization": null
  },
  "82": {
    "text": "Hän näytti minulle, miten karttaa luetaan.",
    "romanization": null
  },
  "83": {
    "text": "Jaoimme leiripaikan toisen perheen kanssa.",
    "romanization": null
  },
  "84": {
    "text": "Kaksi päivää ulkona nollaa kaiken.",
    "romanization": null
  },
  "85": {
    "text": "Puhelimessa ei ole kenttää, ja se tuntuu oikealta.",
    "romanization": null
  },
  "86": {
    "text": "Emme nähneet toista ihmistä tunteihin.",
    "romanization": null
  },
  "87": {
    "text": "Hän nukahti ennen kuin tuli sammui.",
    "romanization": null
  },
  "88": {
    "text": "Ensimmäinen aamu on aina kylmä ja hidas.",
    "romanization": null
  },
  "89": {
    "text": "Pakkasimme tavarat ja jätimme paikan siistimmäksi kuin se oli tullessamme.",
    "romanization": null
  },
  "90": {
    "text": "Missä on lähin vesipiste?",
    "romanization": null
  },
  "91": {
    "text": "Kuivakäymälä on polkua pitkin.",
    "romanization": null
  },
  "92": {
    "text": "Hautaa ruoantähteet kauas leiristä.",
    "romanization": null
  },
  "93": {
    "text": "Ripusta märät vaatteet nuotion viereen kuivumaan.",
    "romanization": null
  },
  "94": {
    "text": "Ensiapupakkaus on repun päällä.",
    "romanization": null
  },
  "95": {
    "text": "Kompassi osoittaa magneettiseen pohjoiseen.",
    "romanization": null
  },
  "96": {
    "text": "Pilli on äänekkäämpi kuin äänesi.",
    "romanization": null
  },
  "97": {
    "text": "Kerro jollekin, minne olet menossa.",
    "romanization": null
  },
  "98": {
    "text": "Matkapuhelin menee kuivapussiin.",
    "romanization": null
  },
  "99": {
    "text": "Ota mukaan enemmän kerroksia kuin luulet tarvitsevasi.",
    "romanization": null
  }
}