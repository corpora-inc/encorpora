{
  "0": {
    "text": "Hava kararmadan çadırı kuralım.",
    "romanization": null
  },
  "1": {
    "text": "Çakmağı nereye koymuştum?",
    "romanization": null
  },
  "2": {
    "text": "Çadır kazıkları yan cepte.",
    "romanization": null
  },
  "3": {
    "text": "Uyku tulumum sıfır dereceye kadar dayanıklı.",
    "romanization": null
  },
  "4": {
    "text": "Matı sermeden önce şişir.",
    "romanization": null
  },
  "5": {
    "text": "Fener yeni pil istiyor.",
    "romanization": null
  },
  "6": {
    "text": "Yatmadan önce gergi iplerini sıkılaştır.",
    "romanization": null
  },
  "7": {
    "text": "Yağmurluk, dikiş yerleri dışa gelecek şekilde takılır.",
    "romanization": null
  },
  "8": {
    "text": "Çadırı düz bir yere kur.",
    "romanization": null
  },
  "9": {
    "text": "Yiyecekleri çadırdan uzak tut.",
    "romanization": null
  },
  "10": {
    "text": "Tek bir lüks eşya getirmişti: küçük bir yastık.",
    "romanization": null
  },
  "11": {
    "text": "Kafa lambası sayesinde etrafta el yordamıyla dolaşmaya gerek kalmıyor.",
    "romanization": null
  },
  "12": {
    "text": "Kamp alanı ikinci derenin hemen ilerisinde.",
    "romanization": null
  },
  "13": {
    "text": "Buzluk gölgede kalsın.",
    "romanization": null
  },
  "14": {
    "text": "Katlanır sandalye eski günlerini aratıyor.",
    "romanization": null
  },
  "15": {
    "text": "Sırt çantası göründüğünden daha ağır.",
    "romanization": null
  },
  "16": {
    "text": "Harita sırt çantasının yan cebine girdi.",
    "romanization": null
  },
  "17": {
    "text": "Su filtresi küçük kuru çantanın içinde.",
    "romanization": null
  },
  "18": {
    "text": "Küçük baltanın koruyucu kılıfı var.",
    "romanization": null
  },
  "19": {
    "text": "Konserve açacağını yine unutmuşuz.",
    "romanization": null
  },
  "20": {
    "text": "Yakmadan önce biraz kuru tutuşturucu topla.",
    "romanization": null
  },
  "21": {
    "text": "Ateş çukuru zaten yapılmış.",
    "romanization": null
  },
  "22": {
    "text": "Daha fazla çırağa ihtiyacımız var.",
    "romanization": null
  },
  "23": {
    "text": "Ateşe yaş odun atma.",
    "romanization": null
  },
  "24": {
    "text": "Közler alevlerden daha sıcak.",
    "romanization": null
  },
  "25": {
    "text": "Suyu içmeden önce kaynat.",
    "romanization": null
  },
  "26": {
    "text": "Pastırma dışarıda daha uzun sürede pişiyor.",
    "romanization": null
  },
  "27": {
    "text": "Gitmeden önce közlerin üzerine su dök.",
    "romanization": null
  },
  "28": {
    "text": "Soğuk sabahlar için küçük bir ocak getirmişti.",
    "romanization": null
  },
  "29": {
    "text": "Kahve dışarıda daha lezzetli olur.",
    "romanization": null
  },
  "30": {
    "text": "Tavanın sapı çabuk ısınıyor.",
    "romanization": null
  },
  "31": {
    "text": "Akşam yemeğini düz bir taşın üzerinde pişirdik.",
    "romanization": null
  },
  "32": {
    "text": "Marshmallow yine alev aldı.",
    "romanization": null
  },
  "33": {
    "text": "Yavaşça, alevin kenarında kızart.",
    "romanization": null
  },
  "34": {
    "text": "Ne getirdiysen, hepsini geri götür.",
    "romanization": null
  },
  "35": {
    "text": "Hava durumu gece yarısından sonra yağmur gösteriyor.",
    "romanization": null
  },
  "36": {
    "text": "Rüzgar aniden şiddetlendi.",
    "romanization": null
  },
  "37": {
    "text": "Bulutlar sırtın üzerinden geldi.",
    "romanization": null
  },
  "38": {
    "text": "Gün batımından sonra sıcaklık hızla düştü.",
    "romanization": null
  },
  "39": {
    "text": "Sabah ayazı saat ona kadar dağıldı.",
    "romanization": null
  },
  "40": {
    "text": "Sis, patikayı takip etmeyi zorlaştırdı.",
    "romanization": null
  },
  "41": {
    "text": "Sivrisinekler alacakaranlıkta ortaya çıktı.",
    "romanization": null
  },
  "42": {
    "text": "Burada gökyüzü daha geniş.",
    "romanization": null
  },
  "43": {
    "text": "Şimşek hala kilometrelerce uzakta.",
    "romanization": null
  },
  "44": {
    "text": "Öğleden sonra güneşi en yakıcı olanıdır.",
    "romanization": null
  },
  "45": {
    "text": "Patika iki kilometre boyunca nehri takip ediyor.",
    "romanization": null
  },
  "46": {
    "text": "İşaretli yolda kal.",
    "romanization": null
  },
  "47": {
    "text": "Patika başlangıcı yoldan üç kilometre yukarıda.",
    "romanization": null
  },
  "48": {
    "text": "Yol ayrımında yanlış yöne saptık.",
    "romanization": null
  },
  "49": {
    "text": "Harita zirvenin yakınında bir sığınak gösteriyor.",
    "romanization": null
  },
  "50": {
    "text": "Sabit bir tempo tutturdu ve onu korudu.",
    "romanization": null
  },
  "51": {
    "text": "Dönemeçli yollar tırmanışı kolaylaştırıyor.",
    "romanization": null
  },
  "52": {
    "text": "Zirvedeki manzara tırmanışa değdi.",
    "romanization": null
  },
  "53": {
    "text": "İnişte gevşek taşlara dikkat et.",
    "romanization": null
  },
  "54": {
    "text": "Yumuşak toprakta geyik izleri gördük.",
    "romanization": null
  },
  "55": {
    "text": "Susuzluk hissetmeden önce su iç.",
    "romanization": null
  },
  "56": {
    "text": "Ağaçlar zirveye yakın inceldi.",
    "romanization": null
  },
  "57": {
    "text": "Dinlenmek için devrilmiş bir kütüğe oturduk.",
    "romanization": null
  },
  "58": {
    "text": "Derenin üzerindeki köprü patikadan daha eski görünüyordu.",
    "romanization": null
  },
  "59": {
    "text": "Gün batımına kadar kampa geri döndük.",
    "romanization": null
  },
  "60": {
    "text": "Samanyolu bu gece çok parlak.",
    "romanization": null
  },
  "61": {
    "text": "Büyük Ayı'yı gösterdi.",
    "romanization": null
  },
  "62": {
    "text": "Bir kayan yıldız gökyüzünden geçti.",
    "romanization": null
  },
  "63": {
    "text": "Biz konuşurken ateş çıtırdıyordu.",
    "romanization": null
  },
  "64": {
    "text": "Güney yarımkürede yıldızlar farklı.",
    "romanization": null
  },
  "65": {
    "text": "Ağaçların arasından bir baykuş sesi geldi.",
    "romanization": null
  },
  "66": {
    "text": "Ay geç ve turuncu renkte doğdu.",
    "romanization": null
  },
  "67": {
    "text": "Gece yarısına kadar ateşin etrafında hikayeler anlattık.",
    "romanization": null
  },
  "68": {
    "text": "Gece düşündüğünden daha gürültülü.",
    "romanization": null
  },
  "69": {
    "text": "Çadırın kapısı açık uyuduk.",
    "romanization": null
  },
  "70": {
    "text": "Şafakta kampın içinden bir geyik geçti.",
    "romanization": null
  },
  "71": {
    "text": "Sincaplar atıştırmalıkları yine de buldu.",
    "romanization": null
  },
  "72": {
    "text": "Karşı kıyıda bir kunduz gördük.",
    "romanization": null
  },
  "73": {
    "text": "Yiyeceklerini kapalı tut ve gece asılı bırak.",
    "romanization": null
  },
  "74": {
    "text": "Ayı çantası ağacın yüksek bir yerine asılır.",
    "romanization": null
  },
  "75": {
    "text": "Sürpriz istemiyorsan ayakkabılarını dışarıda bırakma.",
    "romanization": null
  },
  "76": {
    "text": "Bir kurbağa ayağımın dibinden zıplayarak geçti.",
    "romanization": null
  },
  "77": {
    "text": "Kuşlar bizi güneşten önce uyandırdı.",
    "romanization": null
  },
  "78": {
    "text": "Bir süre karda izleri takip ettik.",
    "romanization": null
  },
  "79": {
    "text": "Gölde balık yoktu ama çok sayıda yusufçuk vardı.",
    "romanization": null
  },
  "80": {
    "text": "Çocuklar göle kadar tüm yolu koştular.",
    "romanization": null
  },
  "81": {
    "text": "Çocukluğundan beri kamp yapmamıştı.",
    "romanization": null
  },
  "82": {
    "text": "Bana harita okumayı öğretti.",
    "romanization": null
  },
  "83": {
    "text": "Kamp alanını başka bir aileyle paylaştık.",
    "romanization": null
  },
  "84": {
    "text": "İki gün dışarıda kalmak her şeyi sıfırlar.",
    "romanization": null
  },
  "85": {
    "text": "Telefonda sinyal yok ve bu iyi hissettiriyor.",
    "romanization": null
  },
  "86": {
    "text": "Saatlerce başka kimseyi görmedik.",
    "romanization": null
  },
  "87": {
    "text": "Ateş sönmeden uyuyakaldı.",
    "romanization": null
  },
  "88": {
    "text": "İlk sabah her zaman soğuk ve ağırdır.",
    "romanization": null
  },
  "89": {
    "text": "Toparlandık ve alanı bulduğumuzdan daha temiz bıraktık.",
    "romanization": null
  },
  "90": {
    "text": "En yakın su kaynağı nerede?",
    "romanization": null
  },
  "91": {
    "text": "Çukur tuvalet patikanın aşağısında.",
    "romanization": null
  },
  "92": {
    "text": "Yemek artıklarını kamptan uzağa göm.",
    "romanization": null
  },
  "93": {
    "text": "Islak çamaşırları kuruması için ateşin yanına as.",
    "romanization": null
  },
  "94": {
    "text": "İlk yardım çantası sırt çantasının en üstünde.",
    "romanization": null
  },
  "95": {
    "text": "Pusula manyetik kuzeyi gösterir.",
    "romanization": null
  },
  "96": {
    "text": "Düdük sesinden daha yüksek çıkar.",
    "romanization": null
  },
  "97": {
    "text": "Nereye gittiğini birine söyle.",
    "romanization": null
  },
  "98": {
    "text": "Cep telefonu kuru bir çantaya konur.",
    "romanization": null
  },
  "99": {
    "text": "İhtiyacın olduğunu düşündüğünden daha fazla kat giysi getir.",
    "romanization": null
  }
}