{
  "0": {
    "text": "Ar moki groti pianinu?",
    "romanization": null
  },
  "1": {
    "text": "Groju smuiku nedideliame orkestre.",
    "romanization": null
  },
  "2": {
    "text": "Gitarai reikia naujų stygų.",
    "romanization": null
  },
  "3": {
    "text": "Ji groja būgnais savo sesers grupėje.",
    "romanization": null
  },
  "4": {
    "text": "Mokausi groti fleita.",
    "romanization": null
  },
  "5": {
    "text": "Jis vėl paėmė trimitą į rankas po dvidešimties metų.",
    "romanization": null
  },
  "6": {
    "text": "Violončelė atremta į sieną.",
    "romanization": null
  },
  "7": {
    "text": "Derinimas užtrunka ilgiau, nei tikėjausi.",
    "romanization": null
  },
  "8": {
    "text": "Kuri styga išderinta?",
    "romanization": null
  },
  "9": {
    "text": "Smuiko stryko plaukus reikia pakeisti.",
    "romanization": null
  },
  "10": {
    "text": "Nusipirkau naudotą sintezatorių internetu.",
    "romanization": null
  },
  "11": {
    "text": "Jai labiau patinka pianinas nei fortepijonas.",
    "romanization": null
  },
  "12": {
    "text": "Jis visur nešiojasi savo saksofono dėklą.",
    "romanization": null
  },
  "13": {
    "text": "Būgnininkas susiruošė anksčiau, nei atvyko visi kiti.",
    "romanization": null
  },
  "14": {
    "text": "Ukulele lengviau pradėti groti nei gitara.",
    "romanization": null
  },
  "15": {
    "text": "Ar moki skaityti natas?",
    "romanization": null
  },
  "16": {
    "text": "Kūrinys yra G-dur.",
    "romanization": null
  },
  "17": {
    "text": "Mes grojame trijų ketvirtinių taktu.",
    "romanization": null
  },
  "18": {
    "text": "Pirmą natą pagrok šiek tiek garsiau.",
    "romanization": null
  },
  "19": {
    "text": "Pauzė yra tokia pat svarbi kaip ir nata.",
    "romanization": null
  },
  "20": {
    "text": "Jis paaiškino, kas yra bemolis ir diezė.",
    "romanization": null
  },
  "21": {
    "text": "Akordų keitimas dabar atrodo natūralus.",
    "romanization": null
  },
  "22": {
    "text": "Gama yra tiesiog natos iš eilės.",
    "romanization": null
  },
  "23": {
    "text": "Pabandyk tą pačią ištrauką viena oktava žemiau.",
    "romanization": null
  },
  "24": {
    "text": "Ji pasižymėjo įkvėpimus paraštėje.",
    "romanization": null
  },
  "25": {
    "text": "Dirigentas mums davė ženklą pradėti.",
    "romanization": null
  },
  "26": {
    "text": "Šis taktas man visada kelia problemų.",
    "romanization": null
  },
  "27": {
    "text": "Melodija paprasta, bet ji įstringa galvoje.",
    "romanization": null
  },
  "28": {
    "text": "Jis mieliau kuria muziką iš klausos.",
    "romanization": null
  },
  "29": {
    "text": "Daugumoje dainų naudojami tik keli akordai.",
    "romanization": null
  },
  "30": {
    "text": "Repetuoju trisdešimt minučių po vakarienės.",
    "romanization": null
  },
  "31": {
    "text": "Grok lėtai, kol pirštai prisimins.",
    "romanization": null
  },
  "32": {
    "text": "Ji naudoja metronomą, kad išlaikytų ritmą.",
    "romanization": null
  },
  "33": {
    "text": "Jis įrašo save ir vėliau perklauso.",
    "romanization": null
  },
  "34": {
    "text": "Apšilk prieš sunkias ištraukas.",
    "romanization": null
  },
  "35": {
    "text": "Klaidos yra repeticijų dalis.",
    "romanization": null
  },
  "36": {
    "text": "Aš padalijau tai į mažas dalis.",
    "romanization": null
  },
  "37": {
    "text": "Penkios minutės šiandien yra geriau nei dvi valandos kitą savaitę.",
    "romanization": null
  },
  "38": {
    "text": "Ji repetuoja prieš veidrodį.",
    "romanization": null
  },
  "39": {
    "text": "Mokytojas davė man naują pratimą.",
    "romanization": null
  },
  "40": {
    "text": "Neskubėk lėtose dalyse.",
    "romanization": null
  },
  "41": {
    "text": "Jis kartais groja užsimerkęs.",
    "romanization": null
  },
  "42": {
    "text": "Sunkiausias taktas yra tas, kurį praleidau.",
    "romanization": null
  },
  "43": {
    "text": "Po trijų dienų pertraukos visada jaučiuosi aprūdijęs.",
    "romanization": null
  },
  "44": {
    "text": "Repetuok pabaigą labiau nei pradžią.",
    "romanization": null
  },
  "45": {
    "text": "Mano rankos drebėjo prieš rečitalį.",
    "romanization": null
  },
  "46": {
    "text": "Publika plojo dar nepasibaigus kūriniui.",
    "romanization": null
  },
  "47": {
    "text": "Ji nusilenkė ir nuėjo nuo scenos.",
    "romanization": null
  },
  "48": {
    "text": "Jis pamiršo eilutę ir improvizavo.",
    "romanization": null
  },
  "49": {
    "text": "Grupė derino instrumentus, kol šviesos pritemo.",
    "romanization": null
  },
  "50": {
    "text": "Ar galėtum man atversti puslapį?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofonas per arti lėkščių.",
    "romanization": null
  },
  "52": {
    "text": "Mes sugrojome bisą.",
    "romanization": null
  },
  "53": {
    "text": "Jis pažvelgė į minią ir nusišypsojo.",
    "romanization": null
  },
  "54": {
    "text": "Pirmasis koncertas visada yra sunkiausias.",
    "romanization": null
  },
  "55": {
    "text": "Scenos baimė niekada visiškai nepraeina.",
    "romanization": null
  },
  "56": {
    "text": "Beveik išmečiau stryką per kadenciją.",
    "romanization": null
  },
  "57": {
    "text": "Dainavimas viešai yra savotiška drąsa.",
    "romanization": null
  },
  "58": {
    "text": "Aplodismentai atrodė ilgesni už dainą.",
    "romanization": null
  },
  "59": {
    "text": "Po pasirodymo susitikome su savo mėgstamiausiu muzikantu.",
    "romanization": null
  },
  "60": {
    "text": "Kokios muzikos klausai?",
    "romanization": null
  },
  "61": {
    "text": "Užaugau klausydamas mamos plokštelių.",
    "romanization": null
  },
  "62": {
    "text": "Jis klauso operos, kol gamina.",
    "romanization": null
  },
  "63": {
    "text": "Boso partija yra tai, kas sukuria dainą.",
    "romanization": null
  },
  "64": {
    "text": "Įraše girdisi patalpos akustika.",
    "romanization": null
  },
  "65": {
    "text": "Šis albumas geriau skamba vinilinėje plokštelėje.",
    "romanization": null
  },
  "66": {
    "text": "Ji užmerkė akis ir klausėsi styginių.",
    "romanization": null
  },
  "67": {
    "text": "Pianinas šiek tiek išderintas.",
    "romanization": null
  },
  "68": {
    "text": "Vis grįžtu prie šio albumo.",
    "romanization": null
  },
  "69": {
    "text": "Kai pirmą kartą išgirdau, sustabdžiau viską, ką dariau.",
    "romanization": null
  },
  "70": {
    "text": "Jis kas savaitę rekomenduoja vis kitą džiazo plokštelę.",
    "romanization": null
  },
  "71": {
    "text": "Ši daina man primena mano senelį.",
    "romanization": null
  },
  "72": {
    "text": "Po melodija slypi tyli harmonija.",
    "romanization": null
  },
  "73": {
    "text": "Gyva muzika skamba kitaip nei įrašas.",
    "romanization": null
  },
  "74": {
    "text": "Vėlai vakare renkuosi ausines.",
    "romanization": null
  },
  "75": {
    "text": "Choras renkasi trečiadienio vakarais.",
    "romanization": null
  },
  "76": {
    "text": "Bosas laiko visą grupę kartu.",
    "romanization": null
  },
  "77": {
    "text": "Dirigentas švelniai įvedė orkestrą.",
    "romanization": null
  },
  "78": {
    "text": "Tą pačią ištrauką repetavome keturis kartus.",
    "romanization": null
  },
  "79": {
    "text": "Jis groja antruoju smuiku vietiniame simfoniniame orkestre.",
    "romanization": null
  },
  "80": {
    "text": "Kvartetas sėdėjo glaudžiame puslankiu.",
    "romanization": null
  },
  "81": {
    "text": "Būgnininkas atmušė tempą.",
    "romanization": null
  },
  "82": {
    "text": "Ji dainavo harmonijos partiją.",
    "romanization": null
  },
  "83": {
    "text": "Dvi gitaros ir balsas kartais yra pakankamai.",
    "romanization": null
  },
  "84": {
    "text": "Choras nuvyko į mažą bažnyčią dainuoti.",
    "romanization": null
  },
  "85": {
    "text": "Jis įrašė vokalus savo spintoje.",
    "romanization": null
  },
  "86": {
    "text": "Kabelio ūžesys dingo, kai ji pakeitė įvestį.",
    "romanization": null
  },
  "87": {
    "text": "Tam balsui reikia kito mikrofono.",
    "romanization": null
  },
  "88": {
    "text": "Jis išsaugo kiekvieną dublį, jei kitas būtų prastesnis.",
    "romanization": null
  },
  "89": {
    "text": "Miksas skambėjo geriau kitą rytą.",
    "romanization": null
  },
  "90": {
    "text": "Stiprintuvas švyti, kai įkaista.",
    "romanization": null
  },
  "91": {
    "text": "Jis naudoja seną keturių takelių magnetofoną.",
    "romanization": null
  },
  "92": {
    "text": "Mes sudėjome tris tos pačios eilutės dublius.",
    "romanization": null
  },
  "93": {
    "text": "Reverberacija privertė kambarį atrodyti didžiulį.",
    "romanization": null
  },
  "94": {
    "text": "Ji miksavo albumą savo virtuvėje.",
    "romanization": null
  },
  "95": {
    "text": "Muzika sutrumpina ilgą kelionę.",
    "romanization": null
  },
  "96": {
    "text": "Daina gali pakeisti dienos nuotaiką.",
    "romanization": null
  },
  "97": {
    "text": "Visa patalpa dainavo kartu.",
    "romanization": null
  },
  "98": {
    "text": "Tyla po paskutinio akordo yra muzikos dalis.",
    "romanization": null
  },
  "99": {
    "text": "Išmok vieną dainą, kurią galėtum pagroti bet kam.",
    "romanization": null
  }
}