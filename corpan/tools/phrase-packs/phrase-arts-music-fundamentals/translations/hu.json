{
  "0": {
    "text": "Tudsz zongorázni?",
    "romanization": null
  },
  "1": {
    "text": "Egy kis zenekarban hegedülök.",
    "romanization": null
  },
  "2": {
    "text": "A gitárra új húrok kellenek.",
    "romanization": null
  },
  "3": {
    "text": "A nővére zenekarában dobol.",
    "romanization": null
  },
  "4": {
    "text": "Tanulok fuvolázni.",
    "romanization": null
  },
  "5": {
    "text": "Húsz év után újra a kezébe vette a trombitát.",
    "romanization": null
  },
  "6": {
    "text": "A cselló a falnak támaszkodik.",
    "romanization": null
  },
  "7": {
    "text": "A hangolás tovább tart, mint gondoltam.",
    "romanization": null
  },
  "8": {
    "text": "Melyik húr hamis?",
    "romanization": null
  },
  "9": {
    "text": "A vonó szőrét cserélni kell.",
    "romanization": null
  },
  "10": {
    "text": "Vettem egy használt szintetizátort online.",
    "romanization": null
  },
  "11": {
    "text": "Az álló zongorát jobban szereti, mint a nagyzongorát.",
    "romanization": null
  },
  "12": {
    "text": "Mindenhová magával viszi a szaxofontokját.",
    "romanization": null
  },
  "13": {
    "text": "A dobos már mindenki előtt beállította a cuccát.",
    "romanization": null
  },
  "14": {
    "text": "Ukulelén könnyebb elkezdeni, mint gitáron.",
    "romanization": null
  },
  "15": {
    "text": "Tudsz kottát olvasni?",
    "romanization": null
  },
  "16": {
    "text": "A darab G-dúrban van.",
    "romanization": null
  },
  "17": {
    "text": "Háromnegyedes ütemben vagyunk.",
    "romanization": null
  },
  "18": {
    "text": "Az első hangot játszd egy kicsit hangosabban.",
    "romanization": null
  },
  "19": {
    "text": "A szünet éppolyan fontos, mint a hang.",
    "romanization": null
  },
  "20": {
    "text": "Elmagyarázta, mi a b és mi a kereszt.",
    "romanization": null
  },
  "21": {
    "text": "Az akkordváltások már természetesnek tűnnek.",
    "romanization": null
  },
  "22": {
    "text": "A skála csak egymás utáni hangokból áll.",
    "romanization": null
  },
  "23": {
    "text": "Próbáld meg ugyanazt a részt egy oktávval lejjebb.",
    "romanization": null
  },
  "24": {
    "text": "Bejelölte a légvételeket a margón.",
    "romanization": null
  },
  "25": {
    "text": "A karmester beintett minket.",
    "romanization": null
  },
  "26": {
    "text": "Ez az ütem mindig kifog rajtam.",
    "romanization": null
  },
  "27": {
    "text": "A dallam egyszerű, de megragad az emberben.",
    "romanization": null
  },
  "28": {
    "text": "Szívesebben ír zenét hallás után.",
    "romanization": null
  },
  "29": {
    "text": "A legtöbb dalban csak néhány akkord van.",
    "romanization": null
  },
  "30": {
    "text": "Vacsora után harminc percet gyakorolok.",
    "romanization": null
  },
  "31": {
    "text": "Játszd lassan, amíg az ujjaid meg nem jegyzik.",
    "romanization": null
  },
  "32": {
    "text": "Metronómot használ, hogy tartsa a tempót.",
    "romanization": null
  },
  "33": {
    "text": "Felveszi magát, és visszahallgatja.",
    "romanization": null
  },
  "34": {
    "text": "Melegíts be a nehéz részek előtt.",
    "romanization": null
  },
  "35": {
    "text": "A hibák a gyakorlás részei.",
    "romanization": null
  },
  "36": {
    "text": "Kis részekre bontottam.",
    "romanization": null
  },
  "37": {
    "text": "Öt perc ma jobb, mint két óra jövő héten.",
    "romanization": null
  },
  "38": {
    "text": "Tükör előtt gyakorol.",
    "romanization": null
  },
  "39": {
    "text": "A tanár adott egy új gyakorlatot.",
    "romanization": null
  },
  "40": {
    "text": "Ne siettesd a lassú részeket.",
    "romanization": null
  },
  "41": {
    "text": "Néha csukott szemmel játszik.",
    "romanization": null
  },
  "42": {
    "text": "A legtrükkösebb ütem az, amit kihagytam.",
    "romanization": null
  },
  "43": {
    "text": "Három nap kihagyás után mindig berozsdásodom.",
    "romanization": null
  },
  "44": {
    "text": "A befejezést gyakorold többet, mint a kezdetet.",
    "romanization": null
  },
  "45": {
    "text": "Remegtek a kezeim a fellépés előtt.",
    "romanization": null
  },
  "46": {
    "text": "A közönség megtapsolt, mielőtt a darab véget ért volna.",
    "romanization": null
  },
  "47": {
    "text": "Meghajolt, és levonult a színpadról.",
    "romanization": null
  },
  "48": {
    "text": "Elfelejtett egy sort, és improvizált.",
    "romanization": null
  },
  "49": {
    "text": "A zenekar hangolt, miközben lekapcsolták a fényeket.",
    "romanization": null
  },
  "50": {
    "text": "Lapoznál nekem?",
    "romanization": null
  },
  "51": {
    "text": "A mikrofon túl közel van a cintányérokhoz.",
    "romanization": null
  },
  "52": {
    "text": "Ráadást játszottunk.",
    "romanization": null
  },
  "53": {
    "text": "Belenézett a tömegbe és elmosolyodott.",
    "romanization": null
  },
  "54": {
    "text": "Az első koncert mindig a legnehezebb.",
    "romanization": null
  },
  "55": {
    "text": "A lámpaláz sosem múlik el teljesen.",
    "romanization": null
  },
  "56": {
    "text": "Majdnem elejtettem a vonót a kadencia alatt.",
    "romanization": null
  },
  "57": {
    "text": "Nyilvánosan énekelni különleges bátorság.",
    "romanization": null
  },
  "58": {
    "text": "A taps hosszabbnak tűnt, mint a dal.",
    "romanization": null
  },
  "59": {
    "text": "A műsor után találkoztunk a kedvenc zenészünkkel.",
    "romanization": null
  },
  "60": {
    "text": "Milyen zenét szeretsz?",
    "romanization": null
  },
  "61": {
    "text": "Anyám lemezeit hallgatva nőttem fel.",
    "romanization": null
  },
  "62": {
    "text": "Operát hallgat, miközben főz.",
    "romanization": null
  },
  "63": {
    "text": "A basszus alapja adja a dal lelkét.",
    "romanization": null
  },
  "64": {
    "text": "Hallani a teret a felvételen.",
    "romanization": null
  },
  "65": {
    "text": "Ez az album jobban szól bakeliten.",
    "romanization": null
  },
  "66": {
    "text": "Becsukta a szemét, és hallgatta a vonósokat.",
    "romanization": null
  },
  "67": {
    "text": "A zongora kissé hamis.",
    "romanization": null
  },
  "68": {
    "text": "Mindig visszatérek ehhez az albumhoz.",
    "romanization": null
  },
  "69": {
    "text": "Amikor először hallottam, abbahagytam, amit csináltam.",
    "romanization": null
  },
  "70": {
    "text": "Minden héten más jazz lemezt ajánl.",
    "romanization": null
  },
  "71": {
    "text": "A dal a nagypapámra emlékeztet.",
    "romanization": null
  },
  "72": {
    "text": "Van egy halk harmónia a dallam alatt.",
    "romanization": null
  },
  "73": {
    "text": "Az élő zene másképp szól, mint egy felvétel.",
    "romanization": null
  },
  "74": {
    "text": "Késő este inkább fejhallgatót használok.",
    "romanization": null
  },
  "75": {
    "text": "A kórus szerda esténként találkozik.",
    "romanization": null
  },
  "76": {
    "text": "A basszus tartja össze az egész zenekart.",
    "romanization": null
  },
  "77": {
    "text": "A karmester finoman hozta be a zenekart.",
    "romanization": null
  },
  "78": {
    "text": "Négyszer próbáltuk ugyanazt a részt.",
    "romanization": null
  },
  "79": {
    "text": "Második hegedűs a helyi szimfonikus zenekarban.",
    "romanization": null
  },
  "80": {
    "text": "A kvartett szorosan félkörben ült.",
    "romanization": null
  },
  "81": {
    "text": "A dobos beütötte a tempót.",
    "romanization": null
  },
  "82": {
    "text": "Ő énekelte a harmónia szólamot.",
    "romanization": null
  },
  "83": {
    "text": "Két gitár és egy hang néha elég.",
    "romanization": null
  },
  "84": {
    "text": "A kórus elutazott egy kis templomba énekelni.",
    "romanization": null
  },
  "85": {
    "text": "A szekrényében vette fel az éneket.",
    "romanization": null
  },
  "86": {
    "text": "A kábelzúgás eltűnt, amikor bemenetet váltott.",
    "romanization": null
  },
  "87": {
    "text": "Más mikrofon kell ahhoz a hanghoz.",
    "romanization": null
  },
  "88": {
    "text": "Minden felvételt elment, hátha a következő rosszabb lesz.",
    "romanization": null
  },
  "89": {
    "text": "A keverés jobban szólt másnap reggel.",
    "romanization": null
  },
  "90": {
    "text": "Az erősítő izzik, amikor bemelegszik.",
    "romanization": null
  },
  "91": {
    "text": "Egy régi négysávos magnót használ.",
    "romanization": null
  },
  "92": {
    "text": "Három felvételt rétegeztünk ugyanabból a sorból.",
    "romanization": null
  },
  "93": {
    "text": "A zengetés hatalmassá tette a szobát.",
    "romanization": null
  },
  "94": {
    "text": "A konyhájában keverte az albumot.",
    "romanization": null
  },
  "95": {
    "text": "A zene megrövidíti a hosszú utat.",
    "romanization": null
  },
  "96": {
    "text": "Egy dal megváltoztathatja, hogyan érezzük magunkat egy napon.",
    "romanization": null
  },
  "97": {
    "text": "Az egész terem együtt énekelt.",
    "romanization": null
  },
  "98": {
    "text": "A csend az utolsó akkord után a zene része.",
    "romanization": null
  },
  "99": {
    "text": "Tanulj meg egy dalt, amit bárkinek el tudsz játszani.",
    "romanization": null
  }
}