{
  "0": {
    "text": "Czy umiesz grać na pianinie?",
    "romanization": null
  },
  "1": {
    "text": "Gram na skrzypcach w małej orkiestrze.",
    "romanization": null
  },
  "2": {
    "text": "Gitara potrzebuje nowych strun.",
    "romanization": null
  },
  "3": {
    "text": "Ona gra na perkusji w zespole swojej siostry.",
    "romanization": null
  },
  "4": {
    "text": "Uczę się grać na flecie.",
    "romanization": null
  },
  "5": {
    "text": "Wrócił do trąbki po dwudziestu latach.",
    "romanization": null
  },
  "6": {
    "text": "Wiolonczela opiera się o ścianę.",
    "romanization": null
  },
  "7": {
    "text": "Strojenie zajmuje więcej czasu, niż się spodziewałem.",
    "romanization": null
  },
  "8": {
    "text": "Która struna jest rozstrojona?",
    "romanization": null
  },
  "9": {
    "text": "Smyczek potrzebuje nowego włosia.",
    "romanization": null
  },
  "10": {
    "text": "Kupiłem używany keyboard online.",
    "romanization": null
  },
  "11": {
    "text": "Woli pianino od fortepianu.",
    "romanization": null
  },
  "12": {
    "text": "Wszędzie nosi futerał na saksofon.",
    "romanization": null
  },
  "13": {
    "text": "Perkusista rozstawił się, zanim wszyscy inni przyszli.",
    "romanization": null
  },
  "14": {
    "text": "Ukulele jest łatwiejsze na początek niż gitara.",
    "romanization": null
  },
  "15": {
    "text": "Czy umiesz czytać nuty?",
    "romanization": null
  },
  "16": {
    "text": "Utwór jest w tonacji G-dur.",
    "romanization": null
  },
  "17": {
    "text": "Gramy w metrum trzy czwarte.",
    "romanization": null
  },
  "18": {
    "text": "Zagraj pierwszą nutę trochę głośniej.",
    "romanization": null
  },
  "19": {
    "text": "Pauza jest równie ważna jak nuta.",
    "romanization": null
  },
  "20": {
    "text": "Wyjaśnił, czym jest bemol i krzyżyk.",
    "romanization": null
  },
  "21": {
    "text": "Zmiany akordów wydają się teraz naturalne.",
    "romanization": null
  },
  "22": {
    "text": "Gama to po prostu nuty po kolei.",
    "romanization": null
  },
  "23": {
    "text": "Spróbuj ten sam fragment oktawę niżej.",
    "romanization": null
  },
  "24": {
    "text": "Zaznaczyła oddechy na marginesie.",
    "romanization": null
  },
  "25": {
    "text": "Dyrygent dał nam znak do wejścia.",
    "romanization": null
  },
  "26": {
    "text": "Ten takt sprawia mi za każdym razem problem.",
    "romanization": null
  },
  "27": {
    "text": "Melodia jest prosta, ale zapada w pamięć.",
    "romanization": null
  },
  "28": {
    "text": "Woli komponować ze słuchu.",
    "romanization": null
  },
  "29": {
    "text": "Większość piosenek używa tylko kilku akordów.",
    "romanization": null
  },
  "30": {
    "text": "Ćwiczę przez trzydzieści minut po kolacji.",
    "romanization": null
  },
  "31": {
    "text": "Graj powoli, aż palce zapamiętają.",
    "romanization": null
  },
  "32": {
    "text": "Używa metronomu, żeby utrzymać równe tempo.",
    "romanization": null
  },
  "33": {
    "text": "Nagrywa się i potem słucha.",
    "romanization": null
  },
  "34": {
    "text": "Rozgrzej się przed trudnymi fragmentami.",
    "romanization": null
  },
  "35": {
    "text": "Błędy są częścią ćwiczenia.",
    "romanization": null
  },
  "36": {
    "text": "Podzieliłem to na małe sekcje.",
    "romanization": null
  },
  "37": {
    "text": "Pięć minut dzisiaj jest lepsze niż dwie godziny w przyszłym tygodniu.",
    "romanization": null
  },
  "38": {
    "text": "Ćwiczy przed lustrem.",
    "romanization": null
  },
  "39": {
    "text": "Nauczyciel dał mi nowe ćwiczenie.",
    "romanization": null
  },
  "40": {
    "text": "Nie spiesz się z wolnymi fragmentami.",
    "romanization": null
  },
  "41": {
    "text": "Czasami gra z zamkniętymi oczami.",
    "romanization": null
  },
  "42": {
    "text": "Najtrudniejszy takt to ten, który pominąłem.",
    "romanization": null
  },
  "43": {
    "text": "Po trzech dniach przerwy zawsze wracam zardzewiały.",
    "romanization": null
  },
  "44": {
    "text": "Ćwicz zakończenie bardziej niż początek.",
    "romanization": null
  },
  "45": {
    "text": "Ręce trzęsły mi się przed recitalem.",
    "romanization": null
  },
  "46": {
    "text": "Publiczność klaskała, zanim utwór się skończył.",
    "romanization": null
  },
  "47": {
    "text": "Ukłoniła się i zeszła ze sceny.",
    "romanization": null
  },
  "48": {
    "text": "Zapomniał tekstu i improwizował.",
    "romanization": null
  },
  "49": {
    "text": "Zespół stroił instrumenty, gdy światła przygasły.",
    "romanization": null
  },
  "50": {
    "text": "Czy mógłbyś przewrócić mi stronę?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofon jest za blisko talerzy.",
    "romanization": null
  },
  "52": {
    "text": "Zagraliśmy bis.",
    "romanization": null
  },
  "53": {
    "text": "Spojrzał w tłum i uśmiechnął się.",
    "romanization": null
  },
  "54": {
    "text": "Pierwszy koncert jest zawsze najtrudniejszy.",
    "romanization": null
  },
  "55": {
    "text": "Tremy nigdy tak naprawdę nie da się pozbyć.",
    "romanization": null
  },
  "56": {
    "text": "Prawie upuściłem smyczek podczas kadencji.",
    "romanization": null
  },
  "57": {
    "text": "Śpiewanie publicznie to osobny rodzaj odwagi.",
    "romanization": null
  },
  "58": {
    "text": "Brawa trwały dłużej niż piosenka.",
    "romanization": null
  },
  "59": {
    "text": "Spotkaliśmy naszego ulubionego muzyka po koncercie.",
    "romanization": null
  },
  "60": {
    "text": "Jakiej muzyki słuchasz?",
    "romanization": null
  },
  "61": {
    "text": "Dorastałem, słuchając płyt mojej mamy.",
    "romanization": null
  },
  "62": {
    "text": "Słucha opery, kiedy gotuje.",
    "romanization": null
  },
  "63": {
    "text": "Linia basu to podstawa tej piosenki.",
    "romanization": null
  },
  "64": {
    "text": "Słychać akustykę pomieszczenia na nagraniu.",
    "romanization": null
  },
  "65": {
    "text": "Ten album brzmi lepiej na winylu.",
    "romanization": null
  },
  "66": {
    "text": "Zamknęła oczy i słuchała strun.",
    "romanization": null
  },
  "67": {
    "text": "Pianino jest lekko rozstrojone.",
    "romanization": null
  },
  "68": {
    "text": "Ciągle wracam do tego albumu.",
    "romanization": null
  },
  "69": {
    "text": "Kiedy usłyszałem to po raz pierwszy, przestałem robić, co robiłem.",
    "romanization": null
  },
  "70": {
    "text": "Co tydzień poleca inną płytę jazzową.",
    "romanization": null
  },
  "71": {
    "text": "Ta piosenka przypomina mi mojego dziadka.",
    "romanization": null
  },
  "72": {
    "text": "Pod melodią kryje się cicha harmonia.",
    "romanization": null
  },
  "73": {
    "text": "Muzyka na żywo brzmi inaczej niż z nagrania.",
    "romanization": null
  },
  "74": {
    "text": "Wolę słuchawki późno w nocy.",
    "romanization": null
  },
  "75": {
    "text": "Chór spotyka się w środy wieczorem.",
    "romanization": null
  },
  "76": {
    "text": "Bas trzyma cały zespół w ryzach.",
    "romanization": null
  },
  "77": {
    "text": "Dyrygent delikatnie wprowadził orkiestrę.",
    "romanization": null
  },
  "78": {
    "text": "Ćwiczyliśmy ten sam fragment cztery razy.",
    "romanization": null
  },
  "79": {
    "text": "Gra drugie skrzypce w lokalnej orkiestrze symfonicznej.",
    "romanization": null
  },
  "80": {
    "text": "Kwartet siedział w ciasnym półkolu.",
    "romanization": null
  },
  "81": {
    "text": "Perkusista odliczył tempo.",
    "romanization": null
  },
  "82": {
    "text": "Zaśpiewała partię harmoniczną.",
    "romanization": null
  },
  "83": {
    "text": "Dwie gitary i głos to czasem wystarczy.",
    "romanization": null
  },
  "84": {
    "text": "Chór pojechał do małego kościoła, żeby zaśpiewać.",
    "romanization": null
  },
  "85": {
    "text": "Nagrywał wokale w swojej szafie.",
    "romanization": null
  },
  "86": {
    "text": "Szum kabla zniknął, gdy zmieniła wejście.",
    "romanization": null
  },
  "87": {
    "text": "Potrzebujesz innego mikrofonu do tego głosu.",
    "romanization": null
  },
  "88": {
    "text": "Zachowuje każde nagranie na wypadek, gdyby następne było gorsze.",
    "romanization": null
  },
  "89": {
    "text": "Miks brzmiał lepiej następnego ranka.",
    "romanization": null
  },
  "90": {
    "text": "Wzmacniacz świeci, gdy się rozgrzewa.",
    "romanization": null
  },
  "91": {
    "text": "Używa starego czterokanałowego magnetofonu.",
    "romanization": null
  },
  "92": {
    "text": "Nałożyliśmy na siebie trzy nagrania tej samej partii.",
    "romanization": null
  },
  "93": {
    "text": "Pogłos sprawił, że pomieszczenie wydawało się ogromne.",
    "romanization": null
  },
  "94": {
    "text": "Zmiksowała album w swojej kuchni.",
    "romanization": null
  },
  "95": {
    "text": "Muzyka sprawia, że długa podróż samochodem wydaje się krótsza.",
    "romanization": null
  },
  "96": {
    "text": "Piosenka może zmienić to, jak czuje się dzień.",
    "romanization": null
  },
  "97": {
    "text": "Cała sala śpiewała razem.",
    "romanization": null
  },
  "98": {
    "text": "Cisza po ostatnim akordzie jest częścią muzyki.",
    "romanization": null
  },
  "99": {
    "text": "Naucz się jednej piosenki, którą możesz zagrać dla każdego.",
    "romanization": null
  }
}