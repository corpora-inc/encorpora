{
  "0": {
    "text": "Piyano çalabiliyor musun?",
    "romanization": null
  },
  "1": {
    "text": "Küçük bir orkestrada keman çalıyorum.",
    "romanization": null
  },
  "2": {
    "text": "Gitarın yeni tellere ihtiyacı var.",
    "romanization": null
  },
  "3": {
    "text": "Kız kardeşinin grubunda davul çalıyor.",
    "romanization": null
  },
  "4": {
    "text": "Flüt çalmayı öğreniyorum.",
    "romanization": null
  },
  "5": {
    "text": "Yirmi yıl sonra tekrar trompet çalmaya başladı.",
    "romanization": null
  },
  "6": {
    "text": "Çello duvara yaslanmış.",
    "romanization": null
  },
  "7": {
    "text": "Akort etmek beklediğimden daha uzun sürdü.",
    "romanization": null
  },
  "8": {
    "text": "Hangi tel akortsuz?",
    "romanization": null
  },
  "9": {
    "text": "Yayın kıllarının yenilenmesi gerekiyor.",
    "romanization": null
  },
  "10": {
    "text": "İnternetten ikinci el bir klavye aldım.",
    "romanization": null
  },
  "11": {
    "text": "Kuyruklu piyanoya göre duvar piyanosunu tercih ediyor.",
    "romanization": null
  },
  "12": {
    "text": "Saksafon çantasını her yere taşıyor.",
    "romanization": null
  },
  "13": {
    "text": "Davulcu, diğer herkes gelmeden önce kurulumu yaptı.",
    "romanization": null
  },
  "14": {
    "text": "Ukulele, gitardan daha kolay başlanabilir bir enstrüman.",
    "romanization": null
  },
  "15": {
    "text": "Nota okuyabiliyor musun?",
    "romanization": null
  },
  "16": {
    "text": "Eser Sol Majör'de.",
    "romanization": null
  },
  "17": {
    "text": "Üç dört ölçüdeyiz.",
    "romanization": null
  },
  "18": {
    "text": "İlk notayı biraz daha yüksek sesle çal.",
    "romanization": null
  },
  "19": {
    "text": "Sus işareti de nota kadar önemli.",
    "romanization": null
  },
  "20": {
    "text": "Bemol ve diyezin ne olduğunu açıkladı.",
    "romanization": null
  },
  "21": {
    "text": "Akor geçişleri artık doğal geliyor.",
    "romanization": null
  },
  "22": {
    "text": "Gam, sadece art arda gelen notalardır.",
    "romanization": null
  },
  "23": {
    "text": "Aynı pasajı bir oktav daha pes çalmayı dene.",
    "romanization": null
  },
  "24": {
    "text": "Nefes alma yerlerini kenar boşluğuna işaretledi.",
    "romanization": null
  },
  "25": {
    "text": "Şef bize girişi saydırdı.",
    "romanization": null
  },
  "26": {
    "text": "Bu ölçü her seferinde beni zorluyor.",
    "romanization": null
  },
  "27": {
    "text": "Melodi basit ama akılda kalıcı.",
    "romanization": null
  },
  "28": {
    "text": "Müziği kulaktan yazmayı tercih ediyor.",
    "romanization": null
  },
  "29": {
    "text": "Çoğu şarkı sadece birkaç akor kullanır.",
    "romanization": null
  },
  "30": {
    "text": "Akşam yemeğinden sonra otuz dakika pratik yapıyorum.",
    "romanization": null
  },
  "31": {
    "text": "Parmakların ezberleyene kadar yavaş çal.",
    "romanization": null
  },
  "32": {
    "text": "Ritim tutmak için metronom kullanıyor.",
    "romanization": null
  },
  "33": {
    "text": "Kendini kaydedip sonra dinliyor.",
    "romanization": null
  },
  "34": {
    "text": "Zor pasajlardan önce ısın.",
    "romanization": null
  },
  "35": {
    "text": "Hatalar pratiğin bir parçasıdır.",
    "romanization": null
  },
  "36": {
    "text": "Küçük bölümlere ayırdım.",
    "romanization": null
  },
  "37": {
    "text": "Bugün beş dakika, gelecek hafta iki saatten daha iyidir.",
    "romanization": null
  },
  "38": {
    "text": "Ayna karşısında pratik yapıyor.",
    "romanization": null
  },
  "39": {
    "text": "Öğretmen bana yeni bir egzersiz verdi.",
    "romanization": null
  },
  "40": {
    "text": "Yavaş kısımları acele etme.",
    "romanization": null
  },
  "41": {
    "text": "Bazen gözleri kapalı çalar.",
    "romanization": null
  },
  "42": {
    "text": "En zor ölçü, atladığım ölçüydü.",
    "romanization": null
  },
  "43": {
    "text": "Üç gün ara verdikten sonra her zaman paslanmış olarak geri dönerim.",
    "romanization": null
  },
  "44": {
    "text": "Başlangıçtan çok sonu çalış.",
    "romanization": null
  },
  "45": {
    "text": "Resitalden önce ellerim titriyordu.",
    "romanization": null
  },
  "46": {
    "text": "Seyirciler eser bitmeden alkışladı.",
    "romanization": null
  },
  "47": {
    "text": "Selam verdi ve sahneden indi.",
    "romanization": null
  },
  "48": {
    "text": "Bir yeri unuttu ve doğaçlama yaparak durumu kurtardı.",
    "romanization": null
  },
  "49": {
    "text": "Işıklar kısılırken grup enstrümanlarını akort etti.",
    "romanization": null
  },
  "50": {
    "text": "Benim için sayfayı çevirir misin?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofon zillere çok yakın.",
    "romanization": null
  },
  "52": {
    "text": "Bir bis yaptık.",
    "romanization": null
  },
  "53": {
    "text": "Kalabalığa baktı ve gülümsedi.",
    "romanization": null
  },
  "54": {
    "text": "İlk konser her zaman en zorudur.",
    "romanization": null
  },
  "55": {
    "text": "Sahne korkusu asla tamamen geçmez.",
    "romanization": null
  },
  "56": {
    "text": "Kadans sırasında yayı neredeyse düşürüyordum.",
    "romanization": null
  },
  "57": {
    "text": "Halk önünde şarkı söylemek ayrı bir cesaret ister.",
    "romanization": null
  },
  "58": {
    "text": "Alkış şarkıdan daha uzun sürdü gibi geldi.",
    "romanization": null
  },
  "59": {
    "text": "Gösteriden sonra favori müzisyenimizle tanıştık.",
    "romanization": null
  },
  "60": {
    "text": "Ne tür müzik seversin?",
    "romanization": null
  },
  "61": {
    "text": "Annemin plaklarını dinleyerek büyüdüm.",
    "romanization": null
  },
  "62": {
    "text": "Yemek yaparken opera dinler.",
    "romanization": null
  },
  "63": {
    "text": "Şarkıyı şarkı yapan bas çizgisidir.",
    "romanization": null
  },
  "64": {
    "text": "Kayıtta odanın akustiğini duyabiliyorsun.",
    "romanization": null
  },
  "65": {
    "text": "Bu albüm plakta daha iyi geliyor.",
    "romanization": null
  },
  "66": {
    "text": "Gözlerini kapattı ve yaylıları dinledi.",
    "romanization": null
  },
  "67": {
    "text": "Piyano biraz akortsuz.",
    "romanization": null
  },
  "68": {
    "text": "Bu albüme dönüp dönüp duruyorum.",
    "romanization": null
  },
  "69": {
    "text": "Onu ilk duyduğumda ne yapıyorsam bıraktım.",
    "romanization": null
  },
  "70": {
    "text": "Her hafta farklı bir caz plağı öneriyor.",
    "romanization": null
  },
  "71": {
    "text": "Bu şarkı bana büyükbabamı hatırlatıyor.",
    "romanization": null
  },
  "72": {
    "text": "Melodinin altında sessiz bir armoni var.",
    "romanization": null
  },
  "73": {
    "text": "Canlı müzik kayıttan farklı gelir.",
    "romanization": null
  },
  "74": {
    "text": "Gece geç saatlerde kulaklık tercih ederim.",
    "romanization": null
  },
  "75": {
    "text": "Koro Çarşamba akşamları toplanıyor.",
    "romanization": null
  },
  "76": {
    "text": "Bas, tüm grubu bir arada tutar.",
    "romanization": null
  },
  "77": {
    "text": "Şef orkestrayı nazikçe başlattı.",
    "romanization": null
  },
  "78": {
    "text": "Aynı pasajı dört kez prova ettik.",
    "romanization": null
  },
  "79": {
    "text": "Yerel senfonide ikinci keman çalıyor.",
    "romanization": null
  },
  "80": {
    "text": "Kuartet dar bir yarım daire şeklinde oturdu.",
    "romanization": null
  },
  "81": {
    "text": "Davulcu tempoyu saydı.",
    "romanization": null
  },
  "82": {
    "text": "Armoni kısmını o söyledi.",
    "romanization": null
  },
  "83": {
    "text": "Bazen iki gitar ve bir ses yeterlidir.",
    "romanization": null
  },
  "84": {
    "text": "Koro şarkı söylemek için küçük bir kiliseye gitti.",
    "romanization": null
  },
  "85": {
    "text": "Vokalleri dolabında kaydetti.",
    "romanization": null
  },
  "86": {
    "text": "Girişi değiştirdiğinde kablo uğultusu kayboldu.",
    "romanization": null
  },
  "87": {
    "text": "O ses için farklı bir mikrofona ihtiyacın var.",
    "romanization": null
  },
  "88": {
    "text": "Bir sonraki daha kötü olursa diye her kaydı saklar.",
    "romanization": null
  },
  "89": {
    "text": "Mix ertesi sabah daha iyi geliyordu.",
    "romanization": null
  },
  "90": {
    "text": "Amfi ısındığında parlar.",
    "romanization": null
  },
  "91": {
    "text": "Eski bir dört kanallı teyp kaydedici kullanıyor.",
    "romanization": null
  },
  "92": {
    "text": "Aynı bölümün üç kaydını üst üste bindirdik.",
    "romanization": null
  },
  "93": {
    "text": "Reverb odayı çok büyük hissettirdi.",
    "romanization": null
  },
  "94": {
    "text": "Albümü mutfağında miksledi.",
    "romanization": null
  },
  "95": {
    "text": "Müzik, uzun yolculukları kısaltır.",
    "romanization": null
  },
  "96": {
    "text": "Bir şarkı, bir günün nasıl hissettirdiğini değiştirebilir.",
    "romanization": null
  },
  "97": {
    "text": "Bütün oda eşlik etti.",
    "romanization": null
  },
  "98": {
    "text": "Son akordan sonraki sessizlik müziğin bir parçasıdır.",
    "romanization": null
  },
  "99": {
    "text": "Herkese çalabileceğin bir şarkı öğren.",
    "romanization": null
  }
}