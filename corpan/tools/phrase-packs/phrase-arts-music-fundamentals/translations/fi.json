{
  "0": {
    "text": "Osaatko soittaa pianoa?",
    "romanization": null
  },
  "1": {
    "text": "Soitan viulua pienessä orkesterissa.",
    "romanization": null
  },
  "2": {
    "text": "Kitara tarvitsee uudet kielet.",
    "romanization": null
  },
  "3": {
    "text": "Hän soittaa rumpuja siskonsa bändissä.",
    "romanization": null
  },
  "4": {
    "text": "Olen opettelemassa huilunsoittoa.",
    "romanization": null
  },
  "5": {
    "text": "Hän tarttui trumpettiin uudelleen kahdenkymmenen vuoden jälkeen.",
    "romanization": null
  },
  "6": {
    "text": "Sello nojaa seinää vasten.",
    "romanization": null
  },
  "7": {
    "text": "Viritys kestää kauemmin kuin odotin.",
    "romanization": null
  },
  "8": {
    "text": "Mikä kieli on epävireessä?",
    "romanization": null
  },
  "9": {
    "text": "Jousi tarvitsee uudet jouhet.",
    "romanization": null
  },
  "10": {
    "text": "Ostin käytetyn kosketinsoittimen netistä.",
    "romanization": null
  },
  "11": {
    "text": "Hän pitää pystypianosta enemmän kuin flyygelistä.",
    "romanization": null
  },
  "12": {
    "text": "Hän kantaa saksofonikoteloaan kaikkialle.",
    "romanization": null
  },
  "13": {
    "text": "Rumpali pystytti soittimensa ennen kuin kaikki muut saapuivat.",
    "romanization": null
  },
  "14": {
    "text": "Ukulelella on helpompi aloittaa kuin kitaralla.",
    "romanization": null
  },
  "15": {
    "text": "Osaatko lukea nuotteja?",
    "romanization": null
  },
  "16": {
    "text": "Kappale on G-duurissa.",
    "romanization": null
  },
  "17": {
    "text": "Olemme kolme neljäsosa -tahtilajissa.",
    "romanization": null
  },
  "18": {
    "text": "Soita ensimmäinen nuotti vähän kovempaa.",
    "romanization": null
  },
  "19": {
    "text": "Tauko on yhtä tärkeä kuin nuotti.",
    "romanization": null
  },
  "20": {
    "text": "Hän selitti, mitä alennusmerkki ja ylennysmerkki ovat.",
    "romanization": null
  },
  "21": {
    "text": "Soinnunvaihdot tuntuvat nyt luonnollisilta.",
    "romanization": null
  },
  "22": {
    "text": "Skaala on vain nuotteja peräkkäin.",
    "romanization": null
  },
  "23": {
    "text": "Kokeile samaa kohtaa oktaavia alempaa.",
    "romanization": null
  },
  "24": {
    "text": "Hän merkitsi hengityskohdat marginaaliin.",
    "romanization": null
  },
  "25": {
    "text": "Kapellimestari laski meidät sisään.",
    "romanization": null
  },
  "26": {
    "text": "Tämä tahti tuottaa minulle vaikeuksia joka kerta.",
    "romanization": null
  },
  "27": {
    "text": "Melodia on yksinkertainen, mutta se jää mieleen.",
    "romanization": null
  },
  "28": {
    "text": "Hän säveltää mieluiten korvakuulolta.",
    "romanization": null
  },
  "29": {
    "text": "Useimmissa kappaleissa käytetään vain muutamaa sointua.",
    "romanization": null
  },
  "30": {
    "text": "Harjoittelen kolmekymmentä minuuttia illallisen jälkeen.",
    "romanization": null
  },
  "31": {
    "text": "Soita hitaasti, kunnes sormesi muistavat.",
    "romanization": null
  },
  "32": {
    "text": "Hän käyttää metronomia pysyäkseen tasaisena.",
    "romanization": null
  },
  "33": {
    "text": "Hän äänittää itsensä ja kuuntelee sen jälkeen.",
    "romanization": null
  },
  "34": {
    "text": "Lämmittele ennen vaikeita kohtia.",
    "romanization": null
  },
  "35": {
    "text": "Virheet ovat osa harjoittelua.",
    "romanization": null
  },
  "36": {
    "text": "Jaoin sen pieniin osiin.",
    "romanization": null
  },
  "37": {
    "text": "Viisi minuuttia tänään on parempi kuin kaksi tuntia ensi viikolla.",
    "romanization": null
  },
  "38": {
    "text": "Hän harjoittelee peilin edessä.",
    "romanization": null
  },
  "39": {
    "text": "Opettaja antoi minulle uuden harjoituksen.",
    "romanization": null
  },
  "40": {
    "text": "Älä kiirehdi hitaita osia.",
    "romanization": null
  },
  "41": {
    "text": "Hän soittaa joskus silmät kiinni.",
    "romanization": null
  },
  "42": {
    "text": "Vaikein tahti on se, jonka ohitin.",
    "romanization": null
  },
  "43": {
    "text": "Kolmen vapaapäivän jälkeen olen aina ruosteessa.",
    "romanization": null
  },
  "44": {
    "text": "Harjoittele loppua enemmän kuin alkua.",
    "romanization": null
  },
  "45": {
    "text": "Käteni tärisivät ennen konserttia.",
    "romanization": null
  },
  "46": {
    "text": "Yleisö taputti ennen kuin kappale oli ohi.",
    "romanization": null
  },
  "47": {
    "text": "Hän kumarsi ja käveli pois lavalta.",
    "romanization": null
  },
  "48": {
    "text": "Hän unohti kohdan ja improvisoi sen läpi.",
    "romanization": null
  },
  "49": {
    "text": "Bändi viritti soittimensa, kun valot himmenivät.",
    "romanization": null
  },
  "50": {
    "text": "Voisitko kääntää sivua puolestani?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofoni on liian lähellä symbaaleja.",
    "romanization": null
  },
  "52": {
    "text": "Soitimme encorea.",
    "romanization": null
  },
  "53": {
    "text": "Hän katsoi yleisöön ja hymyili.",
    "romanization": null
  },
  "54": {
    "text": "Ensimmäinen konsertti on aina vaikein.",
    "romanization": null
  },
  "55": {
    "text": "Ramppikuume ei koskaan katoa kokonaan.",
    "romanization": null
  },
  "56": {
    "text": "Melkein pudotin jousen kadenssin aikana.",
    "romanization": null
  },
  "57": {
    "text": "Julkisesti laulaminen on omaa rohkeuttaan.",
    "romanization": null
  },
  "58": {
    "text": "Aplodit tuntuivat pidemmiltä kuin itse kappale.",
    "romanization": null
  },
  "59": {
    "text": "Tapasimme suosikkimuusikkomme esityksen jälkeen.",
    "romanization": null
  },
  "60": {
    "text": "Millaisesta musiikista pidät?",
    "romanization": null
  },
  "61": {
    "text": "Kasvoin kuunnellen äitini levyjä.",
    "romanization": null
  },
  "62": {
    "text": "Hän kuuntelee oopperaa kokkaillessaan.",
    "romanization": null
  },
  "63": {
    "text": "Bassolinja tekee kappaleesta sen, mikä se on.",
    "romanization": null
  },
  "64": {
    "text": "Äänityksessä voi kuulla tilan.",
    "romanization": null
  },
  "65": {
    "text": "Tämä albumi kuulostaa paremmalta vinyylillä.",
    "romanization": null
  },
  "66": {
    "text": "Hän sulki silmänsä ja kuunteli jousia.",
    "romanization": null
  },
  "67": {
    "text": "Piano on hieman epävireessä.",
    "romanization": null
  },
  "68": {
    "text": "Palaan tähän albumiin yhä uudelleen.",
    "romanization": null
  },
  "69": {
    "text": "Kun kuulin sen ensimmäisen kerran, lopetin sen, mitä olin tekemässä.",
    "romanization": null
  },
  "70": {
    "text": "Hän suosittelee eri jazzlevyä joka viikko.",
    "romanization": null
  },
  "71": {
    "text": "Kappale muistuttaa minua isoisästäni.",
    "romanization": null
  },
  "72": {
    "text": "Melodian alla on hiljainen harmonia.",
    "romanization": null
  },
  "73": {
    "text": "Elävä musiikki kuulostaa erilaiselta kuin äänitys.",
    "romanization": null
  },
  "74": {
    "text": "Suosin kuulokkeita myöhään illalla.",
    "romanization": null
  },
  "75": {
    "text": "Kuoro kokoontuu keskiviikkoiltaisin.",
    "romanization": null
  },
  "76": {
    "text": "Basso pitää koko bändin kasassa.",
    "romanization": null
  },
  "77": {
    "text": "Kapellimestari toi orkesterin mukaan varovasti.",
    "romanization": null
  },
  "78": {
    "text": "Harjoittelimme samaa kohtaa neljä kertaa.",
    "romanization": null
  },
  "79": {
    "text": "Hän soittaa toista viulua paikallisessa sinfoniaorkesterissa.",
    "romanization": null
  },
  "80": {
    "text": "Kvartetti istui tiiviissä puolikaaressa.",
    "romanization": null
  },
  "81": {
    "text": "Rumpali laski tempon sisään.",
    "romanization": null
  },
  "82": {
    "text": "Hän lauloi stemman.",
    "romanization": null
  },
  "83": {
    "text": "Kaksi kitaraa ja ääni riittävät joskus.",
    "romanization": null
  },
  "84": {
    "text": "Kuoro matkusti pieneen kirkkoon laulamaan.",
    "romanization": null
  },
  "85": {
    "text": "Hän äänitti lauluraidat vaatekaapissaan.",
    "romanization": null
  },
  "86": {
    "text": "Kaapelin hurina katosi, kun hän vaihtoi sisääntulon.",
    "romanization": null
  },
  "87": {
    "text": "Tarvitset erilaisen mikrofonin tuolle äänelle.",
    "romanization": null
  },
  "88": {
    "text": "Hän tallentaa jokaisen oton siltä varalta, että seuraava on huonompi.",
    "romanization": null
  },
  "89": {
    "text": "Miksaus kuulosti paremmalta seuraavana aamuna.",
    "romanization": null
  },
  "90": {
    "text": "Vahvistin hehkuu, kun se lämpenee.",
    "romanization": null
  },
  "91": {
    "text": "Hän käyttää vanhaa neliraitaista nauhuria.",
    "romanization": null
  },
  "92": {
    "text": "Kerrostimme kolme ottoa samasta kohdasta.",
    "romanization": null
  },
  "93": {
    "text": "Kaiku sai huoneen tuntumaan valtavalta.",
    "romanization": null
  },
  "94": {
    "text": "Hän miksasi albumin keittiössään.",
    "romanization": null
  },
  "95": {
    "text": "Musiikki tekee pitkästä ajomatkasta lyhyemmän.",
    "romanization": null
  },
  "96": {
    "text": "Kappale voi muuttaa päivän tunnelmaa.",
    "romanization": null
  },
  "97": {
    "text": "Koko huone lauloi mukana.",
    "romanization": null
  },
  "98": {
    "text": "Hiljaisuus viimeisen soinnun jälkeen on osa musiikkia.",
    "romanization": null
  },
  "99": {
    "text": "Opettele yksi kappale, jonka voit soittaa kenelle tahansa.",
    "romanization": null
  }
}