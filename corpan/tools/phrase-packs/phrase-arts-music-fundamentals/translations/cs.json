{
  "0": {
    "text": "Umíš hrát na klavír?",
    "romanization": null
  },
  "1": {
    "text": "Hraju na housle v malém orchestru.",
    "romanization": null
  },
  "2": {
    "text": "Kytara potřebuje nové struny.",
    "romanization": null
  },
  "3": {
    "text": "Hraje na bicí v kapele své sestry.",
    "romanization": null
  },
  "4": {
    "text": "Učím se hrát na flétnu.",
    "romanization": null
  },
  "5": {
    "text": "Po dvaceti letech se zase vrátil k trubce.",
    "romanization": null
  },
  "6": {
    "text": "Violoncello je opřené o zeď.",
    "romanization": null
  },
  "7": {
    "text": "Ladění trvá déle, než jsem čekal/čekala.",
    "romanization": null
  },
  "8": {
    "text": "Která struna je rozladěná?",
    "romanization": null
  },
  "9": {
    "text": "Smyčec potřebuje nové žíně.",
    "romanization": null
  },
  "10": {
    "text": "Koupil/koupila jsem si online použitý keyboard.",
    "romanization": null
  },
  "11": {
    "text": "Dává přednost pianinu před křídlem.",
    "romanization": null
  },
  "12": {
    "text": "Všude s sebou nosí pouzdro na saxofon.",
    "romanization": null
  },
  "13": {
    "text": "Bubeník si postavil soupravu dřív, než dorazili ostatní.",
    "romanization": null
  },
  "14": {
    "text": "Ukulele je na začátek snazší než kytara.",
    "romanization": null
  },
  "15": {
    "text": "Umíš číst noty?",
    "romanization": null
  },
  "16": {
    "text": "Skladba je v G dur.",
    "romanization": null
  },
  "17": {
    "text": "Jsme ve tříčtvrtečním taktu.",
    "romanization": null
  },
  "18": {
    "text": "Zahraj první notu trochu hlasitěji.",
    "romanization": null
  },
  "19": {
    "text": "Pomlka je stejně důležitá jako nota.",
    "romanization": null
  },
  "20": {
    "text": "Vysvětlil, co je béčko a křížek.",
    "romanization": null
  },
  "21": {
    "text": "Střídání akordů už mi teď přijde přirozené.",
    "romanization": null
  },
  "22": {
    "text": "Stupnice jsou jen noty za sebou.",
    "romanization": null
  },
  "23": {
    "text": "Zkus stejnou pasáž o oktávu níž.",
    "romanization": null
  },
  "24": {
    "text": "Do okraje si poznamenala místa pro nádech.",
    "romanization": null
  },
  "25": {
    "text": "Dirigent nám udával nástup.",
    "romanization": null
  },
  "26": {
    "text": "Tenhle takt mi dělá pokaždé potíže.",
    "romanization": null
  },
  "27": {
    "text": "Melodie je jednoduchá, ale zůstane ti v hlavě.",
    "romanization": null
  },
  "28": {
    "text": "Raději skládá hudbu podle sluchu.",
    "romanization": null
  },
  "29": {
    "text": "Většina písní používá jen pár akordů.",
    "romanization": null
  },
  "30": {
    "text": "Cvičím třicet minut po večeři.",
    "romanization": null
  },
  "31": {
    "text": "Hraj to pomalu, dokud si to prsty nezapamatují.",
    "romanization": null
  },
  "32": {
    "text": "Používá metronom, aby udržela tempo.",
    "romanization": null
  },
  "33": {
    "text": "Nahrává se a pak si to poslechne.",
    "romanization": null
  },
  "34": {
    "text": "Rozehřej se před obtížnými pasážemi.",
    "romanization": null
  },
  "35": {
    "text": "Chyby jsou součástí cvičení.",
    "romanization": null
  },
  "36": {
    "text": "Rozdělil/rozdělila jsem si to na malé úseky.",
    "romanization": null
  },
  "37": {
    "text": "Pět minut dnes je lepší než dvě hodiny příští týden.",
    "romanization": null
  },
  "38": {
    "text": "Cvičí před zrcadlem.",
    "romanization": null
  },
  "39": {
    "text": "Učitel/učitelka mi dal/dala nové cvičení.",
    "romanization": null
  },
  "40": {
    "text": "Nespěchej na pomalé části.",
    "romanization": null
  },
  "41": {
    "text": "Někdy hraje se zavřenýma očima.",
    "romanization": null
  },
  "42": {
    "text": "Nejtěžší takt je ten, který jsem přeskočil/přeskočila.",
    "romanization": null
  },
  "43": {
    "text": "Po třech dnech volna jsem vždycky zrezivělý/zrezivělá.",
    "romanization": null
  },
  "44": {
    "text": "Cvič konec víc než začátek.",
    "romanization": null
  },
  "45": {
    "text": "Před recitálem se mi třásly ruce.",
    "romanization": null
  },
  "46": {
    "text": "Publikum tleskalo, než skladba skončila.",
    "romanization": null
  },
  "47": {
    "text": "Uklonila se a odešla z pódia.",
    "romanization": null
  },
  "48": {
    "text": "Zapomněl text a improvizoval.",
    "romanization": null
  },
  "49": {
    "text": "Kapela se ladila, zatímco se stmívalo.",
    "romanization": null
  },
  "50": {
    "text": "Mohl/mohla bys mi otočit stránku?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofon je moc blízko činelům.",
    "romanization": null
  },
  "52": {
    "text": "Hráli jsme přídavek.",
    "romanization": null
  },
  "53": {
    "text": "Podíval se do davu a usměl se.",
    "romanization": null
  },
  "54": {
    "text": "První koncert je vždycky nejtěžší.",
    "romanization": null
  },
  "55": {
    "text": "Tréma nikdy úplně nezmizí.",
    "romanization": null
  },
  "56": {
    "text": "Během kadence jsem málem upustil/upustila smyčec.",
    "romanization": null
  },
  "57": {
    "text": "Zpívání na veřejnosti je svým způsobem odvaha.",
    "romanization": null
  },
  "58": {
    "text": "Potlesk se zdál delší než píseň.",
    "romanization": null
  },
  "59": {
    "text": "Po koncertě jsme potkali našeho oblíbeného hudebníka.",
    "romanization": null
  },
  "60": {
    "text": "Jakou hudbu máš rád/ráda?",
    "romanization": null
  },
  "61": {
    "text": "Vyrostl/vyrostla jsem na deskách mé matky.",
    "romanization": null
  },
  "62": {
    "text": "Poslouchá operu, když vaří.",
    "romanization": null
  },
  "63": {
    "text": "Basová linka je to, co dělá tu píseň.",
    "romanization": null
  },
  "64": {
    "text": "Na nahrávce slyšíš prostor místnosti.",
    "romanization": null
  },
  "65": {
    "text": "Tohle album zní lépe na vinylu.",
    "romanization": null
  },
  "66": {
    "text": "Zavřela oči a poslouchala smyčce.",
    "romanization": null
  },
  "67": {
    "text": "Klavír je trochu rozladěný.",
    "romanization": null
  },
  "68": {
    "text": "K tomuto albu se neustále vracím.",
    "romanization": null
  },
  "69": {
    "text": "Poprvé, když jsem to slyšel/slyšela, jsem přestal/přestala dělat, co jsem dělal/dělala.",
    "romanization": null
  },
  "70": {
    "text": "Každý týden doporučuje jinou jazzovou desku.",
    "romanization": null
  },
  "71": {
    "text": "Ta píseň mi připomíná mého dědečka.",
    "romanization": null
  },
  "72": {
    "text": "Pod melodií je tichá harmonie.",
    "romanization": null
  },
  "73": {
    "text": "Živá hudba zní jinak než nahrávka.",
    "romanization": null
  },
  "74": {
    "text": "Pozdě v noci dávám přednost sluchátkům.",
    "romanization": null
  },
  "75": {
    "text": "Sbor se schází ve středu večer.",
    "romanization": null
  },
  "76": {
    "text": "Basa drží celou kapelu pohromadě.",
    "romanization": null
  },
  "77": {
    "text": "Dirigent jemně uvedl orchestr.",
    "romanization": null
  },
  "78": {
    "text": "Zkoušeli jsme stejnou pasáž čtyřikrát.",
    "romanization": null
  },
  "79": {
    "text": "Hraje druhé housle v místní filharmonii.",
    "romanization": null
  },
  "80": {
    "text": "Kvarteto sedělo v těsném půlkruhu.",
    "romanization": null
  },
  "81": {
    "text": "Bubeník udával tempo.",
    "romanization": null
  },
  "82": {
    "text": "Zpívala harmonický part.",
    "romanization": null
  },
  "83": {
    "text": "Dvě kytary a hlas někdy stačí.",
    "romanization": null
  },
  "84": {
    "text": "Sbor cestoval do malého kostela, aby tam zpíval.",
    "romanization": null
  },
  "85": {
    "text": "Nazpíval vokály ve skříni.",
    "romanization": null
  },
  "86": {
    "text": "Brnění kabelu zmizelo, když změnila vstup.",
    "romanization": null
  },
  "87": {
    "text": "Na ten hlas potřebuješ jiný mikrofon.",
    "romanization": null
  },
  "88": {
    "text": "Ukládá každý záběr pro případ, že by další byl horší.",
    "romanization": null
  },
  "89": {
    "text": "Mix zněl lépe následující ráno.",
    "romanization": null
  },
  "90": {
    "text": "Zesilovač žhne, když se zahřeje.",
    "romanization": null
  },
  "91": {
    "text": "Používá starý čtyřstopý magnetofon.",
    "romanization": null
  },
  "92": {
    "text": "Vrstvili jsme tři nahrávky stejné linky.",
    "romanization": null
  },
  "93": {
    "text": "Reverb způsobil, že místnost zněla obrovsky.",
    "romanization": null
  },
  "94": {
    "text": "Album smíchala ve své kuchyni.",
    "romanization": null
  },
  "95": {
    "text": "Hudba zkracuje dlouhou jízdu.",
    "romanization": null
  },
  "96": {
    "text": "Píseň dokáže změnit, jaký je den.",
    "romanization": null
  },
  "97": {
    "text": "Celá místnost zpívala s námi.",
    "romanization": null
  },
  "98": {
    "text": "Ticho po posledním akordu je součástí hudby.",
    "romanization": null
  },
  "99": {
    "text": "Nauč se jednu píseň, kterou můžeš zahrát komukoli.",
    "romanization": null
  }
