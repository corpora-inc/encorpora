{
  "0": {
    "text": "Vieš hrať na klavíri?",
    "romanization": null
  },
  "1": {
    "text": "Hrám na husliach v malom orchestri.",
    "romanization": null
  },
  "2": {
    "text": "Gitara potrebuje nové struny.",
    "romanization": null
  },
  "3": {
    "text": "Hrá na bicích v kapele svojej sestry.",
    "romanization": null
  },
  "4": {
    "text": "Učím sa hrať na flaute.",
    "romanization": null
  },
  "5": {
    "text": "Po dvadsiatich rokoch sa opäť chytil trúbky.",
    "romanization": null
  },
  "6": {
    "text": "Violončelo je opreté o stenu.",
    "romanization": null
  },
  "7": {
    "text": "Ladenie trvá dlhšie, než som čakal/a.",
    "romanization": null
  },
  "8": {
    "text": "Ktorá struna je rozladená?",
    "romanization": null
  },
  "9": {
    "text": "Sláčik potrebuje nové vlasy.",
    "romanization": null
  },
  "10": {
    "text": "Kúpil/a som si z druhej ruky klávesy online.",
    "romanization": null
  },
  "11": {
    "text": "Uprednostňuje pianíno pred krídlom.",
    "romanization": null
  },
  "12": {
    "text": "Všade nosí puzdro na saxofón.",
    "romanization": null
  },
  "13": {
    "text": "Bubeník sa pripravil skôr, než prišli ostatní.",
    "romanization": null
  },
  "14": {
    "text": "Ukulele je na začiatok ľahšie ako gitara.",
    "romanization": null
  },
  "15": {
    "text": "Vieš čítať noty?",
    "romanization": null
  },
  "16": {
    "text": "Skladba je v G dur.",
    "romanization": null
  },
  "17": {
    "text": "Sme v trojštvrťovom takte.",
    "romanization": null
  },
  "18": {
    "text": "Zahraj prvú notu trochu hlasnejšie.",
    "romanization": null
  },
  "19": {
    "text": "Pomlka je rovnako dôležitá ako nota.",
    "romanization": null
  },
  "20": {
    "text": "Vysvetlil, čo je béčko a krížik.",
    "romanization": null
  },
  "21": {
    "text": "Prechody medzi akordmi mi už prídu prirodzené.",
    "romanization": null
  },
  "22": {
    "text": "Stupnica sú len noty za sebou.",
    "romanization": null
  },
  "23": {
    "text": "Skús tú istú pasáž o oktávu nižšie.",
    "romanization": null
  },
  "24": {
    "text": "Označila si dychy na okraji.",
    "romanization": null
  },
  "25": {
    "text": "Dirigent nám udával nástup.",
    "romanization": null
  },
  "26": {
    "text": "Tento takt mi robí problémy zakaždým.",
    "romanization": null
  },
  "27": {
    "text": "Melódia je jednoduchá, ale zostane ti v hlave.",
    "romanization": null
  },
  "28": {
    "text": "Radšej skladá hudbu podľa sluchu.",
    "romanization": null
  },
  "29": {
    "text": "Väčšina piesní používa len pár akordov.",
    "romanization": null
  },
  "30": {
    "text": "Cvičím tridsať minút po večeri.",
    "romanization": null
  },
  "31": {
    "text": "Hraj to pomaly, kým si to prsty nezapamätajú.",
    "romanization": null
  },
  "32": {
    "text": "Používa metronóm, aby udržala tempo.",
    "romanization": null
  },
  "33": {
    "text": "Nahráva sa a potom si to vypočuje.",
    "romanization": null
  },
  "34": {
    "text": "Rozcvič sa pred ťažkými pasážami.",
    "romanization": null
  },
  "35": {
    "text": "Chyby sú súčasťou cvičenia.",
    "romanization": null
  },
  "36": {
    "text": "Rozdelil/a som si to na malé časti.",
    "romanization": null
  },
  "37": {
    "text": "Päť minút dnes je lepšie ako dve hodiny budúci týždeň.",
    "romanization": null
  },
  "38": {
    "text": "Cvičí pred zrkadlom.",
    "romanization": null
  },
  "39": {
    "text": "Učiteľ/ka mi dal/a nové cvičenie.",
    "romanization": null
  },
  "40": {
    "text": "Neponáhľaj sa v pomalých častiach.",
    "romanization": null
  },
  "41": {
    "text": "Niekedy hrá so zatvorenými očami.",
    "romanization": null
  },
  "42": {
    "text": "Najzapeklitejší takt je ten, ktorý som preskočil/a.",
    "romanization": null
  },
  "43": {
    "text": "Po troch dňoch voľna som vždy hrdzavý/á.",
    "romanization": null
  },
  "44": {
    "text": "Cvič koniec viac ako začiatok.",
    "romanization": null
  },
  "45": {
    "text": "Pred vystúpením sa mi triasli ruky.",
    "romanization": null
  },
  "46": {
    "text": "Publikum tlieskalo skôr, než skladba skončila.",
    "romanization": null
  },
  "47": {
    "text": "Uklonila sa a odišla z pódia.",
    "romanization": null
  },
  "48": {
    "text": "Zabudol text a improvizoval.",
    "romanization": null
  },
  "49": {
    "text": "Kapela sa ladila, kým sa stlmili svetlá.",
    "romanization": null
  },
  "50": {
    "text": "Mohol/mohla by si mi otočiť stranu?",
    "romanization": null
  },
  "51": {
    "text": "Mikrofón je príliš blízko činelov.",
    "romanization": null
  },
  "52": {
    "text": "Zahrali sme prídavok.",
    "romanization": null
  },
  "53": {
    "text": "Pozrel sa do davu a usmial sa.",
    "romanization": null
  },
  "54": {
    "text": "Prvý koncert je vždy najťažší.",
    "romanization": null
  },
  "55": {
    "text": "Tréma nikdy celkom nezmizne.",
    "romanization": null
  },
  "56": {
    "text": "Počas kadencie som skoro pustil/a sláčik.",
    "romanization": null
  },
  "57": {
    "text": "Spievanie na verejnosti je svojím spôsobom odvaha.",
    "romanization": null
  },
  "58": {
    "text": "Potlesk sa zdal dlhší ako pieseň.",
    "romanization": null
  },
  "59": {
    "text": "Po koncerte sme stretli nášho obľúbeného hudobníka.",
    "romanization": null
  },
  "60": {
    "text": "Akú hudbu máš rád/rada?",
    "romanization": null
  },
  "61": {
    "text": "Vyrastal/a som na platniach mojej mamy.",
    "romanization": null
  },
  "62": {
    "text": "Počúva operu, keď varí.",
    "romanization": null
  },
  "63": {
    "text": "Basová linka robí tú pieseň.",
    "romanization": null
  },
  "64": {
    "text": "Na nahrávke počuť priestor.",
    "romanization": null
  },
  "65": {
    "text": "Tento album znie lepšie na vinyle.",
    "romanization": null
  },
  "66": {
    "text": "Zavrela oči a počúvala struny.",
    "romanization": null
  },
  "67": {
    "text": "Klavír je trochu rozladený.",
    "romanization": null
  },
  "68": {
    "text": "K tomuto albumu sa stále vraciam.",
    "romanization": null
  },
  "69": {
    "text": "Keď som to počul/a prvýkrát, prestal/a som s tým, čo som robil/a.",
    "romanization": null
  },
  "70": {
    "text": "Každý týždeň odporúča inú jazzovú platňu.",
    "romanization": null
  },
  "71": {
    "text": "Táto pieseň mi pripomína môjho starého otca.",
    "romanization": null
  },
  "72": {
    "text": "Pod melódiou je tichá harmónia.",
    "romanization": null
  },
  "73": {
    "text": "Živá hudba znie inak ako nahrávka.",
    "romanization": null
  },
  "74": {
    "text": "Neskoro v noci uprednostňujem slúchadlá.",
    "romanization": null
  },
  "75": {
    "text": "Zbor sa stretáva v stredu večer.",
    "romanization": null
  },
  "76": {
    "text": "Basa drží celú kapelu pokope.",
    "romanization": null
  },
  "77": {
    "text": "Dirigent jemne uviedol orchester.",
    "romanization": null
  },
  "78": {
    "text": "Tú istú pasáž sme nacvičovali štyrikrát.",
    "romanization": null
  },
  "79": {
    "text": "Hrá druhé husle v miestnej filharmónii.",
    "romanization": null
  },
  "80": {
    "text": "Kvarteto sedelo v tesnom polkruhu.",
    "romanization": null
  },
  "81": {
    "text": "Bubeník udával tempo.",
    "romanization": null
  },
  "82": {
    "text": "Spievala harmonický part.",
    "romanization": null
  },
  "83": {
    "text": "Dve gitary a hlas niekedy stačia.",
    "romanization": null
  },
  "84": {
    "text": "Zbor cestoval do malého kostola spievať.",
    "romanization": null
  },
  "85": {
    "text": "Nahral vokály v skrini.",
    "romanization": null
  },
  "86": {
    "text": "Bzučanie kábla zmizlo, keď zmenila vstup.",
    "romanization": null
  },
  "87": {
    "text": "Na ten hlas potrebuješ iný mikrofón.",
    "romanization": null
  },
  "88": {
    "text": "Ukladá si každý záber pre prípad, že by ďalší bol horší.",
    "romanization": null
  },
  "89": {
    "text": "Mix znel lepšie na druhý deň ráno.",
    "romanization": null
  },
  "90": {
    "text": "Zosilňovač svieti, keď sa zohreje.",
    "romanization": null
  },
  "91": {
    "text": "Používa starý štvorstopový magnetofón.",
    "romanization": null
  },
  "92": {
    "text": "Vrstvili sme tri zábery tej istej linky.",
    "romanization": null
  },
  "93": {
    "text": "Reverb spôsobil, že miestnosť znela obrovsky.",
    "romanization": null
  },
  "94": {
    "text": "Album zmiešala v kuchyni.",
    "romanization": null
  },
  "95": {
    "text": "Hudba skracuje dlhú cestu.",
    "romanization": null
  },
  "96": {
    "text": "Pieseň dokáže zmeniť, ako sa cítiš počas dňa.",
    "romanization": null
  },
  "97": {
    "text": "Celá miestnosť spievala spolu.",
    "romanization": null
  },
  "98": {
    "text": "Ticho po poslednom akorde je súčasťou hudby.",
    "romanization": null
  },
  "99": {
    "text": "Nauč sa jednu pieseň, ktorú môžeš zahrať komukoľvek.",
    "romanization": null
  }
}