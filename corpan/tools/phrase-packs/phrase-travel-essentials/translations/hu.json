{
  "0": {
    "text": "Merre van a mosdó?",
    "romanization": null
  },
  "1": {
    "text": "Mennyibe kerül?",
    "romanization": null
  },
  "2": {
    "text": "Elnézést, beszél angolul?",
    "romanization": null
  },
  "3": {
    "text": "Még nem beszélem túl jól a nyelvet.",
    "romanization": null
  },
  "4": {
    "text": "El tudná mondani lassabban?",
    "romanization": null
  },
  "5": {
    "text": "Hol tudok jegyet venni?",
    "romanization": null
  },
  "6": {
    "text": "Foglalt ez a hely?",
    "romanization": null
  },
  "7": {
    "text": "Szeretnék egy egyágyas szobát két éjszakára.",
    "romanization": null
  },
  "8": {
    "text": "Van tengerre néző szobájuk?",
    "romanization": null
  },
  "9": {
    "text": "Hány órától szolgálják fel a reggelit?",
    "romanization": null
  },
  "10": {
    "text": "Megnézhetném az étlapot, kérem?",
    "romanization": null
  },
  "11": {
    "text": "Vegetáriánus vagyok.",
    "romanization": null
  },
  "12": {
    "text": "Allergiás vagyok a földimogyoróra.",
    "romanization": null
  },
  "13": {
    "text": "Iható a csapvíz?",
    "romanization": null
  },
  "14": {
    "text": "Kérhetnénk a számlát?",
    "romanization": null
  },
  "15": {
    "text": "Benne van a szervizdíj?",
    "romanization": null
  },
  "16": {
    "text": "Fizethetek kártyával?",
    "romanization": null
  },
  "17": {
    "text": "Elfogadnak készpénzt?",
    "romanization": null
  },
  "18": {
    "text": "Kaphatnék nyugtát?",
    "romanization": null
  },
  "19": {
    "text": "Tartsa meg az aprót.",
    "romanization": null
  },
  "20": {
    "text": "Melyik vágányról indul a vonat?",
    "romanization": null
  },
  "21": {
    "text": "Késik a járat?",
    "romanization": null
  },
  "22": {
    "text": "Lekéstem a csatlakozásomat.",
    "romanization": null
  },
  "23": {
    "text": "Merre van a poggyászfelvétel?",
    "romanization": null
  },
  "24": {
    "text": "Nem érkezett meg a bőröndöm.",
    "romanization": null
  },
  "25": {
    "text": "Tudna hívni nekem egy taxit?",
    "romanization": null
  },
  "26": {
    "text": "Mennyi ideig tart az út?",
    "romanization": null
  },
  "27": {
    "text": "Kérem, vigyen erre a címre.",
    "romanization": null
  },
  "28": {
    "text": "Meg tudna állni a saroknál?",
    "romanization": null
  },
  "29": {
    "text": "Van a közelben metróállomás?",
    "romanization": null
  },
  "30": {
    "text": "Csak nézelődöm, köszönöm.",
    "romanization": null
  },
  "31": {
    "text": "Van ebből kisebb méret?",
    "romanization": null
  },
  "32": {
    "text": "Felpróbálhatom?",
    "romanization": null
  },
  "33": {
    "text": "Merre van a próbafülke?",
    "romanization": null
  },
  "34": {
    "text": "Ez akciós?",
    "romanization": null
  },
  "35": {
    "text": "Kaphatok kedvezményt, ha készpénzzel fizetek?",
    "romanization": null
  },
  "36": {
    "text": "Ez kézzel készült vagy gyári?",
    "romanization": null
  },
  "37": {
    "text": "Ezt kérem.",
    "romanization": null
  },
  "38": {
    "text": "Be tudná csomagolni ajándéknak?",
    "romanization": null
  },
  "39": {
    "text": "Mennyi ideig érvényes a garancia?",
    "romanization": null
  },
  "40": {
    "text": "Orvoshoz kell mennem.",
    "romanization": null
  },
  "41": {
    "text": "Fáj a fejem.",
    "romanization": null
  },
  "42": {
    "text": "Hol van a legközelebbi gyógyszertár?",
    "romanization": null
  },
  "43": {
    "text": "Kell ehhez recept?",
    "romanization": null
  },
  "44": {
    "text": "Elvesztettem az útlevelemet.",
    "romanization": null
  },
  "45": {
    "text": "Merre van a rendőrőrs?",
    "romanization": null
  },
  "46": {
    "text": "Tudna segíteni, kérem?",
    "romanization": null
  },
  "47": {
    "text": "Azt hiszem, a taxiban hagytam a táskámat.",
    "romanization": null
  },
  "48": {
    "text": "Kérem, hívjon mentőt.",
    "romanization": null
  },
  "49": {
    "text": "Van kórház a közelben?",
    "romanization": null
  },
  "50": {
    "text": "Tudna ajánlani egy jó éttermet a környéken?",
    "romanization": null
  },
  "51": {
    "text": "Mi a helyi specialitás?",
    "romanization": null
  },
  "52": {
    "text": "Szeretnék megkóstolni valami hagyományosat.",
    "romanization": null
  },
  "53": {
    "text": "Csípős?",
    "romanization": null
  },
  "54": {
    "text": "Kiülhetnénk?",
    "romanization": null
  },
  "55": {
    "text": "Nem sietünk.",
    "romanization": null
  },
  "56": {
    "text": "Nagyon finom volt az étel, köszönjük.",
    "romanization": null
  },
  "57": {
    "text": "Kaphatnék egy pohár vizet jég nélkül?",
    "romanization": null
  },
  "58": {
    "text": "Van ebben az ételben tengeri herkentyű?",
    "romanization": null
  },
  "59": {
    "text": "Elvihetném ezt?",
    "romanization": null
  },
  "60": {
    "text": "Mikor vannak nyitva?",
    "romanization": null
  },
  "61": {
    "text": "Bent szabad fényképezni?",
    "romanization": null
  },
  "62": {
    "text": "Van angol nyelvű vezetett túra?",
    "romanization": null
  },
  "63": {
    "text": "Vasárnap ingyenes a múzeum?",
    "romanization": null
  },
  "64": {
    "text": "Mennyivel korábban érdemes érkeznem?",
    "romanization": null
  },
  "65": {
    "text": "Olcsóbbak a jegyek online?",
    "romanization": null
  },
  "66": {
    "text": "Ezekkel a jegyekkel soron kívül bemehetünk?",
    "romanization": null
  },
  "67": {
    "text": "Mit nem érdemes kihagyni, amíg itt vagyok?",
    "romanization": null
  },
  "68": {
    "text": "Készítene rólunk egy képet?",
    "romanization": null
  },
  "69": {
    "text": "Biztonságos este sétálni a környéken?",
    "romanization": null
  },
  "70": {
    "text": "Nyaralni vagyok itt.",
    "romanization": null
  },
  "71": {
    "text": "Munka miatt vagyok itt.",
    "romanization": null
  },
  "72": {
    "text": "Egy hétig maradok.",
    "romanization": null
  },
  "73": {
    "text": "Most járok először ebben az országban.",
    "romanization": null
  },
  "74": {
    "text": "Hová menne ebédelni egy helyi a környéken?",
    "romanization": null
  },
  "75": {
    "text": "Mi volt a legszebb hely, ahol valaha járt?",
    "romanization": null
  },
  "76": {
    "text": "Hosszú volt a repülőút, de a kilátás megérte.",
    "romanization": null
  },
  "77": {
    "text": "Próbálok megtanulni néhány szót az önök nyelvén.",
    "romanization": null
  },
  "78": {
    "text": "Szép estét, és köszönök mindent.",
    "romanization": null
  },
  "79": {
    "text": "Nagyon szívesen visszajönnék ide egyszer.",
    "romanization": null
  }
}