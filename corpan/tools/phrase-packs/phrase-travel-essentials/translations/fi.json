{
  "0": {
    "text": "Missä vessa on?",
    "romanization": null
  },
  "1": {
    "text": "Paljonko se maksaa?",
    "romanization": null
  },
  "2": {
    "text": "Anteeksi, puhutteko englantia?",
    "romanization": null
  },
  "3": {
    "text": "En puhu kieltä vielä kovin hyvin.",
    "romanization": null
  },
  "4": {
    "text": "Voisitko sanoa sen hitaammin?",
    "romanization": null
  },
  "5": {
    "text": "Mistä voin ostaa lipun?",
    "romanization": null
  },
  "6": {
    "text": "Onko tämä paikka varattu?",
    "romanization": null
  },
  "7": {
    "text": "Haluaisin yhden hengen huoneen kahdeksi yöksi.",
    "romanization": null
  },
  "8": {
    "text": "Onko teillä huonetta merinäköalalla?",
    "romanization": null
  },
  "9": {
    "text": "Mihin aikaan aamiainen tarjoillaan?",
    "romanization": null
  },
  "10": {
    "text": "Saisinko ruokalistan, kiitos?",
    "romanization": null
  },
  "11": {
    "text": "Olen kasvissyöjä.",
    "romanization": null
  },
  "12": {
    "text": "Olen allerginen maapähkinöille.",
    "romanization": null
  },
  "13": {
    "text": "Voiko hanavettä juoda turvallisesti?",
    "romanization": null
  },
  "14": {
    "text": "Saisimmeko laskun, kiitos?",
    "romanization": null
  },
  "15": {
    "text": "Sisältyykö palvelumaksu hintaan?",
    "romanization": null
  },
  "16": {
    "text": "Voinko maksaa kortilla?",
    "romanization": null
  },
  "17": {
    "text": "Käykö käteinen?",
    "romanization": null
  },
  "18": {
    "text": "Saisinko kuitin?",
    "romanization": null
  },
  "19": {
    "text": "Pitäkää vaihtorahat.",
    "romanization": null
  },
  "20": {
    "text": "Miltä laiturilta juna lähtee?",
    "romanization": null
  },
  "21": {
    "text": "Onko lento myöhässä?",
    "romanization": null
  },
  "22": {
    "text": "Myöhästyin jatkoyhteydestäni.",
    "romanization": null
  },
  "23": {
    "text": "Missä matkatavaroiden luovutus on?",
    "romanization": null
  },
  "24": {
    "text": "Matkalaukkuni ei tullut perille.",
    "romanization": null
  },
  "25": {
    "text": "Voisitteko tilata minulle taksin?",
    "romanization": null
  },
  "26": {
    "text": "Kuinka kauan matka kestää?",
    "romanization": null
  },
  "27": {
    "text": "Veisitteko minut tähän osoitteeseen, kiitos.",
    "romanization": null
  },
  "28": {
    "text": "Voisitteko pysähtyä kulmalle?",
    "romanization": null
  },
  "29": {
    "text": "Onko täällä lähellä metroasemaa?",
    "romanization": null
  },
  "30": {
    "text": "Katselen vain, kiitos.",
    "romanization": null
  },
  "31": {
    "text": "Onko tätä pienemmässä koossa?",
    "romanization": null
  },
  "32": {
    "text": "Voinko sovittaa tätä?",
    "romanization": null
  },
  "33": {
    "text": "Missä sovituskoppi on?",
    "romanization": null
  },
  "34": {
    "text": "Onko tämä alennuksessa?",
    "romanization": null
  },
  "35": {
    "text": "Saanko alennusta, jos maksan käteisellä?",
    "romanization": null
  },
  "36": {
    "text": "Onko tämä käsintehty vai tehdasvalmisteinen?",
    "romanization": null
  },
  "37": {
    "text": "Otan tämän.",
    "romanization": null
  },
  "38": {
    "text": "Voisitteko paketoida sen lahjaksi?",
    "romanization": null
  },
  "39": {
    "text": "Kuinka pitkä takuu tässä on?",
    "romanization": null
  },
  "40": {
    "text": "Minun täytyy päästä lääkäriin.",
    "romanization": null
  },
  "41": {
    "text": "Minulla on päänsärkyä.",
    "romanization": null
  },
  "42": {
    "text": "Missä on lähin apteekki?",
    "romanization": null
  },
  "43": {
    "text": "Tarvitsenko tähän reseptin?",
    "romanization": null
  },
  "44": {
    "text": "Olen kadottanut passini.",
    "romanization": null
  },
  "45": {
    "text": "Missä poliisiasema on?",
    "romanization": null
  },
  "46": {
    "text": "Voisitko auttaa minua, kiitos?",
    "romanization": null
  },
  "47": {
    "text": "Luulen, että jätin laukkuni taksiin.",
    "romanization": null
  },
  "48": {
    "text": "Soittakaa ambulanssi, kiitos.",
    "romanization": null
  },
  "49": {
    "text": "Onko täällä lähellä sairaalaa?",
    "romanization": null
  },
  "50": {
    "text": "Voisitko suositella hyvää ravintolaa tästä läheltä?",
    "romanization": null
  },
  "51": {
    "text": "Mikä on paikallinen erikoisuus?",
    "romanization": null
  },
  "52": {
    "text": "Haluaisin kokeilla jotain perinteistä.",
    "romanization": null
  },
  "53": {
    "text": "Onko se tulista?",
    "romanization": null
  },
  "54": {
    "text": "Voisimmeko istua ulkona?",
    "romanization": null
  },
  "55": {
    "text": "Meillä ei ole kiire.",
    "romanization": null
  },
  "56": {
    "text": "Ruoka oli todella hyvää, kiitos.",
    "romanization": null
  },
  "57": {
    "text": "Saisinko lasin vettä ilman jäitä?",
    "romanization": null
  },
  "58": {
    "text": "Onko tässä annoksessa mereneläviä?",
    "romanization": null
  },
  "59": {
    "text": "Voisinko ottaa tämän mukaan?",
    "romanization": null
  },
  "60": {
    "text": "Mitkä ovat aukioloajat?",
    "romanization": null
  },
  "61": {
    "text": "Saako sisällä valokuvata?",
    "romanization": null
  },
  "62": {
    "text": "Onko opastusta englanniksi?",
    "romanization": null
  },
  "63": {
    "text": "Onko museoon sunnuntaisin ilmainen sisäänpääsy?",
    "romanization": null
  },
  "64": {
    "text": "Kuinka aikaisin minun kannattaa tulla?",
    "romanization": null
  },
  "65": {
    "text": "Ovatko liput netissä halvempia?",
    "romanization": null
  },
  "66": {
    "text": "Pääsemmekö näillä lipuilla jonon ohi?",
    "romanization": null
  },
  "67": {
    "text": "Mitä minun ei kannata jättää väliin täällä?",
    "romanization": null
  },
  "68": {
    "text": "Voisitko ottaa meistä kuvan?",
    "romanization": null
  },
  "69": {
    "text": "Onko täällä turvallista kävellä illalla?",
    "romanization": null
  },
  "70": {
    "text": "Olen täällä lomalla.",
    "romanization": null
  },
  "71": {
    "text": "Olen täällä työn takia.",
    "romanization": null
  },
  "72": {
    "text": "Viivyn täällä viikon.",
    "romanization": null
  },
  "73": {
    "text": "Olen tässä maassa ensimmäistä kertaa.",
    "romanization": null
  },
  "74": {
    "text": "Missä paikallinen söisi lounasta täällä päin?",
    "romanization": null
  },
  "75": {
    "text": "Mikä on kaunein paikka, jossa olet käynyt?",
    "romanization": null
  },
  "76": {
    "text": "Lento oli pitkä, mutta maisema oli sen arvoinen.",
    "romanization": null
  },
  "77": {
    "text": "Yritän opetella muutaman sanan kielellänne.",
    "romanization": null
  },
  "78": {
    "text": "Hyvää iltaa, ja kiitos kaikesta.",
    "romanization": null
  },
  "79": {
    "text": "Haluaisin tulla tänne vielä joskus uudelleen.",
    "romanization": null
  }
}