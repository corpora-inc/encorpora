{
  "0": {
    "text": "ಬಾತ್‌ರೂಮ್ ಎಲ್ಲಿದೆ?",
    "romanization": "bāt‌rūm ellide?"
  },
  "1": {
    "text": "ಇದಕ್ಕೆ ಎಷ್ಟು ಖರ್ಚಾಗುತ್ತದೆ?",
    "romanization": "idakke eṣṭu kharcāguttade?"
  },
  "2": {
    "text": "ಕ್ಷಮಿಸಿ, ನಿಮಗೆ ಇಂಗ್ಲಿಷ್ ಬರುತ್ತದೆಯೇ?",
    "romanization": "kṣamisi, nimage iṅgliṣ baruttadeyē?"
  },
  "3": {
    "text": "ನನಗೆ ಇನ್ನೂ ಈ ಭಾಷೆ ಅಷ್ಟು ಚೆನ್ನಾಗಿ ಬರುವುದಿಲ್ಲ.",
    "romanization": "nanage innū ī bhāṣe aṣṭu cennāgi baruvudilla."
  },
  "4": {
    "text": "ಸ್ವಲ್ಪ ನಿಧಾನವಾಗಿ ಹೇಳಬಹುದೇ?",
    "romanization": "svalpa nidhānavāgi hēḷabahudē?"
  },
  "5": {
    "text": "ಟಿಕೆಟ್ ಅನ್ನು ಎಲ್ಲಿಂದ ಖರೀದಿಸಬಹುದು?",
    "romanization": "ṭikeṭ annu ellinda kharīdisabahudu?"
  },
  "6": {
    "text": "ಈ ಸೀಟ್ ಯಾರಾದರೂ ತೆಗೆದುಕೊಂಡಿದ್ದಾರಾ?",
    "romanization": "ī sīṭ yārādaru tegedukoṇḍiddārā?"
  },
  "7": {
    "text": "ಎರಡು ರಾತ್ರಿಗಳಿಗೆ ಒಂದು ಸಿಂಗಲ್ ರೂಮ್ ಬೇಕು.",
    "romanization": "eraḍu rātrigaḷige ondu siṅgal rūm bēku."
  },
  "8": {
    "text": "ಸಮುದ್ರ ಕಾಣುವ ರೂಮ್ ಇದೆಯೇ?",
    "romanization": "samudra kāṇuva rūm ideyē?"
  },
  "9": {
    "text": "ಬೆಳಗಿನ ತಿಂಡಿ ಯಾವ ಸಮಯಕ್ಕೆ ಕೊಡುತ್ತಾರೆ?",
    "romanization": "beḷagina tiṇḍi yāva samayakke koḍuttāre?"
  },
  "10": {
    "text": "ದಯವಿಟ್ಟು ಮೆನು ನೋಡಬಹುದೇ?",
    "romanization": "dayaviṭṭu menu nōḍabahudē?"
  },
  "11": {
    "text": "ನಾನು ಸಸ್ಯಾಹಾರಿ.",
    "romanization": "nānu sasyāhāri."
  },
  "12": {
    "text": "ನನಗೆ ಕಡಲೆಕಾಯಿಗೆ ಅಲರ್ಜಿ ಇದೆ.",
    "romanization": "nanage kaḍalekāyige alarji ide."
  },
  "13": {
    "text": "ಟ್ಯಾಪ್ ನೀರು ಕುಡಿಯಲು ಸುರಕ್ಷಿತವೇ?",
    "romanization": "ṭyāp nīru kuḍiyalu surakṣitavē?"
  },
  "14": {
    "text": "ದಯವಿಟ್ಟು ಬಿಲ್ ಕೊಡಬಹುದೇ?",
    "romanization": "dayaviṭṭu bil koḍabahudē?"
  },
  "15": {
    "text": "ಸರ್ವಿಸ್ ಚಾರ್ಜ್ ಇದರಲ್ಲಿ ಸೇರಿದೆಯೇ?",
    "romanization": "sarvis cārj idaralli sēridēyē?"
  },
  "16": {
    "text": "ಕಾರ್ಡ್‌ನಲ್ಲಿ ಪಾವತಿಸಬಹುದೇ?",
    "romanization": "kārḍ‌nalli pāvatisabahudē?"
  },
  "17": {
    "text": "ನಗದು ಸ್ವೀಕರಿಸುತ್ತೀರಾ?",
    "romanization": "nagadu svīkarisuttīrā?"
  },
  "18": {
    "text": "ರಸೀದಿ ಕೊಡಬಹುದೇ?",
    "romanization": "rasīdi koḍabahudē?"
  },
  "19": {
    "text": "ಉಳಿದ ಹಣ ನಿಮ್ಮಲ್ಲೇ ಇರಲಿ.",
    "romanization": "uḷida haṇa nimmallē irali."
  },
  "20": {
    "text": "ರೈಲು ಯಾವ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನಿಂದ ಹೊರಡುತ್ತದೆ?",
    "romanization": "railu yāva plāṭ‌phārm‌ninda horaḍuttade?"
  },
  "21": {
    "text": "ವಿಮಾನ ತಡವಾಗಿದೆಯೇ?",
    "romanization": "vimāna taḍavāgideyē?"
  },
  "22": {
    "text": "ನನ್ನ ಕನೆಕ್ಷನ್ ಮಿಸ್ ಆಯಿತು.",
    "romanization": "nanna kanekṣan mis āyitu."
  },
  "23": {
    "text": "ಬ್ಯಾಗೇಜ್ ಕ್ಲೇಮ್ ಎಲ್ಲಿದೆ?",
    "romanization": "byāgēj klēm ellide?"
  },
  "24": {
    "text": "ನನ್ನ ಸೂಟ್‌ಕೇಸ್ ಬಂದಿಲ್ಲ.",
    "romanization": "nanna sūṭ‌kēs bandilla."
  },
  "25": {
    "text": "ನನಗಾಗಿ ಟ್ಯಾಕ್ಸಿ ಕರೆಸಬಹುದೇ?",
    "romanization": "nanagāgi ṭyāksi karesabahudē?"
  },
  "26": {
    "text": "ಪ್ರಯಾಣಕ್ಕೆ ಎಷ್ಟು ಸಮಯ ಬೇಕಾಗುತ್ತದೆ?",
    "romanization": "prayāṇakke eṣṭu samaya bēkāguttade?"
  },
  "27": {
    "text": "ದಯವಿಟ್ಟು ಈ ವಿಳಾಸಕ್ಕೆ ಕರೆದೊಯ್ಯಿರಿ.",
    "romanization": "dayaviṭṭu ī viḷāsakke karedoyyiri."
  },
  "28": {
    "text": "ದಯವಿಟ್ಟು ಆ ಮೂಲೆ ಬಳಿ ನಿಲ್ಲಿಸಬಹುದೇ?",
    "romanization": "dayaviṭṭu ā mūle baḷi nillisabahudē?"
  },
  "29": {
    "text": "ಇಲ್ಲಿ ಹತ್ತಿರ ಮೆಟ್ರೋ ಸ್ಟೇಷನ್ ಇದೆಯೇ?",
    "romanization": "illi hattira meṭrō sṭēṣan ideyē?"
  },
  "30": {
    "text": "ನಾನು ಸುಮ್ಮನೆ ನೋಡುತ್ತಿದ್ದೇನೆ, ಧನ್ಯವಾದ.",
    "romanization": "nānu summane nōḍuttiddēne, dhanyavāda."
  },
  "31": {
    "text": "ಇದೇದು ಚಿಕ್ಕ ಸೈಜ್‌ನಲ್ಲಿ ಇದೆಯೇ?",
    "romanization": "idēdu cikka saij‌nalli ideyē?"
  },
  "32": {
    "text": "ಇದನ್ನು ಹಾಕಿ ನೋಡಬಹುದೇ?",
    "romanization": "idannu hāki nōḍabahudē?"
  },
  "33": {
    "text": "ಟ್ರಯಲ್ ರೂಮ್ ಎಲ್ಲಿದೆ?",
    "romanization": "ṭrayal rūm ellide?"
  },
  "34": {
    "text": "ಇದಕ್ಕೆ ಸೇಲ್ ಇದೆಯೇ?",
    "romanization": "idakke sēl ideyē?"
  },
  "35": {
    "text": "ನಗದು ಕೊಟ್ಟರೆ ಡಿಸ್ಕೌಂಟ್ ಸಿಗುತ್ತದೆಯೇ?",
    "romanization": "nagadu koṭṭare ḍiskauṇṭ siguttadeyē?"
  },
  "36": {
    "text": "ಇದು ಕೈಯಿಂದ ಮಾಡಿದದ್ದೇ, ಅಥವಾ ಫ್ಯಾಕ್ಟರಿಯಲ್ಲಿ ತಯಾರಿಸಿದದ್ದೇ?",
    "romanization": "idu kaiyinda māḍidaddē, athavā phyākṭariyalli tayārisidaddē?"
  },
  "37": {
    "text": "ಇದನ್ನೇ ತೆಗೆದುಕೊಳ್ಳುತ್ತೇನೆ.",
    "romanization": "idannē tegedukoḷḷuttēne."
  },
  "38": {
    "text": "ಇದನ್ನು ಉಡುಗೊರೆಯಂತೆ ಪ್ಯಾಕ್ ಮಾಡಬಹುದೇ?",
    "romanization": "idannu uḍugoreyante pyāk māḍabahudē?"
  },
  "39": {
    "text": "ವಾರಂಟಿ ಎಷ್ಟು ಕಾಲ ಇರುತ್ತದೆ?",
    "romanization": "vāraṇṭi eṣṭu kāla iruttade?"
  },
  "40": {
    "text": "ನನಗೆ ಡಾಕ್ಟರ್‌ರನ್ನು ನೋಡಬೇಕು.",
    "romanization": "nanage ḍākṭar‌rannu nōḍabēku."
  },
  "41": {
    "text": "ನನಗೆ ತಲೆನೋವು ಇದೆ.",
    "romanization": "nanage talenōvu ide."
  },
  "42": {
    "text": "ಹತ್ತಿರದ ಫಾರ್ಮಸಿ ಎಲ್ಲಿದೆ?",
    "romanization": "hattirada phārmasi ellide?"
  },
  "43": {
    "text": "ಇದಕ್ಕೆ ಪ್ರಿಸ್ಕ್ರಿಪ್ಷನ್ ಬೇಕೇ?",
    "romanization": "idakke priskripṣan bēkē?"
  },
  "44": {
    "text": "ನನ್ನ ಪಾಸ್‌ಪೋರ್ಟ್ ಕಳೆದುಹೋಯಿತು.",
    "romanization": "nanna pās‌pōrṭ kaḷeduhōyitu."
  },
  "45": {
    "text": "ಪೊಲೀಸ್ ಸ್ಟೇಷನ್ ಎಲ್ಲಿದೆ?",
    "romanization": "polīs sṭēṣan ellide?"
  },
  "46": {
    "text": "ದಯವಿಟ್ಟು ನನಗೆ ಸಹಾಯ ಮಾಡಬಹುದೇ?",
    "romanization": "dayaviṭṭu nanage sahāya māḍabahudē?"
  },
  "47": {
    "text": "ನನ್ನ ಬ್ಯಾಗ್ ಟ್ಯಾಕ್ಸಿಯಲ್ಲಿ ಬಿಟ್ಟಿದ್ದೇನೆ ಅನಿಸುತ್ತದೆ.",
    "romanization": "nanna byāg ṭyāksiyalli biṭṭiddēne anisuttade."
  },
  "48": {
    "text": "ದಯವಿಟ್ಟು ಆಂಬುಲೆನ್ಸ್ ಕರೆ ಮಾಡಿ.",
    "romanization": "dayaviṭṭu āmbulens kare māḍi."
  },
  "49": {
    "text": "ಇಲ್ಲಿ ಹತ್ತಿರ ಆಸ್ಪತ್ರೆ ಇದೆಯೇ?",
    "romanization": "illi hattira āspatre ideyē?"
  },
  "50": {
    "text": "ಇಲ್ಲಿ ಸುತ್ತಮುತ್ತ ಒಳ್ಳೆಯ ರೆಸ್ಟೋರೆಂಟ್ ಶಿಫಾರಸು ಮಾಡಬಹುದೇ?",
    "romanization": "illi suttamutta oḷḷeya resṭōreṇṭ śiphārasu māḍabahudē?"
  },
  "51": {
    "text": "ಇಲ್ಲಿನ ವಿಶೇಷ ತಿನಿಸು ಯಾವುದು?",
    "romanization": "illina viśēṣa tinisu yāvudu?"
  },
  "52": {
    "text": "ಸಾಂಪ್ರದಾಯಿಕವಾದ ಏನಾದರೂ ರುಚಿ ನೋಡಲು ಇಷ್ಟ.",
    "romanization": "sāmpradāyikavāda ēnādaru ruci nōḍalu iṣṭa."
  },
  "53": {
    "text": "ಇದು ಖಾರವಾಗಿದೆಯೇ?",
    "romanization": "idu khāravāgideyē?"
  },
  "54": {
    "text": "ನಾವು ಹೊರಗೆ ಕುಳಿತುಕೊಳ್ಳಬಹುದೇ?",
    "romanization": "nāvu horage kuḷitukoḷḷabahudē?"
  },
  "55": {
    "text": "ನಮಗೆ ತುರ್ತು ಇಲ್ಲ.",
    "romanization": "namage turtu illa."
  },
  "56": {
    "text": "ಊಟ ತುಂಬಾ ರುಚಿಯಾಗಿತ್ತು, ಧನ್ಯವಾದ.",
    "romanization": "ūṭa tumbā ruciyāgittu, dhanyavāda."
  },
  "57": {
    "text": "ಐಸ್ ಇಲ್ಲದ ಒಂದು ಗ್ಲಾಸ್ ನೀರು ಕೊಡಬಹುದೇ?",
    "romanization": "ais illada ondu glās nīru koḍabahudē?"
  },
  "58": {
    "text": "ಈ ತಿನಿಸಿನಲ್ಲಿ ಸಮುದ್ರಾಹಾರ ಇದೆಯೇ?",
    "romanization": "ī tinisinalli samudrāhāra ideyē?"
  },
  "59": {
    "text": "ಇದನ್ನು ಪ್ಯಾಕ್ ಮಾಡಿಸಿಕೊಂಡು ಹೋಗಬಹುದೇ?",
    "romanization": "idannu pyāk māḍisikoṇḍu hōgabahudē?"
  },
  "60": {
    "text": "ತೆರೆಯುವ ಸಮಯಗಳು ಯಾವುವು?",
    "romanization": "tereyuva samayagaḷu yāvuvu?"
  },
  "61": {
    "text": "ಒಳಗೆ ಫೋಟೋ ತೆಗೆಯಲು ಅನುಮತಿ ಇದೆಯೇ?",
    "romanization": "oḷage phōṭō tegeyalu anumati ideyē?"
  },
  "62": {
    "text": "ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಗೈಡೆಡ್ ಟೂರ್ ಇದೆಯೇ?",
    "romanization": "iṅgliṣ‌nalli gaiḍeḍ ṭūr ideyē?"
  },
  "63": {
    "text": "ಭಾನುವಾರ ಮ್ಯೂಸಿಯಂ ಉಚಿತವೇ?",
    "romanization": "bhānuvāra myūsiyam ucitavē?"
  },
  "64": {
    "text": "ನಾನು ಎಷ್ಟು ಮುಂಚಿತವಾಗಿ ಬರಬೇಕು?",
    "romanization": "nānu eṣṭu muncitavāgi barabēku?"
  },
  "65": {
    "text": "ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಟಿಕೆಟ್‌ಗಳು ಕಡಿಮೆ ಬೆಲೆಯೇ?",
    "romanization": "ān‌lain‌nalli ṭikeṭ‌gaḷu kaḍime beleyē?"
  },
  "66": {
    "text": "ಈ ಟಿಕೆಟ್‌ಗಳಿಂದ ಸಾಲಿನಲ್ಲಿ ನಿಲ್ಲದೆ ಒಳಗೆ ಹೋಗಬಹುದೇ?",
    "romanization": "ī ṭikeṭ‌gaḷinda sālinalli nillade oḷage hōgabahudē?"
  },
  "67": {
    "text": "ಇಲ್ಲಿರುವಾಗ ನಾನು ತಪ್ಪಿಸಿಕೊಳ್ಳಬಾರದದ್ದು ಏನು?",
    "romanization": "illiruvāga nānu tappisikoḷḷabāradaddu ēnu?"
  },
  "68": {
    "text": "ನಮ್ಮ ಒಂದು ಫೋಟೋ ತೆಗೆದುಕೊಡಬಹುದೇ?",
    "romanization": "namma ondu phōṭō tegedukoḍabahudē?"
  },
  "69": {
    "text": "ರಾತ್ರಿ ಇಲ್ಲಿ ನಡೆದುಕೊಂಡು ತಿರುಗುವುದು ಸುರಕ್ಷಿತವೇ?",
    "romanization": "rātri illi naḍedukoṇḍu tiruguvudu surakṣitavē?"
  },
  "70": {
    "text": "ನಾನು ರಜೆಗೆ ಇಲ್ಲಿ ಬಂದಿದ್ದೇನೆ.",
    "romanization": "nānu rajege illi bandiddēne."
  },
  "71": {
    "text": "ನಾನು ಕೆಲಸಕ್ಕಾಗಿ ಇಲ್ಲಿ ಬಂದಿದ್ದೇನೆ.",
    "romanization": "nānu kelasakkāgi illi bandiddēne."
  },
  "72": {
    "text": "ನಾನು ಒಂದು ವಾರ ಇಲ್ಲಿ ಇರುತ್ತೇನೆ.",
    "romanization": "nānu ondu vāra illi iruttēne."
  },
  "73": {
    "text": "ಈ ದೇಶಕ್ಕೆ ನಾನು ಮೊದಲ ಬಾರಿಗೆ ಬಂದಿದ್ದೇನೆ.",
    "romanization": "ī dēśakke nānu modala bārige bandiddēne."
  },
  "74": {
    "text": "ಇಲ್ಲಿ ಸುತ್ತಮುತ್ತ ಸ್ಥಳೀಯರು ಮಧ್ಯಾಹ್ನದ ಊಟಕ್ಕೆ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತಾರೆ?",
    "romanization": "illi suttamutta sthaḷīyaru madhyāhnada ūṭakke elligē hōguttāre?"
  },
  "75": {
    "text": "ನೀವು ನೋಡಿದ ಅತ್ಯಂತ ಸುಂದರವಾದ ಜಾಗ ಯಾವುದು?",
    "romanization": "nīvu nōḍida atyanta sundaravāda jāga yāvudu?"
  },
  "76": {
    "text": "ವಿಮಾನ ಪ್ರಯಾಣ ದೀರ್ಘವಾಗಿತ್ತು, ಆದರೆ ನೋಟಕ್ಕೆ ಅದು ಸಾರ್ಥಕವಾಯಿತು.",
    "romanization": "vimāna prayāṇa dīrghavāgittu, ādare nōṭakke adu sārthakavāyitu."
  },
  "77": {
    "text": "ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಕೆಲವು ಪದಗಳನ್ನು ಕಲಿಯಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದ್ದೇನೆ.",
    "romanization": "nimma bhāṣeyalli kelavu padagaḷannu kaliyalu prayatnisuttiddēne."
  },
  "78": {
    "text": "ಶುಭ ಸಂಜೆ, ಎಲ್ಲಕ್ಕೂ ಧನ್ಯವಾದಗಳು.",
    "romanization": "śubha sanje, ellakkū dhanyavādagaḷu."
  },
  "79": {
    "text": "ಒಂದು ದಿನ ಮತ್ತೆ ಇಲ್ಲಿಗೆ ಬರಲು ನನಗೆ ತುಂಬಾ ಇಷ್ಟ.",
    "romanization": "ondu dina matte illige baralu nanage tumbā iṣṭa."
  }
}