{
  "0": {
    "text": "கழிப்பறை எங்கே இருக்கிறது?",
    "romanization": "kaḻippaṟai eṅkē irukkiṟatu?"
  },
  "1": {
    "text": "இதன் விலை எவ்வளவு?",
    "romanization": "itaṉ vilai evvaḷavu?"
  },
  "2": {
    "text": "மன்னிக்கவும், உங்களுக்கு ஆங்கிலம் பேசத் தெரியுமா?",
    "romanization": "maṉṉikkavum, uṅkaḷukku āṅkilam pēcat teriyumā?"
  },
  "3": {
    "text": "இந்த மொழியை நான் இன்னும் அவ்வளவு நன்றாகப் பேச மாட்டேன்.",
    "romanization": "inta moḻiyai nāṉ iṉṉum avvaḷavu naṉṟākap pēca māṭṭēṉ."
  },
  "4": {
    "text": "கொஞ்சம் மெதுவாகச் சொல்ல முடியுமா?",
    "romanization": "koñcam metuvākac colla muṭiyumā?"
  },
  "5": {
    "text": "டிக்கெட் எங்கே வாங்கலாம்?",
    "romanization": "ṭikkeṭ eṅkē vāṅkalām?"
  },
  "6": {
    "text": "இந்த இருக்கை யாருக்காவது வைத்ததா?",
    "romanization": "inta irukkai yārukkāvatu vaittatā?"
  },
  "7": {
    "text": "இரண்டு இரவுகளுக்கு ஒரு சிங்கிள் அறை வேண்டும்.",
    "romanization": "iraṇṭu iravukaḷukku oru ciṅkiḷ aṟai vēṇṭum."
  },
  "8": {
    "text": "கடல் தெரியும் அறை ஏதாவது இருக்கிறதா?",
    "romanization": "kaṭal teriyum aṟai ētāvatu irukkiṟatā?"
  },
  "9": {
    "text": "காலை உணவு எத்தனை மணிக்கு பரிமாறப்படும்?",
    "romanization": "kālai uṇavu ettaṉai maṇikku parimāṟappaṭum?"
  },
  "10": {
    "text": "மெனுவைப் பார்க்கலாமா, தயவுசெய்து?",
    "romanization": "meṉuvaip pārkkalāmā, tayavuceytu?"
  },
  "11": {
    "text": "நான் சைவம்.",
    "romanization": "nāṉ caivam."
  },
  "12": {
    "text": "எனக்கு வேர்க்கடலை ஒவ்வாமை இருக்கிறது.",
    "romanization": "eṉakku vērkkaṭalai ovvāmai irukkiṟatu."
  },
  "13": {
    "text": "குழாய் தண்ணீர் குடிக்க பாதுகாப்பானதா?",
    "romanization": "kuḻāy taṇṇīr kuṭikka pātukāppāṉatā?"
  },
  "14": {
    "text": "பில் கொடுக்க முடியுமா, தயவுசெய்து?",
    "romanization": "pil koṭukka muṭiyumā, tayavuceytu?"
  },
  "15": {
    "text": "சேவை கட்டணம் இதில் சேர்த்திருக்கிறதா?",
    "romanization": "cēvai kaṭṭaṇam itil cērttirukkiṟatā?"
  },
  "16": {
    "text": "கார்டால் பணம் செலுத்தலாமா?",
    "romanization": "kārṭāl paṇam celuttalāmā?"
  },
  "17": {
    "text": "பணம் கொடுத்தால் ஏற்றுக்கொள்வீர்களா?",
    "romanization": "paṇam koṭuttāl ēṟṟukkoḷvīrkaḷā?"
  },
  "18": {
    "text": "ரசீது கிடைக்குமா?",
    "romanization": "racītu kiṭaikkumā?"
  },
  "19": {
    "text": "மீதியை வைத்துக்கொள்ளுங்கள்.",
    "romanization": "mītiyai vaittukkoḷḷuṅkaḷ."
  },
  "20": {
    "text": "ரயில் எந்த பிளாட்பார்மிலிருந்து புறப்படும்?",
    "romanization": "rayil enta piḷāṭpārmiliruntu puṟappaṭum?"
  },
  "21": {
    "text": "விமானம் தாமதமாகிவிட்டதா?",
    "romanization": "vimāṉam tāmatamākiviṭṭatā?"
  },
  "22": {
    "text": "என் கனெக்ஷன் பயணத்தைத் தவறவிட்டேன்.",
    "romanization": "eṉ kaṉekṣaṉ payaṇattait tavaṟaviṭṭēṉ."
  },
  "23": {
    "text": "பேக்கேஜ் கிளெய்ம் எங்கே இருக்கிறது?",
    "romanization": "pēkkēj kiḷeym eṅkē irukkiṟatu?"
  },
  "24": {
    "text": "என் சூட்கேஸ் வரவில்லை.",
    "romanization": "eṉ cūṭkēs varavillai."
  },
  "25": {
    "text": "எனக்காக ஒரு டாக்ஸி அழைத்து தர முடியுமா?",
    "romanization": "eṉakkāka oru ṭāksi aḻaittu tara muṭiyumā?"
  },
  "26": {
    "text": "பயணத்துக்கு எவ்வளவு நேரம் ஆகும்?",
    "romanization": "payaṇattukku evvaḷavu nēram ākum?"
  },
  "27": {
    "text": "தயவுசெய்து இந்த முகவரிக்கு அழைத்துச் செல்லுங்கள்.",
    "romanization": "tayavuceytu inta mukavarikku aḻaittuc celluṅkaḷ."
  },
  "28": {
    "text": "மூலையில் கொஞ்சம் நிறுத்த முடியுமா?",
    "romanization": "mūlaiyil koñcam niṟutta muṭiyumā?"
  },
  "29": {
    "text": "இங்கே அருகில் மெட்ரோ நிலையம் இருக்கிறதா?",
    "romanization": "iṅkē arukil meṭrō nilaiyam irukkiṟatā?"
  },
  "30": {
    "text": "நான் சும்மா பார்த்துக்கொண்டிருக்கிறேன், நன்றி.",
    "romanization": "nāṉ cummā pārttukkoṇṭirukkiṟēṉ, naṉṟi."
  },
  "31": {
    "text": "இது இன்னும் சிறிய சைஸில் இருக்கிறதா?",
    "romanization": "itu iṉṉum ciṟiya caisil irukkiṟatā?"
  },
  "32": {
    "text": "இதை அணிந்து பார்த்துக்கொள்ளலாமா?",
    "romanization": "itai aṇintu pārttukkoḷḷalāmā?"
  },
  "33": {
    "text": "உடை மாற்றும் அறை எங்கே?",
    "romanization": "uṭai māṟṟum aṟai eṅkē?"
  },
  "34": {
    "text": "இது தள்ளுபடியில் இருக்கிறதா?",
    "romanization": "itu taḷḷupaṭiyil irukkiṟatā?"
  },
  "35": {
    "text": "பணமாகச் செலுத்தினால் தள்ளுபடி கிடைக்குமா?",
    "romanization": "paṇamākac celuttiṉāl taḷḷupaṭi kiṭaikkumā?"
  },
  "36": {
    "text": "இது கைத்தயாரிப்பா, இல்லையா தொழிற்சாலையில் தயாரித்ததா?",
    "romanization": "itu kaittayārippā, illaiyā toḻiṟcālaiyil tayārittatā?"
  },
  "37": {
    "text": "இதை எடுத்துக்கொள்கிறேன்.",
    "romanization": "itai eṭuttukkoḷkiṟēṉ."
  },
  "38": {
    "text": "இதை பரிசாகப் பேக் செய்து தர முடியுமா?",
    "romanization": "itai parisākap pěk ceytu tara muṭiyumā?"
  },
  "39": {
    "text": "வாரண்டி எவ்வளவு காலம்?",
    "romanization": "vāraṇṭi evvaḷavu kālam?"
  },
  "40": {
    "text": "நான் ஒரு மருத்துவரைப் பார்க்க வேண்டும்.",
    "romanization": "nāṉ oru maruttuvaraip pārkka vēṇṭum."
  },
  "41": {
    "text": "எனக்கு தலைவலி இருக்கிறது.",
    "romanization": "eṉakku talaivali irukkiṟatu."
  },
  "42": {
    "text": "அருகிலுள்ள மருந்தகம் எங்கே?",
    "romanization": "arukiluḷḷa maruntakam eṅkē?"
  },
  "43": {
    "text": "இதற்கு மருத்துவரின் சீட்டு வேண்டுமா?",
    "romanization": "itaṟku maruttuvariṉ cīṭṭu vēṇṭumā?"
  },
  "44": {
    "text": "என் பாஸ்போர்ட் தொலைந்துவிட்டது.",
    "romanization": "eṉ pāspōrṭ tolaittuviṭṭatu."
  },
  "45": {
    "text": "காவல் நிலையம் எங்கே இருக்கிறது?",
    "romanization": "kāval nilaiyam eṅkē irukkiṟatu?"
  },
  "46": {
    "text": "தயவுசெய்து எனக்கு உதவ முடியுமா?",
    "romanization": "tayavuceytu eṉakku utava muṭiyumā?"
  },
  "47": {
    "text": "என் பையை டாக்ஸியில் விட்டுவந்திருக்கலாம் என்று நினைக்கிறேன்.",
    "romanization": "eṉ paiyai ṭāksiyil viṭṭuvantirukkalām eṉṟu niṉaikkiṟēṉ."
  },
  "48": {
    "text": "தயவுசெய்து ஆம்புலன்ஸை அழைக்கவும்.",
    "romanization": "tayavuceytu āmpulaṉsai aḻaikkavum."
  },
  "49": {
    "text": "அருகில் மருத்துவமனை இருக்கிறதா?",
    "romanization": "arukil maruttuvamaṉai irukkiṟatā?"
  },
  "50": {
    "text": "இங்கே அருகில் நல்ல உணவகம் ஒன்றை பரிந்துரைக்க முடியுமா?",
    "romanization": "iṅkē arukil nalla uṇavakam oṉṟai parinturaikka muṭiyumā?"
  },
  "51": {
    "text": "இங்குள்ள சிறப்பு உணவு என்ன?",
    "romanization": "iṅkuḷḷa ciṟappu uṇavu eṉṉa?"
  },
  "52": {
    "text": "பாரம்பரியமான ஏதாவது ஒன்றைச் சுவைக்க விரும்புகிறேன்.",
    "romanization": "pārampariyamāṉa ētāvatu oṉṟaic cuvaikka virumpukiṟēṉ."
  },
  "53": {
    "text": "இது காரமா?",
    "romanization": "itu kāramā?"
  },
  "54": {
    "text": "நாங்கள் வெளியே உட்காரலாமா?",
    "romanization": "nāṅkaḷ veḷiyē uṭkāralāmā?"
  },
  "55": {
    "text": "எங்களுக்கு அவசரம் இல்லை.",
    "romanization": "eṅkaḷukku avacaram illai."
  },
  "56": {
    "text": "உணவு மிகவும் ருசியாக இருந்தது, நன்றி.",
    "romanization": "uṇavu mikavum ruciyāka iruntatu, naṉṟi."
  },
  "57": {
    "text": "ஐஸ் இல்லாமல் ஒரு கிளாஸ் தண்ணீர் கிடைக்குமா?",
    "romanization": "ais illāmal oru kiḷās taṇṇīr kiṭaikkumā?"
  },
  "58": {
    "text": "இந்த உணவில் கடல் உணவு சேர்க்கப்பட்டிருக்கிறதா?",
    "romanization": "inta uṇavil kaṭal uṇavu cērkkappaṭṭirukkiṟatā?"
  },
  "59": {
    "text": "இதை பார்சலாக எடுத்துச் செல்லலாமா?",
    "romanization": "itai pārcalāk eṭuttuc cellalāmā?"
  },
  "60": {
    "text": "திறந்திருக்கும் நேரம் என்ன?",
    "romanization": "tiṟantirukkum nēram eṉṉa?"
  },
  "61": {
    "text": "உள்ளே புகைப்படம் எடுக்க அனுமதி இருக்கிறதா?",
    "romanization": "uḷḷē pukaippaṭam eṭukka aṉumati irukkiṟatā?"
  },
  "62": {
    "text": "ஆங்கிலத்தில் வழிகாட்டியுடன் சுற்றிப் பார்க்க ஏற்பாடு இருக்கிறதா?",
    "romanization": "āṅkilattil vaḻikāṭṭiyuṭaṉ cuṟṟip pārkka ēṟpāṭu irukkiṟatā?"
  },
  "63": {
    "text": "ஞாயிற்றுக்கிழமைகளில் அருங்காட்சியகம் இலவசமா?",
    "romanization": "ñāyiṟṟukkiḻamaikaḷil aruṅkāṭciyakam ilavacamā?"
  },
  "64": {
    "text": "நான் எவ்வளவு முன்பாக வர வேண்டும்?",
    "romanization": "nāṉ evvaḷavu muṉpāka vara vēṇṭum?"
  },
  "65": {
    "text": "ஆன்லைனில் டிக்கெட்டுகள் மலிவாக கிடைக்குமா?",
    "romanization": "āṉlaiṉil ṭikkeṭṭukaḷ malivāka kiṭaikkumā?"
  },
  "66": {
    "text": "இந்த டிக்கெட்டுகளால் வரிசையைத் தவிர்க்க முடியுமா?",
    "romanization": "inta ṭikkeṭṭukaḷāl varicaiyait tavirkka muṭiyumā?"
  },
  "67": {
    "text": "இங்கே இருக்கும்போது கண்டிப்பாக பார்க்க வேண்டியது என்ன?",
    "romanization": "iṅkē irukkumpōtu kaṇṭippāka pārkka vēṇṭiyatu eṉṉa?"
  },
  "68": {
    "text": "எங்களை ஒரு புகைப்படம் எடுத்து தர முடியுமா?",
    "romanization": "eṅkaḷai oru pukaippaṭam eṭuttu tara muṭiyumā?"
  },
  "69": {
    "text": "இரவில் இங்கே நடந்து செல்ல பாதுகாப்பானதா?",
    "romanization": "iravil iṅkē naṭantu cella pātukāppāṉatā?"
  },
  "70": {
    "text": "நான் விடுமுறைக்காக இங்கே வந்திருக்கிறேன்.",
    "romanization": "nāṉ viṭumuṟaikkāka iṅkē vantirukkiṟēṉ."
  },
  "71": {
    "text": "நான் வேலைக்காக இங்கே வந்திருக்கிறேன்.",
    "romanization": "nāṉ vēlaikkāka iṅkē vantirukkiṟēṉ."
  },
  "72": {
    "text": "நான் ஒரு வாரம் இங்கே தங்குவேன்.",
    "romanization": "nāṉ oru vāram iṅkē taṅkuvēṉ."
  },
  "73": {
    "text": "இந்த நாட்டுக்கு நான் முதன்முறையாக வந்திருக்கிறேன்.",
    "romanization": "inta nāṭṭukku nāṉ mutaṉmuṟaiyāka vantirukkiṟēṉ."
  },
  "74": {
    "text": "இங்கே அருகில் உள்ளூர்வாசிகள் மதிய உணவு எங்கே சாப்பிடுவார்கள்?",
    "romanization": "iṅkē arukil uḷḷūrvācikaḷ matiya uṇavu eṅkē cāppiṭuvārkaḷ?"
  },
  "75": {
    "text": "நீங்கள் சென்ற இடங்களில் மிக அழகான இடம் எது?",
    "romanization": "nīṅkaḷ ceṉṟa iṭaṅkaḷil mika aḻakāṉa iṭam etu?"
  },
  "76": {
    "text": "விமானப் பயணம் நீண்டதாக இருந்தது, ஆனால் அந்த காட்சி அதற்குத் தகுந்தது.",
    "romanization": "vimāṉap payaṇam nīṇṭatāka iruntatu, āṉāl anta kāṭci ataṟkut takuntatu."
  },
  "77": {
    "text": "உங்கள் மொழியில் சில வார்த்தைகள் கற்றுக்கொள்ள முயற்சி செய்கிறேன்.",
    "romanization": "uṅkaḷ moḻiyil cila vārttaikaḷ kaṟṟukkoḷḷa muyaṟci ceykiṟēṉ."
  },
  "78": {
    "text": "இனிய மாலை நேரம் அமையட்டும்; எல்லாவற்றிற்கும் நன்றி.",
    "romanization": "iṉiya mālai nēram amaiyaṭṭum; ellāvaṟṟiṟkum naṉṟi."
  },
  "79": {
    "text": "ஒருநாள் மீண்டும் இங்கே வர மிகவும் ஆசையாக இருக்கிறது.",
    "romanization": "orunāḷ mīṇṭum iṅkē vara mikavum ācaiyāka irukkiṟatu."
  }
}