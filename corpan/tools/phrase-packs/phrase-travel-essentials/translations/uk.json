{
  "0": {
    "text": "Де тут туалет?",
    "romanization": "De tut tualet?"
  },
  "1": {
    "text": "Скільки це коштує?",
    "romanization": "Skilky tse koshtuie?"
  },
  "2": {
    "text": "Перепрошую, ви говорите англійською?",
    "romanization": "Pereproshuiu, vy hovoryte anhliiskoiu?"
  },
  "3": {
    "text": "Я ще не дуже добре розмовляю цією мовою.",
    "romanization": "Ya shche ne duzhe dobre rozmovliaiu tsiieiu movoiu."
  },
  "4": {
    "text": "Можете сказати це повільніше?",
    "romanization": "Mozhete skazaty tse povilnishe?"
  },
  "5": {
    "text": "Де я можу купити квиток?",
    "romanization": "De ya mozhu kupyty kvytok?"
  },
  "6": {
    "text": "Це місце зайняте?",
    "romanization": "Tse mistse zainiate?"
  },
  "7": {
    "text": "Я хотів би одномісний номер на дві ночі.",
    "romanization": "Ya khotiv by odnomisnyi nomer na dvi nochi."
  },
  "8": {
    "text": "У вас є номер із видом на море?",
    "romanization": "U vas ye nomer iz vydom na more?"
  },
  "9": {
    "text": "О котрій подають сніданок?",
    "romanization": "O kotrii podaiut snidanok?"
  },
  "10": {
    "text": "Можна меню, будь ласка?",
    "romanization": "Mozhna meniu, bud laska?"
  },
  "11": {
    "text": "Я вегетаріанець.",
    "romanization": "Ya vehetarianets."
  },
  "12": {
    "text": "У мене алергія на арахіс.",
    "romanization": "U mene alerhiia na arakhis."
  },
  "13": {
    "text": "Воду з-під крана можна пити?",
    "romanization": "Vodu z-pid krana mozhna pyty?"
  },
  "14": {
    "text": "Можна рахунок, будь ласка?",
    "romanization": "Mozhna rakhunok, bud laska?"
  },
  "15": {
    "text": "Обслуговування включено?",
    "romanization": "Obsluhovuvannia vkliucheno?"
  },
  "16": {
    "text": "Можна оплатити карткою?",
    "romanization": "Mozhna oplatyty kartkoiu?"
  },
  "17": {
    "text": "Ви приймаєте готівку?",
    "romanization": "Vy pryimaiete hotivku?"
  },
  "18": {
    "text": "Можна чек?",
    "romanization": "Mozhna chek?"
  },
  "19": {
    "text": "Решту залиште собі.",
    "romanization": "Reshtu zalyshte sobi."
  },
  "20": {
    "text": "З якої платформи відправляється поїзд?",
    "romanization": "Z yakoi platformy vidpravliaietsia poizd?"
  },
  "21": {
    "text": "Рейс затримали?",
    "romanization": "Reis zatrymaly?"
  },
  "22": {
    "text": "Я не встиг на пересадку.",
    "romanization": "Ya ne vstyh na peresadku."
  },
  "23": {
    "text": "Де видача багажу?",
    "romanization": "De vydacha bahazhu?"
  },
  "24": {
    "text": "Моя валіза не прилетіла.",
    "romanization": "Moia valiza ne pryletila."
  },
  "25": {
    "text": "Можете викликати мені таксі?",
    "romanization": "Mozhete vyklykaty meni taksi?"
  },
  "26": {
    "text": "Скільки триває дорога?",
    "romanization": "Skilky tryvaie doroha?"
  },
  "27": {
    "text": "Відвезіть мене, будь ласка, за цією адресою.",
    "romanization": "Vidvezit mene, bud laska, za tsiieiu adresoiu."
  },
  "28": {
    "text": "Можете зупинитися на розі?",
    "romanization": "Mozhete zupynytysia na rozi?"
  },
  "29": {
    "text": "Поруч є станція метро?",
    "romanization": "Poruch ye stantsiia metro?"
  },
  "30": {
    "text": "Я просто дивлюся, дякую.",
    "romanization": "Ya prosto dyvliusia, diakuiu."
  },
  "31": {
    "text": "У вас є це меншого розміру?",
    "romanization": "U vas ye tse menshoho rozmiru?"
  },
  "32": {
    "text": "Можна приміряти?",
    "romanization": "Mozhna prymiriaty?"
  },
  "33": {
    "text": "Де примірочна?",
    "romanization": "De prymirochna?"
  },
  "34": {
    "text": "Це зі знижкою?",
    "romanization": "Tse zi znyzhkoiu?"
  },
  "35": {
    "text": "Якщо заплачу готівкою, буде знижка?",
    "romanization": "Yakshcho zaplachu hotivkoiu, bude znyzhka?"
  },
  "36": {
    "text": "Це ручна робота чи фабричне виробництво?",
    "romanization": "Tse ruchna robota chy fabrychne vyrobnytstvo?"
  },
  "37": {
    "text": "Беру.",
    "romanization": "Beru."
  },
  "38": {
    "text": "Можете запакувати це як подарунок?",
    "romanization": "Mozhete zapakuvaty tse yak podarunok?"
  },
  "39": {
    "text": "На який термін гарантія?",
    "romanization": "Na yakyi termin harantiia?"
  },
  "40": {
    "text": "Мені потрібно до лікаря.",
    "romanization": "Meni potribno do likaria."
  },
  "41": {
    "text": "У мене болить голова.",
    "romanization": "U mene bolyt holova."
  },
  "42": {
    "text": "Де найближча аптека?",
    "romanization": "De naiblyzhcha apteka?"
  },
  "43": {
    "text": "На це потрібен рецепт?",
    "romanization": "Na tse potriben retsept?"
  },
  "44": {
    "text": "Я загубив паспорт.",
    "romanization": "Ya zahubyv pasport."
  },
  "45": {
    "text": "Де поліцейський відділок?",
    "romanization": "De politseiskyi viddilok?"
  },
  "46": {
    "text": "Допоможіть мені, будь ласка.",
    "romanization": "Dopomozhit meni, bud laska."
  },
  "47": {
    "text": "Здається, я залишив сумку в таксі.",
    "romanization": "Zdaietsia, ya zalyshyv sumku v taksi."
  },
  "48": {
    "text": "Викличте швидку, будь ласка.",
    "romanization": "Vyklychte shvydku, bud laska."
  },
  "49": {
    "text": "Поблизу є лікарня?",
    "romanization": "Poblyzu ye likarnia?"
  },
  "50": {
    "text": "Можете порадити хороший ресторан неподалік?",
    "romanization": "Mozhete poradyty khoroshyi restoran nepodalik?"
  },
  "51": {
    "text": "Яка тут місцева фірмова страва?",
    "romanization": "Yaka tut mistseva firmova strava?"
  },
  "52": {
    "text": "Я б хотів спробувати щось традиційне.",
    "romanization": "Ya b khotiv sprobuvaty shchos tradytsiine."
  },
  "53": {
    "text": "Це гостре?",
    "romanization": "Tse hostre?"
  },
  "54": {
    "text": "Можемо сісти надворі?",
    "romanization": "Mozhemo sisty nadvori?"
  },
  "55": {
    "text": "Ми не поспішаємо.",
    "romanization": "My ne pospishaiemo."
  },
  "56": {
    "text": "Їжа була дуже смачна, дякую.",
    "romanization": "Yizha bula duzhe smachna, diakuiu."
  },
  "57": {
    "text": "Можна склянку води без льоду?",
    "romanization": "Mozhna sklianku vody bez lodu?"
  },
  "58": {
    "text": "У цій страві є морепродукти?",
    "romanization": "U tsii stravi ye moreprodukty?"
  },
  "59": {
    "text": "Можна взяти це із собою?",
    "romanization": "Mozhna vziaty tse iz soboiu?"
  },
  "60": {
    "text": "Який у вас графік роботи?",
    "romanization": "Yakyi u vas hrafik roboty?"
  },
  "61": {
    "text": "Усередині можна фотографувати?",
    "romanization": "Useredyni mozhna fotohrafuvaty?"
  },
  "62": {
    "text": "Є екскурсія англійською?",
    "romanization": "Ye ekskursiia anhliiskoiu?"
  },
  "63": {
    "text": "У неділю вхід до музею безкоштовний?",
    "romanization": "U nediliu vkhid do muzeiu bezkoshtovnyi?"
  },
  "64": {
    "text": "Наскільки раніше варто прийти?",
    "romanization": "Naskilky ranishe varto pryity?"
  },
  "65": {
    "text": "Онлайн квитки дешевші?",
    "romanization": "Onlain kvytky deshevshi?"
  },
  "66": {
    "text": "З цими квитками можна пройти без черги?",
    "romanization": "Z tsymy kvytkamy mozhna proity bez cherhy?"
  },
  "67": {
    "text": "Що тут точно варто побачити?",
    "romanization": "Shcho tut tochno varto pobachyty?"
  },
  "68": {
    "text": "Можете нас сфотографувати?",
    "romanization": "Mozhete nas sfotohrafuvaty?"
  },
  "69": {
    "text": "Тут безпечно гуляти вночі?",
    "romanization": "Tut bezpechno huliaty vnochi?"
  },
  "70": {
    "text": "Я тут у відпустці.",
    "romanization": "Ya tut u vidpusttsi."
  },
  "71": {
    "text": "Я тут у справах.",
    "romanization": "Ya tut u spravakh."
  },
  "72": {
    "text": "Я залишуся на тиждень.",
    "romanization": "Ya zalyshusia na tyzhden."
  },
  "73": {
    "text": "Я вперше в цій країні.",
    "romanization": "Ya vpershe v tsii kraini."
  },
  "74": {
    "text": "Де тут місцеві обідають?",
    "romanization": "De tut mistsevi obidaiut?"
  },
  "75": {
    "text": "Яке найгарніше місце ви відвідували?",
    "romanization": "Yake naiharnishe mistse vy vidviduvaly?"
  },
  "76": {
    "text": "Політ був довгий, але краєвид того вартий.",
    "romanization": "Polit buv dovhyi, ale kraievyd toho vartyi."
  },
  "77": {
    "text": "Я намагаюся вивчити кілька слів вашою мовою.",
    "romanization": "Ya namahaiusia vyvchyty kilka sliv vashoiu movoiu."
  },
  "78": {
    "text": "Гарного вечора і дякую за все.",
    "romanization": "Harnoho vechora i diakuiu za vse."
  },
  "79": {
    "text": "Я б із радістю колись сюди повернувся.",
    "romanization": "Ya b iz radistiu kolys siudy povernuvsia."
  }
}