{
  "0": {
    "text": "Kje je stranišče?",
    "romanization": null
  },
  "1": {
    "text": "Koliko stane?",
    "romanization": null
  },
  "2": {
    "text": "Oprostite, ali govorite angleško?",
    "romanization": null
  },
  "3": {
    "text": "Tega jezika še ne govorim najbolje.",
    "romanization": null
  },
  "4": {
    "text": "Lahko poveste malo počasneje?",
    "romanization": null
  },
  "5": {
    "text": "Kje lahko kupim vozovnico?",
    "romanization": null
  },
  "6": {
    "text": "Je ta sedež zaseden?",
    "romanization": null
  },
  "7": {
    "text": "Rad bi enoposteljno sobo za dve noči.",
    "romanization": null
  },
  "8": {
    "text": "Imate sobo s pogledom na morje?",
    "romanization": null
  },
  "9": {
    "text": "Ob kateri uri strežete zajtrk?",
    "romanization": null
  },
  "10": {
    "text": "Lahko dobim jedilni list, prosim?",
    "romanization": null
  },
  "11": {
    "text": "Sem vegetarijanec.",
    "romanization": null
  },
  "12": {
    "text": "Alergičen sem na arašide.",
    "romanization": null
  },
  "13": {
    "text": "Je voda iz pipe pitna?",
    "romanization": null
  },
  "14": {
    "text": "Lahko dobimo račun, prosim?",
    "romanization": null
  },
  "15": {
    "text": "Je postrežba vključena v ceno?",
    "romanization": null
  },
  "16": {
    "text": "Lahko plačam s kartico?",
    "romanization": null
  },
  "17": {
    "text": "Sprejemate gotovino?",
    "romanization": null
  },
  "18": {
    "text": "Lahko dobim račun?",
    "romanization": null
  },
  "19": {
    "text": "Kar obdržite drobiž.",
    "romanization": null
  },
  "20": {
    "text": "S katerega perona odpelje vlak?",
    "romanization": null
  },
  "21": {
    "text": "Ali ima let zamudo?",
    "romanization": null
  },
  "22": {
    "text": "Zamudil sem povezavo.",
    "romanization": null
  },
  "23": {
    "text": "Kje je prevzem prtljage?",
    "romanization": null
  },
  "24": {
    "text": "Moj kovček ni prispel.",
    "romanization": null
  },
  "25": {
    "text": "Mi lahko pokličete taksi?",
    "romanization": null
  },
  "26": {
    "text": "Koliko časa traja pot?",
    "romanization": null
  },
  "27": {
    "text": "Prosim, peljite me na ta naslov.",
    "romanization": null
  },
  "28": {
    "text": "Lahko ustavite pri vogalu?",
    "romanization": null
  },
  "29": {
    "text": "Je v bližini postaja podzemne železnice?",
    "romanization": null
  },
  "30": {
    "text": "Samo gledam, hvala.",
    "romanization": null
  },
  "31": {
    "text": "Imate to v manjši velikosti?",
    "romanization": null
  },
  "32": {
    "text": "Lahko pomerim?",
    "romanization": null
  },
  "33": {
    "text": "Kje je kabina za pomerjanje?",
    "romanization": null
  },
  "34": {
    "text": "Je to znižano?",
    "romanization": null
  },
  "35": {
    "text": "Dobim popust, če plačam z gotovino?",
    "romanization": null
  },
  "36": {
    "text": "Je to ročno izdelano ali industrijsko?",
    "romanization": null
  },
  "37": {
    "text": "To bom vzel.",
    "romanization": null
  },
  "38": {
    "text": "Lahko zavijete kot darilo?",
    "romanization": null
  },
  "39": {
    "text": "Kako dolga je garancija?",
    "romanization": null
  },
  "40": {
    "text": "Moram k zdravniku.",
    "romanization": null
  },
  "41": {
    "text": "Boli me glava.",
    "romanization": null
  },
  "42": {
    "text": "Kje je najbližja lekarna?",
    "romanization": null
  },
  "43": {
    "text": "Ali za to potrebujem recept?",
    "romanization": null
  },
  "44": {
    "text": "Izgubil sem potni list.",
    "romanization": null
  },
  "45": {
    "text": "Kje je policijska postaja?",
    "romanization": null
  },
  "46": {
    "text": "Mi lahko prosim pomagate?",
    "romanization": null
  },
  "47": {
    "text": "Mislim, da sem torbo pustil v taksiju.",
    "romanization": null
  },
  "48": {
    "text": "Prosim, pokličite rešilca.",
    "romanization": null
  },
  "49": {
    "text": "Je v bližini bolnišnica?",
    "romanization": null
  },
  "50": {
    "text": "Mi lahko priporočite dobro restavracijo v bližini?",
    "romanization": null
  },
  "51": {
    "text": "Katera je lokalna specialiteta?",
    "romanization": null
  },
  "52": {
    "text": "Rad bi poskusil nekaj tradicionalnega.",
    "romanization": null
  },
  "53": {
    "text": "Je pekoče?",
    "romanization": null
  },
  "54": {
    "text": "Lahko sedimo zunaj?",
    "romanization": null
  },
  "55": {
    "text": "Ne mudi se nam.",
    "romanization": null
  },
  "56": {
    "text": "Hrana je bila odlična, hvala.",
    "romanization": null
  },
  "57": {
    "text": "Lahko dobim kozarec vode brez ledu?",
    "romanization": null
  },
  "58": {
    "text": "Je ta jed pripravljena z morskimi sadeži?",
    "romanization": null
  },
  "59": {
    "text": "Lahko to vzamem za s seboj?",
    "romanization": null
  },
  "60": {
    "text": "Kakšen je odpiralni čas?",
    "romanization": null
  },
  "61": {
    "text": "Je fotografiranje v notranjosti dovoljeno?",
    "romanization": null
  },
  "62": {
    "text": "Ali je voden ogled v angleščini?",
    "romanization": null
  },
  "63": {
    "text": "Je muzej ob nedeljah brezplačen?",
    "romanization": null
  },
  "64": {
    "text": "Koliko prej naj pridem?",
    "romanization": null
  },
  "65": {
    "text": "So vstopnice na spletu cenejše?",
    "romanization": null
  },
  "66": {
    "text": "Lahko s temi vstopnicami preskočimo vrsto?",
    "romanization": null
  },
  "67": {
    "text": "Česa tukaj res ne smem zamuditi?",
    "romanization": null
  },
  "68": {
    "text": "Nas lahko fotografirate?",
    "romanization": null
  },
  "69": {
    "text": "Je ponoči varno hoditi naokoli?",
    "romanization": null
  },
  "70": {
    "text": "Tukaj sem na počitnicah.",
    "romanization": null
  },
  "71": {
    "text": "Tukaj sem službeno.",
    "romanization": null
  },
  "72": {
    "text": "Ostal bom en teden.",
    "romanization": null
  },
  "73": {
    "text": "Prvič sem v tej državi.",
    "romanization": null
  },
  "74": {
    "text": "Kam bi šel domačin tukaj na kosilo?",
    "romanization": null
  },
  "75": {
    "text": "Kateri je najlepši kraj, ki ste ga obiskali?",
    "romanization": null
  },
  "76": {
    "text": "Let je bil dolg, ampak razgled je bil vreden tega.",
    "romanization": null
  },
  "77": {
    "text": "Poskušam se naučiti nekaj besed v vašem jeziku.",
    "romanization": null
  },
  "78": {
    "text": "Lep večer vam želim in hvala za vse.",
    "romanization": null
  },
  "79": {
    "text": "Z veseljem bi se nekega dne vrnil sem.",
    "romanization": null
  }
}