{
  "0": {
    "text": "Choo kiko wapi?",
    "romanization": null
  },
  "1": {
    "text": "Bei yake ni shilingi ngapi?",
    "romanization": null
  },
  "2": {
    "text": "Samahani, unazungumza Kiingereza?",
    "romanization": null
  },
  "3": {
    "text": "Bado sizungumzi lugha hii vizuri sana.",
    "romanization": null
  },
  "4": {
    "text": "Unaweza kusema polepole zaidi?",
    "romanization": null
  },
  "5": {
    "text": "Naweza kununua tiketi wapi?",
    "romanization": null
  },
  "6": {
    "text": "Kiti hiki kimekaliwa?",
    "romanization": null
  },
  "7": {
    "text": "Ningependa chumba cha mtu mmoja kwa usiku mbili.",
    "romanization": null
  },
  "8": {
    "text": "Mna chumba kinachoangalia bahari?",
    "romanization": null
  },
  "9": {
    "text": "Kifungua kinywa hutolewa saa ngapi?",
    "romanization": null
  },
  "10": {
    "text": "Naweza kuona menyu, tafadhali?",
    "romanization": null
  },
  "11": {
    "text": "Mimi sili nyama.",
    "romanization": null
  },
  "12": {
    "text": "Nina mzio wa karanga.",
    "romanization": null
  },
  "13": {
    "text": "Maji ya bomba ni salama kunywa?",
    "romanization": null
  },
  "14": {
    "text": "Tunaweza kupata bili, tafadhali?",
    "romanization": null
  },
  "15": {
    "text": "Huduma imejumuishwa kwenye bei?",
    "romanization": null
  },
  "16": {
    "text": "Naweza kulipa kwa kadi?",
    "romanization": null
  },
  "17": {
    "text": "Mnapokea pesa taslimu?",
    "romanization": null
  },
  "18": {
    "text": "Naweza kupata risiti?",
    "romanization": null
  },
  "19": {
    "text": "Bakisha chenji.",
    "romanization": null
  },
  "20": {
    "text": "Treni inaondoka kwenye jukwaa gani?",
    "romanization": null
  },
  "21": {
    "text": "Ndege imechelewa?",
    "romanization": null
  },
  "22": {
    "text": "Nimeikosa ndege yangu ya kuunganisha.",
    "romanization": null
  },
  "23": {
    "text": "Sehemu ya kuchukua mizigo iko wapi?",
    "romanization": null
  },
  "24": {
    "text": "Sanduku langu halijafika.",
    "romanization": null
  },
  "25": {
    "text": "Unaweza kuniitia teksi?",
    "romanization": null
  },
  "26": {
    "text": "Safari itachukua muda gani?",
    "romanization": null
  },
  "27": {
    "text": "Tafadhali nipeleke kwenye anwani hii.",
    "romanization": null
  },
  "28": {
    "text": "Unaweza kusimama pale kona?",
    "romanization": null
  },
  "29": {
    "text": "Kuna kituo cha metro karibu hapa?",
    "romanization": null
  },
  "30": {
    "text": "Naangalia tu, asante.",
    "romanization": null
  },
  "31": {
    "text": "Mnayo hii ya saizi ndogo zaidi?",
    "romanization": null
  },
  "32": {
    "text": "Naweza kuijaribu?",
    "romanization": null
  },
  "33": {
    "text": "Chumba cha kubadilishia kiko wapi?",
    "romanization": null
  },
  "34": {
    "text": "Hii imepunguzwa bei?",
    "romanization": null
  },
  "35": {
    "text": "Naweza kupata punguzo nikilipa kwa pesa taslimu?",
    "romanization": null
  },
  "36": {
    "text": "Hii imetengenezwa kwa mkono au kiwandani?",
    "romanization": null
  },
  "37": {
    "text": "Nitaichukua.",
    "romanization": null
  },
  "38": {
    "text": "Unaweza kuifunga kama zawadi?",
    "romanization": null
  },
  "39": {
    "text": "Dhamana yake ni ya muda gani?",
    "romanization": null
  },
  "40": {
    "text": "Nahitaji kumwona daktari.",
    "romanization": null
  },
  "41": {
    "text": "Ninaumwa na kichwa.",
    "romanization": null
  },
  "42": {
    "text": "Duka la dawa lililo karibu zaidi liko wapi?",
    "romanization": null
  },
  "43": {
    "text": "Nahitaji cheti cha daktari kwa hii?",
    "romanization": null
  },
  "44": {
    "text": "Nimepoteza pasipoti yangu.",
    "romanization": null
  },
  "45": {
    "text": "Kituo cha polisi kiko wapi?",
    "romanization": null
  },
  "46": {
    "text": "Unaweza kunisaidia, tafadhali?",
    "romanization": null
  },
  "47": {
    "text": "Nadhani nilisahau begi langu kwenye teksi.",
    "romanization": null
  },
  "48": {
    "text": "Tafadhali piga simu ya ambulansi.",
    "romanization": null
  },
  "49": {
    "text": "Kuna hospitali karibu hapa?",
    "romanization": null
  },
  "50": {
    "text": "Unaweza kupendekeza mkahawa mzuri karibu hapa?",
    "romanization": null
  },
  "51": {
    "text": "Chakula maarufu cha hapa ni kipi?",
    "romanization": null
  },
  "52": {
    "text": "Ningependa kujaribu kitu cha kienyeji.",
    "romanization": null
  },
  "53": {
    "text": "Kina pilipili?",
    "romanization": null
  },
  "54": {
    "text": "Tunaweza kukaa nje?",
    "romanization": null
  },
  "55": {
    "text": "Hatuna haraka.",
    "romanization": null
  },
  "56": {
    "text": "Chakula kilikuwa kitamu sana, asante.",
    "romanization": null
  },
  "57": {
    "text": "Naweza kupata glasi ya maji bila barafu?",
    "romanization": null
  },
  "58": {
    "text": "Chakula hiki kimetengenezwa kwa vyakula vya baharini?",
    "romanization": null
  },
  "59": {
    "text": "Naweza kuchukua hiki niende nacho?",
    "romanization": null
  },
  "60": {
    "text": "Mnafungua na kufunga saa ngapi?",
    "romanization": null
  },
  "61": {
    "text": "Kupiga picha kunaruhusiwa ndani?",
    "romanization": null
  },
  "62": {
    "text": "Kuna ziara ya kuongozwa kwa Kiingereza?",
    "romanization": null
  },
  "63": {
    "text": "Makumbusho ni bure Jumapili?",
    "romanization": null
  },
  "64": {
    "text": "Nifike mapema kiasi gani?",
    "romanization": null
  },
  "65": {
    "text": "Tiketi ni nafuu zaidi mtandaoni?",
    "romanization": null
  },
  "66": {
    "text": "Tunaweza kuruka foleni kwa tiketi hizi?",
    "romanization": null
  },
  "67": {
    "text": "Nikiwa hapa, ni kitu gani nisichopaswa kukikosa?",
    "romanization": null
  },
  "68": {
    "text": "Unaweza kutupiga picha?",
    "romanization": null
  },
  "69": {
    "text": "Ni salama kutembea usiku?",
    "romanization": null
  },
  "70": {
    "text": "Niko hapa kwa likizo.",
    "romanization": null
  },
  "71": {
    "text": "Niko hapa kikazi.",
    "romanization": null
  },
  "72": {
    "text": "Nitakaa kwa wiki moja.",
    "romanization": null
  },
  "73": {
    "text": "Ni mara yangu ya kwanza katika nchi hii.",
    "romanization": null
  },
  "74": {
    "text": "Mwenyeji wa hapa angekula chakula cha mchana wapi karibu hapa?",
    "romanization": null
  },
  "75": {
    "text": "Ni sehemu gani nzuri zaidi uliyowahi kutembelea?",
    "romanization": null
  },
  "76": {
    "text": "Safari ya ndege ilikuwa ndefu, lakini mandhari yalistahili.",
    "romanization": null
  },
  "77": {
    "text": "Ninajaribu kujifunza maneno machache ya lugha yenu.",
    "romanization": null
  },
  "78": {
    "text": "Uwe na jioni njema, na asante kwa kila kitu.",
    "romanization": null
  },
  "79": {
    "text": "Ningependa kurudi hapa siku moja.",
    "romanization": null
  }
}