{
  "0": {
    "text": "शौचालय कहाँ छ?",
    "romanization": "śaucālaya kahā̃ cha?"
  },
  "1": {
    "text": "यसको कति पर्छ?",
    "romanization": "yasako kati parcha?"
  },
  "2": {
    "text": "माफ गर्नुहोस्, तपाईं अंग्रेजी बोल्नुहुन्छ?",
    "romanization": "māph garnuhos, tapāī̃ aṅgrejī bolnuhuncha?"
  },
  "3": {
    "text": "मलाई यो भाषा अझै धेरै राम्रोसँग बोल्न आउँदैन।",
    "romanization": "malāī yo bhāṣā ajhai dherai rāmrōsaṅga bolna āũdaina."
  },
  "4": {
    "text": "अलि बिस्तारै भन्नुहुन्छ?",
    "romanization": "ali bistārai bhannuhuncha?"
  },
  "5": {
    "text": "टिकट कहाँ किन्न पाइन्छ?",
    "romanization": "ṭikaṭ kahā̃ kinna pāincha?"
  },
  "6": {
    "text": "यो सिटमा कोही बस्दै हुनुहुन्छ?",
    "romanization": "yo siṭmā kohī basdai hunuhuncha?"
  },
  "7": {
    "text": "मलाई दुई रातका लागि एक जनाको कोठा चाहिन्छ।",
    "romanization": "malāī duī rātakā lāgi ek janāko koṭhā cāhincha."
  },
  "8": {
    "text": "समुद्र देखिने कोठा छ?",
    "romanization": "samudra dekhine koṭhā cha?"
  },
  "9": {
    "text": "नास्ता कति बजे पाइन्छ?",
    "romanization": "nāstā kati baje pāincha?"
  },
  "10": {
    "text": "मेनु हेर्न पाइन्छ, कृपया?",
    "romanization": "menu herna pāincha, kṛpayā?"
  },
  "11": {
    "text": "म शाकाहारी हुँ।",
    "romanization": "ma śākāhārī hũ."
  },
  "12": {
    "text": "मलाई बदामबाट एलर्जी हुन्छ।",
    "romanization": "malāī badāmbāṭa elarjī huncha."
  },
  "13": {
    "text": "धाराको पानी पिउन सुरक्षित छ?",
    "romanization": "dhārāko pānī piuna surakṣit cha?"
  },
  "14": {
    "text": "बिल दिनुहुन्छ, कृपया?",
    "romanization": "bil dinuhuncha, kṛpayā?"
  },
  "15": {
    "text": "सेवा शुल्क समावेश छ?",
    "romanization": "sevā śulka samāveś cha?"
  },
  "16": {
    "text": "कार्डबाट तिर्न मिल्छ?",
    "romanization": "kārḍbāṭa tirna milcha?"
  },
  "17": {
    "text": "नगद लिनुहुन्छ?",
    "romanization": "nagad linuhuncha?"
  },
  "18": {
    "text": "रसिद दिनुहुन्छ?",
    "romanization": "rasid dinuhuncha?"
  },
  "19": {
    "text": "बाँकी पैसा तपाईं नै राख्नुहोस्।",
    "romanization": "bā̃kī paisā tapāī̃ nai rākhnuhos."
  },
  "20": {
    "text": "रेल कुन प्लेटफर्मबाट छुट्छ?",
    "romanization": "rel kun pleṭapharmbāṭa chuṭcha?"
  },
  "21": {
    "text": "उडान ढिला भएको हो?",
    "romanization": "uḍān ḍhilā bhaeko ho?"
  },
  "22": {
    "text": "मेरो अर्को यात्रा छुट्यो।",
    "romanization": "mero arko yātrā chuṭyo."
  },
  "23": {
    "text": "सामान लिने ठाउँ कहाँ छ?",
    "romanization": "sāmān line ṭhāũ kahā̃ cha?"
  },
  "24": {
    "text": "मेरो सुटकेस आइपुगेन।",
    "romanization": "mero suṭkes āipugena."
  },
  "25": {
    "text": "मेरो लागि ट्याक्सी बोलाइदिनुहुन्छ?",
    "romanization": "mero lāgi ṭyāksī bolāidinuhuncha?"
  },
  "26": {
    "text": "यात्रा कति समय लाग्छ?",
    "romanization": "yātrā kati samaya lāgcha?"
  },
  "27": {
    "text": "कृपया मलाई यो ठेगानामा लैजानुहोस्।",
    "romanization": "kṛpayā malāī yo ṭhegānāmā laijānuhos."
  },
  "28": {
    "text": "कुनामा रोकिदिनुहुन्छ?",
    "romanization": "kunāmā rokidinuhuncha?"
  },
  "29": {
    "text": "यहाँ नजिकै मेट्रो स्टेशन छ?",
    "romanization": "yahā̃ najikai meṭro sṭeśan cha?"
  },
  "30": {
    "text": "म हेर्दै मात्र छु, धन्यवाद।",
    "romanization": "ma herdai mātra chu, dhanyavād."
  },
  "31": {
    "text": "यो सानो साइजमा छ?",
    "romanization": "yo sāno sāijmā cha?"
  },
  "32": {
    "text": "यो लगाएर हेर्न मिल्छ?",
    "romanization": "yo lagāera herna milcha?"
  },
  "33": {
    "text": "कपडा फेर्ने कोठा कहाँ छ?",
    "romanization": "kapaḍā pherne koṭhā kahā̃ cha?"
  },
  "34": {
    "text": "यो छुटमा छ?",
    "romanization": "yo chuṭmā cha?"
  },
  "35": {
    "text": "नगद तिरेँ भने छुट पाइन्छ?",
    "romanization": "nagad tirẽ bhane chuṭ pāincha?"
  },
  "36": {
    "text": "यो हातले बनाइएको हो कि कारखानामा बनेको?",
    "romanization": "yo hātle banāieko ho ki kārkhānāmā baneko?"
  },
  "37": {
    "text": "म यही लिन्छु।",
    "romanization": "ma yahī linchu."
  },
  "38": {
    "text": "यसलाई उपहारजस्तो प्याक गरिदिनुहुन्छ?",
    "romanization": "yaslāī upahārjasto pyāk garidinuhuncha?"
  },
  "39": {
    "text": "वारेन्टी कति समयको छ?",
    "romanization": "vārenṭī kati samayako cha?"
  },
  "40": {
    "text": "मलाई डाक्टर देखाउनुपर्छ।",
    "romanization": "malāī ḍākṭar dekhāunuparcha."
  },
  "41": {
    "text": "मेरो टाउको दुखेको छ।",
    "romanization": "mero ṭāuko dukheko cha."
  },
  "42": {
    "text": "सबैभन्दा नजिकको औषधि पसल कहाँ छ?",
    "romanization": "sabaibhandā najikako auṣadhi pasal kahā̃ cha?"
  },
  "43": {
    "text": "यसका लागि डाक्टरको पर्चा चाहिन्छ?",
    "romanization": "yaskā lāgi ḍākṭarko parcā cāhincha?"
  },
  "44": {
    "text": "मेरो पासपोर्ट हरायो।",
    "romanization": "mero pāsaporṭ harāyo."
  },
  "45": {
    "text": "प्रहरी चौकी कहाँ छ?",
    "romanization": "praharī caukī kahā̃ cha?"
  },
  "46": {
    "text": "कृपया मलाई सहयोग गर्नुहुन्छ?",
    "romanization": "kṛpayā malāī sahayog garnuhuncha?"
  },
  "47": {
    "text": "मेरो झोला ट्याक्सीमै छोडेँ जस्तो लाग्छ।",
    "romanization": "mero jholā ṭyāksīmai choḍẽ jasto lāgcha."
  },
  "48": {
    "text": "कृपया एम्बुलेन्स बोलाउनुहोस्।",
    "romanization": "kṛpayā embulens bolāunuhos."
  },
  "49": {
    "text": "नजिकै अस्पताल छ?",
    "romanization": "najikai aspatāl cha?"
  },
  "50": {
    "text": "यहाँ वरिपरि राम्रो रेस्टुरेन्ट सिफारिस गर्नुहुन्छ?",
    "romanization": "yahā̃ varipari rāmrō resṭurenṭ siphāris garnuhuncha?"
  },
  "51": {
    "text": "यहाँको खास परिकार के हो?",
    "romanization": "yahā̃ko khās parikār ke ho?"
  },
  "52": {
    "text": "म केही परम्परागत खानेकुरा चाख्न चाहन्छु।",
    "romanization": "ma kehī paramparāgat khānekurā cākhna cāhanchu."
  },
  "53": {
    "text": "यो पिरो छ?",
    "romanization": "yo piro cha?"
  },
  "54": {
    "text": "हामी बाहिर बस्न सक्छौँ?",
    "romanization": "hāmī bāhira basna sakchaũ?"
  },
  "55": {
    "text": "हामीलाई हतार छैन।",
    "romanization": "hāmīlāī hatār chaina."
  },
  "56": {
    "text": "खाना निकै मिठो थियो, धन्यवाद।",
    "romanization": "khānā nikai miṭho thiyo, dhanyavād."
  },
  "57": {
    "text": "बरफ नहाली एक गिलास पानी दिनुहुन्छ?",
    "romanization": "baraph nahālī ek gilās pānī dinuhuncha?"
  },
  "58": {
    "text": "यो परिकार समुद्री खानेकुराबाट बनेको हो?",
    "romanization": "yo parikār samudrī khānekurābāṭa baneko ho?"
  },
  "59": {
    "text": "यो प्याक गरेर लैजान मिल्छ?",
    "romanization": "yo pyāk garera laijāna milcha?"
  },
  "60": {
    "text": "खुल्ने समय कति हो?",
    "romanization": "khulne samaya kati ho?"
  },
  "61": {
    "text": "भित्र फोटो खिच्न मिल्छ?",
    "romanization": "bhitra phoṭo khicna milcha?"
  },
  "62": {
    "text": "अंग्रेजीमा गाइडेड टुर छ?",
    "romanization": "aṅgrejīmā gāiḍeḍ ṭur cha?"
  },
  "63": {
    "text": "आइतबार संग्रहालय निःशुल्क हुन्छ?",
    "romanization": "āitbār saṅgrahālaya niḥśulka huncha?"
  },
  "64": {
    "text": "म कति अगाडि आइपुग्नुपर्छ?",
    "romanization": "ma kati agāḍi āipugnuparcha?"
  },
  "65": {
    "text": "अनलाइन टिकट सस्तो पर्छ?",
    "romanization": "analāin ṭikaṭ sasto parcha?"
  },
  "66": {
    "text": "यी टिकटले लाइन नबसी जान मिल्छ?",
    "romanization": "yī ṭikaṭle lāin nabasī jāna milcha?"
  },
  "67": {
    "text": "यहाँ हुँदा छुटाउनै नहुने कुरा के हो?",
    "romanization": "yahā̃ hũdā chuṭāunai nahune kurā ke ho?"
  },
  "68": {
    "text": "हाम्रो एउटा फोटो खिचिदिनुहुन्छ?",
    "romanization": "hāmro euṭā phoṭo khicidinuhuncha?"
  },
  "69": {
    "text": "राति वरिपरि हिँड्न सुरक्षित छ?",
    "romanization": "rāti varipari hĩḍna surakṣit cha?"
  },
  "70": {
    "text": "म बिदा मनाउन आएको हुँ।",
    "romanization": "ma bidā manāuna āeko hũ."
  },
  "71": {
    "text": "म कामका लागि आएको हुँ।",
    "romanization": "ma kāmkā lāgi āeko hũ."
  },
  "72": {
    "text": "म एक हप्ता बस्छु।",
    "romanization": "ma ek haptā baschu."
  },
  "73": {
    "text": "यो देशमा मेरो पहिलो पटक हो।",
    "romanization": "yo deśmā mero pahilo paṭak ho."
  },
  "74": {
    "text": "यहाँ वरिपरि स्थानीय मानिसहरू दिउँसो कहाँ खान्छन्?",
    "romanization": "yahā̃ varipari sthānīya mānisharū diũso kahā̃ khānchan?"
  },
  "75": {
    "text": "तपाईंले घुम्नुभएको सबैभन्दा सुन्दर ठाउँ कुन हो?",
    "romanization": "tapāī̃le ghumnubhaeko sabaibhandā sundar ṭhāũ kun ho?"
  },
  "76": {
    "text": "उडान लामो थियो, तर दृश्य हेर्दा सबै थकाइ सार्थक लाग्यो।",
    "romanization": "uḍān lāmo thiyo, tara dṛśya herdā sabai thakāi sārthak lāgyo."
  },
  "77": {
    "text": "म तपाईंको भाषाका केही शब्द सिक्न खोज्दै छु।",
    "romanization": "ma tapāī̃ko bhāṣākā kehī śabda sikna khojdai chu."
  },
  "78": {
    "text": "शुभ साँझ, र सबै कुराका लागि धन्यवाद।",
    "romanization": "śubh sā̃jh, ra sabai kurākā lāgi dhanyavād."
  },
  "79": {
    "text": "कुनै दिन फेरि यहाँ आउन मन छ।",
    "romanization": "kunai din pheri yahā̃ āuna man cha."
  }
}