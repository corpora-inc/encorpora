{
  "0": {
    "text": "Tuvalet nerede?",
    "romanization": null
  },
  "1": {
    "text": "Ne kadar tutuyor?",
    "romanization": null
  },
  "2": {
    "text": "Affedersiniz, İngilizce biliyor musunuz?",
    "romanization": null
  },
  "3": {
    "text": "Dili henüz çok iyi konuşamıyorum.",
    "romanization": null
  },
  "4": {
    "text": "Biraz daha yavaş söyler misiniz?",
    "romanization": null
  },
  "5": {
    "text": "Nereden bilet alabilirim?",
    "romanization": null
  },
  "6": {
    "text": "Bu koltuk dolu mu?",
    "romanization": null
  },
  "7": {
    "text": "İki gecelik tek kişilik bir oda istiyorum.",
    "romanization": null
  },
  "8": {
    "text": "Deniz manzaralı bir odanız var mı?",
    "romanization": null
  },
  "9": {
    "text": "Kahvaltı saat kaçta veriliyor?",
    "romanization": null
  },
  "10": {
    "text": "Menüyü görebilir miyim lütfen?",
    "romanization": null
  },
  "11": {
    "text": "Ben vejetaryenim.",
    "romanization": null
  },
  "12": {
    "text": "Yer fıstığına alerjim var.",
    "romanization": null
  },
  "13": {
    "text": "Musluk suyu içmek için güvenli mi?",
    "romanization": null
  },
  "14": {
    "text": "Hesabı alabilir miyiz lütfen?",
    "romanization": null
  },
  "15": {
    "text": "Servis ücreti dahil mi?",
    "romanization": null
  },
  "16": {
    "text": "Kartla ödeme yapabilir miyim?",
    "romanization": null
  },
  "17": {
    "text": "Nakit kabul ediyor musunuz?",
    "romanization": null
  },
  "18": {
    "text": "Fiş alabilir miyim?",
    "romanization": null
  },
  "19": {
    "text": "Üstü kalsın.",
    "romanization": null
  },
  "20": {
    "text": "Tren hangi perondan kalkıyor?",
    "romanization": null
  },
  "21": {
    "text": "Uçak rötar yaptı mı?",
    "romanization": null
  },
  "22": {
    "text": "Aktarma uçuşumu kaçırdım.",
    "romanization": null
  },
  "23": {
    "text": "Bagaj teslim yeri nerede?",
    "romanization": null
  },
  "24": {
    "text": "Valizim gelmedi.",
    "romanization": null
  },
  "25": {
    "text": "Benim için bir taksi çağırabilir misiniz?",
    "romanization": null
  },
  "26": {
    "text": "Yolculuk ne kadar sürer?",
    "romanization": null
  },
  "27": {
    "text": "Lütfen beni bu adrese götürün.",
    "romanization": null
  },
  "28": {
    "text": "Köşede durabilir misiniz?",
    "romanization": null
  },
  "29": {
    "text": "Buralarda metro istasyonu var mı?",
    "romanization": null
  },
  "30": {
    "text": "Sadece bakıyorum, teşekkürler.",
    "romanization": null
  },
  "31": {
    "text": "Bunun daha küçük bedeni var mı?",
    "romanization": null
  },
  "32": {
    "text": "Deneyebilir miyim?",
    "romanization": null
  },
  "33": {
    "text": "Deneme kabini nerede?",
    "romanization": null
  },
  "34": {
    "text": "Bu indirimde mi?",
    "romanization": null
  },
  "35": {
    "text": "Nakit ödersem indirim yapar mısınız?",
    "romanization": null
  },
  "36": {
    "text": "Bu el yapımı mı, fabrikasyon mu?",
    "romanization": null
  },
  "37": {
    "text": "Bunu alıyorum.",
    "romanization": null
  },
  "38": {
    "text": "Hediye paketi yapabilir misiniz?",
    "romanization": null
  },
  "39": {
    "text": "Garantisi ne kadar sürüyor?",
    "romanization": null
  },
  "40": {
    "text": "Bir doktora görünmem gerekiyor.",
    "romanization": null
  },
  "41": {
    "text": "Başım ağrıyor.",
    "romanization": null
  },
  "42": {
    "text": "En yakın eczane nerede?",
    "romanization": null
  },
  "43": {
    "text": "Bunun için reçete gerekiyor mu?",
    "romanization": null
  },
  "44": {
    "text": "Pasaportumu kaybettim.",
    "romanization": null
  },
  "45": {
    "text": "Polis merkezi nerede?",
    "romanization": null
  },
  "46": {
    "text": "Bana yardım edebilir misiniz lütfen?",
    "romanization": null
  },
  "47": {
    "text": "Sanırım çantamı takside unuttum.",
    "romanization": null
  },
  "48": {
    "text": "Lütfen ambulans çağırın.",
    "romanization": null
  },
  "49": {
    "text": "Yakınlarda hastane var mı?",
    "romanization": null
  },
  "50": {
    "text": "Buralarda iyi bir restoran önerebilir misiniz?",
    "romanization": null
  },
  "51": {
    "text": "Buranın yerel lezzeti nedir?",
    "romanization": null
  },
  "52": {
    "text": "Geleneksel bir şey denemek istiyorum.",
    "romanization": null
  },
  "53": {
    "text": "Acı mı?",
    "romanization": null
  },
  "54": {
    "text": "Dışarıda oturabilir miyiz?",
    "romanization": null
  },
  "55": {
    "text": "Acelimiz yok.",
    "romanization": null
  },
  "56": {
    "text": "Yemek çok lezzetliydi, teşekkür ederiz.",
    "romanization": null
  },
  "57": {
    "text": "Buzsuz bir bardak su alabilir miyim?",
    "romanization": null
  },
  "58": {
    "text": "Bu yemekte deniz ürünü var mı?",
    "romanization": null
  },
  "59": {
    "text": "Bunu paket yaptırabilir miyim?",
    "romanization": null
  },
  "60": {
    "text": "Çalışma saatleri nedir?",
    "romanization": null
  },
  "61": {
    "text": "İçeride fotoğraf çekmek serbest mi?",
    "romanization": null
  },
  "62": {
    "text": "İngilizce rehberli tur var mı?",
    "romanization": null
  },
  "63": {
    "text": "Müze pazar günleri ücretsiz mi?",
    "romanization": null
  },
  "64": {
    "text": "Ne kadar erken gelmeliyim?",
    "romanization": null
  },
  "65": {
    "text": "Biletler internette daha ucuz mu?",
    "romanization": null
  },
  "66": {
    "text": "Bu biletlerle sırayı atlayabilir miyiz?",
    "romanization": null
  },
  "67": {
    "text": "Buradayken kesinlikle neyi görmeliyim?",
    "romanization": null
  },
  "68": {
    "text": "Fotoğrafımızı çekebilir misiniz?",
    "romanization": null
  },
  "69": {
    "text": "Gece buralarda yürümek güvenli mi?",
    "romanization": null
  },
  "70": {
    "text": "Tatil için buradayım.",
    "romanization": null
  },
  "71": {
    "text": "İş için buradayım.",
    "romanization": null
  },
  "72": {
    "text": "Bir hafta kalacağım.",
    "romanization": null
  },
  "73": {
    "text": "Bu ülkeye ilk gelişim.",
    "romanization": null
  },
  "74": {
    "text": "Buralarda yerel halk öğle yemeğini nerede yer?",
    "romanization": null
  },
  "75": {
    "text": "Gezdiğiniz en güzel yer neresi?",
    "romanization": null
  },
  "76": {
    "text": "Uçuş uzundu ama manzara buna değdi.",
    "romanization": null
  },
  "77": {
    "text": "Dilinizde birkaç kelime öğrenmeye çalışıyorum.",
    "romanization": null
  },
  "78": {
    "text": "İyi akşamlar, her şey için teşekkür ederim.",
    "romanization": null
  },
  "79": {
    "text": "Bir gün buraya tekrar gelmeyi çok isterim.",
    "romanization": null
  }
}