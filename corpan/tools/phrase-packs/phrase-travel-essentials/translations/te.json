{
  "0": {
    "text": "బాత్రూం ఎక్కడ ఉంది?",
    "romanization": "bātrūṃ ekkaḍa undi?"
  },
  "1": {
    "text": "ఇది ఎంత అవుతుంది?",
    "romanization": "idi enta avutundi?"
  },
  "2": {
    "text": "క్షమించండి, మీకు ఇంగ్లీష్ వచ్చా?",
    "romanization": "kṣamin̄caṇḍi, mīku iṅglīṣ vaccā?"
  },
  "3": {
    "text": "నాకు ఈ భాష ఇంకా అంత బాగా రాదు.",
    "romanization": "nāku ī bhāṣa iṅkā anta bāgā rādu."
  },
  "4": {
    "text": "కొంచెం నెమ్మదిగా చెప్పగలరా?",
    "romanization": "kon̄ceṃ nemmadigā ceppagalarā?"
  },
  "5": {
    "text": "టికెట్ ఎక్కడ కొనగలను?",
    "romanization": "ṭikeṭ ekkaḍa konagalanu?"
  },
  "6": {
    "text": "ఈ సీట్లో ఎవరైనా కూర్చున్నారా?",
    "romanization": "ī sīṭlō evarainā kūrcunnārā?"
  },
  "7": {
    "text": "రెండు రాత్రులకు ఒక సింగిల్ రూమ్ కావాలి.",
    "romanization": "reṇḍu rātrulaku oka siṅgil rūm kāvāli."
  },
  "8": {
    "text": "సముద్రం కనిపించే రూమ్ ఉందా?",
    "romanization": "samudraṃ kanipin̄cē rūm undā?"
  },
  "9": {
    "text": "బ్రేక్‌ఫాస్ట్ ఎన్ని గంటలకు ఇస్తారు?",
    "romanization": "brēkphāsṭ enni gaṇṭalaku istāru?"
  },
  "10": {
    "text": "మెనూ చూపించగలరా, దయచేసి?",
    "romanization": "menū cūpin̄cagalarā, dayacēsi?"
  },
  "11": {
    "text": "నేను శాకాహారిని.",
    "romanization": "nēnu śākāhārini."
  },
  "12": {
    "text": "నాకు వేరుశెనగతో అలర్జీ ఉంది.",
    "romanization": "nāku vēruśenagatō alarjī undi."
  },
  "13": {
    "text": "ట్యాప్ నీళ్లు తాగడానికి సురక్షితమేనా?",
    "romanization": "ṭyāp nīḷlu tāgaḍāniki surakṣitamēnā?"
  },
  "14": {
    "text": "బిల్ ఇవ్వగలరా, దయచేసి?",
    "romanization": "bil ivvagalarā, dayacēsi?"
  },
  "15": {
    "text": "సర్వీస్ ఛార్జ్ ఇందులో కలిసే ఉందా?",
    "romanization": "sarvīs chārj indulō kalisē undā?"
  },
  "16": {
    "text": "కార్డ్‌తో చెల్లించవచ్చా?",
    "romanization": "kārḍtō cellin̄cavaccā?"
  },
  "17": {
    "text": "నగదు తీసుకుంటారా?",
    "romanization": "nagadu tīsukuṇṭārā?"
  },
  "18": {
    "text": "రసీదు ఇవ్వగలరా?",
    "romanization": "rasīdu ivvagalarā?"
  },
  "19": {
    "text": "చిల్లర మీ దగ్గరే ఉంచుకోండి.",
    "romanization": "cillara mī daggarē un̄cukōṇḍi."
  },
  "20": {
    "text": "రైలు ఏ ప్లాట్‌ఫామ్ నుంచి బయలుదేరుతుంది?",
    "romanization": "railu ē plāṭphām nun̄ci bayaludērutundi?"
  },
  "21": {
    "text": "ఫ్లైట్ ఆలస్యమైందా?",
    "romanization": "phlaiṭ ālasyamaindā?"
  },
  "22": {
    "text": "నా కనెక్టింగ్ ప్రయాణం మిస్ అయింది.",
    "romanization": "nā kanekṭiṅg prayāṇaṃ mis ayindi."
  },
  "23": {
    "text": "బ్యాగేజ్ క్లెయిమ్ ఎక్కడ ఉంది?",
    "romanization": "byāgēj kleym ekkaḍa undi?"
  },
  "24": {
    "text": "నా సూట్‌కేస్ రాలేదు.",
    "romanization": "nā sūṭkēs rālēdu."
  },
  "25": {
    "text": "నా కోసం టాక్సీ పిలవగలరా?",
    "romanization": "nā kōsaṃ ṭāksī pilavagalara?"
  },
  "26": {
    "text": "ప్రయాణానికి ఎంత సమయం పడుతుంది?",
    "romanization": "prayāṇāniki enta samayaṃ paḍutundi?"
  },
  "27": {
    "text": "దయచేసి నన్ను ఈ చిరునామాకు తీసుకెళ్లండి.",
    "romanization": "dayacēsi nannu ī cirunāmāku tīsukeḷḷaṇḍi."
  },
  "28": {
    "text": "ఆ మూల దగ్గర ఆపగలరా?",
    "romanization": "ā mūla daggara āpagalarā?"
  },
  "29": {
    "text": "ఇక్కడ దగ్గర్లో మెట్రో స్టేషన్ ఉందా?",
    "romanization": "ikkaḍa daggarlō meṭrō sṭēṣan undā?"
  },
  "30": {
    "text": "నేను చూస్తున్నానంతే, ధన్యవాదాలు.",
    "romanization": "nēnu cūstunnānante, dhan'yavādālu."
  },
  "31": {
    "text": "ఇది చిన్న సైజులో ఉందా?",
    "romanization": "idi cinna saijulō undā?"
  },
  "32": {
    "text": "దీన్ని వేసి చూసుకోవచ్చా?",
    "romanization": "dīnni vēsi cūsukōvaccā?"
  },
  "33": {
    "text": "ట్రయల్ రూమ్ ఎక్కడ ఉంది?",
    "romanization": "ṭrayal rūm ekkaḍa undi?"
  },
  "34": {
    "text": "ఇది సేల్‌లో ఉందా?",
    "romanization": "idi sēllō undā?"
  },
  "35": {
    "text": "నగదుగా చెల్లిస్తే డిస్కౌంట్ ఇస్తారా?",
    "romanization": "nagadugā cellistē ḍiskauṇṭ istārā?"
  },
  "36": {
    "text": "ఇది చేతితో చేసినదా, ఫ్యాక్టరీలో చేసినదా?",
    "romanization": "idi cētitō cēsinadā, phyākṭarīlō cēsinadā?"
  },
  "37": {
    "text": "ఇదే తీసుకుంటాను.",
    "romanization": "idē tīsukuṇṭānu."
  },
  "38": {
    "text": "దీన్ని గిఫ్ట్‌లా ప్యాక్ చేయగలరా?",
    "romanization": "dīnni giphṭlā pyāk cēyagalarā?"
  },
  "39": {
    "text": "వారంటీ ఎంత కాలం ఉంటుంది?",
    "romanization": "vāraṇṭī enta kālaṃ uṇṭundi?"
  },
  "40": {
    "text": "నాకు డాక్టర్‌ను కలవాలి.",
    "romanization": "nāku ḍākṭarnu kalavāli."
  },
  "41": {
    "text": "నాకు తలనొప్పి ఉంది.",
    "romanization": "nāku talanoppi undi."
  },
  "42": {
    "text": "దగ్గర్లో ఉన్న ఫార్మసీ ఎక్కడ?",
    "romanization": "daggarlō unna phārmasī ekkaḍa?"
  },
  "43": {
    "text": "దీనికి ప్రిస్క్రిప్షన్ అవసరమా?",
    "romanization": "dīniki priskripṣan avasaramā?"
  },
  "44": {
    "text": "నా పాస్‌పోర్ట్ పోయింది.",
    "romanization": "nā pāspōrṭ pōyindi."
  },
  "45": {
    "text": "పోలీస్ స్టేషన్ ఎక్కడ ఉంది?",
    "romanization": "pōlīs sṭēṣan ekkaḍa undi?"
  },
  "46": {
    "text": "దయచేసి నాకు సహాయం చేయగలరా?",
    "romanization": "dayacēsi nāku sahāyaṃ cēyagalarā?"
  },
  "47": {
    "text": "నా బ్యాగ్ టాక్సీలో వదిలేసినట్టు అనిపిస్తోంది.",
    "romanization": "nā byāg ṭāksīlō vadilēsinaṭṭu anipistōndi."
  },
  "48": {
    "text": "దయచేసి అంబులెన్స్‌కి కాల్ చేయండి.",
    "romanization": "dayacēsi ambulenski kāl cēyaṇḍi."
  },
  "49": {
    "text": "ఇక్కడ దగ్గర్లో ఆసుపత్రి ఉందా?",
    "romanization": "ikkaḍa daggarlō āsupatri undā?"
  },
  "50": {
    "text": "ఇక్కడ దగ్గర్లో మంచి రెస్టారెంట్ ఏదైనా సూచిస్తారా?",
    "romanization": "ikkaḍa daggarlō man̄ci resṭāreṇṭ ēdainā sūcistārā?"
  },
  "51": {
    "text": "ఇక్కడి ప్రత్యేక వంటకం ఏంటి?",
    "romanization": "ikkaḍi pratyēka vaṇṭakaṃ ēṇṭi?"
  },
  "52": {
    "text": "ఏదైనా సంప్రదాయ వంటకం రుచి చూడాలనుకుంటున్నాను.",
    "romanization": "ēdainā sampradāya vaṇṭakaṃ ruci cūḍālanukuṇṭunnānu."
  },
  "53": {
    "text": "ఇది కారంగా ఉంటుందా?",
    "romanization": "idi kāraṅgā uṇṭundā?"
  },
  "54": {
    "text": "మేము బయట కూర్చోవచ్చా?",
    "romanization": "mēmu bayaṭa kūrcōvaccā?"
  },
  "55": {
    "text": "మాకు తొందర లేదు.",
    "romanization": "māku tondara lēdu."
  },
  "56": {
    "text": "భోజనం చాలా రుచిగా ఉంది, ధన్యవాదాలు.",
    "romanization": "bhōjanaṃ cālā rucigā undi, dhan'yavādālu."
  },
  "57": {
    "text": "ఐస్ లేకుండా ఒక గ్లాస్ నీళ్లు ఇవ్వగలరా?",
    "romanization": "ais lēkuṇḍā oka glās nīḷlu ivvagalarā?"
  },
  "58": {
    "text": "ఈ వంటకంలో సముద్రపు ఆహారం ఉందా?",
    "romanization": "ī vaṇṭakanlō samudrapu āhāraṃ undā?"
  },
  "59": {
    "text": "దీన్ని పార్సెల్‌గా తీసుకెళ్లవచ్చా?",
    "romanization": "dīnni pārs elgā tīsukeḷḷavaccā?"
  },
  "60": {
    "text": "తెరిచి ఉండే సమయాలు ఏంటి?",
    "romanization": "terici uṇḍē samayālu ēṇṭi?"
  },
  "61": {
    "text": "లోపల ఫోటోలు తీయడానికి అనుమతి ఉందా?",
    "romanization": "lōpala phōṭōlu tīyaḍāniki anumati undā?"
  },
  "62": {
    "text": "ఇంగ్లీష్‌లో గైడెడ్ టూర్ ఉందా?",
    "romanization": "iṅglīṣlō gaiḍeḍ ṭūr undā?"
  },
  "63": {
    "text": "ఆదివారాల్లో మ్యూజియం ఉచితమా?",
    "romanization": "ādivārāllō myūjiyaṃ ucitamā?"
  },
  "64": {
    "text": "నేను ఎంత ముందుగా రావాలి?",
    "romanization": "nēnu enta mundugā rāvali?"
  },
  "65": {
    "text": "టికెట్లు ఆన్‌లైన్‌లో తక్కువ ధరకు దొరుకుతాయా?",
    "romanization": "ṭikeṭlu ānlainlō takkuva dharaku dorukutāyā?"
  },
  "66": {
    "text": "ఈ టికెట్లతో క్యూలో నిలబడకుండా వెళ్లవచ్చా?",
    "romanization": "ī ṭikeṭlatō kyūlō nilabaḍakuṇḍā veḷḷavaccā?"
  },
  "67": {
    "text": "ఇక్కడికి వచ్చాక తప్పకుండా చూడాల్సింది ఏంటి?",
    "romanization": "ikkaḍiki vaccāka tappakuṇḍā cūḍālsindi ēṇṭi?"
  },
  "68": {
    "text": "మా ఫోటో ఒకటి తీసి పెట్టగలరా?",
    "romanization": "mā phōṭō okaṭi tīsi peṭṭagalarā?"
  },
  "69": {
    "text": "రాత్రి ఇక్కడ నడవడం సురక్షితమేనా?",
    "romanization": "rātri ikkaḍa naḍavaḍaṃ surakṣitamēnā?"
  },
  "70": {
    "text": "నేను సెలవుల కోసం ఇక్కడికి వచ్చాను.",
    "romanization": "nēnu selavula kōsaṃ ikkaḍiki vaccānu."
  },
  "71": {
    "text": "నేను పని కోసం ఇక్కడికి వచ్చాను.",
    "romanization": "nēnu pani kōsaṃ ikkaḍiki vaccānu."
  },
  "72": {
    "text": "నేను వారం రోజుల పాటు ఇక్కడ ఉంటాను.",
    "romanization": "nēnu vāraṃ rōjula pāṭu ikkaḍa uṇṭānu."
  },
  "73": {
    "text": "ఈ దేశానికి రావడం నాకు ఇదే మొదటిసారి.",
    "romanization": "ī dēśāniki rāvaḍaṃ nāku idē modaṭisāri."
  },
  "74": {
    "text": "ఇక్కడ దగ్గర్లో స్థానికులు లంచ్‌కు ఎక్కడికి వెళ్తారు?",
    "romanization": "ikkaḍa daggarlō sthānikulu lan̄cuku ekkaḍiki veḷtāru?"
  },
  "75": {
    "text": "మీరు చూసిన ప్రదేశాల్లో అత్యంత అందమైనది ఏది?",
    "romanization": "mīru cūsina pradēśāllō atyanta andamainadi ēdi?"
  },
  "76": {
    "text": "ఫ్లైట్ పొడవుగా ఉంది, కానీ ఆ దృశ్యం చూసాక విలువైనదే అనిపించింది.",
    "romanization": "phlaiṭ poḍavugā undi, kānī ā dr̥śyaṃ cūsāka viluvainadē anipin̄cindi."
  },
  "77": {
    "text": "మీ భాషలో కొన్ని పదాలు నేర్చుకోవడానికి ప్రయత్నిస్తున్నాను.",
    "romanization": "mī bhāṣalō konni padālu nērcukōvaḍāniki prayatnistunnānu."
  },
  "78": {
    "text": "మీ సాయంత్రం బాగా గడవాలి, అన్నింటికీ ధన్యవాదాలు.",
    "romanization": "mī sāyantraṃ bāgā gaḍavāli, anniṇṭikī dhan'yavādālu."
  },
  "79": {
    "text": "ఏదో ఒక రోజు మళ్లీ ఇక్కడికి రావాలని ఉంది.",
    "romanization": "ēdō oka rōju maḷḷī ikkaḍiki rāvalani undi."
  }
}