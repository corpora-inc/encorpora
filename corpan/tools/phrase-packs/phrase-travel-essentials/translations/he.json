{
  "0": {
    "text": "איפה השירותים?",
    "romanization": "eifo ha-sherutim?"
  },
  "1": {
    "text": "כמה זה עולה?",
    "romanization": "kama ze ole?"
  },
  "2": {
    "text": "סליחה, אתה מדבר אנגלית?",
    "romanization": "slicha, ata medaber anglit?"
  },
  "3": {
    "text": "אני עדיין לא מדבר את השפה כל כך טוב.",
    "romanization": "ani adayin lo medaber et ha-safa kol kach tov."
  },
  "4": {
    "text": "אפשר להגיד את זה יותר לאט?",
    "romanization": "efshar lehagid et ze yoter le'at?"
  },
  "5": {
    "text": "איפה אפשר לקנות כרטיס?",
    "romanization": "eifo efshar liknot kartis?"
  },
  "6": {
    "text": "המקום הזה תפוס?",
    "romanization": "ha-makom haze tafus?"
  },
  "7": {
    "text": "אני רוצה חדר ליחיד לשני לילות.",
    "romanization": "ani rotze cheder le-yachid le-shnei leilot."
  },
  "8": {
    "text": "יש לכם חדר עם נוף לים?",
    "romanization": "yesh lachem cheder im nof la-yam?"
  },
  "9": {
    "text": "באיזו שעה מגישים ארוחת בוקר?",
    "romanization": "be'eizo sha'a magishim aruchat boker?"
  },
  "10": {
    "text": "אפשר לראות את התפריט, בבקשה?",
    "romanization": "efshar lir'ot et ha-tafrit, bevakasha?"
  },
  "11": {
    "text": "אני צמחוני.",
    "romanization": "ani tzimchoni."
  },
  "12": {
    "text": "אני אלרגי לבוטנים.",
    "romanization": "ani alergi le-botnim."
  },
  "13": {
    "text": "אפשר לשתות את מי הברז?",
    "romanization": "efshar lishtot et mei ha-berez?"
  },
  "14": {
    "text": "אפשר לקבל חשבון, בבקשה?",
    "romanization": "efshar lekabel cheshbon, bevakasha?"
  },
  "15": {
    "text": "השירות כלול?",
    "romanization": "ha-sherut kalul?"
  },
  "16": {
    "text": "אפשר לשלם בכרטיס?",
    "romanization": "efshar leshalem be-kartis?"
  },
  "17": {
    "text": "אתם מקבלים מזומן?",
    "romanization": "atem mekablim mezuman?"
  },
  "18": {
    "text": "אפשר לקבל קבלה?",
    "romanization": "efshar lekabel kabala?"
  },
  "19": {
    "text": "תשאיר את העודף.",
    "romanization": "tash'ir et ha-odef."
  },
  "20": {
    "text": "מאיזה רציף הרכבת יוצאת?",
    "romanization": "me'eize ratzif ha-rakevet yotzet?"
  },
  "21": {
    "text": "הטיסה התעכבה?",
    "romanization": "ha-tisa hit'akva?"
  },
  "22": {
    "text": "פספסתי את הקונקשן שלי.",
    "romanization": "fisfasti et ha-connection sheli."
  },
  "23": {
    "text": "איפה איסוף הכבודה?",
    "romanization": "eifo isuf ha-kvuda?"
  },
  "24": {
    "text": "המזוודה שלי לא הגיעה.",
    "romanization": "ha-mizvada sheli lo higi'a."
  },
  "25": {
    "text": "אפשר להזמין לי מונית?",
    "romanization": "efshar lehazmin li monit?"
  },
  "26": {
    "text": "כמה זמן הנסיעה לוקחת?",
    "romanization": "kama zman ha-nesi'a lokachat?"
  },
  "27": {
    "text": "קח אותי לכתובת הזאת, בבקשה.",
    "romanization": "kach oti la-ktovet hazot, bevakasha."
  },
  "28": {
    "text": "אפשר לעצור בפינה?",
    "romanization": "efshar la'atzor ba-pina?"
  },
  "29": {
    "text": "יש תחנת מטרו קרוב לכאן?",
    "romanization": "yesh tachanat metro karov le-kan?"
  },
  "30": {
    "text": "אני רק מסתכל, תודה.",
    "romanization": "ani rak mistakel, toda."
  },
  "31": {
    "text": "יש לכם את זה במידה קטנה יותר?",
    "romanization": "yesh lachem et ze be-mida ktana yoter?"
  },
  "32": {
    "text": "אפשר למדוד את זה?",
    "romanization": "efshar limdod et ze?"
  },
  "33": {
    "text": "איפה תא המדידה?",
    "romanization": "eifo ta ha-medida?"
  },
  "34": {
    "text": "זה במבצע?",
    "romanization": "ze be-mivtza?"
  },
  "35": {
    "text": "יש הנחה אם אני משלם במזומן?",
    "romanization": "yesh hanacha im ani meshalem be-mezuman?"
  },
  "36": {
    "text": "זה עבודת יד או ייצור תעשייתי?",
    "romanization": "ze avodat yad o yitzur ta'asiyati?"
  },
  "37": {
    "text": "אני אקח את זה.",
    "romanization": "ani ekach et ze."
  },
  "38": {
    "text": "אפשר לעטוף את זה כמתנה?",
    "romanization": "efshar la'atof et ze ke-matana?"
  },
  "39": {
    "text": "לכמה זמן האחריות?",
    "romanization": "le-kama zman ha-achrayut?"
  },
  "40": {
    "text": "אני צריך לראות רופא.",
    "romanization": "ani tzrich lir'ot rofe."
  },
  "41": {
    "text": "כואב לי הראש.",
    "romanization": "ko'ev li ha-rosh."
  },
  "42": {
    "text": "איפה בית המרקחת הקרוב ביותר?",
    "romanization": "eifo beit ha-mirkachat ha-karov beyoter?"
  },
  "43": {
    "text": "צריך מרשם בשביל זה?",
    "romanization": "tzarich mirsham bishvil ze?"
  },
  "44": {
    "text": "איבדתי את הדרכון שלי.",
    "romanization": "ibadeti et ha-darkon sheli."
  },
  "45": {
    "text": "איפה תחנת המשטרה?",
    "romanization": "eifo tachanat ha-mishtara?"
  },
  "46": {
    "text": "אפשר לעזור לי, בבקשה?",
    "romanization": "efshar la'azor li, bevakasha?"
  },
  "47": {
    "text": "אני חושב שהשארתי את התיק שלי במונית.",
    "romanization": "ani choshev she-hish'arti et ha-tik sheli ba-monit."
  },
  "48": {
    "text": "בבקשה תזמינו אמבולנס.",
    "romanization": "bevakasha tazminu ambulanс."
  },
  "49": {
    "text": "יש בית חולים באזור?",
    "romanization": "yesh beit cholim ba-ezor?"
  },
  "50": {
    "text": "אפשר להמליץ על מסעדה טובה באזור?",
    "romanization": "efshar lehamlitz al mis'ada tova ba-ezor?"
  },
  "51": {
    "text": "מה המנה המקומית המיוחדת?",
    "romanization": "ma ha-mana ha-mekomit ha-meyuchedet?"
  },
  "52": {
    "text": "אני רוצה לנסות משהו מסורתי.",
    "romanization": "ani rotze lenasot mashehu masorti."
  },
  "53": {
    "text": "זה חריף?",
    "romanization": "ze charif?"
  },
  "54": {
    "text": "אפשר לשבת בחוץ?",
    "romanization": "efshar lashevet ba-chutz?"
  },
  "55": {
    "text": "אנחנו לא ממהרים.",
    "romanization": "anachnu lo memaharim."
  },
  "56": {
    "text": "האוכל היה ממש טעים, תודה.",
    "romanization": "ha-ochel haya mamash ta'im, toda."
  },
  "57": {
    "text": "אפשר כוס מים בלי קרח?",
    "romanization": "efshar kos mayim bli kerach?"
  },
  "58": {
    "text": "המנה הזאת מכילה פירות ים?",
    "romanization": "ha-mana hazot mechila peirot yam?"
  },
  "59": {
    "text": "אפשר לקחת את זה בטייק אוויי?",
    "romanization": "efshar lakachat et ze be-take away?"
  },
  "60": {
    "text": "מה שעות הפתיחה?",
    "romanization": "ma sha'ot ha-pticha?"
  },
  "61": {
    "text": "מותר לצלם בפנים?",
    "romanization": "mutar letzalem bifnim?"
  },
  "62": {
    "text": "יש סיור מודרך באנגלית?",
    "romanization": "yesh siyur mudrach be-anglit?"
  },
  "63": {
    "text": "המוזיאון פתוח בחינם בימי ראשון?",
    "romanization": "ha-muze'on patuach be-chinam be-yemei rishon?"
  },
  "64": {
    "text": "כמה מוקדם כדאי להגיע?",
    "romanization": "kama mukdam kedai lehagi'a?"
  },
  "65": {
    "text": "הכרטיסים זולים יותר באינטרנט?",
    "romanization": "ha-kartisim zolim yoter ba-internet?"
  },
  "66": {
    "text": "אפשר לדלג על התור עם הכרטיסים האלה?",
    "romanization": "efshar ledaleg al ha-tor im ha-kartisim ha-ele?"
  },
  "67": {
    "text": "מה לא כדאי לפספס כאן?",
    "romanization": "ma lo kedai lefasfes kan?"
  },
  "68": {
    "text": "אפשר לצלם אותנו?",
    "romanization": "efshar letzalem otanu?"
  },
  "69": {
    "text": "בטוח להסתובב כאן בלילה?",
    "romanization": "batuach lehistovev kan ba-laila?"
  },
  "70": {
    "text": "אני כאן בחופשה.",
    "romanization": "ani kan be-chufsha."
  },
  "71": {
    "text": "אני כאן בענייני עבודה.",
    "romanization": "ani kan be-inyenei avoda."
  },
  "72": {
    "text": "אני אשאר כאן שבוע.",
    "romanization": "ani esha'er kan shavua."
  },
  "73": {
    "text": "זאת הפעם הראשונה שלי במדינה הזאת.",
    "romanization": "zot ha-pa'am ha-rishona sheli ba-medina hazot."
  },
  "74": {
    "text": "איפה מקומי היה אוכל כאן צהריים?",
    "romanization": "eifo mekomi haya ochel kan tzohorayim?"
  },
  "75": {
    "text": "מה המקום הכי יפה שביקרת בו?",
    "romanization": "ma ha-makom hachi yafe she-bikarta bo?"
  },
  "76": {
    "text": "הטיסה הייתה ארוכה, אבל הנוף היה שווה את זה.",
    "romanization": "ha-tisa hayta aruka, aval ha-nof haya shave et ze."
  },
  "77": {
    "text": "אני מנסה ללמוד כמה מילים בשפה שלכם.",
    "romanization": "ani menase lilmod kama milim ba-safa shelachem."
  },
  "78": {
    "text": "ערב טוב, ותודה על הכול.",
    "romanization": "erev tov, ve-toda al hakol."
  },
  "79": {
    "text": "אשמח לחזור לכאן יום אחד.",
    "romanization": "esmach lachzor le-kan yom echad."
  }
}