{
  "0": {
    "text": "ఉల్లిపాయను సన్నగా తరగండి.",
    "romanization": "ullipāyanu sannagā taragaṇḍi."
  },
  "1": {
    "text": "పాస్తా వేసే ముందు నీటిని మరిగించండి.",
    "romanization": "pāstā vēse mundu nīṭini marigaṇḍi."
  },
  "2": {
    "text": "సాస్ మరుగుతున్నప్పుడు కలుపుతూ ఉండండి.",
    "romanization": "sās marugutunnappuḍu kaluputū uṇḍaṇḍi."
  },
  "3": {
    "text": "చికెన్‌కు ఉప్పు, మిరియాలు వేయండి.",
    "romanization": "cikeṉku uppu, miriyālu vēyaṇḍi."
  },
  "4": {
    "text": "గుడ్లు నురుగు వచ్చే వరకు గిలకొట్టండి.",
    "romanization": "guḍlu nurugu vacce varaku gilakoṭṭaṇḍi."
  },
  "5": {
    "text": "పిండిని మెల్లగా కలపండి.",
    "romanization": "piṇḍini mellagā kalapaṇḍi."
  },
  "6": {
    "text": "మాంసాన్ని కొన్ని నిమిషాలు పక్కన పెట్టండి.",
    "romanization": "māṁsānni konni nimiṣālu pakkana peṭṭaṇḍi."
  },
  "7": {
    "text": "కూరగాయలను ఎక్కువ మంటపై వేయించండి.",
    "romanization": "kūragāyalanu ekkuva maṇṭapai vēyiṁcaṇḍi."
  },
  "8": {
    "text": "బ్రెడ్‌ను క్రాస్‌గా కోయండి.",
    "romanization": "breḍnu krāsugā kōyaṇḍi."
  },
  "9": {
    "text": "వెల్లుల్లిని వేయించండి, కానీ మాడ్చకండి.",
    "romanization": "vellullini vēyiṁcaṇḍi, kānī māḍcakkaṇḍi."
  },
  "10": {
    "text": "సూప్‌ను మళ్ళీ మరిగించండి.",
    "romanization": "sūpnu maḷḷī marigaṇḍi."
  },
  "11": {
    "text": "స్టాక్‌ను ఒక గంట పాటు సన్నని మంటపై ఉడికించండి.",
    "romanization": "sṭākunu oka gaṇṭa pāṭu sannani maṇṭapai uḍikaṇḍi."
  },
  "12": {
    "text": "చికెన్‌ను రాత్రంతా నానబెట్టండి.",
    "romanization": "cikeṉnu rātrantā nānabeṭṭaṇḍi."
  },
  "13": {
    "text": "ముందుగా మసాలా దినుసులను పొడి బాణలిలో వేయించండి.",
    "romanization": "mundugā masālā dinusulanu poḍi bāṇaḷilō vēyiṁcaṇḍi."
  },
  "14": {
    "text": "వైన్‌ను సగం అయ్యే వరకు మరిగించండి.",
    "romanization": "vaiṉnu sagam ayye varaku marigaṇḍi."
  },
  "15": {
    "text": "బ్రోకలీని నాలుగు నిమిషాలు ఆవిరిలో ఉడికించండి.",
    "romanization": "brokalīni nālugu nimiṣālu āvirilō uḍikaṇḍi."
  },
  "16": {
    "text": "ఉల్లిపాయలను నెమ్మదిగా క్యారమెలైజ్ చేయండి.",
    "romanization": "ullipāyalanu nemmadigā kyāramelaiz cēyaṇḍi."
  },
  "17": {
    "text": "పిండిని మెత్తగా అయ్యే వరకు పిసకండి.",
    "romanization": "piṇḍini mettagā ayye varaku pisakaṇḍi."
  },
  "18": {
    "text": "సూప్ రసాన్ని సన్నటి జల్లెడతో వడకట్టండి.",
    "romanization": "sūp rasānni sannaṭi jalleḍatō vaḍakaṭṭaṇḍi."
  },
  "19": {
    "text": "పైన కొద్దిగా తాజా జాజికాయ తురమండి.",
    "romanization": "paina koddigā tājā jājikāya turamaṇḍi."
  },
  "20": {
    "text": "మన దగ్గర ఆలివ్ ఆయిల్ లేదు.",
    "romanization": "mana daggarā āliv āyil lēdu."
  },
  "21": {
    "text": "నిమ్మకాయ ఎండిపోయింది, రసం రాదు.",
    "romanization": "nimmakāya eṇḍipōyindi, rasam rādu."
  },
  "22": {
    "text": "ఉప్పు ఇవ్వగలరా?",
    "romanization": "uppu ivvagalarā?"
  },
  "23": {
    "text": "తాజా బేసిల్ చాలా రుచిని ఇస్తుంది.",
    "romanization": "tājā bēsil cālā rucini istundi."
  },
  "24": {
    "text": "నేను వెల్లుల్లిని గడ్డలుగా కొంటాను.",
    "romanization": "nēnu vellullini gaḍḍalugā koṇṭānu."
  },
  "25": {
    "text": "బ్రౌన్ షుగర్ కుకీలను మెత్తగా చేస్తుంది.",
    "romanization": "braun ṣugar kukīlanu mettagā cēstundi."
  },
  "26": {
    "text": "గుడ్లు ఇంకా ఫ్రిజ్‌లోనే ఉన్నాయి.",
    "romanization": "guḍlu iṅkā phrijlōnē unnāyi."
  },
  "27": {
    "text": "తోటలో కొత్తిమీర దాదాపు కోయడానికి సిద్ధంగా ఉంది.",
    "romanization": "tōṭalō kottimīra dādāpu kōyaḍāniki siddhaṅgā undi."
  },
  "28": {
    "text": "శాండ్‌విచ్‌కి ఒక టమాటా కావాలి.",
    "romanization": "śāṇḍviciki oka ṭamāṭā kāvāli."
  },
  "29": {
    "text": "కౌంటర్‌పై వెన్న త్వరగా మెత్తబడుతుంది.",
    "romanization": "kauṇṭarpai venna tvaragā mettabaḍutundi."
  },
  "30": {
    "text": "అతను అన్నింటికీ సముద్రపు ఉప్పును వాడతాడు.",
    "romanization": "atanu anniṇṭikī samudrapu uppunu vāḍatāḍu."
  },
  "31": {
    "text": "పిండి సంచి దాదాపు ఖాళీ అయింది.",
    "romanization": "piṇḍi sañci dādāpu khāḷī ayindi."
  },
  "32": {
    "text": "వారాంతంలో క్రీమ్ పాడైపోయింది.",
    "romanization": "vārāntaṁlō krīm pāḍaipōyindi."
  },
  "33": {
    "text": "నాకు సోర్ క్రీమ్ కంటే గ్రీక్ యోగర్ట్ ఇష్టం.",
    "romanization": "nāku sōr krīm kaṇṭe grīk yōgarṭ iṣṭam."
  },
  "34": {
    "text": "పుట్టగొడుగులు ఉడికే కొద్దీ చిన్నవి అవుతాయి.",
    "romanization": "puṭṭagoḍugulu uḍike koddī cinnavi avutāyi."
  },
  "35": {
    "text": "చిటికెడు ఎర్ర మిరపకాయ పొడి వేయండి.",
    "romanization": "ciṭikeḍu erra mirapakāya poḍi vēyaṇḍi."
  },
  "36": {
    "text": "ఈ వంటకానికి రెండు కప్పుల రసం కావాలి.",
    "romanization": "ī vaṇṭakāniki reṇḍu kappula rasam kāvāli."
  },
  "37": {
    "text": "ఆమె ఎప్పుడూ ఆంచోవీలను కిచెన్ స్టోర్‌లో ఉంచుతుంది.",
    "romanization": "āme eppuḍū āṁcōvīlanu kiceṉ sṭōrlō uṁcutundi."
  },
  "38": {
    "text": "మిరపకాయలు వేయించినప్పుడు తీపిగా మారతాయి.",
    "romanization": "mirapakāyalu vēyiṁcinappuḍu tīpigā māratāyi."
  },
  "39": {
    "text": "ఫ్రోజెన్ బఠానీలు ఒక చిన్న అద్భుతం.",
    "romanization": "phrōjeṉ baṭhānīlu oka cinna adbhutam."
  },
  "40": {
    "text": "వంటగదిలో బ్రెడ్ వాసన వస్తుంది.",
    "romanization": "vaṇṭagadilō breḍ vāsana vastundi."
  },
  "41": {
    "text": "అతను కౌంటర్‌పై అన్నం అంతా చల్లాడు.",
    "romanization": "atanu kauṇṭarpai annaṁ antā callāḍu."
  },
  "42": {
    "text": "బాణలి ఇప్పటికే చాలా వేడిగా ఉంది.",
    "romanization": "bāṇaḷi ippaṭikē cālā vēḍigā undi."
  },
  "43": {
    "text": "నేను మళ్ళీ టోస్ట్‌ను మాడ్చేశాను.",
    "romanization": "nēnu maḷḷī ṭōsṭnu māḍcēśānu."
  },
  "44": {
    "text": "ఆమె సాస్‌ను రుచి చూసి, మరికొంత ఉప్పు వేసింది.",
    "romanization": "āme sāsnu ruci cūsi, marikonta uppu vēsi."
  },
  "45": {
    "text": "రాత్రి భోజనం చేస్తున్నప్పుడు స్మోక్ అలారం మోగింది.",
    "romanization": "rātri bhōjanaṁ cēstunnappuḍu smōk alāraṁ mōgindi."
  },
  "46": {
    "text": "అతను పని చేసుకుంటూనే శుభ్రం చేసుకుంటాడు.",
    "romanization": "atanu pani cēsukuntūnē śubhraṁ cēsukuntāḍu."
  },
  "47": {
    "text": "ఆమె ఫోన్ మాట్లాడుతుండగా గిన్నె పొంగిపోయింది.",
    "romanization": "āme phōn māṭlāḍutunḍagā ginne poṅgipōyindi."
  },
  "48": {
    "text": "ఫ్రిజ్‌ను తుడవాలి.",
    "romanization": "phrijnu tuḍavāli."
  },
  "49": {
    "text": "పిల్లలు అడగకుండానే బల్ల సర్దారు.",
    "romanization": "pillalu aḍagakuṇḍānē balla sardāru."
  },
  "50": {
    "text": "పాస్తా నీరు మరుగుతోంది.",
    "romanization": "pāstā nīru marugutōndi."
  },
  "51": {
    "text": "కటింగ్ బోర్డు జారిపోకుండా ఆమె దాని కింద ఒక టవల్ పెట్టింది.",
    "romanization": "kaṭiṅg bōrḍu jāripōkuṇḍā āme dāni kinda oka ṭaval peṭṭindi."
  },
  "52": {
    "text": "అతను ఎప్పుడూ చెప్పులు లేకుండా వంట చేస్తాడు.",
    "romanization": "atanu eppuḍū ceppulu lēkuṇḍā vaṇṭa cēstāḍu."
  },
  "53": {
    "text": "నేను ఓవెన్ తెరిచినప్పుడు కేక్ కుంగిపోయింది.",
    "romanization": "nēnu ōveṉ tericinappuḍu kēk kuṅgipōyindi."
  },
  "54": {
    "text": "ఓవెన్‌ను ముందుగా వేడి చేయడం మర్చిపోయాం.",
    "romanization": "ōveṉnu mundugā vēḍi cēyaḍaṁ marcipōyāṁ."
  },
  "55": {
    "text": "కుక్క గుమ్మం దగ్గర నుండి ప్రతి కదలికను చూసింది.",
    "romanization": "kukka gummaṁ daggarā nuṇḍi prati kadalikanu cūsindi."
  },
  "56": {
    "text": "ఆవిరి బయటికి వెళ్ళడానికి వంటగది కిటికీ తెరిచి ఉంది.",
    "romanization": "āviri bayaṭiki veḷḷaḍāniki vaṇṭagadi kiṭikī terici undi."
  },
  "57": {
    "text": "ఆమె వంట చేస్తున్నప్పుడు సంగీతం పెంచింది.",
    "romanization": "āme vaṇṭa cēstunnappuḍu saṅgītaṁ peṁcindi."
  },
  "58": {
    "text": "మేము తింటున్నప్పుడు గిన్నెలు పేరుకుపోయాయి.",
    "romanization": "mēmu tiṇṭunnappuḍu ginnelu pērukupōyāyi."
  },
  "59": {
    "text": "మిగిలిపోయినవి రేపు మధ్యాహ్న భోజనం.",
    "romanization": "migilipōyinavi rēpu madhyāhna bhōjanaṁ."
  },
  "60": {
    "text": "నేను వంటకాన్ని అడుగు అడుగునా అనుసరించాను.",
    "romanization": "nēnu vaṇṭakānni aḍugu aḍugunā anusariṁcānu."
  },
  "61": {
    "text": "మొదటి పాన్‌కేక్ ఎప్పుడూ సరిగా రాదు.",
    "romanization": "modaṭi pānkēk eppuḍū sarigā rādu."
  },
  "62": {
    "text": "ఆమె అనుకోకుండా ఈ సాస్‌ను కనిపెట్టింది.",
    "romanization": "āme anukōkuṇḍā ī sāsnu kanipeṭṭindi."
  },
  "63": {
    "text": "అతను చలికాలంలో బేకింగ్ నేర్చుకున్నాడు.",
    "romanization": "atanu calikālaṁlō bēkiṅg nērcukunnāḍu."
  },
  "64": {
    "text": "వంటల పుస్తకం అదే పేజీలో తెరుచుకుంది.",
    "romanization": "vaṇṭala pustakaṁ adē pējīlō terucukundi."
  },
  "65": {
    "text": "నేను వంటకాన్ని రెట్టింపు చేసి, చాలా ఎక్కువ చేశాను.",
    "romanization": "nēnu vaṇṭakānni reṭṭiṁpu cēsi, cālā ekkuva cēśānu."
  },
  "66": {
    "text": "డంప్లింగ్ ఎలా మడచాలో వీడియో నాకు చూపించింది.",
    "romanization": "ḍaṁpliṅg elā maḍacālō viḍiyō nāku cūpiṁcindi."
  },
  "67": {
    "text": "అతను అన్నింటినీ చిన్న త్రాసుతో కొలుస్తాడు.",
    "romanization": "atanu anniṇṭinī cinna trāsutō kolustāḍu."
  },
  "68": {
    "text": "ఆమె గడియారం కంటే వాసనతోనే ఎక్కువ వంట చేస్తుంది.",
    "romanization": "āme gaḍiyāraṁ kaṇṭe vāsanatōnē ekkuva vaṇṭa cēstundi."
  },
  "69": {
    "text": "నేను కొత్త మసాలా దినుసును ప్రయత్నించాను, అది బాగా కుదిరింది.",
    "romanization": "nēnu kotta masālā dinusunu prayatniṁcānu, adi bāgā kudirindi."
  },
  "70": {
    "text": "మొదటిసారి బ్రెడ్ పొంగలేదు.",
    "romanization": "modaṭisāri breḍ poṅgalēdu."
  },
  "71": {
    "text": "ఆమె వంట చేస్తూ రుచి చూసి, సరిచేసింది.",
    "romanization": "āme vaṇṭa cēstū ruci cūsi, saricēsindi."
  },
  "72": {
    "text": "అతను ఈ వంటకాన్ని తన అమ్మమ్మ నుండి నేర్చుకున్నాడు.",
    "romanization": "atanu ī vaṇṭakānni tana ammamma nuṇḍi nērcukunnāḍu."
  },
  "73": {
    "text": "ఈ వంటకం ఒక చిన్న కార్డుపై రాసి తరతరాలుగా వచ్చింది.",
    "romanization": "ī vaṇṭakaṁ oka cinna kārḍupai rāsi taratarālugā vaccindi."
  },
  "74": {
    "text": "ఒక్కరి కోసం వంట చేయడం ఒక ప్రత్యేకమైన కళ.",
    "romanization": "okkari kōsaṁ vaṇṭa cēyaḍaṁ oka pratyēkamaina kaḷa."
  },
  "75": {
    "text": "ఐదు నిమిషాల్లో రాత్రి భోజనం సిద్ధంగా ఉంటుంది.",
    "romanization": "aidu nimiṣāllō rātri bhōjanaṁ siddhaṅgā uṇṭundi."
  },
  "76": {
    "text": "దయచేసి నాకు బ్రెడ్ ఇవ్వండి.",
    "romanization": "dayacēsi nāku breḍ ivvaṇḍi."
  },
  "77": {
    "text": "ఇంట్లో వంటగది అన్నిటికంటే వెచ్చని గది.",
    "romanization": "iṁṭlō vaṇṭagadi anniṭikaṇṭe veccani gadi."
  },
  "78": {
    "text": "సూర్యుడు అస్తమిస్తున్నప్పుడు మేము బయట తిన్నాము.",
    "romanization": "sūryuḍu astamistunnappuḍu mēmu bayaṭa tinnāmu."
  },
  "79": {
    "text": "అందరూ గిన్నెలు కడగడానికి సహాయం చేశారు.",
    "romanization": "andarū ginnelu kaḍagaḍāniki sahāyaṁ cēśāru."
  },
  "80": {
    "text": "ఆమె ఎప్పుడూ కావాలనే ఎక్కువ వంట చేస్తుంది.",
    "romanization": "āme eppuḍū kāvālānē ekkuva vaṇṭa cēstundi."
  },
  "81": {
    "text": "అతను ఎప్పుడూ ఒక వైన్ బాటిల్ తెస్తాడు.",
    "romanization": "atanu eppuḍū oka vaiṉ bāṭil testāḍu."
  },
  "82": {
    "text": "పిల్లలు మూడు సార్లు వడ్డించుకుని తిన్నారు.",
    "romanization": "pillalu mūḍu sārlu vaḍḍiṁcukuni tinnāru."
  },
  "83": {
    "text": "కొవ్వొత్తులు పూర్తిగా కాలిపోయాయి.",
    "romanization": "kovvottulu pūrtigā kālipōyāyi."
  },
  "84": {
    "text": "ప్లేట్లు తీసేసిన చాలా సేపటి వరకు మేము మాట్లాడుకున్నాము.",
    "romanization": "plēṭlu tīsesina cālā sēpaṭi varaku mēmu māṭlāḍukunnāmu."
  },
  "85": {
    "text": "కత్తి కనిపించే దానికంటే పదునుగా ఉంది.",
    "romanization": "katti kanipiṁcē dānikaṇṭe padunugā undi."
  },
  "86": {
    "text": "సాస్ కోసం చెక్క గరిటెను వాడండి.",
    "romanization": "sās kōsaṁ cekka gariṭenu vāḍaṇḍi."
  },
  "87": {
    "text": "కాస్ట్ ఐరన్ బాణలి బరువుగా ఉంటుంది, కానీ విలువైనది.",
    "romanization": "kāst airaṉ bāṇaḷi baruvugā uṇṭundi, kānī viluvainadi."
  },
  "88": {
    "text": "అతను మసాలా దినుసులను ఒక చిన్న డ్రాయర్‌లో ఉంచుతాడు.",
    "romanization": "atanu masālā dinusulanu oka cinna ḍrāyarlō uṁcutāḍu."
  },
  "89": {
    "text": "మంచి కటింగ్ బోర్డు అన్ని పనులను సులభతరం చేస్తుంది.",
    "romanization": "mañci kaṭiṅg bōrḍu anni panulanu sulabhataraṁ cēstundi."
  },
  "90": {
    "text": "ఓవెన్ చివరకు సరిపడా వేడిగా ఉంది.",
    "romanization": "ōveṉ civaraku saripaḍā vēḍigā undi."
  },
  "91": {
    "text": "బ్లెండర్ మొత్తం బాదంపప్పులను రుబ్బడానికి కష్టపడుతుంది.",
    "romanization": "bleṇḍar mottaṁ bādampappulanu rubbāḍāniki kaṣṭapaḍutundi."
  },
  "92": {
    "text": "ఆమె తడి గుడ్డతో కౌంటర్‌ను తుడిచింది.",
    "romanization": "āme taḍi guḍḍatō kauṇṭarnu tuḍicindi."
  },
  "93": {
    "text": "జల్లెడ రెండో డ్రాయర్‌లో ఉంది.",
    "romanization": "jalleḍa reṇḍō ḍrāyarlō undi."
  },
  "94": {
    "text": "ఓవెన్ మిట్స్‌ను మర్చిపోవద్దు.",
    "romanization": "ōveṉ miṭsnu marcipōvaddu."
  },
  "95": {
    "text": "వంట చేయడం అంటే చాలా వరకు ఓపికే.",
    "romanization": "vaṇṭa cēyaḍaṁ aṇṭe cālā varaku ōpikē."
  },
  "96": {
    "text": "ఒకే పదార్థాలు వేర్వేరు చేతుల్లో వేర్వేరు వంటకాలుగా మారతాయి.",
    "romanization": "okē padārthālu vērvēru cētullō vērvēru vaṇṭakālugā māratāyi."
  },
  "97": {
    "text": "ఉప్పు సరిచేయడం మొదటి పని.",
    "romanization": "uppu saricēyaḍaṁ modaṭi pani."
  },
  "98": {
    "text": "ఎక్కువ వేసే ముందు రుచి చూడండి.",
    "romanization": "ekkuva vēse mundu ruci cūḍaṇḍi."
  },
  "99": {
    "text": "నెమ్మదిగా తినే ఒక సాధారణ భోజనం ఒక చిన్న విజయం.",
    "romanization": "nemmadigā tinē oka sādhāraṇa bhōjanaṁ oka cinna vijayaṁ."
  }
}