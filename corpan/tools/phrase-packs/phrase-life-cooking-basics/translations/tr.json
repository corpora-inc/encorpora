{
  "0": {
    "text": "Soğanı ince ince doğrayın.",
    "romanization": null
  },
  "1": {
    "text": "Makarnayı eklemeden önce suyu kaynatın.",
    "romanization": null
  },
  "2": {
    "text": "Sosu kısık ateşte kaynarken karıştırın.",
    "romanization": null
  },
  "3": {
    "text": "Tavuğu tuz ve karabiberle baharatlandırın.",
    "romanization": null
  },
  "4": {
    "text": "Yumurtaları köpürene kadar çırpın.",
    "romanization": null
  },
  "5": {
    "text": "Unu yavaşça karışıma ekleyin.",
    "romanization": null
  },
  "6": {
    "text": "Eti birkaç dakika dinlendirin.",
    "romanization": null
  },
  "7": {
    "text": "Sebzeleri yüksek ateşte fırınlayın.",
    "romanization": null
  },
  "8": {
    "text": "Ekmeği çapraz dilimleyin.",
    "romanization": null
  },
  "9": {
    "text": "Sarımsağı soteleyin ama yakmayın.",
    "romanization": null
  },
  "10": {
    "text": "Çorbayı tekrar kaynatın.",
    "romanization": null
  },
  "11": {
    "text": "Et suyunu bir saat kısık ateşte kaynatın.",
    "romanization": null
  },
  "12": {
    "text": "Tavuğu bir gece önceden marine edin.",
    "romanization": null
  },
  "13": {
    "text": "Baharatları önce kuru tavada kavurun.",
    "romanization": null
  },
  "14": {
    "text": "Şarabı yarı yarıya çektirin.",
    "romanization": null
  },
  "15": {
    "text": "Brokoliyi dört dakika buharda pişirin.",
    "romanization": null
  },
  "16": {
    "text": "Soğanları yavaşça karamelize edin.",
    "romanization": null
  },
  "17": {
    "text": "Hamuru pürüzsüz olana kadar yoğurun.",
    "romanization": null
  },
  "18": {
    "text": "Et suyunu ince bir süzgeçten geçirin.",
    "romanization": null
  },
  "19": {
    "text": "Üzerine biraz taze muskat rendeleyin.",
    "romanization": null
  },
  "20": {
    "text": "Zeytinyağımız kalmamış.",
    "romanization": null
  },
  "21": {
    "text": "Limonun suyu çıkmıyor, çok kuru.",
    "romanization": null
  },
  "22": {
    "text": "Tuzu uzatır mısın?",
    "romanization": null
  },
  "23": {
    "text": "Taze fesleğen çok fark ettiriyor.",
    "romanization": null
  },
  "24": {
    "text": "Sarımsağı baş olarak alıyorum.",
    "romanization": null
  },
  "25": {
    "text": "Esmer şeker kurabiyeleri daha yumuşak yapıyor.",
    "romanization": null
  },
  "26": {
    "text": "Yumurtalar hala buzdolabında duruyor.",
    "romanization": null
  },
  "27": {
    "text": "Bahçedeki kişniş neredeyse olmuş.",
    "romanization": null
  },
  "28": {
    "text": "Sandviç için bir domates lazım.",
    "romanization": null
  },
  "29": {
    "text": "Tereyağı tezgahta daha çabuk yumuşuyor.",
    "romanization": null
  },
  "30": {
    "text": "Her şeyde deniz tuzu kullanıyor.",
    "romanization": null
  },
  "31": {
    "text": "Un torbası neredeyse bitmiş.",
    "romanization": null
  },
  "32": {
    "text": "Krema hafta sonu bozulmuş.",
    "romanization": null
  },
  "33": {
    "text": "Ekşi kremaya Yunan yoğurdunu tercih ederim.",
    "romanization": null
  },
  "34": {
    "text": "Mantarlar piştikçe küçülüyor.",
    "romanization": null
  },
  "35": {
    "text": "Bir tutam kırmızı biber ekleyin.",
    "romanization": null
  },
  "36": {
    "text": "Tarifte iki bardak et suyu gerekiyor.",
    "romanization": null
  },
  "37": {
    "text": "Kilerinde her zaman ançüez bulundurur.",
    "romanization": null
  },
  "38": {
    "text": "Biberler fırınlandığında tatlılaşıyor.",
    "romanization": null
  },
  "39": {
    "text": "Dondurulmuş bezelye küçük bir mucize.",
    "romanization": null
  },
  "40": {
    "text": "Mutfak ekmek kokuyor.",
    "romanization": null
  },
  "41": {
    "text": "Pirinci tezgahın her yerine dökmüş.",
    "romanization": null
  },
  "42": {
    "text": "Tava zaten çok ısınmış.",
    "romanization": null
  },
  "43": {
    "text": "Tostu yine yakmışım.",
    "romanization": null
  },
  "44": {
    "text": "Sosu tadıp biraz daha tuz ekledi.",
    "romanization": null
  },
  "45": {
    "text": "Yemek yerken duman alarmı çalmış.",
    "romanization": null
  },
  "46": {
    "text": "Yaptıkça temizliyor.",
    "romanization": null
  },
  "47": {
    "text": "Telefonu yanıtlarken tencere taşmış.",
    "romanization": null
  },
  "48": {
    "text": "Buzdolabının silinmesi lazım.",
    "romanization": null
  },
  "49": {
    "text": "Çocuklar söylenmeden masayı kurmuşlar.",
    "romanization": null
  },
  "50": {
    "text": "Makarna suyu kaynıyor.",
    "romanization": null
  },
  "51": {
    "text": "Kesme tahtası kaymasın diye altına havlu koydu.",
    "romanization": null
  },
  "52": {
    "text": "Her zaman çıplak ayakla yemek yapıyor.",
    "romanization": null
  },
  "53": {
    "text": "Fırını açınca kek çökmüş.",
    "romanization": null
  },
  "54": {
    "text": "Fırını önceden ısıtmayı unutmuşuz.",
    "romanization": null
  },
  "55": {
    "text": "Köpek kapı eşiğinden her hareketi izliyordu.",
    "romanization": null
  },
  "56": {
    "text": "Buhar çıksın diye mutfak penceresi açık.",
    "romanization": null
  },
  "57": {
    "text": "Yemek yaparken müziğin sesini açtı.",
    "romanization": null
  },
  "58": {
    "text": "Biz yemek yerken bulaşıklar birikmiş.",
    "romanization": null
  },
  "59": {
    "text": "Kalan yemekler yarın öğle yemeği olacak.",
    "romanization": null
  },
  "60": {
    "text": "Tarifi adım adım uyguladım.",
    "romanization": null
  },
  "61": {
    "text": "İlk krep her zaman en kötü olur.",
    "romanization": null
  },
  "62": {
    "text": "Sosu tesadüfen bulmuş.",
    "romanization": null
  },
  "63": {
    "text": "Kışın kendi kendine fırıncılık yapmayı öğrenmiş.",
    "romanization": null
  },
  "64": {
    "text": "Yemek kitabı yine aynı sayfada açıldı.",
    "romanization": null
  },
  "65": {
    "text": "Tarifi iki katına çıkarınca çok fazla yapmışım.",
    "romanization": null
  },
  "66": {
    "text": "Video bana mantı nasıl katlanır gösterdi.",
    "romanization": null
  },
  "67": {
    "text": "Her şeyi küçük bir tartıyla ölçüyor.",
    "romanization": null
  },
  "68": {
    "text": "Saate bakmaktan çok kokuya göre yemek yapıyor.",
    "romanization": null
  },
  "69": {
    "text": "Yeni bir baharat denedim ve çok yakıştı.",
    "romanization": null
  },
  "70": {
    "text": "Ekmek ilk denemede kabarmadı.",
    "romanization": null
  },
  "71": {
    "text": "Yaptıkça tadına bakıp ayarlamalar yaptı.",
    "romanization": null
  },
  "72": {
    "text": "Bu yemeği büyükannesinden öğrenmiş.",
    "romanization": null
  },
  "73": {
    "text": "Tarif küçük bir kartta nesilden nesile aktarılmış.",
    "romanization": null
  },
  "74": {
    "text": "Tek kişilik yemek yapmak ayrı bir sanat.",
    "romanization": null
  },
  "75": {
    "text": "Akşam yemeği beş dakikaya hazır.",
    "romanization": null
  },
  "76": {
    "text": "Ekmeği uzatır mısın lütfen?",
    "romanization": null
  },
  "77": {
    "text": "Mutfak evin en sıcak odasıdır.",
    "romanization": null
  },
  "78": {
    "text": "Güneş batarken dışarıda yemek yedik.",
    "romanization": null
  },
  "79": {
    "text": "Herkes bulaşıklara yardım etti.",
    "romanization": null
  },
  "80": {
    "text": "Her zaman bilerek çok yemek yapar.",
    "romanization": null
  },
  "81": {
    "text": "Her zaman bir şişe şarap getiriyor.",
    "romanization": null
  },
  "82": {
    "text": "Çocuklar üçer porsiyon yemiş.",
    "romanization": null
  },
  "83": {
    "text": "Mumlar tamamen bitmiş.",
    "romanization": null
  },
  "84": {
    "text": "Tabaklar toplandıktan sonra uzun uzun sohbet ettik.",
    "romanization": null
  },
  "85": {
    "text": "Bıçak göründüğünden daha keskin.",
    "romanization": null
  },
  "86": {
    "text": "Sos için tahta kaşığı kullanın.",
    "romanization": null
  },
  "87": {
    "text": "Dökme demir tava ağır ama buna değer.",
    "romanization": null
  },
  "88": {
    "text": "Baharatları küçük bir çekmecede saklıyor.",
    "romanization": null
  },
  "89": {
    "text": "İyi bir kesme tahtası her şeyi kolaylaştırır.",
    "romanization": null
  },
  "90": {
    "text": "Fırın sonunda yeterince ısınmış.",
    "romanization": null
  },
  "91": {
    "text": "Blender bütün bademleri çekmekte zorlanıyor.",
    "romanization": null
  },
  "92": {
    "text": "Tezgahı nemli bir bezle sildi.",
    "romanization": null
  },
  "93": {
    "text": "Süzgeç ikinci çekmecede.",
    "romanization": null
  },
  "94": {
    "text": "Fırın eldivenlerini unutmayın.",
    "romanization": null
  },
  "95": {
    "text": "Yemek yapmak çoğunlukla sabır işidir.",
    "romanization": null
  },
  "96": {
    "text": "Aynı malzemeler farklı ellerde farklı yemeklere dönüşür.",
    "romanization": null
  },
  "97": {
    "text": "Tuz, ilk ayarlayacağın şeydir.",
    "romanization": null
  },
  "98": {
    "text": "Daha fazla eklemeden önce tadına bakın.",
    "romanization": null
  },
  "99": {
    "text": "Yavaşça yenen basit bir yemek küçük bir zaferdir.",
    "romanization": null
  }
}