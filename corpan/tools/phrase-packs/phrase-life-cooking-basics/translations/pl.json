{
  "0": {
    "text": "Posiekaj cebulę drobno.",
    "romanization": null
  },
  "1": {
    "text": "Zagotuj wodę, zanim dodasz makaron.",
    "romanization": null
  },
  "2": {
    "text": "Mieszaj sos, gdy się dusi.",
    "romanization": null
  },
  "3": {
    "text": "Dopraw kurczaka solą i pieprzem.",
    "romanization": null
  },
  "4": {
    "text": "Ubij jajka, aż będą puszyste.",
    "romanization": null
  },
  "5": {
    "text": "Delikatnie wmieszaj mąkę.",
    "romanization": null
  },
  "6": {
    "text": "Pozwól mięsu odpocząć przez kilka minut.",
    "romanization": null
  },
  "7": {
    "text": "Piecz warzywa w wysokiej temperaturze.",
    "romanization": null
  },
  "8": {
    "text": "Pokrój chleb po skosie.",
    "romanization": null
  },
  "9": {
    "text": "Podsmaż czosnek, ale go nie spal.",
    "romanization": null
  },
  "10": {
    "text": "Ponownie zagotuj zupę.",
    "romanization": null
  },
  "11": {
    "text": "Gotuj bulion na małym ogniu przez godzinę.",
    "romanization": null
  },
  "12": {
    "text": "Marynuj kurczaka przez noc.",
    "romanization": null
  },
  "13": {
    "text": "Najpierw upraż przyprawy na suchej patelni.",
    "romanization": null
  },
  "14": {
    "text": "Zredukuj wino o połowę.",
    "romanization": null
  },
  "15": {
    "text": "Gotuj brokuły na parze przez cztery minuty.",
    "romanization": null
  },
  "16": {
    "text": "Powoli karmelizuj cebulę.",
    "romanization": null
  },
  "17": {
    "text": "Wyrabiaj ciasto, aż będzie gładkie.",
    "romanization": null
  },
  "18": {
    "text": "Przecedź bulion przez drobne sitko.",
    "romanization": null
  },
  "19": {
    "text": "Zetrzyj trochę świeżej gałki muszkatołowej na wierzch.",
    "romanization": null
  },
  "20": {
    "text": "Skończyła nam się oliwa z oliwek.",
    "romanization": null
  },
  "21": {
    "text": "Ta cytryna jest za sucha, żeby wycisnąć z niej sok.",
    "romanization": null
  },
  "22": {
    "text": "Czy możesz podać sól?",
    "romanization": null
  },
  "23": {
    "text": "Świeża bazylia robi dużą różnicę.",
    "romanization": null
  },
  "24": {
    "text": "Kupuję czosnek na główki.",
    "romanization": null
  },
  "25": {
    "text": "Brązowy cukier sprawia, że ciasteczka są bardziej miękkie.",
    "romanization": null
  },
  "26": {
    "text": "Jajka są nadal w lodówce.",
    "romanization": null
  },
  "27": {
    "text": "Kolendra w ogrodzie jest już prawie gotowa.",
    "romanization": null
  },
  "28": {
    "text": "Potrzebujemy pomidora do kanapki.",
    "romanization": null
  },
  "29": {
    "text": "Masło szybciej mięknie na blacie.",
    "romanization": null
  },
  "30": {
    "text": "On używa soli morskiej do wszystkiego.",
    "romanization": null
  },
  "31": {
    "text": "Worek z mąką jest prawie pusty.",
    "romanization": null
  },
  "32": {
    "text": "Śmietana zepsuła się przez weekend.",
    "romanization": null
  },
  "33": {
    "text": "Wolę jogurt grecki od śmietany.",
    "romanization": null
  },
  "34": {
    "text": "Grzyby kurczą się podczas gotowania.",
    "romanization": null
  },
  "35": {
    "text": "Dodaj szczyptę czerwonej papryki.",
    "romanization": null
  },
  "36": {
    "text": "Przepis wymaga dwóch szklanek bulionu.",
    "romanization": null
  },
  "37": {
    "text": "Ona zawsze trzyma anchois w spiżarni.",
    "romanization": null
  },
  "38": {
    "text": "Papryka staje się słodka, gdy jest pieczona.",
    "romanization": null
  },
  "39": {
    "text": "Mrożony groszek to mały cud.",
    "romanization": null
  },
  "40": {
    "text": "W kuchni pachnie chlebem.",
    "romanization": null
  },
  "41": {
    "text": "Wysypał ryż na cały blat.",
    "romanization": null
  },
  "42": {
    "text": "Patelnia jest już za gorąca.",
    "romanization": null
  },
  "43": {
    "text": "Znowu spaliłem tosty.",
    "romanization": null
  },
  "44": {
    "text": "Spróbowała sosu i dodała więcej soli.",
    "romanization": null
  },
  "45": {
    "text": "Czujnik dymu włączył się podczas kolacji.",
    "romanization": null
  },
  "46": {
    "text": "On sprząta na bieżąco.",
    "romanization": null
  },
  "47": {
    "text": "Garnek wykipiał, gdy odbierała telefon.",
    "romanization": null
  },
  "48": {
    "text": "Lodówka wymaga przetarcia.",
    "romanization": null
  },
  "49": {
    "text": "Dzieci nakryły do stołu bez proszenia.",
    "romanization": null
  },
  "50": {
    "text": "Woda na makaron bulgocze.",
    "romanization": null
  },
  "51": {
    "text": "Położyła ręcznik pod deskę do krojenia, żeby się nie ślizgała.",
    "romanization": null
  },
  "52": {
    "text": "On zawsze gotuje boso.",
    "romanization": null
  },
  "53": {
    "text": "Ciasto opadło, gdy otworzyłem piekarnik.",
    "romanization": null
  },
  "54": {
    "text": "Zapomnieliśmy rozgrzać piekarnik.",
    "romanization": null
  },
  "55": {
    "text": "Pies obserwował każdy ruch z progu.",
    "romanization": null
  },
  "56": {
    "text": "Okno w kuchni jest otwarte, żeby para uciekła.",
    "romanization": null
  },
  "57": {
    "text": "Podkręciła muzykę, gdy gotowała.",
    "romanization": null
  },
  "58": {
    "text": "Naczynia piętrzyły się, gdy jedliśmy.",
    "romanization": null
  },
  "59": {
    "text": "Resztki będą jutro na obiad.",
    "romanization": null
  },
  "60": {
    "text": "Postępowałem zgodnie z przepisem krok po kroku.",
    "romanization": null
  },
  "61": {
    "text": "Pierwszy naleśnik zawsze jest najgorszy.",
    "romanization": null
  },
  "62": {
    "text": "Odkryła ten sos przez przypadek.",
    "romanization": null
  },
  "63": {
    "text": "Nauczył się piec zimą.",
    "romanization": null
  },
  "64": {
    "text": "Książka kucharska otworzyła się na tej samej stronie.",
    "romanization": null
  },
  "65": {
    "text": "Podwoiłem przepis i zrobiłem za dużo.",
    "romanization": null
  },
  "66": {
    "text": "Film pokazał mi, jak składać pieroga.",
    "romanization": null
  },
  "67": {
    "text": "On wszystko waży na małej wadze.",
    "romanization": null
  },
  "68": {
    "text": "Ona gotuje bardziej na wyczucie niż na czas.",
    "romanization": null
  },
  "69": {
    "text": "Spróbowałem nowej przyprawy i się sprawdziła.",
    "romanization": null
  },
  "70": {
    "text": "Chleb nie wyrósł za pierwszym razem.",
    "romanization": null
  },
  "71": {
    "text": "Próbowała na bieżąco i doprawiała.",
    "romanization": null
  },
  "72": {
    "text": "Nauczył się tego dania od babci.",
    "romanization": null
  },
  "73": {
    "text": "Przepis był przekazywany na małej karteczce.",
    "romanization": null
  },
  "74": {
    "text": "Gotowanie dla jednej osoby to inna sztuka.",
    "romanization": null
  },
  "75": {
    "text": "Obiad będzie gotowy za pięć minut.",
    "romanization": null
  },
  "76": {
    "text": "Proszę, podaj mi chleb.",
    "romanization": null
  },
  "77": {
    "text": "Kuchnia to najcieplejsze pomieszczenie w domu.",
    "romanization": null
  },
  "78": {
    "text": "Jedliśmy na zewnątrz, gdy zachodziło słońce.",
    "romanization": null
  },
  "79": {
    "text": "Wszyscy pomagali przy zmywaniu.",
    "romanization": null
  },
  "80": {
    "text": "Ona zawsze gotuje za dużo, celowo.",
    "romanization": null
  },
  "81": {
    "text": "On zawsze przynosi butelkę wina.",
    "romanization": null
  },
  "82": {
    "text": "Dzieci zjadły po trzy porcje.",
    "romanization": null
  },
  "83": {
    "text": "Świece wypaliły się do końca.",
    "romanization": null
  },
  "84": {
    "text": "Rozmawialiśmy długo po tym, jak sprzątnięto talerze.",
    "romanization": null
  },
  "85": {
    "text": "Ten nóż jest ostrzejszy, niż wygląda.",
    "romanization": null
  },
  "86": {
    "text": "Użyj drewnianej łyżki do sosu.",
    "romanization": null
  },
  "87": {
    "text": "Żeliwna patelnia jest ciężka, ale warto.",
    "romanization": null
  },
  "88": {
    "text": "On trzyma przyprawy w małej szufladzie.",
    "romanization": null
  },
  "89": {
    "text": "Dobra deska do krojenia ułatwia wszystko.",
    "romanization": null
  },
  "90": {
    "text": "Piekarnik jest w końcu wystarczająco gorący.",
    "romanization": null
  },
  "91": {
    "text": "Blender ma problem z całymi migdałami.",
    "romanization": null
  },
  "92": {
    "text": "Przetarła blat wilgotną ściereczką.",
    "romanization": null
  },
  "93": {
    "text": "Durszlak jest w drugiej szufladzie.",
    "romanization": null
  },
  "94": {
    "text": "Nie zapomnij o rękawicach kuchennych.",
    "romanization": null
  },
  "95": {
    "text": "Gotowanie to głównie cierpliwość.",
    "romanization": null
  },
  "96": {
    "text": "Te same składniki tworzą różne dania w różnych rękach.",
    "romanization": null
  },
  "97": {
    "text": "Sól to pierwsza rzecz, którą poprawiasz.",
    "romanization": null
  },
  "98": {
    "text": "Spróbuj, zanim dodasz więcej.",
    "romanization": null
  },
  "99": {
    "text": "Prosty posiłek zjedzony powoli to małe zwycięstwo.",
    "romanization": null
  }
}