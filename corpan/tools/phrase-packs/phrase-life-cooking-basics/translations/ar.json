{
  "0": {
    "text": "افرُم البصل ناعمًا.",
    "romanization": "Ufrum al-baṣal nāʿiman."
  },
  "1": {
    "text": "اغلِ الماء قبل إضافة المعكرونة.",
    "romanization": "Ighli al-māʾ qabla iḍāfat al-maʿkarūnah."
  },
  "2": {
    "text": "قلّب الصلصة وهي تتسبك.",
    "romanization": "Qallib al-ṣalṣah wa-hiya tatasabbak."
  },
  "3": {
    "text": "تبّل الدجاج بالملح والفلفل.",
    "romanization": "Tabbil ad-dajāj bi-al-milḥ wa-al-filfil."
  },
  "4": {
    "text": "اخفق البيض حتى يصبح رغويًا.",
    "romanization": "Ikhfaq al-bayḍ ḥattá yuṣbiḥ raghawīyan."
  },
  "5": {
    "text": "ادمج الطحين برفق.",
    "romanization": "Idmuj aṭ-ṭaḥīn bi-rifq."
  },
  "6": {
    "text": "دع اللحم يرتاح لبضع دقائق.",
    "romanization": "Daʿ al-laḥm yartāḥ li-biḍʿ daqāʾiq."
  },
  "7": {
    "text": "اشوِ الخضروات على نار عالية.",
    "romanization": "Ishwi al-khaḍrawāt ʿalá nār ʿāliyah."
  },
  "8": {
    "text": "قطّع الخبز بشكل مائل.",
    "romanization": "Qaṭṭiʿ al-khubz bi-shakl māʾil."
  },
  "9": {
    "text": "قلّب الثوم لكن لا تحرقه.",
    "romanization": "Qallib ath-thūm lākin lā taḥriqhu."
  },
  "10": {
    "text": "دع الحساء يغلي مجددًا.",
    "romanization": "Daʿ al-ḥisāʾ yaghlī mujaddadan."
  },
  "11": {
    "text": "دع المرق يتسبك لمدة ساعة.",
    "romanization": "Daʿ al-maraq yatasabbak li-muddat sāʿah."
  },
  "12": {
    "text": "تبّل الدجاج ليلة كاملة.",
    "romanization": "Tabbil ad-dajāj laylatan kāmilah."
  },
  "13": {
    "text": "حمّص البهارات في مقلاة جافة أولًا.",
    "romanization": "Ḥammiṣ al-bahārāt fī miqlāh jāffah awwalan."
  },
  "14": {
    "text": "اخفض كمية النبيذ إلى النصف.",
    "romanization": "Ikhfaḍ kammiyat an-nabīdh ilá an-niṣf."
  },
  "15": {
    "text": "ابخر البروكلي لمدة أربع دقائق.",
    "romanization": "Abkhir al-brūklī li-muddat arbaʿ daqāʾiq."
  },
  "16": {
    "text": "كرمل البصل ببطء.",
    "romanization": "Karmil al-baṣal bi-buṭʾ."
  },
  "17": {
    "text": "اعجن العجينة حتى تصبح ناعمة.",
    "romanization": "Iʿjin al-ʿajīnah ḥattá taṣbiḥ nāʿimah."
  },
  "18": {
    "text": "صفّ المرق عبر مصفاة ناعمة.",
    "romanization": "Ṣaffi al-maraq ʿabra miṣfāh nāʿimah."
  },
  "19": {
    "text": "ابشر قليلًا من جوزة الطيب الطازجة فوقها.",
    "romanization": "Ibshur qalīlan min jawzat aṭ-ṭīb aṭ-ṭāzajah fawqahā."
  },
  "20": {
    "text": "نفد منّا زيت الزيتون.",
    "romanization": "Nafada minnā zayt az-zaytūn."
  },
  "21": {
    "text": "الليمونة جافة جدًا للعصر.",
    "romanization": "Al-laymūnah jāffah jiddan lil-ʿaṣr."
  },
  "22": {
    "text": "هل يمكنك تمرير الملح؟",
    "romanization": "Hal yumkinuka tamrīr al-milḥ?"
  },
  "23": {
    "text": "الريحان الطازج يُحدث فرقًا كبيرًا.",
    "romanization": "Ar-rayḥān aṭ-ṭāzaj yuḥdith farqan kabīran."
  },
  "24": {
    "text": "أشتري الثوم بالرأس.",
    "romanization": "Ashtarī ath-thūm bir-raʾs."
  },
  "25": {
    "text": "السكر الأسمر يجعل الكعك أكثر طراوة.",
    "romanization": "As-sukkar al-asmar yajʿal al-kaʿk akthar ṭarāwah."
  },
  "26": {
    "text": "البيض لا يزال في الثلاجة.",
    "romanization": "Al-bayḍ lā yazāl fī ath-thallājah."
  },
  "27": {
    "text": "الكزبرة أوشكت على النضوج في الحديقة.",
    "romanization": "Al-kuzbarah awshakat ʿalá an-nuḍūj fī al-ḥadīqah."
  },
  "28": {
    "text": "نحتاج إلى طماطم للسندويتش.",
    "romanization": "Naḥtāj ilá ṭamāṭim lil-sandawītsh."
  },
  "29": {
    "text": "الزبدة تلين أسرع على الطاولة.",
    "romanization": "Az-zubdah talīn asraʿ ʿalá aṭ-ṭāwilah."
  },
  "30": {
    "text": "يستخدم ملح البحر لكل شيء.",
    "romanization": "Yastaḫdim milḥ al-baḥr li-kull shayʾ."
  },
  "31": {
    "text": "كيس الطحين شبه فارغ.",
    "romanization": "Kīs aṭ-ṭaḥīn shibh fārigh."
  },
  "32": {
    "text": "الكريمة فسدت خلال عطلة نهاية الأسبوع.",
    "romanization": "Al-krīmah fasadat khilāl ʿuṭlat nihāyat al-usbūʿ."
  },
  "33": {
    "text": "أفضل الزبادي اليوناني على القشطة الحامضة.",
    "romanization": "Ufaḍḍil az-zabādī al-yūnānī ʿalá al-qishṭah al-ḥāmiḍah."
  },
  "34": {
    "text": "الفطر ينكمش أثناء الطهي.",
    "romanization": "Al-fiṭr yankaṣh athnāʾ aṭ-ṭahī."
  },
  "35": {
    "text": "أضف رشة من الفلفل الأحمر.",
    "romanization": "Aḍif rashshah min al-filfil al-aḥmar."
  },
  "36": {
    "text": "تتطلب الوصفة كوبين من المرق.",
    "romanization": "Tataṭallab al-waṣfah kōbayn min al-maraq."
  },
  "37": {
    "text": "تحتفظ دائمًا بالأنشوجة في خزانة المؤن.",
    "romanization": "Taḥtafiẓ dāʾiman bi-al-anshūjah fī khizānat al-muʾan."
  },
  "38": {
    "text": "تصبح الفلفل حلوة عندما تُشوى.",
    "romanization": "Taṣbiḥ al-filfil ḥulwah ʿindamā tushwá."
  },
  "39": {
    "text": "البازلاء المجمدة معجزة صغيرة.",
    "romanization": "Al-bāzilāʾ al-mujammadah muʿjizah ṣaghīrah."
  },
  "40": {
    "text": "رائحة الخبز تملأ المطبخ.",
    "romanization": "Rāʾiḥat al-khubz tamlaʾ al-maṭbakh."
  },
  "41": {
    "text": "سكب الأرز في كل مكان على الطاولة.",
    "romanization": "Sakaba al-aruzz fī kull makān ʿalá aṭ-ṭāwilah."
  },
  "42": {
    "text": "المقلاة ساخنة جدًا بالفعل.",
    "romanization": "Al-miqlāh sākhinah jiddan bi-al-fiʿl."
  },
  "43": {
    "text": "أحرقت الخبز المحمص مرة أخرى.",
    "romanization": "Aḥraqtu al-khubz al-muḥammaṣ marratan ukhrá."
  },
  "44": {
    "text": "تذوقت الصلصة وأضافت المزيد من الملح.",
    "romanization": "Tadhawwaqat aṣ-ṣalṣah wa-aḍāfat al-mazīd min al-milḥ."
  },
  "45": {
    "text": "انطلق جرس إنذار الدخان أثناء العشاء.",
    "romanization": "Inṭalaqa jaras inthār ad-dukhān athnāʾ al-ʿashāʾ."
  },
  "46": {
    "text": "ينظف أولًا بأول.",
    "romanization": "Yunaẓẓif awwalan bi-awwal."
  },
  "47": {
    "text": "فاضت القدر بينما كانت تجيب على الهاتف.",
    "romanization": "Fāḍat al-qidr baynamā kānat tujīb ʿalá al-hātif."
  },
  "48": {
    "text": "الثلاجة بحاجة إلى مسح.",
    "romanization": "Ath-thallājah bi-ḥājah ilá masḥ."
  },
  "49": {
    "text": "رتب الأطفال المائدة دون أن يُطلب منهم.",
    "romanization": "Rattaba al-aṭfāl al-māʾidah dūna an yuṭlab minhum."
  },
  "50": {
    "text": "ماء المعكرونة يغلي.",
    "romanization": "Māʾ al-maʿkarūnah yaghlī."
  },
  "51": {
    "text": "وضعت منشفة تحت لوح التقطيع حتى لا ينزلق.",
    "romanization": "Waḍaʿat minshafah taḥta lawḥ at-taqṭīʿ ḥattá lā yanzaliq."
  },
  "52": {
    "text": "يطهو دائمًا حافي القدمين.",
    "romanization": "Yaṭhū dāʾiman ḥāfī al-qadamayn."
  },
  "53": {
    "text": "هبطت الكعكة عندما فتحت الفرن.",
    "romanization": "Habaṭat al-kaʿkah ʿindamā fataḥtu al-furn."
  },
  "54": {
    "text": "نسينا تسخين الفرن مسبقًا.",
    "romanization": "Nasīnā tasḫīn al-furn musbaqan."
  },
  "55": {
    "text": "راقب الكلب كل حركة من عتبة الباب.",
    "romanization": "Rāqaba al-kalb kulla ḥarakah min ʿatabat al-bāb."
  },
  "56": {
    "text": "نافذة المطبخ مفتوحة لإخراج البخار.",
    "romanization": "Nāfidhat al-maṭbakh maftūḥah li-ikhrāj al-bukhār."
  },
  "57": {
    "text": "رفعت صوت الموسيقى بينما كانت تطبخ.",
    "romanization": "Rafaʿat ṣawt al-mūsīqá baynamā kānat taṭbukh."
  },
  "58": {
    "text": "تراكمت الأطباق بينما كنا نأكل.",
    "romanization": "Tarakkamat al-aṭbāq baynamā kunnā naʾkul."
  },
  "59": {
    "text": "البقايا ستكون غداء الغد.",
    "romanization": "Al-baqāyā satakūnu ghadāʾ al-ghad."
  },
  "60": {
    "text": "اتبعت الوصفة خطوة بخطوة.",
    "romanization": "Ittabaʿtu al-waṣfah khaṭwatan bi-khaṭwah."
  },
  "61": {
    "text": "أول فطيرة دائمًا ما تكون الأسوأ.",
    "romanization": "Awwal faṭīrah dāʾiman mā takūnu al-aswaʾ."
  },
  "62": {
    "text": "اخترعت الصلصة بالصدفة.",
    "romanization": "Ikhtaraʿat aṣ-ṣalṣah bi-aṣ-ṣudfah."
  },
  "63": {
    "text": "علّم نفسه الخبز خلال الشتاء.",
    "romanization": "ʿAllama nafsahu al-khubz khilāl ash-shitāʾ."
  },
  "64": {
    "text": "انفتح كتاب الطبخ على نفس الصفحة.",
    "romanization": "Infataḥa kitāb aṭ-ṭabkh ʿalá nafs aṣ-ṣafḥah."
  },
  "65": {
    "text": "ضاعفت كمية الوصفة وصنعت الكثير.",
    "romanization": "Ḍāʿaftu kammiyat al-waṣfah wa-ṣanaʿtu al-kathīr."
  },
  "66": {
    "text": "أراني الفيديو كيف أطوي فطيرة الدمبلنغ.",
    "romanization": "Arānī al-fīdyū kayfa aṭwī faṭīrat ad-dambling."
  },
  "67": {
    "text": "يزن كل شيء بميزان صغير.",
    "romanization": "Yazin kulla shayʾ bi-mīzān ṣaghīr."
  },
  "68": {
    "text": "تطبخ بالرائحة أكثر من الساعة.",
    "romanization": "Taṭbukh bi-ar-rāʾiḥah akthar min as-sāʿah."
  },
  "69": {
    "text": "جربت بهارًا جديدًا ونجح الأمر.",
    "romanization": "Jarrabtu bahāran jadīdan wa-najaḥa al-amr."
  },
  "70": {
    "text": "الخبز لم يرتفع في المرة الأولى.",
    "romanization": "Al-khubz lam yartafiʿ fī al-marrah al-ūlá."
  },
  "71": {
    "text": "تذوقت أثناء الطهي وعدّلت.",
    "romanization": "Tadhawwaqat athnāʾ aṭ-ṭahī wa-ʿaddalat."
  },
  "72": {
    "text": "تعلم هذا الطبق من جدته.",
    "romanization": "Taʿallama hādhā aṭ-ṭabaq min jaddatih."
  },
  "73": {
    "text": "توارثت الوصفة عبر بطاقة صغيرة.",
    "romanization": "Tawārathat al-waṣfah ʿabra biṭāqah ṣaghīrah."
  },
  "74": {
    "text": "الطبخ لشخص واحد فن مختلف.",
    "romanization": "Aṭ-ṭabkh li-shakhṣ wāḥid fann mukhtalif."
  },
  "75": {
    "text": "العشاء جاهز في خمس دقائق.",
    "romanization": "Al-ʿashāʾ jāhiz fī khams daqāʾiq."
  },
  "76": {
    "text": "ناولني الخبز من فضلك.",
    "romanization": "Nāwilnī al-khubz min faḍlik."
  },
  "77": {
    "text": "المطبخ هو أدفأ غرفة في المنزل.",
    "romanization": "Al-maṭbakh huwa adfaʾ ghurfah fī al-manzil."
  },
  "78": {
    "text": "أكلنا في الخارج بينما كانت الشمس تغرب.",
    "romanization": "Akalnā fī al-khārij baynamā kānat ash-shams taghrub."
  },
  "79": {
    "text": "ساعد الجميع في غسل الأطباق.",
    "romanization": "Sāʿada al-jamīʿ fī ghasl al-aṭbāq."
  },
  "80": {
    "text": "تطبخ دائمًا كمية كبيرة جدًا، عن قصد.",
    "romanization": "Taṭbukh dāʾiman kammiyah kabīrah jiddan, ʿan qaṣd."
  },
  "81": {
    "text": "يحضر دائمًا زجاجة نبيذ.",
    "romanization": "Yuḥḍir dāʾiman zujājat nabīdh."
  },
  "82": {
    "text": "أكل الأطفال ثلاث حصص.",
    "romanization": "Akala al-aṭfāl thalāth ḥiṣaṣ."
  },
  "83": {
    "text": "احترقت الشموع حتى النهاية.",
    "romanization": "Iḥtaraqat ash-shumūʿ ḥattá an-nihāyah."
  },
  "84": {
    "text": "تحدثنا طويلًا بعد رفع الأطباق.",
    "romanization": "Taḥaddathnā ṭawīlan baʿda rafʿ al-aṭbāq."
  },
  "85": {
    "text": "السكين أحدّ مما تبدو عليه.",
    "romanization": "As-sikkīn aḥadd mimmā tabdū ʿalayh."
  },
  "86": {
    "text": "استخدم الملعقة الخشبية للصلصة.",
    "romanization": "Istaḫdim al-milʿaqah al-khashabīyah li-aṣ-ṣalṣah."
  },
  "87": {
    "text": "مقلاة الحديد الزهر ثقيلة ولكنها تستحق العناء.",
    "romanization": "Miqlāt al-ḥadīd az-zahr thaqīlah wa-lākinnahā tastaḥiqq al-ʿanāʾ."
  },
  "88": {
    "text": "يحتفظ بالبهارات في درج صغير.",
    "romanization": "Yaḥtafiẓ bi-al-bahārāt fī durj ṣaghīr."
  },
  "89": {
    "text": "لوح تقطيع جيد يجعل كل شيء أسهل.",
    "romanization": "Lawḥ taqṭīʿ jayyid yajʿal kulla shayʾ ashal."
  },
  "90": {
    "text": "الفرن أصبح ساخنًا بما يكفي أخيرًا.",
    "romanization": "Al-furn aṣbaḥa sākhinan bi-mā yakfī akhīran."
  },
  "91": {
    "text": "الخلاط يواجه صعوبة مع اللوز الكامل.",
    "romanization": "Al-khallāṭ yuwājih ṣuʿūbah maʿ al-lawz al-kāmil."
  },
  "92": {
    "text": "مسحت الطاولة بقطعة قماش مبللة.",
    "romanization": "Masaḥat aṭ-ṭāwilah bi-qiṭʿat qumāsh muballalah."
  },
  "93": {
    "text": "المصفاة في الدرج الثاني.",
    "romanization": "Al-miṣfāh fī ad-durj ath-thānī."
  },
  "94": {
    "text": "لا تنس قفازات الفرن.",
    "romanization": "Lā tansa quffāzāt al-furn."
  },
  "95": {
    "text": "الطبخ غالبًا ما يكون صبرًا.",
    "romanization": "Aṭ-ṭabkh ghāliban mā yakūnu ṣabran."
  },
  "96": {
    "text": "نفس المكونات تصنع أطباقًا مختلفة في أيدي مختلفة.",
    "romanization": "Nafs al-mukawwināt taṣnaʿ aṭbāqan mukhtalifah fī aydī mukhtalifah."
  },
  "97": {
    "text": "الملح هو أول شيء تعدّله.",
    "romanization": "Al-milḥ huwa awwal shayʾ tuʿaddiluhu."
  },
  "98": {
    "text": "تذوق قبل أن تضيف المزيد.",
    "romanization": "Tadhawwaq qabla an tuḍīf al-mazīd."
  },
  "99": {
    "text": "وجبة بسيطة تؤكل ببطء هي انتصار صغير.",
    "romanization": "Wajbah basīṭah tuʾkal bi-buṭʾ hiya intiṣār ṣaghīr."
  }
}