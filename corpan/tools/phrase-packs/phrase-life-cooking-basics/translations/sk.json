{
  "0": {
    "text": "Nakrájajte cibuľu nadrobno.",
    "romanization": null
  },
  "1": {
    "text": "Vodu priveďte do varu, kým pridáte cestoviny.",
    "romanization": null
  },
  "2": {
    "text": "Omáčku miešajte, kým sa varí.",
    "romanization": null
  },
  "3": {
    "text": "Kura osoľte a okoreňte.",
    "romanization": null
  },
  "4": {
    "text": "Vajíčka vyšľahajte do peny.",
    "romanization": null
  },
  "5": {
    "text": "Múku zľahka vmiešajte.",
    "romanization": null
  },
  "6": {
    "text": "Mäso nechajte pár minút odpočívať.",
    "romanization": null
  },
  "7": {
    "text": "Zeleninu pečte na vysokej teplote.",
    "romanization": null
  },
  "8": {
    "text": "Chlieb krájajte šikmo.",
    "romanization": null
  },
  "9": {
    "text": "Cesnak orestujte, ale nespáľte ho.",
    "romanization": null
  },
  "10": {
    "text": "Polievku opäť priveďte do varu.",
    "romanization": null
  },
  "11": {
    "text": "Vývar nechajte hodinu jemne vrieť.",
    "romanization": null
  },
  "12": {
    "text": "Kura marinujte cez noc.",
    "romanization": null
  },
  "13": {
    "text": "Korenie najprv opečte na suchej panvici.",
    "romanization": null
  },
  "14": {
    "text": "Víno zredukujte na polovicu.",
    "romanization": null
  },
  "15": {
    "text": "Brokolicu varte v pare štyri minúty.",
    "romanization": null
  },
  "16": {
    "text": "Cibuľu karamelizujte pomaly.",
    "romanization": null
  },
  "17": {
    "text": "Cesto mieste, kým nebude hladké.",
    "romanization": null
  },
  "18": {
    "text": "Vývar preceďte cez jemné sitko.",
    "romanization": null
  },
  "19": {
    "text": "Navrch nastrúhajte trochu čerstvého muškátového orieška.",
    "romanization": null
  },
  "20": {
    "text": "Došiel nám olivový olej.",
    "romanization": null
  },
  "21": {
    "text": "Citrón je príliš suchý na šťavu.",
    "romanization": null
  },
  "22": {
    "text": "Mohli by ste mi podať soľ?",
    "romanization": null
  },
  "23": {
    "text": "Čerstvá bazalka robí veľký rozdiel.",
    "romanization": null
  },
  "24": {
    "text": "Cesnak kupujem po hlávkach.",
    "romanization": null
  },
  "25": {
    "text": "Hnedý cukor robí sušienky jemnejšími.",
    "romanization": null
  },
  "26": {
    "text": "Vajíčka sú stále v chladničke.",
    "romanization": null
  },
  "27": {
    "text": "Koriander je v záhrade už skoro hotový.",
    "romanization": null
  },
  "28": {
    "text": "Potrebujeme paradajku do sendviča.",
    "romanization": null
  },
  "29": {
    "text": "Maslo zmäkne rýchlejšie na linke.",
    "romanization": null
  },
  "30": {
    "text": "Na všetko používa morskú soľ.",
    "romanization": null
  },
  "31": {
    "text": "Vrece s múkou je skoro prázdne.",
    "romanization": null
  },
  "32": {
    "text": "Smotana sa cez víkend pokazila.",
    "romanization": null
  },
  "33": {
    "text": "Grécky jogurt mám radšej ako kyslú smotanu.",
    "romanization": null
  },
  "34": {
    "text": "Huby sa pri varení zmenšujú.",
    "romanization": null
  },
  "35": {
    "text": "Pridajte štipku červenej papriky.",
    "romanization": null
  },
  "36": {
    "text": "Recept vyžaduje dve šálky vývaru.",
    "romanization": null
  },
  "37": {
    "text": "Vždy má v špajzi ančovičky.",
    "romanization": null
  },
  "38": {
    "text": "Papriky zosladnú, keď sa upečú.",
    "romanization": null
  },
  "39": {
    "text": "Mrazený hrášok je malý zázrak.",
    "romanization": null
  },
  "40": {
    "text": "V kuchyni vonia chlieb.",
    "romanization": null
  },
  "41": {
    "text": "Ryžu rozsypal po celej linke.",
    "romanization": null
  },
  "42": {
    "text": "Panvica je už príliš horúca.",
    "romanization": null
  },
  "43": {
    "text": "Zase som spálil hrianky.",
    "romanization": null
  },
  "44": {
    "text": "Ochutnala omáčku a pridala viac soli.",
    "romanization": null
  },
  "45": {
    "text": "Počas večere sa spustil dymový alarm.",
    "romanization": null
  },
  "46": {
    "text": "Upratuje priebežne.",
    "romanization": null
  },
  "47": {
    "text": "Hrniec vykypel, kým zdvihla telefón.",
    "romanization": null
  },
  "48": {
    "text": "Chladničku treba utrieť.",
    "romanization": null
  },
  "49": {
    "text": "Deti prestreli stôl bez toho, aby ich niekto požiadal.",
    "romanization": null
  },
  "50": {
    "text": "Voda na cestoviny buble.",
    "romanization": null
  },
  "51": {
    "text": "Pod dosku na krájanie dala utierku, aby sa nešmýkala.",
    "romanization": null
  },
  "52": {
    "text": "Vždy varí bosý.",
    "romanization": null
  },
  "53": {
    "text": "Koláč spadol, keď som otvoril rúru.",
    "romanization": null
  },
  "54": {
    "text": "Zabudli sme predhriať rúru.",
    "romanization": null
  },
  "55": {
    "text": "Pes sledoval každý pohyb z dverí.",
    "romanization": null
  },
  "56": {
    "text": "Okno v kuchyni je otvorené, aby vyšla para.",
    "romanization": null
  },
  "57": {
    "text": "Pri varení si pustila hlasnejšie hudbu.",
    "romanization": null
  },
  "58": {
    "text": "Riad sa hromadil, kým sme jedli.",
    "romanization": null
  },
  "59": {
    "text": "Zvyšky budú zajtra na obed.",
    "romanization": null
  },
  "60": {
    "text": "Postupoval som podľa receptu krok za krokom.",
    "romanization": null
  },
  "61": {
    "text": "Prvá palacinka je vždy najhoršia.",
    "romanization": null
  },
  "62": {
    "text": "Omáčku vymyslela náhodou.",
    "romanization": null
  },
  "63": {
    "text": "Cez zimu sa naučil piecť sám.",
    "romanization": null
  },
  "64": {
    "text": "Kuchárska kniha sa otvorila na tej istej strane.",
    "romanization": null
  },
  "65": {
    "text": "Zdvojnásobil som recept a urobil som toho príliš veľa.",
    "romanization": null
  },
  "66": {
    "text": "Video mi ukázalo, ako zložiť knedľu.",
    "romanization": null
  },
  "67": {
    "text": "Všetko váži na malej váhe.",
    "romanization": null
  },
  "68": {
    "text": "Varí skôr podľa vône ako podľa hodín.",
    "romanization": null
  },
  "69": {
    "text": "Vyskúšal som nové korenie a fungovalo to.",
    "romanization": null
  },
  "70": {
    "text": "Chlieb prvýkrát nevykysol.",
    "romanization": null
  },
  "71": {
    "text": "Ochutnávala priebežne a prispôsobovala.",
    "romanization": null
  },
  "72": {
    "text": "Toto jedlo sa naučil od svojej babičky.",
    "romanization": null
  },
  "73": {
    "text": "Recept sa odovzdával na malej kartičke.",
    "romanization": null
  },
  "74": {
    "text": "Varenie pre jedného je iné umenie.",
    "romanization": null
  },
  "75": {
    "text": "Večera je hotová o päť minút.",
    "romanization": null
  },
  "76": {
    "text": "Prosím, podajte mi chlieb.",
    "romanization": null
  },
  "77": {
    "text": "Kuchyňa je najteplejšia miestnosť v dome.",
    "romanization": null
  },
  "78": {
    "text": "Jedli sme vonku, kým zapadalo slnko.",
    "romanization": null
  },
  "79": {
    "text": "Všetci pomáhali s riadom.",
    "romanization": null
  },
  "80": {
    "text": "Vždy varí príliš veľa, naschvál.",
    "romanization": null
  },
  "81": {
    "text": "Vždy prinesie fľašu vína.",
    "romanization": null
  },
  "82": {
    "text": "Deti zjedli tri porcie.",
    "romanization": null
  },
  "83": {
    "text": "Sviečky dohoreli úplne.",
    "romanization": null
  },
  "84": {
    "text": "Rozprávali sme sa dlho po tom, čo sa odpratali taniere.",
    "romanization": null
  },
  "85": {
    "text": "Nôž je ostrejší, než vyzerá.",
    "romanization": null
  },
  "86": {
    "text": "Na omáčku použite drevenú varešku.",
    "romanization": null
  },
  "87": {
    "text": "Liatinová panvica je ťažká, ale stojí za to.",
    "romanization": null
  },
  "88": {
    "text": "Korenie má v malej zásuvke.",
    "romanization": null
  },
  "89": {
    "text": "Dobrá doska na krájanie všetko uľahčí.",
    "romanization": null
  },
  "90": {
    "text": "Rúra je konečne dostatočne horúca.",
    "romanization": null
  },
  "91": {
    "text": "Mixér má problém s celými mandľami.",
    "romanization": null
  },
  "92": {
    "text": "Utierala linku vlhkou handrou.",
    "romanization": null
  },
  "93": {
    "text": "Cedník je v druhej zásuvke.",
    "romanization": null
  },
  "94": {
    "text": "Nezabudnite na chňapky.",
    "romanization": null
  },
  "95": {
    "text": "Varenie je väčšinou o trpezlivosti.",
    "romanization": null
  },
  "96": {
    "text": "Tie isté ingrediencie robia v rôznych rukách rôzne jedlá.",
    "romanization": null
  },
  "97": {
    "text": "Soľ je prvá vec, ktorú upravíte.",
    "romanization": null
  },
  "98": {
    "text": "Ochutnajte, kým pridáte viac.",
    "romanization": null
  },
  "99": {
    "text": "Jednoduché jedlo zjedené pomaly je malé víťazstvo.",
    "romanization": null
  }
}