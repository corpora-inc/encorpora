{
  "0": {
    "text": "ಈರುಳ್ಳಿಯನ್ನು ಸಣ್ಣಗೆ ಹೆಚ್ಚಿ.",
    "romanization": "īruḷḷiyannu saṇṇage hecci."
  },
  "1": {
    "text": "ಪಾಸ್ತಾ ಹಾಕುವ ಮೊದಲು ನೀರನ್ನು ಕುದಿಸಿ.",
    "romanization": "pāstā hākuva modalu nīrannu kudisi."
  },
  "2": {
    "text": "ಸಾಸ್ ಕುದಿಯುತ್ತಿರುವಾಗ ತಿರುಗಿಸುತ್ತಾ ಇರಿ.",
    "romanization": "sās kudiyuttiruvāga tirugisuttā iri."
  },
  "3": {
    "text": "ಚಿಕನ್‌ಗೆ ಉಪ್ಪು ಮತ್ತು ಮೆಣಸು ಹಾಕಿ.",
    "romanization": "cikan-ge uppu mattu meṇasu hāki."
  },
  "4": {
    "text": "ಮೊಟ್ಟೆ ನೊರೆ ಬರುವವರೆಗೆ ಚೆನ್ನಾಗಿ ಕಲಸಿ.",
    "romanization": "moṭṭe nore baruvavarege cennāgi kalasi."
  },
  "5": {
    "text": "ಹಿಟ್ಟನ್ನು ನಿಧಾನವಾಗಿ ಸೇರಿಸಿ.",
    "romanization": "hiṭṭannu nidānavāgi sērisi."
  },
  "6": {
    "text": "ಮಾಂಸವನ್ನು ಕೆಲವು ನಿಮಿಷ ವಿಶ್ರಮಿಸಲು ಬಿಡಿ.",
    "romanization": "māṁsavannu kelavu nimiṣa viśramisalu biḍi."
  },
  "7": {
    "text": "ತರಕಾರಿಗಳನ್ನು ಹೆಚ್ಚು ಉರಿಯಲ್ಲಿ ಸುಡಿ.",
    "romanization": "tarakārigaḷannu heccu uriyalli suḍi."
  },
  "8": {
    "text": "ಬ್ರೆಡ್ ಅನ್ನು ಓರೆಯಾಗಿ ಕತ್ತರಿಸಿ.",
    "romanization": "breḍ annu ōreyāgi kattarisi."
  },
  "9": {
    "text": "ಬೆಳ್ಳುಳ್ಳಿಯನ್ನು ಹುರಿಯಿರಿ, ಆದರೆ ಸುಡಬೇಡಿ.",
    "romanization": "beḷḷuḷḷiyannu huriyiri, ādare suḍabēḍi."
  },
  "10": {
    "text": "ಸೂಪ್ ಅನ್ನು ಮತ್ತೆ ಕುದಿಸಿ.",
    "romanization": "sūp annu matte kudisi."
  },
  "11": {
    "text": "ಸ್ಟಾಕ್ ಅನ್ನು ಒಂದು ಗಂಟೆ ಸಣ್ಣ ಉರಿಯಲ್ಲಿ ಕುದಿಸಿ.",
    "romanization": "sṭāk annu ondu gaṇṭe saṇṇa uriyalli kudisi."
  },
  "12": {
    "text": "ಚಿಕನ್‌ ಅನ್ನು ರಾತ್ರಿಯಿಡೀ ಮ್ಯಾರಿನೇಟ್ ಮಾಡಿ.",
    "romanization": "cikan annu rātriyiḍī myārinēṭ māḍi."
  },
  "13": {
    "text": "ಮೊದಲು ಮಸಾಲೆಗಳನ್ನು ಬರಿ ಬಾಣಲೆಯಲ್ಲಿ ಹುರಿಯಿರಿ.",
    "romanization": "modalu masālegaḷannu bari bāṇalēyalli huriyiri."
  },
  "14": {
    "text": "ವೈನ್ ಅನ್ನು ಅರ್ಧದಷ್ಟು ಇಂಗಿಸಿ.",
    "romanization": "vain annu ardhadastu iṅgisi."
  },
  "15": {
    "text": "ಬ್ರೊಕೊಲಿಯನ್ನು ನಾಲ್ಕು ನಿಮಿಷ ಆವಿಯಲ್ಲಿ ಬೇಯಿಸಿ.",
    "romanization": "brokoliyaannu nālku nimiṣa āviyalli bēyisi."
  },
  "16": {
    "text": "ಈರುಳ್ಳಿಯನ್ನು ನಿಧಾನವಾಗಿ ಕ್ಯಾರಮೆಲೈಸ್ ಮಾಡಿ.",
    "romanization": "īruḷḷiyannu nidānavāgi kyāramelais māḍi."
  },
  "17": {
    "text": "ಹಿಟ್ಟನ್ನು ನುಣುಪಾಗುವವರೆಗೆ ನಾದಿ.",
    "romanization": "hiṭṭannu nuṇupāguvavarege nādi."
  },
  "18": {
    "text": "ಬ್ರೋತ್ ಅನ್ನು ಸಣ್ಣ ಜರಡಿ ಮೂಲಕ ಸೋಸಿ.",
    "romanization": "brōt annu saṇṇa jaraḍi mūlaka sōsi."
  },
  "19": {
    "text": "ಮೇಲೆ ಸ್ವಲ್ಪ ತಾಜಾ ಜಾಯಿಕಾಯಿ ತುರಿ.",
    "romanization": "mēle svalpa tājhā jāyikāyi turi."
  },
  "20": {
    "text": "ನಮ್ಮಲ್ಲಿ ಆಲಿವ್ ಎಣ್ಣೆ ಖಾಲಿಯಾಗಿದೆ.",
    "romanization": "nammalli āliv eṇṇe khāliyāgide."
  },
  "21": {
    "text": "ನಿಂಬೆಹಣ್ಣಿನಲ್ಲಿ ರಸ ತೆಗೆಯಲು ತುಂಬಾ ಒಣಗಿದೆ.",
    "romanization": "nimbehaṇṇinalli rasa tegeyalu tumbā oṇagide."
  },
  "22": {
    "text": "ಉಪ್ಪನ್ನು ಕೊಡುತ್ತೀರಾ?",
    "romanization": "uppannu koḍuttīrā?"
  },
  "23": {
    "text": "ತಾಜಾ ತುಳಸಿ ದೊಡ್ಡ ವ್ಯತ್ಯಾಸವನ್ನು ಮಾಡುತ್ತದೆ.",
    "romanization": "tājhā tuḷasi doḍḍa vyatyāsavannu māḍuttade."
  },
  "24": {
    "text": "ನಾನು ಬೆಳ್ಳುಳ್ಳಿಯನ್ನು ಗಡ್ಡೆ ಲೆಕ್ಕದಲ್ಲಿ ಖರೀದಿಸುತ್ತೇನೆ.",
    "romanization": "nānu beḷḷuḷḷiyannu gaḍḍe lekkadalli kharīdisuttēne."
  },
  "25": {
    "text": "ಕಂದು ಸಕ್ಕರೆ ಕುಕೀಗಳನ್ನು ಮೃದುವಾಗಿಸುತ್ತದೆ.",
    "romanization": "kandu sakkare kukīgaḷannu mṛduvāgisuttade."
  },
  "26": {
    "text": "ಮೊಟ್ಟೆಗಳು ಇನ್ನೂ ಫ್ರಿಜ್‌ನಲ್ಲಿವೆ.",
    "romanization": "moṭṭegaḷu innū phrijnallive."
  },
  "27": {
    "text": "ತೋಟದಲ್ಲಿ ಕೊತ್ತಂಬರಿ ಸೊಪ್ಪು ಬಹುತೇಕ ಸಿದ್ಧವಾಗಿದೆ.",
    "romanization": "tōṭadalli kottambari soppu bahutēka siddhavāgide."
  },
  "28": {
    "text": "ಸ್ಯಾಂಡ್‌ವಿಚ್‌ಗೆ ಒಂದು ಟೊಮೆಟೊ ಬೇಕು.",
    "romanization": "syāṇḍvic-ge ondu ṭomeṭo bēku."
  },
  "29": {
    "text": "ಕೌಂಟರ್ ಮೇಲೆ ಬೆಣ್ಣೆ ಬೇಗ ಮೃದುವಾಗುತ್ತದೆ.",
    "romanization": "kauṇṭar mēle beṇṇe bēga mṛduvāguttade."
  },
  "30": {
    "text": "ಅವನು ಎಲ್ಲದಕ್ಕೂ ಕಡಲ ಉಪ್ಪನ್ನು ಬಳಸುತ್ತಾನೆ.",
    "romanization": "avanu elladakkū kaḍala uppannu baḷasuttāne."
  },
  "31": {
    "text": "ಹಿಟ್ಟಿನ ಚೀಲ ಬಹುತೇಕ ಖಾಲಿಯಾಗಿದೆ.",
    "romanization": "hiṭṭina cīla bahutēka khāliyāgide."
  },
  "32": {
    "text": "ವಾರಾಂತ್ಯದಲ್ಲಿ ಕ್ರೀಮ್ ಹಾಳಾಗಿದೆ.",
    "romanization": "vārāntyadalli krīm hāḷāgide."
  },
  "33": {
    "text": "ನನಗೆ ಸೌರ್ ಕ್ರೀಮ್‌ಗಿಂತ ಗ್ರೀಕ್ ಮೊಸರು ಹೆಚ್ಚು ಇಷ್ಟ.",
    "romanization": "nanage saur krīm-ginta grīk mosaru heccu iṣṭa."
  },
  "34": {
    "text": "ಅಣಬೆಗಳು ಬೇಯುವಾಗ ಕುಗ್ಗುತ್ತವೆ.",
    "romanization": "aṇabegaḷu bēyuvāga kugguttāve."
  },
  "35": {
    "text": "ಒಂದು ಚಿಟಿಕೆ ಕೆಂಪು ಮೆಣಸು ಸೇರಿಸಿ.",
    "romanization": "ondu ciṭike kempu meṇasu sērisi."
  },
  "36": {
    "text": "ಈ ಪಾಕವಿಧಾನಕ್ಕೆ ಎರಡು ಕಪ್ ಬ್ರೋತ್ ಬೇಕು.",
    "romanization": "ī pāka-vidhānakkke eraḍu kap brōt bēku."
  },
  "37": {
    "text": "ಅವಳು ಯಾವಾಗಲೂ ಆಂಚೋವಿಗಳನ್ನು ಪ್ಯಾಂಟ್ರಿಯಲ್ಲಿ ಇಡುತ್ತಾಳೆ.",
    "romanization": "avaḷu yāvāgalū āṁcōvigaḷannu pyāṇṭriyalli iḍuttāḷe."
  },
  "38": {
    "text": "ಮೆಣಸುಗಳನ್ನು ಸುಟ್ಟಾಗ ಅವು ಸಿಹಿಯಾಗುತ್ತವೆ.",
    "romanization": "meṇasugaḷannu suṭṭāga avu sihiyāguttāve."
  },
  "39": {
    "text": "ಹೆಪ್ಪುಗಟ್ಟಿದ ಬಟಾಣಿ ಒಂದು ಸಣ್ಣ ಪವಾಡ.",
    "romanization": "heppugaṭṭida baṭāṇi ondu saṇṇa pavāḍa."
  },
  "40": {
    "text": "ಅಡುಗೆಮನೆ ಬ್ರೆಡ್ ವಾಸನೆ ಬರುತ್ತಿದೆ.",
    "romanization": "aḍugemane breḍ vāsane baruttide."
  },
  "41": {
    "text": "ಅವನು ಕೌಂಟರ್ ಮೇಲೆಲ್ಲಾ ಅನ್ನ ಚೆಲ್ಲಿದ.",
    "romanization": "avanu kauṇṭar mēlellā anna cellida."
  },
  "42": {
    "text": "ಬಾಣಲೆ ಈಗಾಗಲೇ ತುಂಬಾ ಬಿಸಿಯಾಗಿದೆ.",
    "romanization": "bāṇale īgāgalē tumbā bisiyāgide."
  },
  "43": {
    "text": "ನಾನು ಮತ್ತೆ ಟೋಸ್ಟ್ ಸುಟ್ಟುಬಿಟ್ಟೆ.",
    "romanization": "nānu matte ṭōsṭ suṭṭubiṭṭe."
  },
  "44": {
    "text": "ಅವಳು ಸಾಸ್ ರುಚಿ ನೋಡಿ, ಇನ್ನಷ್ಟು ಉಪ್ಪು ಸೇರಿಸಿದಳು.",
    "romanization": "avaḷu sās ruci nōḍi, innastu uppu sērisidaḷu."
  },
  "45": {
    "text": "ಊಟದ ಸಮಯದಲ್ಲಿ ಹೊಗೆ ಅಲಾರಾಂ ಮೊಳಗಿತು.",
    "romanization": "ūṭada samayadalli hoge alārāṁ moḷagitu."
  },
  "46": {
    "text": "ಅವನು ಕೆಲಸ ಮಾಡುವಾಗಲೇ ಸ್ವಚ್ಛಗೊಳಿಸುತ್ತಾನೆ.",
    "romanization": "avanu kelasa māḍuvāgalē svacchagoḷisuttāne."
  },
  "47": {
    "text": "ಅವಳು ಫೋನ್ ಉತ್ತರಿಸುವಾಗ ಪಾತ್ರೆ ಉಕ್ಕಿ ಹರಿಯಿತು.",
    "romanization": "avaḷu phōn uttārisuvāga pātre ukki hariyitu."
  },
  "48": {
    "text": "ಫ್ರಿಜ್ ಅನ್ನು ಒರೆಸಬೇಕು.",
    "romanization": "phrij annu oresabēku."
  },
  "49": {
    "text": "ಮಕ್ಕಳು ಕೇಳದೆ ಮೇಜು ಸಿದ್ಧಪಡಿಸಿದರು.",
    "romanization": "makkaḷu kēḷade mēju siddhapaḍisidaru."
  },
  "50": {
    "text": "ಪಾಸ್ತಾ ನೀರು ಕುದಿಯುತ್ತಿದೆ.",
    "romanization": "pāstā nīru kudiyuttide."
  },
  "51": {
    "text": "ಕಟಿಂಗ್ ಬೋರ್ಡ್ ಜಾರದಂತೆ ಅವಳು ಅದರ ಕೆಳಗೆ ಟವೆಲ್ ಇಟ್ಟಳು.",
    "romanization": "kaṭiṅg bōrḍ jāradante avaḷu adara keḷage ṭavel iṭṭaḷu."
  },
  "52": {
    "text": "ಅವನು ಯಾವಾಗಲೂ ಬರಿಗಾಲಿನಲ್ಲಿ ಅಡುಗೆ ಮಾಡುತ್ತಾನೆ.",
    "romanization": "avanu yāvāgalū barigālinalli aḍuge māḍuttāne."
  },
  "53": {
    "text": "ನಾನು ಓವನ್ ತೆರೆದಾಗ ಕೇಕ್ ಕುಸಿಯಿತು.",
    "romanization": "nānu ōvan teredāga kēk kusiyitu."
  },
  "54": {
    "text": "ನಾವು ಓವನ್ ಅನ್ನು ಮೊದಲೇ ಬಿಸಿ ಮಾಡಲು ಮರೆತಿದ್ದೇವೆ.",
    "romanization": "nāvu ōvan annu modalē basi māḍalu maretiddēve."
  },
  "55": {
    "text": "ನಾಯಿ ಬಾಗಿಲ ಬಳಿಯಿಂದ ಪ್ರತಿಯೊಂದು ಚಲನೆಯನ್ನು ನೋಡುತ್ತಿತ್ತು.",
    "romanization": "nāyi bāgila baḷiyinda pratiyondū calaneyannu nōḍuttittu."
  },
  "56": {
    "text": "ಆವಿ ಹೊರಹೋಗಲು ಅಡುಗೆಮನೆಯ ಕಿಟಕಿ ತೆರೆದಿದೆ.",
    "romanization": "āvi horahōgalu aḍugemaneya kiṭaki teredide."
  },
  "57": {
    "text": "ಅವಳು ಅಡುಗೆ ಮಾಡುವಾಗ ಸಂಗೀತವನ್ನು ಜೋರಾಗಿ ಹಾಕಿದಳು.",
    "romanization": "avaḷu aḍuge māḍuvāga saṅgītavannu jōrāgi hākidaḷu."
  },
  "58": {
    "text": "ನಾವು ಊಟ ಮಾಡುವಾಗ ಪಾತ್ರೆಗಳು ರಾಶಿ ಬಿದ್ದವು.",
    "romanization": "nāvu ūṭa māḍuvāga pātregaḷu rāśi biddavu."
  },
  "59": {
    "text": "ಉಳಿದ ಆಹಾರ ನಾಳೆ ಮಧ್ಯಾಹ್ನದ ಊಟ.",
    "romanization": "uḷida āhāra nāḷe madhyāhnada ūṭa."
  },
  "60": {
    "text": "ನಾನು ಪಾಕವಿಧಾನವನ್ನು ಹಂತ ಹಂತವಾಗಿ ಅನುಸರಿಸಿದೆ.",
    "romanization": "nānu pāka-vidhānavaannu hanta hantavāgi anusariside."
  },
  "61": {
    "text": "ಮೊದಲ ಪ್ಯಾನ್‌ಕೇಕ್ ಯಾವಾಗಲೂ ಕೆಟ್ಟದಾಗಿರುತ್ತದೆ.",
    "romanization": "modala pyānkēk yāvāgalū keṭṭadāgiruttade."
  },
  "62": {
    "text": "ಅವಳು ಆಕಸ್ಮಿಕವಾಗಿ ಆ ಸಾಸ್ ಅನ್ನು ಕಂಡುಹಿಡಿದಳು.",
    "romanization": "avaḷu ākasamikavāgi ā sās annu kaṇḍuhiḍidaḷu."
  },
  "63": {
    "text": "ಅವನು ಚಳಿಗಾಲದಲ್ಲಿ ತಾನೇ ಬೇಕ್ ಮಾಡಲು ಕಲಿತನು.",
    "romanization": "avanu caḷigāladalli tānē bēk māḍalu kalitanu."
  },
  "64": {
    "text": "ಅಡುಗೆ ಪುಸ್ತಕ ಅದೇ ಪುಟಕ್ಕೆ ತೆರೆದುಕೊಂಡಿತು.",
    "romanization": "aḍuge pustaka adē puṭakke teredukoṇḍitu."
  },
  "65": {
    "text": "ನಾನು ಪಾಕವಿಧಾನವನ್ನು ದ್ವಿಗುಣಗೊಳಿಸಿ ತುಂಬಾ ಹೆಚ್ಚು ಮಾಡಿದೆ.",
    "romanization": "nānu pāka-vidhānavaannu dviguṇagoḷisi tumbā heccu māḍide."
  },
  "66": {
    "text": "ಡಂಪ್ಲಿಂಗ್ ಅನ್ನು ಹೇಗೆ ಮಡಚುವುದು ಎಂದು ವಿಡಿಯೋ ನನಗೆ ತೋರಿಸಿತು.",
    "romanization": "ḍampliṅ annu hēge maḍacuvudu endu viḍiyo nanage tōrisitu."
  },
  "67": {
    "text": "ಅವನು ಎಲ್ಲವನ್ನೂ ಸಣ್ಣ ತೂಕದ ಯಂತ್ರದಿಂದ ಅಳೆಯುತ್ತಾನೆ.",
    "romanization": "avanu ellavannū saṇṇa tūkada yantradinda aḷeyuttāne."
  },
  "68": {
    "text": "ಅವಳು ಸಮಯಕ್ಕಿಂತ ವಾಸನೆಯಿಂದ ಹೆಚ್ಚು ಅಡುಗೆ ಮಾಡುತ್ತಾಳೆ.",
    "romanization": "avaḷu samayakkinta vāsaneyinda heccu aḍuge māḍuttāḷe."
  },
  "69": {
    "text": "ನಾನು ಹೊಸ ಮಸಾಲೆಯನ್ನು ಪ್ರಯತ್ನಿಸಿದೆ ಮತ್ತು ಅದು ಚೆನ್ನಾಗಿ ಕೆಲಸ ಮಾಡಿತು.",
    "romanization": "nānu hosa masāleyannu prayatniside mattu adu cennāgi kelasa māḍitu."
  },
  "70": {
    "text": "ಮೊದಲ ಬಾರಿಗೆ ಬ್ರೆಡ್ ಉಬ್ಬಲಿಲ್ಲ.",
    "romanization": "modala bārige breḍ ubbalilla."
  },
  "71": {
    "text": "ಅವಳು ಅಡುಗೆ ಮಾಡುವಾಗ ರುಚಿ ನೋಡಿ ಸರಿಪಡಿಸಿದಳು.",
    "romanization": "avaḷu aḍuge māḍuvāga ruci nōḍi saripaḍisidaḷu."
  },
  "72": {
    "text": "ಅವನು ಈ ಖಾದ್ಯವನ್ನು ತನ್ನ ಅಜ್ಜಿಯಿಂದ ಕಲಿತನು.",
    "romanization": "avanu ī khādyavannu tanna ajjiyinda kalitanu."
  },
  "73": {
    "text": "ಪಾಕವಿಧಾನವನ್ನು ಒಂದು ಸಣ್ಣ ಕಾರ್ಡ್‌ನಲ್ಲಿ ಬರೆದು ನೀಡಲಾಗಿತ್ತು.",
    "romanization": "pāka-vidhānavaannu ondu saṇṇa kārḍnalli baredu nīḍalāgittu."
  },
  "74": {
    "text": "ಒಬ್ಬರಿಗಾಗಿ ಅಡುಗೆ ಮಾಡುವುದು ಒಂದು ವಿಭಿನ್ನ ಕಲೆ.",
    "romanization": "obbarigāgi aḍuge māḍuvudu ondu vibhinna kale."
  },
  "75": {
    "text": "ಐದು ನಿಮಿಷಗಳಲ್ಲಿ ಊಟ ಸಿದ್ಧ.",
    "romanization": "aidu nimiṣagaḷalli ūṭa siddha."
  },
  "76": {
    "text": "ದಯವಿಟ್ಟು ಬ್ರೆಡ್ ಕೊಡಿ.",
    "romanization": "dayaviṭṭu breḍ koḍi."
  },
  "77": {
    "text": "ಅಡುಗೆಮನೆ ಮನೆಯಲ್ಲಿ ಅತ್ಯಂತ ಬೆಚ್ಚಗಿನ ಕೋಣೆ.",
    "romanization": "aḍugemane maneyalli atyanta beccagina kōṇe."
  },
  "78": {
    "text": "ಸೂರ್ಯಾಸ್ತವಾಗುವಾಗ ನಾವು ಹೊರಗೆ ಊಟ ಮಾಡಿದೆವು.",
    "romanization": "sūryāstavāguvāga nāvu horage ūṭa māḍidevu."
  },
  "79": {
    "text": "ಎಲ್ಲರೂ ಪಾತ್ರೆ ತೊಳೆಯಲು ಸಹಾಯ ಮಾಡಿದರು.",
    "romanization": "ellarū pātre toḷeyalu sahāya māḍidaru."
  },
  "80": {
    "text": "ಅವಳು ಯಾವಾಗಲೂ ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ಹೆಚ್ಚು ಅಡುಗೆ ಮಾಡುತ್ತಾಳೆ.",
    "romanization": "avaḷu yāvāgalū uddēśapūrvakavāgi heccu aḍuge māḍuttāḷe."
  },
  "81": {
    "text": "ಅವನು ಯಾವಾಗಲೂ ಒಂದು ಬಾಟಲ್ ವೈನ್ ತರುತ್ತಾನೆ.",
    "romanization": "avanu yāvāgalū ondu bāṭal vain taruttāne."
  },
  "82": {
    "text": "ಮಕ್ಕಳು ಮೂರು ಬಾರಿ ಊಟ ಮಾಡಿದರು.",
    "romanization": "makkaḷu mūru bāri ūṭa māḍidaru."
  },
  "83": {
    "text": "ಮೇಣದಬತ್ತಿಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಉರಿದು ಹೋದವು.",
    "romanization": "mēṇadabattigaḷu sampūrṇavāgi uridu hōdavu."
  },
  "84": {
    "text": "ಪಾತ್ರೆಗಳನ್ನು ತೆಗೆದ ನಂತರವೂ ನಾವು ಬಹಳ ಹೊತ್ತು ಮಾತನಾಡಿದೆವು.",
    "romanization": "pātregaḷannu tegeda nantaravū nāvu baḷa hotu mātanāḍidevu."
  },
  "85": {
    "text": "ಚಾಕು ಕಾಣುವುದಕ್ಕಿಂತ ಹರಿತವಾಗಿದೆ.",
    "romanization": "cāku kāṇuvudakkinta haritavāgide."
  },
  "86": {
    "text": "ಸಾಸ್‌ಗೆ ಮರದ ಸೌಟು ಬಳಸಿ.",
    "romanization": "sās-ge marada sauṭu baḷasi."
  },
  "87": {
    "text": "ಎರಕಹೊಯ್ದ ಕಬ್ಬಿಣದ ಬಾಣಲೆ ಭಾರವಾಗಿದೆ, ಆದರೆ ಅದಕ್ಕೆ ತಕ್ಕ ಬೆಲೆ ಇದೆ.",
    "romanization": "erakahoyda kabbiṇada bāṇale bhāravāgide, ādare adakke takka bele ide."
  },
  "88": {
    "text": "ಅವನು ಮಸಾಲೆಗಳನ್ನು ಸಣ್ಣ ಡ್ರಾಯರ್‌ನಲ್ಲಿ ಇಡುತ್ತಾನೆ.",
    "romanization": "avanu masālegaḷannu saṇṇa ḍrāyar-nalli iḍuttāne."
  },
  "89": {
    "text": "ಉತ್ತಮ ಕಟಿಂಗ್ ಬೋರ್ಡ್ ಎಲ್ಲವನ್ನೂ ಸುಲಭಗೊಳಿಸುತ್ತದೆ.",
    "romanization": "uttama kaṭiṅg bōrḍ ellavannū sulabhagoḷisuttade."
  },
  "90": {
    "text": "ಓವನ್ ಅಂತಿಮವಾಗಿ ಸಾಕಷ್ಟು ಬಿಸಿಯಾಗಿದೆ.",
    "romanization": "ōvan antimavāgi sākaṣṭu bisiyāgide."
  },
  "91": {
    "text": "ಬ್ಲೆಂಡರ್ ಇಡೀ ಬಾದಾಮಿಗಳನ್ನು ರುಬ್ಬಲು ಕಷ್ಟಪಡುತ್ತದೆ.",
    "romanization": "bleṇḍar iḍī bādāmigaḷannu rubbalu kaṣṭapaḍuttade."
  },
  "92": {
    "text": "ಅವಳು ಕೌಂಟರ್ ಅನ್ನು ಒದ್ದೆ ಬಟ್ಟೆಯಿಂದ ಒರೆಸಿದಳು.",
    "romanization": "avaḷu kauṇṭar annu odde baṭṭeyinda oresidaḷu."
  },
  "93": {
    "text": "ಕೋಲಾಂಡರ್ ಎರಡನೇ ಡ್ರಾಯರ್‌ನಲ್ಲಿದೆ.",
    "romanization": "kōlāṇḍar eraḍanē ḍrāyar-nallide."
  },
  "94": {
    "text": "ಓವನ್ ಮಿಟ್‌ಗಳನ್ನು ಮರೆಯಬೇಡಿ.",
    "romanization": "ōvan miṭ-gaḷannu mareyabēḍi."
  },
  "95": {
    "text": "ಅಡುಗೆ ಮಾಡುವುದು ಹೆಚ್ಚಾಗಿ ತಾಳ್ಮೆ.",
    "romanization": "aḍuge māḍuvudu heccāgi tāḷme."
  },
  "96": {
    "text": "ಒಂದೇ ಪದಾರ್ಥಗಳು ಬೇರೆ ಬೇರೆ ಕೈಗಳಲ್ಲಿ ಬೇರೆ ಬೇರೆ ಖಾದ್ಯಗಳನ್ನು ಮಾಡುತ್ತವೆ.",
    "romanization": "ondē padārthagaḷu bēre bēre kaigaḷalli bēre bēre khādyagaḷannu māḍuttāve."
  },
  "97": {
    "text": "ಉಪ್ಪು ಮೊದಲು ಸರಿಪಡಿಸಬೇಕಾದ ವಿಷಯ.",
    "romanization": "uppu modalu saripaḍisabēkāda viṣaya."
  },
  "98": {
    "text": "ಹೆಚ್ಚು ಸೇರಿಸುವ ಮೊದಲು ರುಚಿ ನೋಡಿ.",
    "romanization": "heccu sērisuva modalu ruci nōḍi."
  },
  "99": {
    "text": "ನಿಧಾನವಾಗಿ ಸೇವಿಸಿದ ಸರಳ ಊಟ ಒಂದು ಸಣ್ಣ ವಿಜಯ.",
    "romanization": "nidānavāgi sēvisida saraḷa ūṭa ondu saṇṇa vijaya."
  }
}