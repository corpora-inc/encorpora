{
  "0": {
    "text": "Smulkiai supjaustykite svogūną.",
    "romanization": null
  },
  "1": {
    "text": "Užvirkite vandenį prieš dėdami makaronus.",
    "romanization": null
  },
  "2": {
    "text": "Maišykite padažą, kol jis troškinasi.",
    "romanization": null
  },
  "3": {
    "text": "Pabarstykite vištieną druska ir pipirais.",
    "romanization": null
  },
  "4": {
    "text": "Plakite kiaušinius, kol jie taps purūs.",
    "romanization": null
  },
  "5": {
    "text": "Atsargiai įmaišykite miltus.",
    "romanization": null
  },
  "6": {
    "text": "Leiskite mėsai pailsėti kelias minutes.",
    "romanization": null
  },
  "7": {
    "text": "Kepkite daržoves aukštoje temperatūroje.",
    "romanization": null
  },
  "8": {
    "text": "Pjaustykite duoną įstrižai.",
    "romanization": null
  },
  "9": {
    "text": "Pakepinkite česnaką, bet neprideginkite.",
    "romanization": null
  },
  "10": {
    "text": "Vėl užvirkite sriubą.",
    "romanization": null
  },
  "11": {
    "text": "Troškinkite sultinį valandą.",
    "romanization": null
  },
  "12": {
    "text": "Marinuokite vištieną per naktį.",
    "romanization": null
  },
  "13": {
    "text": "Pirmiausia pakepinkite prieskonius sausoje keptuvėje.",
    "romanization": null
  },
  "14": {
    "text": "Sumažinkite vyno kiekį perpus.",
    "romanization": null
  },
  "15": {
    "text": "Virkite brokolius garuose keturias minutes.",
    "romanization": null
  },
  "16": {
    "text": "Lėtai karamelizuokite svogūnus.",
    "romanization": null
  },
  "17": {
    "text": "Minkykite tešlą, kol ji taps vientisa.",
    "romanization": null
  },
  "18": {
    "text": "Perkoškite sultinį per smulkų sietelį.",
    "romanization": null
  },
  "19": {
    "text": "Užtarkuokite šiek tiek šviežio muskato riešuto.",
    "romanization": null
  },
  "20": {
    "text": "Baigėsi alyvuogių aliejus.",
    "romanization": null
  },
  "21": {
    "text": "Citrina per sausa, kad išspaustumėte sultis.",
    "romanization": null
  },
  "22": {
    "text": "Ar galėtumėte paduoti druską?",
    "romanization": null
  },
  "23": {
    "text": "Šviežias bazilikas labai pakeičia skonį.",
    "romanization": null
  },
  "24": {
    "text": "Česnakus perku galvomis.",
    "romanization": null
  },
  "25": {
    "text": "Rudasis cukrus padaro sausainius minkštesnius.",
    "romanization": null
  },
  "26": {
    "text": "Kiaušiniai vis dar šaldytuve.",
    "romanization": null
  },
  "27": {
    "text": "Koriandras beveik prinokęs darže.",
    "romanization": null
  },
  "28": {
    "text": "Sumuštiniui reikia pomidoro.",
    "romanization": null
  },
  "29": {
    "text": "Sviestas greičiau suminkštėja ant stalo.",
    "romanization": null
  },
  "30": {
    "text": "Jis viskam naudoja jūros druską.",
    "romanization": null
  },
  "31": {
    "text": "Miltų maišas beveik tuščias.",
    "romanization": null
  },
  "32": {
    "text": "Grietinėlė sugedo per savaitgalį.",
    "romanization": null
  },
  "33": {
    "text": "Man labiau patinka graikiškas jogurtas nei grietinė.",
    "romanization": null
  },
  "34": {
    "text": "Grybai susitraukia, kai kepa.",
    "romanization": null
  },
  "35": {
    "text": "Įberkite žiupsnelį raudonųjų pipirų.",
    "romanization": null
  },
  "36": {
    "text": "Receptui reikia dviejų puodelių sultinio.",
    "romanization": null
  },
  "37": {
    "text": "Ji visada laiko ančiuvius sandėliuke.",
    "romanization": null
  },
  "38": {
    "text": "Paprikos tampa saldžios, kai yra keptos.",
    "romanization": null
  },
  "39": {
    "text": "Šaldyti žirneliai – mažas stebuklas.",
    "romanization": null
  },
  "40": {
    "text": "Virtuvėje kvepia duona.",
    "romanization": null
  },
  "41": {
    "text": "Jis išpylė ryžius ant viso stalo.",
    "romanization": null
  },
  "42": {
    "text": "Keptuvė jau per karšta.",
    "romanization": null
  },
  "43": {
    "text": "Vėl prideginau skrebutį.",
    "romanization": null
  },
  "44": {
    "text": "Ji paragavo padažo ir pridėjo daugiau druskos.",
    "romanization": null
  },
  "45": {
    "text": "Dūmų detektorius įsijungė vakarienės metu.",
    "romanization": null
  },
  "46": {
    "text": "Jis tvarkosi darydamas.",
    "romanization": null
  },
  "47": {
    "text": "Puodas išbėgo, kol ji atsiliepė į telefoną.",
    "romanization": null
  },
  "48": {
    "text": "Šaldytuvą reikia nuvalyti.",
    "romanization": null
  },
  "49": {
    "text": "Vaikai padengė stalą neprašyti.",
    "romanization": null
  },
  "50": {
    "text": "Makaronų vanduo burbuliuoja.",
    "romanization": null
  },
  "51": {
    "text": "Ji padėjo rankšluostį po pjaustymo lenta, kad ši neslystų.",
    "romanization": null
  },
  "52": {
    "text": "Jis visada gamina basas.",
    "romanization": null
  },
  "53": {
    "text": "Pyragas sukrito, kai atidariau orkaitę.",
    "romanization": null
  },
  "54": {
    "text": "Pamiršome įkaitinti orkaitę.",
    "romanization": null
  },
  "55": {
    "text": "Šuo stebėjo kiekvieną judesį nuo durų slenksčio.",
    "romanization": null
  },
  "56": {
    "text": "Virtuvės langas atidarytas, kad išeitų garai.",
    "romanization": null
  },
  "57": {
    "text": "Ji pagarsino muziką, kol gamino.",
    "romanization": null
  },
  "58": {
    "text": "Indai susikaupė, kol valgėme.",
    "romanization": null
  },
  "59": {
    "text": "Likučiai bus rytojaus pietūs.",
    "romanization": null
  },
  "60": {
    "text": "Sekiau receptą žingsnis po žingsnio.",
    "romanization": null
  },
  "61": {
    "text": "Pirmas blynas visada prisvilęs.",
    "romanization": null
  },
  "62": {
    "text": "Ji padažą išrado netyčia.",
    "romanization": null
  },
  "63": {
    "text": "Jis išmoko kepti žiemą.",
    "romanization": null
  },
  "64": {
    "text": "Kulinarijos knyga atsivertė tame pačiame puslapyje.",
    "romanization": null
  },
  "65": {
    "text": "Padvigubinau receptą ir pagaminau per daug.",
    "romanization": null
  },
  "66": {
    "text": "Vaizdo įrašas parodė, kaip lankstyti koldūną.",
    "romanization": null
  },
  "67": {
    "text": "Jis viską sveria mažomis svarstyklėmis.",
    "romanization": null
  },
  "68": {
    "text": "Ji gamina labiau pagal kvapą nei pagal laikrodį.",
    "romanization": null
  },
  "69": {
    "text": "Išbandžiau naują prieskonį ir jis tiko.",
    "romanization": null
  },
  "70": {
    "text": "Duona pirmą kartą neiškilo.",
    "romanization": null
  },
  "71": {
    "text": "Ji ragavo gaminimo metu ir koregavo.",
    "romanization": null
  },
  "72": {
    "text": "Šį patiekalą jis išmoko iš savo močiutės.",
    "romanization": null
  },
  "73": {
    "text": "Receptas buvo perduotas ant mažos kortelės.",
    "romanization": null
  },
  "74": {
    "text": "Gaminti vienam – tai kitoks menas.",
    "romanization": null
  },
  "75": {
    "text": "Vakarienė bus paruošta po penkių minučių.",
    "romanization": null
  },
  "76": {
    "text": "Prašau, paduokite man duonos.",
    "romanization": null
  },
  "77": {
    "text": "Virtuvė yra šilčiausias kambarys namuose.",
    "romanization": null
  },
  "78": {
    "text": "Valgėme lauke, kol leidosi saulė.",
    "romanization": null
  },
  "79": {
    "text": "Visi padėjo plauti indus.",
    "romanization": null
  },
  "80": {
    "text": "Ji visada gamina per daug, tyčia.",
    "romanization": null
  },
  "81": {
    "text": "Jis visada atsineša butelį vyno.",
    "romanization": null
  },
  "82": {
    "text": "Vaikai suvalgė tris porcijas.",
    "romanization": null
  },
  "83": {
    "text": "Žvakės sudegė iki galo.",
    "romanization": null
  },
  "84": {
    "text": "Kalbėjomės ilgai po to, kai indai buvo nurinkti.",
    "romanization": null
  },
  "85": {
    "text": "Peilis aštresnis, nei atrodo.",
    "romanization": null
  },
  "86": {
    "text": "Padažui naudokite medinį šaukštą.",
    "romanization": null
  },
  "87": {
    "text": "Ketaus keptuvė sunki, bet verta.",
    "romanization": null
  },
  "88": {
    "text": "Jis laiko prieskonius mažame stalčiuje.",
    "romanization": null
  },
  "89": {
    "text": "Gera pjaustymo lenta viską palengvina.",
    "romanization": null
  },
  "90": {
    "text": "Orkaitė pagaliau pakankamai įkaitusi.",
    "romanization": null
  },
  "91": {
    "text": "Trintuvas sunkiai susidoroja su sveikais migdolais.",
    "romanization": null
  },
  "92": {
    "text": "Ji nuvalė stalviršį drėgna šluoste.",
    "romanization": null
  },
  "93": {
    "text": "Koštuvas yra antrame stalčiuje.",
    "romanization": null
  },
  "94": {
    "text": "Nepamirškite orkaitės pirštinių.",
    "romanization": null
  },
  "95": {
    "text": "Gaminimas – tai daugiausia kantrybė.",
    "romanization": null
  },
  "96": {
    "text": "Tie patys ingredientai skirtingose rankose sukuria skirtingus patiekalus.",
    "romanization": null
  },
  "97": {
    "text": "Druska – pirmas dalykas, kurį pataisote.",
    "romanization": null
  },
  "98": {
    "text": "Paragaukite prieš dėdami daugiau.",
    "romanization": null
  },
  "99": {
    "text": "Paprastas, lėtai valgomas patiekalas – maža pergalė.",
    "romanization": null
  }
}