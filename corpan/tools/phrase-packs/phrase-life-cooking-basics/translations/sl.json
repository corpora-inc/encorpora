{
  "0": {
    "text": "Na drobno sesekljajte čebulo.",
    "romanization": null
  },
  "1": {
    "text": "Zavrite vodo, preden dodate testenine.",
    "romanization": null
  },
  "2": {
    "text": "Mešajte omako, medtem ko počasi vre.",
    "romanization": null
  },
  "3": {
    "text": "Začinite piščanca s soljo in poprom.",
    "romanization": null
  },
  "4": {
    "text": "Jajca stepajte, dokler ne postanejo penasta.",
    "romanization": null
  },
  "5": {
    "text": "Moko nežno vmešajte.",
    "romanization": null
  },
  "6": {
    "text": "Pustite meso počivati nekaj minut.",
    "romanization": null
  },
  "7": {
    "text": "Zelenjavo pecite na visoki temperaturi.",
    "romanization": null
  },
  "8": {
    "text": "Kruh narežite poševno.",
    "romanization": null
  },
  "9": {
    "text": "Česen prepražite, a ga ne zažgite.",
    "romanization": null
  },
  "10": {
    "text": "Juho ponovno zavrite.",
    "romanization": null
  },
  "11": {
    "text": "Jušno osnovo naj počasi vre eno uro.",
    "romanization": null
  },
  "12": {
    "text": "Piščanca marinirajte čez noč.",
    "romanization": null
  },
  "13": {
    "text": "Začimbe najprej popražite v suhi ponvi.",
    "romanization": null
  },
  "14": {
    "text": "Vino reducirajte za polovico.",
    "romanization": null
  },
  "15": {
    "text": "Brokoli kuhajte v pari štiri minute.",
    "romanization": null
  },
  "16": {
    "text": "Čebulo počasi karamelizirajte.",
    "romanization": null
  },
  "17": {
    "text": "Testo gnetite, dokler ne postane gladko.",
    "romanization": null
  },
  "18": {
    "text": "Juho precedite skozi fino cedilo.",
    "romanization": null
  },
  "19": {
    "text": "Naribajte malo svežega muškatnega oreščka na vrh.",
    "romanization": null
  },
  "20": {
    "text": "Zmanjkalo nam je oljčnega olja.",
    "romanization": null
  },
  "21": {
    "text": "Limona je preveč suha, da bi iz nje iztisnili sok.",
    "romanization": null
  },
  "22": {
    "text": "Mi lahko podaš sol?",
    "romanization": null
  },
  "23": {
    "text": "Sveža bazilika resnično spremeni okus.",
    "romanization": null
  },
  "24": {
    "text": "Česen kupujem po glavah.",
    "romanization": null
  },
  "25": {
    "text": "Rjavi sladkor naredi piškote mehkejše.",
    "romanization": null
  },
  "26": {
    "text": "Jajca so še vedno v hladilniku.",
    "romanization": null
  },
  "27": {
    "text": "Koriander na vrtu je skoraj pripravljen.",
    "romanization": null
  },
  "28": {
    "text": "Potrebujemo paradižnik za sendvič.",
    "romanization": null
  },
  "29": {
    "text": "Maslo se hitreje zmehča na pultu.",
    "romanization": null
  },
  "30": {
    "text": "Za vse uporablja morsko sol.",
    "romanization": null
  },
  "31": {
    "text": "Vreča moke je skoraj prazna.",
    "romanization": null
  },
  "32": {
    "text": "Smetana se je pokvarila čez vikend.",
    "romanization": null
  },
  "33": {
    "text": "Grški jogurt imam raje kot kislo smetano.",
    "romanization": null
  },
  "34": {
    "text": "Gobe se skrčijo, ko se kuhajo.",
    "romanization": null
  },
  "35": {
    "text": "Dodajte ščepec rdeče paprike.",
    "romanization": null
  },
  "36": {
    "text": "Recept zahteva dve skodelici jušne osnove.",
    "romanization": null
  },
  "37": {
    "text": "Vedno ima inčune v shrambi.",
    "romanization": null
  },
  "38": {
    "text": "Paprike postanejo sladke, ko so pečene.",
    "romanization": null
  },
  "39": {
    "text": "Zamrznjen grah je majhen čudež.",
    "romanization": null
  },
  "40": {
    "text": "V kuhinji diši po kruhu.",
    "romanization": null
  },
  "41": {
    "text": "Riž je razsul po celem pultu.",
    "romanization": null
  },
  "42": {
    "text": "Ponev je že prevroča.",
    "romanization": null
  },
  "43": {
    "text": "Spet sem zažgal toast.",
    "romanization": null
  },
  "44": {
    "text": "Poskusila je omako in dodala še soli.",
    "romanization": null
  },
  "45": {
    "text": "Dimni alarm se je sprožil med večerjo.",
    "romanization": null
  },
  "46": {
    "text": "Čisti sproti.",
    "romanization": null
  },
  "47": {
    "text": "Lonec je prekipel, medtem ko je odgovarjala na telefon.",
    "romanization": null
  },
  "48": {
    "text": "Hladilnik je treba obrisati.",
    "romanization": null
  },
  "49": {
    "text": "Otroci so pogrnili mizo, ne da bi jih prosili.",
    "romanization": null
  },
  "50": {
    "text": "Voda za testenine vre.",
    "romanization": null
  },
  "51": {
    "text": "Pod desko za rezanje je dala brisačo, da ne bi drsela.",
    "romanization": null
  },
  "52": {
    "text": "Vedno kuha bos.",
    "romanization": null
  },
  "53": {
    "text": "Torta se je sesedla, ko sem odprl pečico.",
    "romanization": null
  },
  "54": {
    "text": "Pozabili smo segreti pečico.",
    "romanization": null
  },
  "55": {
    "text": "Pes je opazoval vsak gib iz vrat.",
    "romanization": null
  },
  "56": {
    "text": "Kuhinjsko okno je odprto, da gre para ven.",
    "romanization": null
  },
  "57": {
    "text": "Med kuhanjem je naglasila glasbo.",
    "romanization": null
  },
  "58": {
    "text": "Posoda se je nabirala, medtem ko smo jedli.",
    "romanization": null
  },
  "59": {
    "text": "Ostanki bodo jutri za kosilo.",
    "romanization": null
  },
  "60": {
    "text": "Sledil sem receptu korak za korakom.",
    "romanization": null
  },
  "61": {
    "text": "Prva palačinka je vedno najslabša.",
    "romanization": null
  },
  "62": {
    "text": "Omako je izumila po naključju.",
    "romanization": null
  },
  "63": {
    "text": "Pozimi se je naučil peči.",
    "romanization": null
  },
  "64": {
    "text": "Kuharska knjiga se je odprla na isti strani.",
    "romanization": null
  },
  "65": {
    "text": "Podvojil sem recept in naredil preveč.",
    "romanization": null
  },
  "66": {
    "text": "Video mi je pokazal, kako zložiti cmok.",
    "romanization": null
  },
  "67": {
    "text": "Vse tehta z majhno tehtnico.",
    "romanization": null
  },
  "68": {
    "text": "Kuha bolj po vonju kot po uri.",
    "romanization": null
  },
  "69": {
    "text": "Poskusil sem novo začimbo in delovalo je.",
    "romanization": null
  },
  "70": {
    "text": "Kruh prvič ni vzhajal.",
    "romanization": null
  },
  "71": {
    "text": "Poskušala je sproti in prilagajala.",
    "romanization": null
  },
  "72": {
    "text": "To jed se je naučil od svoje babice.",
    "romanization": null
  },
  "73": {
    "text": "Recept se je prenašal na majhni kartici.",
    "romanization": null
  },
  "74": {
    "text": "Kuhanje za enega je drugačna umetnost.",
    "romanization": null
  },
  "75": {
    "text": "Večerja bo pripravljena čez pet minut.",
    "romanization": null
  },
  "76": {
    "text": "Prosim, podaj mi kruh.",
    "romanization": null
  },
  "77": {
    "text": "Kuhinja je najtoplejši prostor v hiši.",
    "romanization": null
  },
  "78": {
    "text": "Jedli smo zunaj, medtem ko je sonce zahajalo.",
    "romanization": null
  },
  "79": {
    "text": "Vsi so pomagali pri pomivanju posode.",
    "romanization": null
  },
  "80": {
    "text": "Vedno skuha preveč, namenoma.",
    "romanization": null
  },
  "81": {
    "text": "Vedno prinese steklenico vina.",
    "romanization": null
  },
  "82": {
    "text": "Otroci so pojedli tri porcije.",
    "romanization": null
  },
  "83": {
    "text": "Sveče so dogorele do konca.",
    "romanization": null
  },
  "84": {
    "text": "Pogovarjali smo se dolgo, potem ko so bili krožniki pospravljeni.",
    "romanization": null
  },
  "85": {
    "text": "Nož je ostrejši, kot je videti.",
    "romanization": null
  },
  "86": {
    "text": "Za omako uporabite leseno žlico.",
    "romanization": null
  },
  "87": {
    "text": "Litoželezna ponev je težka, a se splača.",
    "romanization": null
  },
  "88": {
    "text": "Začimbe hrani v majhnem predalu.",
    "romanization": null
  },
  "89": {
    "text": "Dobra deska za rezanje vse olajša.",
    "romanization": null
  },
  "90": {
    "text": "Pečica je končno dovolj vroča.",
    "romanization": null
  },
  "91": {
    "text": "Mešalnik se muči s celimi mandlji.",
    "romanization": null
  },
  "92": {
    "text": "Pult je obrisala z vlažno krpo.",
    "romanization": null
  },
  "93": {
    "text": "Cedilo je v drugem predalu.",
    "romanization": null
  },
  "94": {
    "text": "Ne pozabite na kuhinjske rokavice.",
    "romanization": null
  },
  "95": {
    "text": "Kuhanje je predvsem potrpežljivost.",
    "romanization": null
  },
  "96": {
    "text": "Iste sestavine v različnih rokah ustvarijo različne jedi.",
    "romanization": null
  },
  "97": {
    "text": "Sol je prva stvar, ki jo popraviš.",
    "romanization": null
  },
  "98": {
    "text": "Poskusite, preden dodate še.",
    "romanization": null
  },
  "99": {
    "text": "Preprost obrok, pojeden počasi, je majhna zmaga.",
    "romanization": null
  }
}