{
  "0": {
    "text": "Kata kitunguu laini.",
    "romanization": null
  },
  "1": {
    "text": "Chemsha maji kabla ya kuweka pasta.",
    "romanization": null
  },
  "2": {
    "text": "Koroga mchuzi wakati unachemka taratibu.",
    "romanization": null
  },
  "3": {
    "text": "Weka viungo kwenye kuku, chumvi na pilipili.",
    "romanization": null
  },
  "4": {
    "text": "Piga mayai hadi yatokote povu.",
    "romanization": null
  },
  "5": {
    "text": "Changanya unga kwa upole.",
    "romanization": null
  },
  "6": {
    "text": "Acha nyama ipumzike kwa dakika chache.",
    "romanization": null
  },
  "7": {
    "text": "Choma mboga kwa moto mkali.",
    "romanization": null
  },
  "8": {
    "text": "Kata mkate mshazari.",
    "romanization": null
  },
  "9": {
    "text": "Kaanga kitunguu saumu lakini usikiunguze.",
    "romanization": null
  },
  "10": {
    "text": "Chemsha supu tena.",
    "romanization": null
  },
  "11": {
    "text": "Acha mchuzi uchemke taratibu kwa saa moja.",
    "romanization": null
  },
  "12": {
    "text": "Roweka kuku usiku kucha.",
    "romanization": null
  },
  "13": {
    "text": "Kaanga viungo kwenye kikaango kikavu kwanza.",
    "romanization": null
  },
  "14": {
    "text": "Acha mvinyo uchemke hadi upungue nusu.",
    "romanization": null
  },
  "15": {
    "text": "Pika brokoli kwa mvuke kwa dakika nne.",
    "romanization": null
  },
  "16": {
    "text": "Karamelisha vitunguu polepole.",
    "romanization": null
  },
  "17": {
    "text": "Kanda unga hadi ulainike.",
    "romanization": null
  },
  "18": {
    "text": "Chuja mchuzi kwa ungo laini.",
    "romanization": null
  },
  "19": {
    "text": "Parua kidogo bizari nyembamba mpya juu.",
    "romanization": null
  },
  "20": {
    "text": "Mafuta ya zeituni yameisha.",
    "romanization": null
  },
  "21": {
    "text": "Limao limekauka sana kiasi cha kutotoa juisi.",
    "romanization": null
  },
  "22": {
    "text": "Tafadhali nipatie chumvi.",
    "romanization": null
  },
  "23": {
    "text": "Mchaichai mbichi huleta tofauti kubwa.",
    "romanization": null
  },
  "24": {
    "text": "Ninanunua vitunguu saumu kwa kichwa.",
    "romanization": null
  },
  "25": {
    "text": "Sukari ya kahawia hufanya biskuti kuwa laini zaidi.",
    "romanization": null
  },
  "26": {
    "text": "Mayai bado yapo kwenye friji.",
    "romanization": null
  },
  "27": {
    "text": "Giligilani inakaribia kukomaa bustanini.",
    "romanization": null
  },
  "28": {
    "text": "Tunahitaji nyanya kwa ajili ya sandwichi.",
    "romanization": null
  },
  "29": {
    "text": "Siagi hulainika haraka zaidi mezani.",
    "romanization": null
  },
  "30": {
    "text": "Yeye hutumia chumvi ya bahari kwa kila kitu.",
    "romanization": null
  },
  "31": {
    "text": "Mfuko wa unga unakaribia kuisha.",
    "romanization": null
  },
  "32": {
    "text": "Krimu iliharibika mwishoni mwa wiki.",
    "romanization": null
  },
  "33": {
    "text": "Napendelea mtindi wa Kigiriki kuliko krimu chungu.",
    "romanization": null
  },
  "34": {
    "text": "Uyoga hupungua unapoiva.",
    "romanization": null
  },
  "35": {
    "text": "Ongeza bana ya pilipili nyekundu.",
    "romanization": null
  },
  "36": {
    "text": "Kichocheo kinahitaji vikombe viwili vya mchuzi.",
    "romanization": null
  },
  "37": {
    "text": "Yeye huweka dagaa jikoni kila wakati.",
    "romanization": null
  },
  "38": {
    "text": "Pilipili hoho huwa tamu zinapochomwa.",
    "romanization": null
  },
  "39": {
    "text": "Njugu za kijani zilizogandishwa ni muujiza mdogo.",
    "romanization": null
  },
  "40": {
    "text": "Jikoni inanukia mkate.",
    "romanization": null
  },
  "41": {
    "text": "Alimwaga wali wote juu ya kaunta.",
    "romanization": null
  },
  "42": {
    "text": "Kikaango tayari kina moto sana.",
    "romanization": null
  },
  "43": {
    "text": "Niliunguza tosti tena.",
    "romanization": null
  },
  "44": {
    "text": "Alionja mchuzi na kuongeza chumvi zaidi.",
    "romanization": null
  },
  "45": {
    "text": "King'ora cha moshi kiliwaka wakati wa chakula cha jioni.",
    "romanization": null
  },
  "46": {
    "text": "Yeye husafisha anapoendelea kupika.",
    "romanization": null
  },
  "47": {
    "text": "Sufuria ilifurika alipojibu simu.",
    "romanization": null
  },
  "48": {
    "text": "Friji inahitaji kufutwa.",
    "romanization": null
  },
  "49": {
    "text": "Watoto waliandaa meza bila kuambiwa.",
    "romanization": null
  },
  "50": {
    "text": "Maji ya pasta yanachemka.",
    "romanization": null
  },
  "51": {
    "text": "Aliweka kitambaa chini ya ubao wa kukatia ili usiteleze.",
    "romanization": null
  },
  "52": {
    "text": "Yeye hupika bila viatu kila wakati.",
    "romanization": null
  },
  "53": {
    "text": "Keki ilianguka nilipofungua oveni.",
    "romanization": null
  },
  "54": {
    "text": "Tulisahau kuwasha oveni mapema.",
    "romanization": null
  },
  "55": {
    "text": "Mbwa alitazama kila hatua kutoka mlangoni.",
    "romanization": null
  },
  "56": {
    "text": "Dirisha la jikoni limefunguliwa ili kutoa mvuke.",
    "romanization": null
  },
  "57": {
    "text": "Aliwasha muziki kwa sauti kubwa alipokuwa akipika.",
    "romanization": null
  },
  "58": {
    "text": "Vyombo vilirundikana tulipokuwa tukila.",
    "romanization": null
  },
  "59": {
    "text": "Mabaki yatakuwa chakula cha mchana kesho.",
    "romanization": null
  },
  "60": {
    "text": "Nilifuata kichocheo hatua kwa hatua.",
    "romanization": null
  },
  "61": {
    "text": "Pankeki ya kwanza huwa mbaya zaidi kila wakati.",
    "romanization": null
  },
  "62": {
    "text": "Aligundua mchuzi huo kwa bahati mbaya.",
    "romanization": null
  },
  "63": {
    "text": "Alijifunza kuoka wakati wa baridi.",
    "romanization": null
  },
  "64": {
    "text": "Kitabu cha mapishi kilifunguka kwenye ukurasa uleule.",
    "romanization": null
  },
  "65": {
    "text": "Niliongeza mara mbili kichocheo na kutengeneza kingi sana.",
    "romanization": null
  },
  "66": {
    "text": "Video ilinionyesha jinsi ya kukunja dumpling.",
    "romanization": null
  },
  "67": {
    "text": "Yeye hupima kila kitu kwa mizani ndogo.",
    "romanization": null
  },
  "68": {
    "text": "Yeye hupika kwa kunusa zaidi kuliko kutazama saa.",
    "romanization": null
  },
  "69": {
    "text": "Nilijaribu kiungo kipya na kilifanya kazi.",
    "romanization": null
  },
  "70": {
    "text": "Mkate haukuumuka mara ya kwanza.",
    "romanization": null
  },
  "71": {
    "text": "Alionja alipokuwa akiendelea na kurekebisha.",
    "romanization": null
  },
  "72": {
    "text": "Alijifunza chakula hiki kutoka kwa bibi yake.",
    "romanization": null
  },
  "73": {
    "text": "Kichocheo hicho kiliandikwa kwenye kadi ndogo na kurithishwa.",
    "romanization": null
  },
  "74": {
    "text": "Kupika kwa mtu mmoja ni sanaa tofauti.",
    "romanization": null
  },
  "75": {
    "text": "Chakula cha jioni kitakuwa tayari baada ya dakika tano.",
    "romanization": null
  },
  "76": {
    "text": "Tafadhali nipatie mkate.",
    "romanization": null
  },
  "77": {
    "text": "Jikoni ndiyo chumba chenye joto zaidi nyumbani.",
    "romanization": null
  },
  "78": {
    "text": "Tulikula nje jua likichwa.",
    "romanization": null
  },
  "79": {
    "text": "Kila mtu alisaidia kuosha vyombo.",
    "romanization": null
  },
  "80": {
    "text": "Yeye hupika kingi sana kimakusudi.",
    "romanization": null
  },
  "81": {
    "text": "Yeye huleta chupa ya mvinyo kila wakati.",
    "romanization": null
  },
  "82": {
    "text": "Watoto walikula mara tatu.",
    "romanization": null
  },
  "83": {
    "text": "Mishumaa iliwaka hadi kuisha kabisa.",
    "romanization": null
  },
  "84": {
    "text": "Tulizungumza kwa muda mrefu baada ya vyombo kuondolewa.",
    "romanization": null
  },
  "85": {
    "text": "Kisu ni kikali kuliko kinavyoonekana.",
    "romanization": null
  },
  "86": {
    "text": "Tumia kijiko cha mbao kwa mchuzi.",
    "romanization": null
  },
  "87": {
    "text": "Kikaango cha chuma ni kizito lakini kinafaa.",
    "romanization": null
  },
  "88": {
    "text": "Yeye huweka viungo kwenye droo ndogo.",
    "romanization": null
  },
  "89": {
    "text": "Ubao mzuri wa kukatia hurahisisha kila kitu.",
    "romanization": null
  },
  "90": {
    "text": "Oveni hatimaye ina joto la kutosha.",
    "romanization": null
  },
  "91": {
    "text": "Blenda inahangaika kusaga lozi nzima.",
    "romanization": null
  },
  "92": {
    "text": "Alifuta kaunta kwa kitambaa chenye unyevunyevu.",
    "romanization": null
  },
  "93": {
    "text": "Kichujio kipo kwenye droo ya pili.",
    "romanization": null
  },
  "94": {
    "text": "Usisahau glovu za oveni.",
    "romanization": null
  },
  "95": {
    "text": "Kupika ni uvumilivu zaidi.",
    "romanization": null
  },
  "96": {
    "text": "Viungo vilevile hutengeneza vyakula tofauti mikononi mwa watu tofauti.",
    "romanization": null
  },
  "97": {
    "text": "Chumvi ndio kitu cha kwanza unachorekebisha.",
    "romanization": null
  },
  "98": {
    "text": "Onja kabla ya kuongeza zaidi.",
    "romanization": null
  },
  "99": {
    "text": "Mlo rahisi unaoliwa polepole ni ushindi mdogo.",
    "romanization": null
  }
}