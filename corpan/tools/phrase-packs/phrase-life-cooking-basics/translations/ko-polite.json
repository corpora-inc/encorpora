{
  "0": {
    "text": "양파를 잘게 다져주세요.",
    "romanization": "Yangpareul jalge dajyeojuseyo."
  },
  "1": {
    "text": "파스타를 넣기 전에 물을 끓여주세요.",
    "romanization": "Pastareul neokgi jeone mureul kkeuryeojuseyo."
  },
  "2": {
    "text": "소스가 끓는 동안 저어주세요.",
    "romanization": "Soseuga kkeullneun dong-an jeoeojuseyo."
  },
  "3": {
    "text": "닭고기에 소금과 후추로 간을 해주세요.",
    "romanization": "Dakgogie sogeumgwa huchuro ganeul haejuseyo."
  },
  "4": {
    "text": "달걀이 거품이 날 때까지 휘저어주세요.",
    "romanization": "Dalgyari geopumi nal ttaekkaji hwijeoeojuseyo."
  },
  "5": {
    "text": "밀가루를 살살 섞어주세요.",
    "romanization": "Milgarureul salsal seokkeojuseyo."
  },
  "6": {
    "text": "고기를 몇 분간 그대로 두세요.",
    "romanization": "Gogireul myeot bungan geudaero duseyo."
  },
  "7": {
    "text": "채소를 센 불에 구워주세요.",
    "romanization": "Chaesoreul sen bure guwojuseyo."
  },
  "8": {
    "text": "빵을 어슷하게 썰어주세요.",
    "romanization": "Ppangeul eoseuthage sseoreojuseyo."
  },
  "9": {
    "text": "마늘을 볶되 태우지 마세요.",
    "romanization": "Maneureul bokkdoe taeuji maseyo."
  },
  "10": {
    "text": "수프를 다시 끓여주세요.",
    "romanization": "Supeureul dasi kkeuryeojuseyo."
  },
  "11": {
    "text": "육수를 한 시간 동안 약불에 끓여주세요.",
    "romanization": "Yuksureul han sigan dong-an yakbure kkeuryeojuseyo."
  },
  "12": {
    "text": "닭고기를 하룻밤 재워두세요.",
    "romanization": "Dakgogireul harutbam jaewoduseyo."
  },
  "13": {
    "text": "향신료를 마른 팬에 먼저 볶아주세요.",
    "romanization": "Hyangsinryoreul mareun paene meonjeo bokkajuseyo."
  },
  "14": {
    "text": "와인을 반으로 졸여주세요.",
    "romanization": "Wainil baneuro joryeojuseyo."
  },
  "15": {
    "text": "브로콜리를 4분간 쪄주세요.",
    "romanization": "Beurokollireul sabungan jjeojuseyo."
  },
  "16": {
    "text": "양파를 약한 불에 천천히 캐러멜화해주세요.",
    "romanization": "Yangpareul yakhan bure cheoncheonhi kaerameolhwahaejuseyo."
  },
  "17": {
    "text": "반죽이 부드러워질 때까지 치대주세요.",
    "romanization": "Banjugi budeureowojil ttaekkaji chidaejuseyo."
  },
  "18": {
    "text": "육수를 고운 체에 걸러주세요.",
    "romanization": "Yuksureul goun chee geolleojuseyo."
  },
  "19": {
    "text": "위에 신선한 너트메그를 조금 갈아 넣어주세요.",
    "romanization": "Wie sinseonhan neoteumegeureul jogeum gara neoeojuseyo."
  },
  "20": {
    "text": "올리브 오일이 다 떨어졌어요.",
    "romanization": "Ollibeu oiri da tteoreojyeosseoyo."
  },
  "21": {
    "text": "레몬이 너무 말라서 즙이 안 나와요.",
    "romanization": "Remoni neomu mallaseo jeubi an nawayo."
  },
  "22": {
    "text": "소금 좀 건네주시겠어요?",
    "romanization": "Sogeum jom geonnejusigesseoyo?"
  },
  "23": {
    "text": "신선한 바질이 맛을 확 살려줘요.",
    "romanization": "Sinseonhan bajiri maseul hwak sallyeojwoyo."
  },
  "24": {
    "text": "저는 마늘을 통째로 사요.",
    "romanization": "Jeoneun maneureul tongjjaero sayo."
  },
  "25": {
    "text": "흑설탕을 넣으면 쿠키가 더 부드러워져요.",
    "romanization": "Heukseoltangeul neoeumyeon kukiga deo budeureowojyeoyo."
  },
  "26": {
    "text": "달걀은 아직 냉장고에 있어요.",
    "romanization": "Dalgyareun ajik naengjanggoe isseoyo."
  },
  "27": {
    "text": "텃밭에 있는 고수가 거의 다 자랐어요.",
    "romanization": "Teotbate inneun gosuga geoui da jarasseoyo."
  },
  "28": {
    "text": "샌드위치에 토마토가 필요해요.",
    "romanization": "Saendeuwichie tomatoga piryohaeyo."
  },
  "29": {
    "text": "버터는 상온에 두면 더 빨리 부드러워져요.",
    "romanization": "Beoteoneun sangone dumyeon deo ppalli budeureowojyeoyo."
  },
  "30": {
    "text": "그는 모든 요리에 천일염을 사용해요.",
    "romanization": "Geuneun modeun yorie cheonillyeomeul sayonghaeyo."
  },
  "31": {
    "text": "밀가루 봉지가 거의 비었어요.",
    "romanization": "Milgaru bongjiga geoui bieosseoyo."
  },
  "32": {
    "text": "크림이 주말 동안 상했어요.",
    "romanization": "Keurimi jumal dong-an sanghaesseoyo."
  },
  "33": {
    "text": "저는 사워크림보다 그릭 요거트를 더 좋아해요.",
    "romanization": "Jeoneun saweokeurimboda geurik yeogeoteureul deo joahaeyo."
  },
  "34": {
    "text": "버섯은 익으면 줄어들어요.",
    "romanization": "Beoseoseun igeumyeon jureodeureoyo."
  },
  "35": {
    "text": "고춧가루를 한 꼬집 넣어주세요.",
    "romanization": "Gochutgarureul han kkojip neoeojuseyo."
  },
  "36": {
    "text": "레시피에는 육수 두 컵이 필요하다고 나와 있어요.",
    "romanization": "Resipieneun yuksu du keobi piryohadago nawa isseoyo."
  },
  "37": {
    "text": "그녀는 항상 찬장에 멸치를 보관해요.",
    "romanization": "Geunyeoneun hangsang chanjange myeolchireul bogwanhaeyo."
  },
  "38": {
    "text": "피망은 구우면 단맛이 나요.",
    "romanization": "Pimangeun guumyeon danmasi nayo."
  },
  "39": {
    "text": "냉동 완두콩은 정말 유용해요.",
    "romanization": "Naengdong wandukongeun jeongmal yuyonghaeyo."
  },
  "40": {
    "text": "부엌에서 빵 냄새가 나요.",
    "romanization": "Bueogeseo ppang naemsaega nayo."
  },
  "41": {
    "text": "그가 밥을 조리대 위에 다 쏟았어요.",
    "romanization": "Geuga babeul joridae wie da ssodasseoyo."
  },
  "42": {
    "text": "프라이팬이 벌써 너무 뜨거워요.",
    "romanization": "Peuraipaeni beolsseo neomu tteugeowoyo."
  },
  "43": {
    "text": "토스트를 또 태웠어요.",
    "romanization": "Toseuteureul tto taewosseoyo."
  },
  "44": {
    "text": "그녀는 소스 맛을 보고 소금을 더 넣었어요.",
    "romanization": "Geunyeoneun soseu maseul bogo sogeumeul deo neoeosseoyo."
  },
  "45": {
    "text": "저녁 식사 중에 연기 감지기가 울렸어요.",
    "romanization": "Jeonyeok siksa junge yeongi gamjigiga ullyeosseoyo."
  },
  "46": {
    "text": "그는 요리하면서 바로바로 정리해요.",
    "romanization": "Geuneun yorihamyeonseo barobaro jeongnihaeyo."
  },
  "47": {
    "text": "그녀가 전화를 받는 동안 냄비가 끓어 넘쳤어요.",
    "romanization": "Geunyeoga jeonhwareul batneun dong-an naembiga kkeureo neomchyeosseoyo."
  },
  "48": {
    "text": "냉장고를 닦아야 해요.",
    "romanization": "Naengjanggoreul dakkaya haeyo."
  },
  "49": {
    "text": "아이들이 시키지 않아도 식탁을 차렸어요.",
    "romanization": "Aideuri sikiji anado siktageul charyeosseoyo."
  },
  "50": {
    "text": "파스타 물이 끓고 있어요.",
    "romanization": "Pasta muri kkeulgo isseoyo."
  },
  "51": {
    "text": "그녀는 도마가 미끄러지지 않도록 아래에 수건을 깔았어요.",
    "romanization": "Geunyeoneun domaga mikkeureojiji antorok araee sugeoneul kkarasseoyo."
  },
  "52": {
    "text": "그는 항상 맨발로 요리해요.",
    "romanization": "Geuneun hangsang maenballo yorihaeyo."
  },
  "53": {
    "text": "오븐을 열었더니 케이크가 주저앉았어요.",
    "romanization": "Obeuneul yeoreotdeoni keikeuga jujeoanjasseoyo."
  },
  "54": {
    "text": "오븐 예열하는 것을 잊었어요.",
    "romanization": "Obeun yeyeolhaneun geoseul ijeosseoyo."
  },
  "55": {
    "text": "강아지가 문간에서 모든 움직임을 지켜봤어요.",
    "romanization": "Gangajiga munganeseo modeun umjigimeul jikyeobwasseoyo."
  },
  "56": {
    "text": "김을 빼려고 부엌 창문을 열어두었어요.",
    "romanization": "Gimeul ppaeryeogo bueok changmuneul yeoreodueosseoyo."
  },
  "57": {
    "text": "그녀는 요리하면서 음악 소리를 키웠어요.",
    "romanization": "Geunyeoneun yorihamyeonseo eumak sorireul kiwosseoyo."
  },
  "58": {
    "text": "우리가 식사하는 동안 설거지거리가 쌓였어요.",
    "romanization": "Uriga siksahaneun dong-an seolgeojigeoriga ssayeosseoyo."
  },
  "59": {
    "text": "남은 음식은 내일 점심이 될 거예요.",
    "romanization": "Nameun eumsigeun naeil jeomsimi doel geoyeyo."
  },
  "60": {
    "text": "레시피를 단계별로 따라 했어요.",
    "romanization": "Resipireul dangyebyeollo ttara haesseoyo."
  },
  "61": {
    "text": "첫 번째 팬케이크는 항상 망치기 마련이에요.",
    "romanization": "Cheot beonjjae paenkeikeuneun hangsang mangchigi maryeonieyo."
  },
  "62": {
    "text": "그녀는 우연히 이 소스를 만들었어요.",
    "romanization": "Geunyeoneun uyeonhi i soseureul mandeureosseoyo."
  },
  "63": {
    "text": "그는 겨울 동안 혼자서 베이킹을 배웠어요.",
    "romanization": "Geuneun gyeoul dong-an honjaseo beikingeul baewosseoyo."
  },
  "64": {
    "text": "요리책이 항상 같은 페이지에서 펼쳐졌어요.",
    "romanization": "Yorichaegi hangsang gateun peijieseo pyeolchyeojyeosseoyo."
  },
  "65": {
    "text": "레시피를 두 배로 늘렸더니 너무 많이 만들었어요.",
    "romanization": "Resipireul du baero neullyeotdeoni neomu mani mandeureosseoyo."
  },
  "66": {
    "text": "그 영상에서 만두 접는 법을 배웠어요.",
    "romanization": "Geu yeongsangeseo mandu jeopneun beobeul baewosseoyo."
  },
  "67": {
    "text": "그는 모든 것을 작은 저울로 재요.",
    "romanization": "Geuneun modeun geoseul jageun jeoullo jaeyo."
  },
  "68": {
    "text": "그녀는 시계보다 냄새로 요리하는 편이에요.",
    "romanization": "Geunyeoneun sigyeboda naemsaero yorihaneun pyeonieyo."
  },
  "69": {
    "text": "새로운 향신료를 써봤는데 성공했어요.",
    "romanization": "Saeroun hyangsinryoreul sseobwanneunde seonggonghaesseoyo."
  },
  "70": {
    "text": "빵이 처음에는 부풀지 않았어요.",
    "romanization": "Pangi cheoeumeneun bupulji anasseoyo."
  },
  "71": {
    "text": "그녀는 요리하면서 맛을 보고 조절했어요.",
    "romanization": "Geunyeoneun yorihamyeonseo maseul bogo jojeolhaesseoyo."
  },
  "72": {
    "text": "그는 이 요리를 할머니께 배웠어요.",
    "romanization": "Geuneun i yorireul halmeonikke baewosseoyo."
  },
  "73": {
    "text": "그 레시피는 작은 카드에 적혀 대대로 전해졌어요.",
    "romanization": "Geu resipineun jageun kadeue jeokhyeo daedaero jeonhaejyeosseoyo."
  },
  "74": {
    "text": "혼자 먹을 요리를 하는 것은 또 다른 기술이에요.",
    "romanization": "Honja meogeul yorireul haneun geoseun tto dareun gisurieyo."
  },
  "75": {
    "text": "저녁 식사가 5분 후에 준비될 거예요.",
    "romanization": "Jeonyeok siksaga obun hue junbidoel geoyeyo."
  },
  "76": {
    "text": "빵 좀 건네주세요.",
    "romanization": "Ppang jom geonneojuseyo."
  },
  "77": {
    "text": "부엌이 집에서 가장 따뜻한 방이에요.",
    "romanization": "Bueogi jibeseo gajang ttatteuthan bangieyo."
  },
  "78": {
    "text": "해가 지는 동안 우리는 밖에서 식사했어요.",
    "romanization": "Haega jineun dong-an urineun bakkeso siksahaesseoyo."
  },
  "79": {
    "text": "모두가 설거지를 도왔어요.",
    "romanization": "Moduga seolgeojireul dowasseoyo."
  },
  "80": {
    "text": "그녀는 항상 일부러 음식을 많이 해요.",
    "romanization": "Geunyeoneun hangsang ilbureo eumsigeul mani haeyo."
  },
  "81": {
    "text": "그는 항상 와인 한 병을 가져와요.",
    "romanization": "Geuneun hangsang wain han byeongeul gajyeowayo."
  },
  "82": {
    "text": "아이들이 세 번이나 더 먹었어요.",
    "romanization": "Aideuri se beonina deo meogeosseoyo."
  },
  "83": {
    "text": "양초가 끝까지 다 탔어요.",
    "romanization": "Yangchoga kkeutkkaji da tasseoyo."
  },
  "84": {
    "text": "접시를 치운 후에도 한참 동안 이야기했어요.",
    "romanization": "Jeopsireul chiun huedo hancham dong-an iyagihaesseoyo."
  },
  "85": {
    "text": "칼이 보기보다 날카로워요.",
    "romanization": "Kari bogiboda nalkarowoyo."
  },
  "86": {
    "text": "소스에는 나무 숟가락을 사용하세요.",
    "romanization": "Soseueneun namu sutgarageul sayonghaseyo."
  },
  "87": {
    "text": "무쇠 팬은 무겁지만 그만한 가치가 있어요.",
    "romanization": "Musoe paeneun mugeopjiman geumanhan gachiga isseoyo."
  },
  "88": {
    "text": "그는 향신료를 작은 서랍에 보관해요.",
    "romanization": "Geuneun hyangsinryoreul jageun seorabe bogwanhaeyo."
  },
  "89": {
    "text": "좋은 도마가 있으면 모든 것이 더 쉬워져요.",
    "romanization": "Joeun domaga isseumyeon modeun geosi deo swiwojyeoyo."
  },
  "90": {
    "text": "오븐이 드디어 충분히 뜨거워졌어요.",
    "romanization": "Obeuni deudieo chungbunhi tteugeowojyeosseoyo."
  },
  "91": {
    "text": "블렌더가 통 아몬드를 갈 때 힘들어해요.",
    "romanization": "Beullendeoga tong amondeureul gal ttae himdeureohaeyo."
  },
  "92": {
    "text": "그녀는 젖은 천으로 조리대를 닦았어요.",
    "romanization": "Geunyeoneun jeojeun cheoneuro joridaereul dakkasseoyo."
  },
  "93": {
    "text": "체는 두 번째 서랍에 있어요.",
    "romanization": "Cheneun du beonjjae seorabe isseoyo."
  },
  "94": {
    "text": "오븐 장갑 잊지 마세요.",
    "romanization": "Obeun janggap itji maseyo."
  },
  "95": {
    "text": "요리는 대부분 인내심이에요.",
    "romanization": "Yorineun daebubun innaesimieyo."
  },
  "96": {
    "text": "같은 재료라도 만드는 사람에 따라 다른 요리가 돼요.",
    "romanization": "Gateun jaeryorado mandeuneun sarame ttara dareun yoriga dwaeyo."
  },
  "97": {
    "text": "간은 가장 먼저 맞춰야 할 부분이에요.",
    "romanization": "Ganeun gajang meonjeo matchwoya hal bubunieyo."
  },
  "98": {
    "text": "더 넣기 전에 맛을 보세요.",
    "romanization": "Deo neokgi jeone maseul boseyo."
  },
  "99": {
    "text": "천천히 먹는 소박한 식사는 작은 행복이에요.",
    "romanization": "Cheoncheonhi meongneun sobakhan siksaneun jageun haengbogieyo."
  }
}