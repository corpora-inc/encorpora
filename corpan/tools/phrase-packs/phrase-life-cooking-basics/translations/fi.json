{
  "0": {
    "text": "Pilko sipuli hienoksi.",
    "romanization": null
  },
  "1": {
    "text": "Keitä vesi ennen kuin lisäät pastan.",
    "romanization": null
  },
  "2": {
    "text": "Sekoita kastiketta sen poristessa.",
    "romanization": null
  },
  "3": {
    "text": "Mausta kana suolalla ja pippurilla.",
    "romanization": null
  },
  "4": {
    "text": "Vatkaa munat vaahdoksi.",
    "romanization": null
  },
  "5": {
    "text": "Kääntele jauhot varovasti joukkoon.",
    "romanization": null
  },
  "6": {
    "text": "Anna lihan levätä muutama minuutti.",
    "romanization": null
  },
  "7": {
    "text": "Paahda kasvikset korkeassa lämpötilassa.",
    "romanization": null
  },
  "8": {
    "text": "Leikkaa leipä vinottain.",
    "romanization": null
  },
  "9": {
    "text": "Kuullota valkosipuli, mutta älä polta sitä.",
    "romanization": null
  },
  "10": {
    "text": "Kiehauta keitto uudelleen.",
    "romanization": null
  },
  "11": {
    "text": "Anna liemen porista tunnin ajan.",
    "romanization": null
  },
  "12": {
    "text": "Marinoi kana yön yli.",
    "romanization": null
  },
  "13": {
    "text": "Paahda mausteet ensin kuivalla pannulla.",
    "romanization": null
  },
  "14": {
    "text": "Keitä viiniä kasaan puoleen.",
    "romanization": null
  },
  "15": {
    "text": "Höyrytä parsakaalia neljä minuuttia.",
    "romanization": null
  },
  "16": {
    "text": "Karamellisoi sipulit hitaasti.",
    "romanization": null
  },
  "17": {
    "text": "Vaivaa taikina tasaiseksi.",
    "romanization": null
  },
  "18": {
    "text": "Siivilöi liemi hienon siivilän läpi.",
    "romanization": null
  },
  "19": {
    "text": "Raasta päälle hieman tuoretta muskottipähkinää.",
    "romanization": null
  },
  "20": {
    "text": "Meiltä loppui oliiviöljy.",
    "romanization": null
  },
  "21": {
    "text": "Sitruuna on liian kuiva puristettavaksi.",
    "romanization": null
  },
  "22": {
    "text": "Voisitko ojentaa suolan?",
    "romanization": null
  },
  "23": {
    "text": "Tuore basilika tekee suuren eron.",
    "romanization": null
  },
  "24": {
    "text": "Ostan valkosipulia kokonaisina päinä.",
    "romanization": null
  },
  "25": {
    "text": "Fariinisokeri tekee kekseistä pehmeämpiä.",
    "romanization": null
  },
  "26": {
    "text": "Munat ovat yhä jääkaapissa.",
    "romanization": null
  },
  "27": {
    "text": "Korianteri on melkein valmis puutarhassa.",
    "romanization": null
  },
  "28": {
    "text": "Tarvitsemme tomaatin voileipään.",
    "romanization": null
  },
  "29": {
    "text": "Voi pehmenee nopeammin pöydällä.",
    "romanization": null
  },
  "30": {
    "text": "Hän käyttää merisuolaa kaikkeen.",
    "romanization": null
  },
  "31": {
    "text": "Jauhopussi on melkein tyhjä.",
    "romanization": null
  },
  "32": {
    "text": "Kerma meni pilalle viikonlopun aikana.",
    "romanization": null
  },
  "33": {
    "text": "Pidän kreikkalaisesta jogurtista enemmän kuin smetanasta.",
    "romanization": null
  },
  "34": {
    "text": "Sienet kutistuvat kypsyessään.",
    "romanization": null
  },
  "35": {
    "text": "Lisää ripaus punaista paprikaa.",
    "romanization": null
  },
  "36": {
    "text": "Resepti vaatii kaksi kuppia lientä.",
    "romanization": null
  },
  "37": {
    "text": "Hänellä on aina anjovista ruokakomerossa.",
    "romanization": null
  },
  "38": {
    "text": "Paprikat muuttuvat makeiksi paahdettaessa.",
    "romanization": null
  },
  "39": {
    "text": "Pakasteherneet ovat pieni ihme.",
    "romanization": null
  },
  "40": {
    "text": "Keittiössä tuoksuu leivältä.",
    "romanization": null
  },
  "41": {
    "text": "Hän läikytti riisit pitkin työtasoa.",
    "romanization": null
  },
  "42": {
    "text": "Pannu on jo liian kuuma.",
    "romanization": null
  },
  "43": {
    "text": "Poltin paahtoleivän taas.",
    "romanization": null
  },
  "44": {
    "text": "Hän maistoi kastiketta ja lisäsi suolaa.",
    "romanization": null
  },
  "45": {
    "text": "Palovaroitin laukesi illallisen aikana.",
    "romanization": null
  },
  "46": {
    "text": "Hän siivoaa samalla kun tekee ruokaa.",
    "romanization": null
  },
  "47": {
    "text": "Kattila kiehui yli hänen vastatessaan puhelimeen.",
    "romanization": null
  },
  "48": {
    "text": "Jääkaappi pitää pyyhkiä.",
    "romanization": null
  },
  "49": {
    "text": "Lapset kattoivat pöydän pyytämättä.",
    "romanization": null
  },
  "50": {
    "text": "Pastavesi kuplii.",
    "romanization": null
  },
  "51": {
    "text": "Hän laittoi pyyhkeen leikkuulaudan alle, jotta se ei liukuisi.",
    "romanization": null
  },
  "52": {
    "text": "Hän kokkaa aina paljain jaloin.",
    "romanization": null
  },
  "53": {
    "text": "Kakku lässähti, kun avasin uunin.",
    "romanization": null
  },
  "54": {
    "text": "Unohdimme esilämmittää uunin.",
    "romanization": null
  },
  "55": {
    "text": "Koira seurasi jokaista liikettä oviaukosta.",
    "romanization": null
  },
  "56": {
    "text": "Keittiön ikkuna on auki, jotta höyry pääsee ulos.",
    "romanization": null
  },
  "57": {
    "text": "Hän laittoi musiikin kovemmalle kokkaillessaan.",
    "romanization": null
  },
  "58": {
    "text": "Astiat kasautuivat syödessämme.",
    "romanization": null
  },
  "59": {
    "text": "Tähteistä tulee huominen lounas.",
    "romanization": null
  },
  "60": {
    "text": "Seurasin reseptiä askel askeleelta.",
    "romanization": null
  },
  "61": {
    "text": "Ensimmäinen lettu on aina huonoin.",
    "romanization": null
  },
  "62": {
    "text": "Hän keksi kastikkeen vahingossa.",
    "romanization": null
  },
  "63": {
    "text": "Hän opetti itsensä leipomaan talven aikana.",
    "romanization": null
  },
  "64": {
    "text": "Keittokirja aukesi itsestään samalle sivulle.",
    "romanization": null
  },
  "65": {
    "text": "Tuplasin reseptin ja tein liikaa.",
    "romanization": null
  },
  "66": {
    "text": "Video näytti minulle, miten nyytti taitellaan.",
    "romanization": null
  },
  "67": {
    "text": "Hän mittaa kaiken pienellä vaa'alla.",
    "romanization": null
  },
  "68": {
    "text": "Hän kokkaa enemmän tuoksun kuin kellon mukaan.",
    "romanization": null
  },
  "69": {
    "text": "Kokeilin uutta maustetta ja se toimi.",
    "romanization": null
  },
  "70": {
    "text": "Leipä ei kohonnut ensimmäisellä kerralla.",
    "romanization": null
  },
  "71": {
    "text": "Hän maisteli ja sääti makua työn edetessä.",
    "romanization": null
  },
  "72": {
    "text": "Hän oppi tämän ruoan isoäidiltään.",
    "romanization": null
  },
  "73": {
    "text": "Resepti periytyi pienellä kortilla.",
    "romanization": null
  },
  "74": {
    "text": "Yhdelle kokkaaminen on oma taiteenlajinsa.",
    "romanization": null
  },
  "75": {
    "text": "Illallinen on valmis viidessä minuutissa.",
    "romanization": null
  },
  "76": {
    "text": "Ole hyvä ja ojenna leipä.",
    "romanization": null
  },
  "77": {
    "text": "Keittiö on talon lämpimin huone.",
    "romanization": null
  },
  "78": {
    "text": "Söimme ulkona auringon laskiessa.",
    "romanization": null
  },
  "79": {
    "text": "Kaikki auttoivat tiskauksessa.",
    "romanization": null
  },
  "80": {
    "text": "Hän kokkaa aina liikaa, tarkoituksella.",
    "romanization": null
  },
  "81": {
    "text": "Hän tuo aina pullon viiniä.",
    "romanization": null
  },
  "82": {
    "text": "Lapset söivät kolme annosta.",
    "romanization": null
  },
  "83": {
    "text": "Kynttilät paloivat loppuun asti.",
    "romanization": null
  },
  "84": {
    "text": "Juttelimme pitkään sen jälkeen, kun astiat oli korjattu pois.",
    "romanization": null
  },
  "85": {
    "text": "Veitsi on terävämpi kuin miltä se näyttää.",
    "romanization": null
  },
  "86": {
    "text": "Käytä puukauhaa kastikkeeseen.",
    "romanization": null
  },
  "87": {
    "text": "Valurautapannu on painava, mutta sen arvoinen.",
    "romanization": null
  },
  "88": {
    "text": "Hän säilyttää mausteet pienessä laatikossa.",
    "romanization": null
  },
  "89": {
    "text": "Hyvä leikkuulauta tekee kaikesta helpompaa.",
    "romanization": null
  },
  "90": {
    "text": "Uuni on vihdoin tarpeeksi kuuma.",
    "romanization": null
  },
  "91": {
    "text": "Tehosekoitin kamppailee kokonaisten manteleiden kanssa.",
    "romanization": null
  },
  "92": {
    "text": "Hän pyyhki työtason kostealla liinalla.",
    "romanization": null
  },
  "93": {
    "text": "Siivilä on toisessa laatikossa.",
    "romanization": null
  },
  "94": {
    "text": "Älä unohda uunikintaita.",
    "romanization": null
  },
  "95": {
    "text": "Ruoanlaitto on enimmäkseen kärsivällisyyttä.",
    "romanization": null
  },
  "96": {
    "text": "Samat ainekset muuttuvat eri ruoiksi eri käsissä.",
    "romanization": null
  },
  "97": {
    "text": "Suola on ensimmäinen asia, jonka korjaat.",
    "romanization": null
  },
  "98": {
    "text": "Maista ennen kuin lisäät.",
    "romanization": null
  },
  "99": {
    "text": "Yksinkertainen, hitaasti syöty ateria on pieni voitto.",
    "romanization": null
  }
}