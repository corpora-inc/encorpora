{
  "0": {
    "text": "Aprítsd fel a hagymát.",
    "romanization": null
  },
  "1": {
    "text": "Forrald fel a vizet, mielőtt hozzáadod a tésztát.",
    "romanization": null
  },
  "2": {
    "text": "Kevergesd a szószt, amíg gyöngyözik.",
    "romanization": null
  },
  "3": {
    "text": "Fűszerezd a csirkét sóval és borssal.",
    "romanization": null
  },
  "4": {
    "text": "Verd fel a tojásokat habosra.",
    "romanization": null
  },
  "5": {
    "text": "Óvatosan forgasd bele a lisztet.",
    "romanization": null
  },
  "6": {
    "text": "Hagyd pihenni a húst néhány percig.",
    "romanization": null
  },
  "7": {
    "text": "Süsd meg a zöldségeket magas hőfokon.",
    "romanization": null
  },
  "8": {
    "text": "Szeleteld fel a kenyeret ferdén.",
    "romanization": null
  },
  "9": {
    "text": "Pirítsd meg a fokhagymát, de ne égesd meg.",
    "romanization": null
  },
  "10": {
    "text": "Forrald fel újra a levest.",
    "romanization": null
  },
  "11": {
    "text": "Gyöngyöztesd a húslevest egy órán át.",
    "romanization": null
  },
  "12": {
    "text": "Párold be a csirkét egy éjszakára.",
    "romanization": null
  },
  "13": {
    "text": "Először pirítsd meg a fűszereket egy száraz serpenyőben.",
    "romanization": null
  },
  "14": {
    "text": "Forrald be a bort a felére.",
    "romanization": null
  },
  "15": {
    "text": "Párold a brokkolit négy percig.",
    "romanization": null
  },
  "16": {
    "text": "Karamelizáld lassan a hagymát.",
    "romanization": null
  },
  "17": {
    "text": "Gyúrd a tésztát simára.",
    "romanization": null
  },
  "18": {
    "text": "Szűrd át a húslevest egy sűrű szitán.",
    "romanization": null
  },
  "19": {
    "text": "Reszelj rá egy kis friss szerecsendiót.",
    "romanization": null
  },
  "20": {
    "text": "Elfogyott az olívaolajunk.",
    "romanization": null
  },
  "21": {
    "text": "Túl száraz a citrom, nem lehet kifacsarni.",
    "romanization": null
  },
  "22": {
    "text": "Ide tudnád adni a sót?",
    "romanization": null
  },
  "23": {
    "text": "A friss bazsalikom sokat dob az ízén.",
    "romanization": null
  },
  "24": {
    "text": "Fejjel veszem a fokhagymát.",
    "romanization": null
  },
  "25": {
    "text": "A barna cukortól puhábbak lesznek a sütik.",
    "romanization": null
  },
  "26": {
    "text": "A tojások még a hűtőben vannak.",
    "romanization": null
  },
  "27": {
    "text": "A koriander már majdnem kész a kertben.",
    "romanization": null
  },
  "28": {
    "text": "Kell egy paradicsom a szendvicsbe.",
    "romanization": null
  },
  "29": {
    "text": "A vaj gyorsabban megpuhul a pulton.",
    "romanization": null
  },
  "30": {
    "text": "Mindenhez tengeri sót használ.",
    "romanization": null
  },
  "31": {
    "text": "Majdnem üres a lisztes zacskó.",
    "romanization": null
  },
  "32": {
    "text": "Megromlott a tejszín a hétvégén.",
    "romanization": null
  },
  "33": {
    "text": "Jobban szeretem a görög joghurtot, mint a tejfölt.",
    "romanization": null
  },
  "34": {
    "text": "A gomba összeesik főzés közben.",
    "romanization": null
  },
  "35": {
    "text": "Tegyél hozzá egy csipet pirospaprikát.",
    "romanization": null
  },
  "36": {
    "text": "A recept két csésze húslevest ír elő.",
    "romanization": null
  },
  "37": {
    "text": "Mindig tart szardellát a kamrában.",
    "romanization": null
  },
  "38": {
    "text": "A paprika édes lesz, ha megsütik.",
    "romanization": null
  },
  "39": {
    "text": "A fagyasztott borsó egy kis csoda.",
    "romanization": null
  },
  "40": {
    "text": "Kenyér illata van a konyhában.",
    "romanization": null
  },
  "41": {
    "text": "Szétöntötte a rizst az egész pulton.",
    "romanization": null
  },
  "42": {
    "text": "Már túl forró a serpenyő.",
    "romanization": null
  },
  "43": {
    "text": "Megint megégettem a pirítóst.",
    "romanization": null
  },
  "44": {
    "text": "Megkóstolta a szószt, és tett még hozzá sót.",
    "romanization": null
  },
  "45": {
    "text": "Vacsora közben megszólalt a füstjelző.",
    "romanization": null
  },
  "46": {
    "text": "Főzés közben rendet rak maga után.",
    "romanization": null
  },
  "47": {
    "text": "Kifutott az étel, amíg telefonált.",
    "romanization": null
  },
  "48": {
    "text": "Ki kell törölni a hűtőt.",
    "romanization": null
  },
  "49": {
    "text": "A gyerekek megterítettek anélkül, hogy kérték volna őket.",
    "romanization": null
  },
  "50": {
    "text": "Forr a tészta vize.",
    "romanization": null
  },
  "51": {
    "text": "Törölközőt tett a vágódeszka alá, hogy ne csússzon el.",
    "romanization": null
  },
  "52": {
    "text": "Mindig mezítláb főz.",
    "romanization": null
  },
  "53": {
    "text": "Összeesett a sütemény, amikor kinyitottam a sütőt.",
    "romanization": null
  },
  "54": {
    "text": "Elfelejtettük előmelegíteni a sütőt.",
    "romanization": null
  },
  "55": {
    "text": "A kutya az ajtóból figyelte minden mozdulatot.",
    "romanization": null
  },
  "56": {
    "text": "Nyitva van a konyhaablak, hogy kiszellőzzön a gőz.",
    "romanization": null
  },
  "57": {
    "text": "Főzés közben felhangosította a zenét.",
    "romanization": null
  },
  "58": {
    "text": "Evés közben felhalmozódtak a mosatlanok.",
    "romanization": null
  },
  "59": {
    "text": "A maradék lesz a holnapi ebéd.",
    "romanization": null
  },
  "60": {
    "text": "Lépésről lépésre követtem a receptet.",
    "romanization": null
  },
  "61": {
    "text": "Az első palacsinta mindig a legrosszabb.",
    "romanization": null
  },
  "62": {
    "text": "Véletlenül találta fel a szószt.",
    "romanization": null
  },
  "63": {
    "text": "Télen tanult meg sütni.",
    "romanization": null
  },
  "64": {
    "text": "A szakácskönyv ugyanazon az oldalon nyílt ki.",
    "romanization": null
  },
  "65": {
    "text": "Megdupláztam a receptet, és túl sokat csináltam.",
    "romanization": null
  },
  "66": {
    "text": "A videó megmutatta, hogyan kell hajtogatni egy gombócot.",
    "romanization": null
  },
  "67": {
    "text": "Mindent kis mérleggel mér.",
    "romanization": null
  },
  "68": {
    "text": "Inkább szaglás alapján főz, mint óra szerint.",
    "romanization": null
  },
  "69": {
    "text": "Kipróbáltam egy új fűszert, és bevált.",
    "romanization": null
  },
  "70": {
    "text": "Az első alkalommal nem kelt meg a kenyér.",
    "romanization": null
  },
  "71": {
    "text": "Főzés közben kóstolt és igazított az ízén.",
    "romanization": null
  },
  "72": {
    "text": "Ezt az ételt a nagymamájától tanulta.",
    "romanization": null
  },
  "73": {
    "text": "A recept egy kis kártyán öröklődött.",
    "romanization": null
  },
  "74": {
    "text": "Egyedül főzni egy külön művészet.",
    "romanization": null
  },
  "75": {
    "text": "Öt perc múlva kész a vacsora.",
    "romanization": null
  },
  "76": {
    "text": "Kérlek, add ide a kenyeret.",
    "romanization": null
  },
  "77": {
    "text": "A konyha a legmelegebb szoba a házban.",
    "romanization": null
  },
  "78": {
    "text": "Kint ettünk, amíg lement a nap.",
    "romanization": null
  },
  "79": {
    "text": "Mindenki segített a mosogatásban.",
    "romanization": null
  },
  "80": {
    "text": "Mindig túl sokat főz, szándékosan.",
    "romanization": null
  },
  "81": {
    "text": "Mindig hoz egy üveg bort.",
    "romanization": null
  },
  "82": {
    "text": "A gyerekek hármat szedtek.",
    "romanization": null
  },
  "83": {
    "text": "A gyertyák teljesen leégtek.",
    "romanization": null
  },
  "84": {
    "text": "Sokáig beszélgettünk, miután elpakoltuk a tányérokat.",
    "romanization": null
  },
  "85": {
    "text": "A kés élesebb, mint amilyennek látszik.",
    "romanization": null
  },
  "86": {
    "text": "Használd a fakanalat a szószhoz.",
    "romanization": null
  },
  "87": {
    "text": "Az öntöttvas serpenyő nehéz, de megéri.",
    "romanization": null
  },
  "88": {
    "text": "Egy kis fiókban tartja a fűszereket.",
    "romanization": null
  },
  "89": {
    "text": "Egy jó vágódeszka mindent megkönnyít.",
    "romanization": null
  },
  "90": {
    "text": "Végre elég forró a sütő.",
    "romanization": null
  },
  "91": {
    "text": "A turmixgép nehezen boldogul az egész mandulával.",
    "romanization": null
  },
  "92": {
    "text": "Nedves ruhával áttörölte a pultot.",
    "romanization": null
  },
  "93": {
    "text": "A szűrő a második fiókban van.",
    "romanization": null
  },
  "94": {
    "text": "Ne felejtsd el a sütőkesztyűt.",
    "romanization": null
  },
  "95": {
    "text": "A főzés nagyrészt türelem.",
    "romanization": null
  },
  "96": {
    "text": "Ugyanazok az alapanyagok más kezekben más ételeket eredményeznek.",
    "romanization": null
  },
  "97": {
    "text": "A só az első, amit beállítasz.",
    "romanization": null
  },
  "98": {
    "text": "Kóstold meg, mielőtt még hozzáadsz.",
    "romanization": null
  },
  "99": {
    "text": "Egy egyszerű, lassan elfogyasztott étel egy kis győzelem.",
    "romanization": null
  }
}