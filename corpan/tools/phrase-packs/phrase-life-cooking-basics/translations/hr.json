  },
  "66": {
    "text": "Video mi je pokazao kako saviti knedlu.",
    "romanization": null
  },
  "67": {
    "text": "On sve mjeri malom vagom.",
    "romanization": null
  },
  "68": {
    "text": "Ona kuha po mirisu više nego po satu.",
    "romanization": null
  },
  "69": {
