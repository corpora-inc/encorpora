  },
  "53": {
    "text": "Kolač je pao kad sam otvorio pećnicu.",
    "romanization": null
  },
  "54": {
    "text": "Zaboravili smo zagrijati pećnicu.",
    "romanization": null
  },
  "55": {
    "text": "Pas je pratio svaki pokret s vrata.",
    "romanization": null
  },
  "56": {
    "text": "Kuhinjski prozor je otvoren da para izađe.",
    "romanization": null
  },
  "57": {
    "text": "Pojačala je glazbu dok je kuhala.",
    "romanization": null
  },
  "58": {
    "text": "Posuđe se nagomilalo dok smo jeli.",
    "romanization": null
  },
  "59": {
    "text": "Ostaci će biti ručak sutra.",
    "romanization": null
  },
  "60": {
    "text": "Slijedio sam recept korak po korak.",
    "romanization": null
  },
  "61": {
    "text": "Prva palačinka je uvijek najgora.",
    "romanization": null
  },
  "62": {
