  },
  "72": {
    "text": "Ovo jelo je naučio od svoje bake.",
    "romanization": null
  },
  "73": {
    "text": "Recept se prenosio na maloj kartici.",
    "romanization": null
  },
  "74": {
    "text": "Kuhanje za jednu osobu je drugačija umjetnost.",
    "romanization": null
  },
  "75": {
    "text": "Večera je gotova za pet minuta.",
    "romanization": null
  },
  "76": {
