  },
  "42": {
    "text": "Tava je već prevruća.",
    "romanization": null
  },
  "43": {
    "text": "Opet sam zagorio tost.",
    "romanization": null
  },
  "44": {
    "text": "Probala je umak i dodala još soli.",
    "romanization": null
  },
  "45": {
    "text": "Detektor dima se oglasio tijekom večere.",
    "romanization": null
  },
  "46": {
    "text": "On čisti usput.",
    "romanization": null
  },
  "47": {
    "text": "Lonac je prekipio dok je odgovarala na telefon.",
    "romanization": null
  },
  "48": {
    "text": "Hladnjak treba obrisati.",
    "romanization": null
  },
  "49": {
    "text": "Djeca su postavila stol bez da ih se tražilo.",
    "romanization": null
  },
  "50": {
    "text": "Voda za tjesteninu ključa.",
    "romanization": null
  },
  "51": {
    "text": "Stavila je ručnik ispod daske za rezanje da ne klizi.",
    "romanization": null
  },
  "52": {
    "text": "On uvijek kuha bos.",
