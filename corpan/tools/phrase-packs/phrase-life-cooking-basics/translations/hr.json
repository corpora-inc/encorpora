    "romanization": null
  },
  "63": {
    "text": "Sam je naučio peći zimi.",
    "romanization": null
  },
  "64": {
    "text": "Kuharica se otvorila na istoj stranici.",
    "romanization": null
  },
  "65": {
    "text": "Udvostručio sam recept i napravio previše.",
