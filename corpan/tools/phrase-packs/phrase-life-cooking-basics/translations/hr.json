    "romanization": null
  },
  "17": {
    "text": "Mijesite tijesto dok ne postane glatko.",
    "romanization": null
  },
  "18": {
    "text": "Procijedite temeljac kroz fino sito.",
    "romanization": null
  },
  "19": {
    "text": "Naribajte malo svježeg muškatnog oraščića na vrh.",
