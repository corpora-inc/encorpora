  },
  "21": {
    "text": "Limun je presuh za cijeđenje.",
    "romanization": null
  },
  "22": {
    "text": "Možeš li mi dodati sol?",
    "romanization": null
  },
  "23": {
    "text": "Svježi bosiljak čini veliku razliku.",
    "romanization": null
  },
  "24": {
    "text": "Kupujem češnjak u glavicama.",
    "romanization": null
  },
  "25": {
    "text": "Smeđi šećer čini kolačiće mekšima.",
    "romanization": null
  },
  "26": {
    "text": "Jaja su još uvijek u hladnjaku.",
    "romanization": null
  },
  "27": {
    "text": "Korijandar je skoro spreman u vrtu.",
    "romanization": null
  },
  "28": {
    "text": "Treba nam rajčica za sendvič.",
    "romanization": null
  },
  "29": {
    "text": "Maslac brže omekša na pultu.",
    "romanization": null
  },
  "30": {
    "text": "On koristi morsku sol za sve.",
    "romanization": null
  },
  "31": {
    "text": "Vreća brašna je skoro prazna.",
    "romanization": null
  },
  "32": {
    "text": "Vrhnje se pokvarilo preko vikenda.",
    "romanization": null
  },
  "33": {
    "text": "Više volim grčki jogurt nego kiselo vrhnje.",
    "romanization": null
  },
  "34": {
    "text": "Gljive se smanje dok se kuhaju.",
    "romanization": null
  },
  "35": {
    "text": "Dodajte prstohvat crvene paprike.",
    "romanization": null
  },
  "36": {
    "text": "Recept traži dvije šalice temeljca.",
    "romanization": null
  },
  "37": {
    "text": "Ona uvijek drži inćune u smočnici.",
    "romanization": null
  },
  "38": {
