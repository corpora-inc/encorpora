# Phrase-pack build artifacts (generated by tools/phrase-packs/build_phrase_pack.py).
# Rebuildable from inputs + shipped via S3, not git.
tools/phrase-packs/*/build/
tools/phrase-packs/*/*.zip.sha256

# Phrase-pack per-language translations — Tier 2 (derived from English source
# via translation backend, stamped with provenance). Canonical copy lives in
# the published zip's data.sqlite3 on S3; pack_store mirror coming in Move B.
# New phrase packs do NOT add translations/ to git. Packs already committed
# before this rule (the original 12 on moonshot-15-plus) stay tracked as a
# historical baseline — gitignore does not retroactively untrack — and will
# migrate on their next version bump per the data-tier plan
# (~/.claude/plans/phrase-pack-authoring-snug-moon.md Move D).
tools/phrase-packs/phrase-*/translations/
