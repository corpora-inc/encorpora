# Phrase-pack build artifacts (generated by tools/phrase-packs/build_phrase_pack.py).
# Rebuildable from inputs + shipped via S3, not git.
tools/phrase-packs/*/build/
tools/phrase-packs/*/*.zip.sha256

# Phrase-pack per-language translations — Tier 2 (derived from English source
# via translation backend). Canonical copy lives in the published zip's
# data.sqlite3 on S3. Untracked across the board as of v0.1.1 (all 24 packs).
tools/phrase-packs/phrase-*/translations/
tools/phrase-packs/example-botany/translations/

# Pack build outputs (regenerated by `npm run dev:corpan` / `npm run build`).
packs/*/dist/
packs/*/_dist/
packs/*/node_modules/

# Pinned compatibility artifacts are intentionally checked in so future pack
# builds cannot mutate what older Corpán hosts receive.
!packs/tutomaton-0.3.2/dist/
!packs/tutomaton-0.3.2/dist/**

# Tutomaton language corpora — LARGE BUILD OUTPUTS regenerable via
# `packs/tutomaton/scripts/bootstrap-languages.mjs`. (NOT input data — see below.)
# Spanish: 157 MB, fetched from the published CDN module ZIP.
# Mandarin: 130 KB, rebuilt from build_corpus.py.
# Post multi-source migration, corpora live under sources/<id>/data/ — both
# patterns are matched so older trees still ignore cleanly.
packs/tutomaton/languages/*/data/*.sqlite3
packs/tutomaton/languages/*/sources/*/data/*.sqlite3
# core_vocab.json IS hand-curated source input (NOT a build output) — must be
# tracked so clean checkouts can build retrievers that import it. Earlier
# accidentally ignored at both old + new paths; tracked at the new path.
# Publisher build outputs (per-source ZIPs land here when --upload not used)
packs/tutomaton/languages/*/sources/*/_dist/
packs/tutomaton-*/data/*.sqlite3
packs/tutomaton-*/_dist/

# LLM publishing scratch
tools/llm-packs/__pycache__/

# tauri-plugin-corpan-llm scaffold artifacts
plugins/tauri-plugin-corpan-llm/target/
plugins/tauri-plugin-corpan-llm/android/build/
plugins/tauri-plugin-corpan-llm/android/.tauri/
plugins/tauri-plugin-corpan-llm/ios/Package.resolved
plugins/tauri-plugin-corpan-llm/vendor/
