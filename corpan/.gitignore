# Phrase-pack build artifacts (generated by tools/phrase-packs/build_phrase_pack.py).
# Source inputs (pack.json, phrases.json, translations/) are tracked; the
# build/ subdirectory + SHA-256 sidecar are not — they're rebuildable from
# inputs and shipped via S3, not git.
tools/phrase-packs/*/build/
tools/phrase-packs/*/*.zip.sha256
