# Build artifacts — regenerated by `cargo build` / `cargo check` / `swift build`.
# Re-created automatically when we or Tauri's CLI first reach into this
# vendored plugin for compilation.

# Tauri CLI ephemeral cache (Swift Package dependency staging for the
# plugin's iOS Package.swift). Created when cargo build pulls in the
# plugin and its build.rs runs.
.tauri/

# Rust compilation output (if anyone runs cargo commands inside the plugin
# dir directly — we don't today, but safe to exclude).
target/
Cargo.lock.bak

# Swift Package Manager build cache (macos-side Swift plugin). Hit ~100MB
# on a fresh cargo check.
macos/.build/
macos/Package.resolved
ios/.build/
ios/Package.resolved

# Generated Swift bridging code.
macos/Sources/generated/

# JS side (we don't use the npm-published client, but upstream ships one).
node_modules/
dist-js/
.rollup.cache/

# Editor / OS cruft.
.DS_Store
*.swp
