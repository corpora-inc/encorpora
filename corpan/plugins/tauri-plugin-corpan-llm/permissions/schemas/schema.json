{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "corpan-llm permissions",
  "description": "Permissions surface for the on-device LLM runtime plugin.",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "enum": [
        "allow-llm-status",
        "allow-llm-load",
        "allow-llm-chat",
        "allow-llm-stop",
        "allow-llm-unload",
        "allow-llm-query-pack-db",
        "default"
      ]
    }
  }
}
