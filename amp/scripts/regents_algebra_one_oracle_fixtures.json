[{"public":{"templateId":"arithmetic-distant-term","prompt":"The first four terms of an arithmetic sequence are $3.1, 3.6, 4.1, 4.6, \\dots$. What is the 21st term, $a_{21}$?","response":{"kind":"choice","label":"Choose one answer","options":[{"id":"option-a","label":"$12.6$"},{"id":"option-b","label":"$13.6$"},{"id":"option-c","label":"$-6.9$"},{"id":"option-d","label":"$13.1$"}]}},"answer":"option-d"},{"public":{"templateId":"geometric-signed-term","prompt":"A geometric sequence has first term $a_1=-4$, and each term is $3$ times the term before it. What is the term $a_{5}$?","response":{"kind":"choice","label":"Choose one answer","options":[{"id":"option-a","label":"$-324$"},{"id":"option-b","label":"$324$"},{"id":"option-c","label":"$-972$"},{"id":"option-d","label":"$8$"}]}},"answer":"option-a"},{"public":{"templateId":"rate-unit-chain","prompt":"A rate is converted by multiplying $\\frac{30\\ \\text{kilometers}}{1\\ \\text{minute}}\\cdot\\frac{1\\ \\text{minute}}{60\\ \\text{seconds}}\\cdot\\frac{1000\\ \\text{meters}}{1\\ \\text{kilometer}}$. In which unit is the result?","response":{"kind":"choice","label":"Choose the unit","options":[{"id":"option-a","label":"$\\text{meters per minute}$"},{"id":"option-b","label":"$\\text{seconds per meter}$"},{"id":"option-c","label":"$\\text{meters per second}$"},{"id":"option-d","label":"$\\text{kilometers per second}$"}]}},"answer":"option-c"},{"public":{"templateId":"negative-monomial-power","prompt":"Which expression is equivalent to $(-4n^{5})^{5}$?","response":{"kind":"choice","label":"Choose the expression","options":[{"id":"option-a","label":"$-1024n^{25}$"},{"id":"option-b","label":"$1024n^{25}$"},{"id":"option-c","label":"$-1024n^{10}$"},{"id":"option-d","label":"$-4n^{25}$"}]}},"answer":"option-a"},{"public":{"templateId":"combine-unlike-radicals","prompt":"Which expression is equivalent to $4\\sqrt{10} + 3\\sqrt{7} + \\sqrt{250}$?","response":{"kind":"choice","label":"Choose the expression","options":[{"id":"o