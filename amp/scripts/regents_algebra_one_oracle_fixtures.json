a"},{"public":{"templateId":"exponential-decay-table","prompt":"Each choice lists the values of $y$ for $x = 0, 2, 4, 6$, in order. Which choice shows exponential decay?","response":{"kind":"choice","label":"Choose the table","options":[{"id":"option-a","label":"$384,\\ 288,\\ 216,\\ 162$"},{"id":"option-b","label":"$162,\\ 216,\\ 288,\\ 384$"},{"id":"option-c","label":"$384,\\ 308,\\ 232,\\ 156$"},{"id":"option-d","label":"$384,\\ 336,\\ 240,\\ 96$"}]}},"answer":"option-a"},{"public":{"templateId":"exponential-passes-linear","prompt":"Two functions are given by $f(x) = 3(2.5)^x$ and $g(x) = 11x + 4$. What is the least whole number $x$ for which $f(x) > g(x)$?","response":{"kind":"number","label":"Least whole number"}},"answer":"3"},{"public":{"templateId":"two-way-share","prompt":"The table shows the counts for 206 commuters. Of the commuters who take a train, what percent are suburb commuters? Round to the nearest percent.","response":{"kind":"choice","label":"Choose the percent","options":[{"id":"option-a","label":"$19\\%$"},{"id":"option-b","label":"$60\\%$"},{"id":"option-c","label":"$47\\%$"},{"id":"option-d","label":"$40\\%$"}]},"figure":{"kind":"scene","scene":{"v":1,"elements":[{"id":"t","type":"table","title":"Commuters","columns":["Takes a train","Drives","Total"],"rows":[{"label":"City","cells":[58,65,123]},{"label":"Suburb","cells":[39,44,83]},{"label":"Total","cells":[97,109,206]}],"sums":true}]}}},"answer":"option-d"},{"public":{"templateId":"quartile-list","prompt":"A data set has 8 values: $32,\\ 35,\\ 27,\\ 3,\\ 27,\\ 16,\\ 23,\\ 34$. The upper quartile is the median of the upper half of the ordered data. What is the upper quartile?","response":{"kind":"number","label":"Upper quartile"}},"answer":"33"},{"public":{"templateId":"average-rate-table-rounded","prompt":"The table shows the population of a city. What is the average rate of change in the population from 1990 to 2020, in people per year, to the nearest whole number?","response":{"kind":"number","label":"Average rate (people per year)"},"figure":{"kind":"scene","scene":{"v":1,"elements":[{"id":"t","type":"table","columns":["Population"],"rows":[{"label":"1980","cells":["3,138,019"]},{"label":"1990","cells":["3,258,793"]},{"label":"2000","cells":["3,365,561"]},{"label":"2010","cells":["3,526,405"]},{"label":"2020","cells":["3,773,243"]}],"corner":"Year"}]}}},"answer":"17148"},{"public":{"templateId":"correlation-causation-choice","prompt":"A study measures the number of coats sold each week and the number of swimmers at a public pool. Which statement best describes the relationship?","response":{"kind":"choice","label":"Choose the statement","options":[{"id":"option-a","label":"Negative correlation; neither causes the other"},{"id":"option-b","label":"Negative correlation; one causes the other"},{"id":"option-c","label":"Positive correlation; one causes the other"},{"id":"option-d","label":"Positive correlation; neither causes the other"}]}},"answer":"option-a"},{"public":{"templateId":"budget-whole-items","prompt":"A club has $54.47$ dollars. After paying a booth fee of $16.61$ dollars, the rest is spent on plants that cost $4.06$ dollars each. What is the greatest whole number of plants that can be bought?","response":{"kind":"number","label":"Greatest number of plants"}},"answer":"9"},{"public":{"templateId":"abs-equals-linear-unique","prompt":"Let $f(x) = 2|x - 6| + 2$ and $g(x) = 3x + 4$. For what value of $x$ does $f(x) = g(x)$?","response":{"kind":"number","label":"Answer"}},"answer":"2"},{"public":{"templateId":"parabola-axis-vertex-graph","prompt":"The graph of a parabola is shown. Which choice gives the equation of its axis of symmetry and the coordinates of its vertex?","response":{"kind":"choice","label":"Choose the axis and vertex","options":[{"id":"option-a","label":"$x = -3$ and vertex $(-5, -3)$"},{"id":"option-b","label":"$x = -5$ and vertex $(-5, -3)$"},{"id":"option-c","label":"$x = -3$ and vertex $(-3, -5)$"},{"id":"option-d","label":"$y = -5$ and vertex $(-3, -5)$"}]},"figure":{"kind":"scene","scene":{"v":1,"width":264,"maxHeight":280,"elements":[{"type":"graph","x":[-6,6],"y":[-6,6],"grid":1,"tick":2,"aspect":1,"axisNames":["x","y"],"curves":[{"fn":{"f":"poly","c":[4,6,1]},"color":"accent"}]}]}}},"answer":"option-c"},{"public":{"templateId":"graph-is-function","prompt":"Which graph represents a function?","response":{"kind":"figure-choice","label":"Choose the graph","noun":"Graph","options":[{"id":"option-a","label":"A vertical line through (-1, 0).","scene":{"v":1,"width":264,"maxHeight":280,"elements":[{"type":"graph","x":[-6,6],"y":[-6,6],"grid":1,"tick":2,"aspect":1,"axisNames":["x","y"],"segments":[{"from":[-1,-6],"to":[-1,6],"color":"accent"}]}]}},{"id":"option-b","label":"A parabola opening to the right with its vertex at (-1, 0).","scene":{"v":1,"width":264,"maxHeight":280,"elements":[{"type":"graph","x":[-6,6],"y":[-6,6],"grid":1,"tick":2,"aspect":1,"axisNames":["x","y"],"segments":[{"from":[4,-5],"to":[2.2,-4],"color":"accent"},{"from":[2.2,-4],"to":[0.8,-3],"color":"accent"},{"from":[0.8,-3],"to":[-0.19999999999999996,-2],"color":"accent"},{"from":[-0.19999999999999996,-2],"to":[-0.8,-1],"color":"accent"},{"from":[-0.8,-1],"to":[-1,0],"color":"accent"},{"from":[-1,0],"to":[-0.8,1],"color":"accent"},{"from":[-0.8,1],"to":[-0.19999999999999996,2],"color":"accent"},{"from":[-0.19999999999999996,2],"to":[0.8,3],"color":"accent"},{"from":[0.8,3],"to":[2.2,4],"color":"accent"},{"from":[2.2,4],"to":[4,5],"color":"accent"}]}]}},{"id":"option-c","label":"A graph of two straight rays meeting at (-1, -2) and opening up.","scene":{"v":1,"width":264,"maxHeight":280,"elements":[{"type":"graph","x":[-6,6],"y":[-6,6],"grid":1,"tick":2,"aspect":1,"axisNames":["x","y"],"segments":[{"from":[-1,-2],"to":[3,2],"color":"accent"},{"from":[-1,-2],"to":[-5,2],"color":"accent"}]}]}},{"id":"option-d","label":"A graph of two straight rays meeting at (-3, 0) and opening to the right.","scene":{"v":1,"width":26