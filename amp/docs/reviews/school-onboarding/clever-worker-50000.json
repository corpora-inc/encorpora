          "sql": "WITH candidates AS MATERIALIZED ( SELECT s.id,s.grant_id FROM amp_seats s JOIN amp_people p ON p.id=s.person_id WHERE p.tenant_id=$1 AND ($2::uuid IS NULL OR p.id=$2) AND s.released_at IS NULL ), eligible AS MATERIALIZED ( SELECT s.grant_id,s.person_id,l.class_ids FROM amp_seats s JOIN amp_school_licenses l ON l.id=s.license_id JOIN amp_people p ON p.id=s.person_id JOIN amp_org_roles r ON r.person_id=s.person_id AND r.role='student' JOIN amp_orgs o ON o.id=r.org_id AND o.path @> ARRAY[l.org_id]::uuid[] WHERE (s.grant_id IN(SELECT grant_id FROM candidates)) IS TRUE AND s.released_at IS NULL AND p.deleted_at IS NULL AND l.status='active' AND l.starts_at<=now() AND l.ends_at>now() AND r.begin_on<=(now() AT TIME ZONE o.timezone)::date AND (r.end_on IS NULL OR r.end_on>(now() AT TIME ZONE o.timezone)::date) ), valid AS MATERIALIZED ( SELECT grant_id FROM eligible WHERE class_ids IS NULL UNION ALL SELECT s.grant_id FROM eligible s JOIN amp_enrollments e ON e.person_id=s.person_id AND e.role='student' AND e.class_id=ANY(s.class_ids) JOIN amp_classes c ON c.id=e.class_id AND c.archived_at IS NULL JOIN amp_orgs o ON o.id=c.org_id WHERE s.class_ids IS NOT NULL AND e.begin_on<=(now() AT TIME ZONE o.timezone)::date AND (e.end_on IS NULL OR e.end_on>(now() AT TIME ZONE o.timezone)::date) ), released AS ( UPDATE amp_seats s SET released_at=now() FROM candidates candidate WHERE s.id=candidate.id AND s.released_at IS NULL AND candidate.grant_id LIKE 'school-seat:%' AND candidate.grant_id NOT IN(SELECT grant_id FROM valid) RETURNING s.grant_id) UPDATE amp_grants SET status='revoked' WHERE id IN(SELECT grant_id FROM released)",
