# Non-secret settings. Secrets (database URL, Stripe, consent keys) come from
# Secret Manager into the amp-env Secret at deploy time; see deploy/README.md.
AMP_AUTH_MODE=oidc
# Google load-balancer ranges and this environment's ingress address.
AMP_TRUSTED_PROXIES=35.191.0.0/16,130.211.0.0/22,${AMP_INGRESS_IP}/32
AMP_STRIPE_ENABLED=false
