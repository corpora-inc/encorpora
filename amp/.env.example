# Local development only. Export these values in the API shell.
AMP_DATABASE_URL=postgres://amp:amp@127.0.0.1:55439/amp
# Maximum connections per API or job process; integer >= 2.
# Defaults: 3 for production/accounts/OIDC; 10 for local development.
# Set an explicit hosted budget, e.g. 3, in protected deployment configuration.
AMP_DATABASE_POOL_MAX=10
AMP_AUTH_MODE=development
AMP_HOST=127.0.0.1
AMP_PORT=4311
# AMP accounts: AMP_AUTH_MODE=accounts with the settings below (docs/deployment.md).
# AMP_ACCOUNTS_URL=http://127.0.0.1:4310
# AMP_ACCOUNTS_SECRET=replace-with-at-least-32-random-characters
# AMP_MAIL_RESEND_API_KEY=
# AMP_MAIL_FROM=
# AMP_GOOGLE_CLIENT_ID= / AMP_GOOGLE_CLIENT_SECRET=
# AMP_GITHUB_CLIENT_ID= / AMP_GITHUB_CLIENT_SECRET=
# AMP_MICROSOFT_CLIENT_ID= / AMP_MICROSOFT_CLIENT_SECRET=
# AMP_APPLE_CLIENT_ID= / AMP_APPLE_TEAM_ID= / AMP_APPLE_KEY_ID= / AMP_APPLE_PRIVATE_KEY=
# Production with external OIDC requires AMP_AUTH_MODE=oidc and a configured identity provider.
# AMP_OIDC_ISSUER=https://identity.example.com/
# AMP_OIDC_AUDIENCE=amp
# AMP_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Browser OIDC public client configuration (never a client secret):
# VITE_AMP_AUTHORITY=https://identity.example.com/
# VITE_AMP_CLIENT_ID=amp-web
# VITE_AMP_SCOPES=openid profile amp-api
# VITE_AMP_RESOURCE=https://api.example.com/

# Optional annual and monthly web billing. Disabled unless every required setting is explicit.
AMP_STRIPE_ENABLED=false
AMP_STRIPE_MODE=test
# AMP_STRIPE_SECRET_KEY=       # Secret manager only; never commit a real key.
# AMP_STRIPE_WEBHOOK_SECRET=   # Secret manager only.
# AMP_STRIPE_ACCOUNT_ID=
# AMP_STRIPE_PRODUCT_ID=
# AMP_STRIPE_PRICE_ID=
# AMP_STRIPE_CURRENCY=usd
# AMP_STRIPE_AMOUNT_MINOR=    # Annual catalog subtotal in minor currency units.
# AMP_STRIPE_MONTHLY_PRICE_ID=      # Optional monthly recurring price, same product/currency.
# AMP_STRIPE_MONTHLY_AMOUNT_MINOR=  # Required with monthly price.
# AMP_PAYMENT_MONTHLY_DOCUMENT_PROFILE= # Required matching monthly receipt profile JSON.
# AMP_STRIPE_SKU=
# AMP_STRIPE_APP_ORIGIN=https://your-parent-app.example
# AMP_STRIPE_PORTAL_CONFIGURATION_ID=
# AMP_STRIPE_AUTOMATIC_TAX=true
# AMP_STRIPE_CONSENT_POLICY_VERSION=
# AMP_STRIPE_LIVE_APPROVED=false
# AMP_STRIPE_WORKER_BATCH=20

# Optional trusted private funding-offer JSON; absent means no purchase offers.
# Requires evidence-backed vendor, product and purchasing-route approvals.
# AMP_FUNDING_OFFERS_FILE=/private/config/amp-funding-offers.json

# Optional private consent configuration; route registration never installs policy.
# Consent delivery is disabled by default; configured transport does not approve policy.
# AMP_CONSENT_POLICY_FILE=/private/config/amp-consent-policy.json
# AMP_CONSENT_SECRET_BASE64= # Secret manager only: exactly 32 random bytes, base64.

# Opt-in only after sender verification, tracking disablement and deployment review.
# AMP_CONSENT_DELIVERY=resend
# AMP_CONSENT_SENDER=notice@example.com
# AMP_CONSENT_RESEND_API_KEY= # Secret manager only; do not commit credentials.
# AMP_CONSENT_RESEND_TRACKING_DISABLED=true
# Run the separate bounded consent:deliver job with NODE_ENV=production.

# Optional finite server offline packs; no native offline client is enabled.
# AMP_OFFLINE_PACKS=enabled
# AMP_OFFLINE_PRIVATE_KEY_FILE=/secure/path/private-key.pem
# AMP_OFFLINE_PUBLIC_KEY_FILE=/secure/path/public-key.pem
# AMP_OFFLINE_KEY_ID=<deployment-key-id>
# AMP_OFFLINE_SERVICE_ID=https://example.invalid/amp
# AMP_OFFLINE_ACCOUNT_BINDING_KEY=<base64-32-byte-secret>

# Hosted behind a load balancer: proxy CIDRs whose X-Forwarded-For is trusted.
# AMP_TRUSTED_PROXIES=35.191.0.0/16,130.211.0.0/22,203.0.113.10/32
