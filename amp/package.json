{
  "name": "@corpora/amp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx scripts/test-database-preflight.ts && tsx --test tests/*.integration.ts",
    "test:ui": "tsx scripts/verify-ui.ts && tsx scripts/verify-book-ui.ts && tsx scripts/verify-book-models.ts && tsx scripts/verify-algebra-reader.ts && tsx scripts/verify-early-number-reader.ts && tsx scripts/verify-unit-region-reader.ts && tsx scripts/verify-ratio-reader.ts && npm run test:funding-ui && npm run test:choice-ui && npm run test:consent-ui && npm run test:progress-ui && npm run test:graphical-ui && npm run test:measurement-ui",
    "tsc": "tsc --noEmit",
    "build": "npm run tsc && vite build",
    "audit": "tsx scripts/audit.ts",
    "publications": "tsx scripts/publications.ts",
    "commerce:import": "tsx scripts/commerce-event.ts",
    "production:queue": "tsx scripts/production-queue.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "review:math": "mkdir -p artifacts && tsx scripts/export-math-cases.ts > artifacts/math-review.jsonl && python3 scripts/independent-math-review.py < artifacts/math-review.jsonl",
    "privacy:retention": "tsx scripts/privacy-retention.ts",
    "billing:worker": "tsx scripts/stripe-worker.ts",
    "test:family-ui": "tsx scripts/verify-family-ui.ts && tsx scripts/verify-trial-ui.ts && tsx scripts/verify-session-ui.ts && npm run test:annual-ui && npm run test:purchase-app-ui && tsx scripts/verify-family-focus-ui.ts && tsx scripts/verify-consent-app-ui.ts && npm run test:native-ui && npm run test:payment-ui",
    "test:book-ui": "tsx scripts/verify-book-ui.ts",
    "test:choice-ui": "tsx scripts/verify-choice-ui.ts",
    "test:funding-ui": "tsx scripts/verify-funding-ui.ts",
    "funding:import": "tsx scripts/funding-import.ts",
    "test:annual-ui": "tsx scripts/verify-annual-purchase-ui.ts",
    "test:graphical-ui": "tsx scripts/verify-graphical-ui.ts",
    "test:measurement-ui": "tsx scripts/verify-measurement-ui.ts",
    "test:progress-ui": "tsx scripts/verify-progress-ui.ts",
    "test:consent-ui": "tsx scripts/verify-consent-ui.ts",
    "consent:policy": "tsx scripts/consent-policy.ts",
    "test:purchase-app-ui": "tsx scripts/verify-purchase-app-ui.ts",
    "test:native-ui": "tsx scripts/verify-native-preview.ts",
    "test:native-session": "tsx scripts/verify-native-session.ts",
    "test:payment-ui": "tsx scripts/verify-payment-ui.ts",
    "consent:deliver": "tsx scripts/consent-delivery.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@tauri-apps/api": "^2.12.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.1.0",
    "katex": "^0.16.47",
    "oidc-client-ts": "^3.5.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "6.34.1",
    "stripe": "23.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
