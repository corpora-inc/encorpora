{"id": "fraction-whole-as-parts--se", "title": "Recognizing equivalent fractions", "cast": {"teacher": {}, "learner": {}}, "shots": [{"figure": {"view": [-2.2, 0.2, 8.8, 10.2], "points": {"Sa": [0, 8.4], "Sb": [0, 3], "La": [-1.2, 7.2], "Lb": [-1.2, 1.8], "E1": [4, 6.0], "E2": [4, 0.6]}, "parts": [{"id": "A", "bar": "Sa", "w": 8, "h": 2.4, "divisions": 2, "title": "\\text{one whole strip}", "start": true}, {"id": "B", "bar": "Sb", "w": 8, "h": 2.4, "divisions": 4, "title": "\\text{the same whole strip}", "start": true}, {"id": "la", "label": "\\frac{1}{2}", "at": "La", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "lb", "label": "\\frac{2}{4}", "at": "Lb", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "edge", "seg": ["E1", "E2"], "ink": "warm", "dash": true, "w": 3}]}, "beats": [{"speaker": "teacher", "say": "Here are two strips. Exactly the same size. Each one is one whole.", "do": [{"do": "hide", "target": "B.title", "dur": 0.01}, {"do": "problem", "text": "Two strips are the same size. One half of the first is shaded. Two fourths of the second is shaded. Which shaded part is more?", "choices": ["One half is more", "Two fourths is more", "They are the same amount"], "at": "Exactly"}, {"do": "highlight", "target": ["A.whole", "B.whole"], "at": "Each"}], "pause": 0}, {"speaker": "teacher", "say": "This strip is cut into two equal parts, and one part is shaded. That is one half.", "do": [{"do": "shade", "target": "A", "to": 0.5, "at": "one"}, {"do": "show", "target": "la", "at": "half"}], "pause": 0}, {"speaker": "teacher", "say": "This strip is cut into four equal parts, and two of them are shaded. Two fourths.", "do": [{"do": "shade", "target": "B", "to": 0.5, "at": "two"}, {"do": "show", "target": "lb", "at": "fourths"}], "pause": 0}, {"speaker": "teacher", "say": "Which one is more? One half, or two fourths?", "do": [{"do": "highlight", "target": "A.part", "at": "half", "until": "or"}, {"do": "highlight", "target": "B.part", "at": "fourths"}], "pause": 0.05}, {"speaker": "learner", "say": "Two fourths! Two and four are bigger numbers than one and two.", "do": [{"do": "highlight", "target": "B.part", "at": "Two", "until": "Two", "untilNth": 2}, {"do": "highlight", "target": "lb", "at": "Two", "nth": 2, "until": "than"}], "pause": 0.05}, {"speaker": "teacher", "say": "That is what the numbers seem to say. So let's not ask the numbers. Let's ask the strips.", "do": [{"do": "highlight", "target": "lb", "at": "numbers", "until": "So"}, {"do": "highlight", "target": ["A.part", "B.part"], "at": "strips"}], "pause": 0}, {"speaker": "teacher", "say": "Look where each shaded part ends.", "do": [{"do": "draw", "target": "edge", "at": "ends"}], "pause": 0.05}, {"speaker": "learner", "say": "They stop at the very same place!", "do": [{"do": "highlight", "target": "edge", "at": "same"}], "pause": 0.05}, {"speaker": "teacher", "say": "The very same place. Same amount of strip.", "do": [{"do": "highlight", "target": "edge", "at": "same", "until": "Same", "untilNth": 2}, {"do": "highlight", "target": ["A.part", "B.part"], "at": "Same", "nth": 2}], "pause": 0}, {"speaker": "teacher", "say": "One half and two fourths are two names for one amount. Now let's see why.", "do": [{"do": "highlight", "target": "A.part", "at": "half", "until": "and"}, {"do": "highlight", "target": "B.part", "at": "fourths", "until": "are"}, {"do": "highlight", "target": "edge", "at": "one", "nth": 2, "until": "Now"}], "pause": 0.5}]}, {"figure": {"view": [-1.2, 1.4, 9.2, 10.0], "points": {"C": [0, 5.2], "N1": [1.7, 8.9], "N2": [3.604, 8.9], "N3": [6.188, 8.9]}, "parts": [{"id": "C", "bar": "C", "w": 8, "h": 3.0, "divisions": 2, "title": "\\text{one whole strip}", "start": true}, {"id": "n1", "label": "\\frac{1}{2}", "at": "N1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "n2", "label": "=\\frac{2}{4}", "at": "N2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "n3", "label": "=\\frac{4}{8}", "at": "N3", "dir": "c", "size": "xl", "ink": "warm"}]}, "beats": [{"speaker": "teacher", "say": "Here is one whole strip, cut into two equal parts. One part is shaded: one half.", "do": [{"do": "clear"}, {"do": "shade", "target": "C", "to": 0.5, "at": "shaded"}, {"do": "show", "target": "n1", "at": "half"}, {"do": "write", "tex": "\\frac{1}{2}", "at": "half"}], "pause": 0}, {"speaker": "teacher", "say": "Now cut every part in half. Straight through the middle of each one.", "do": [{"do": "partition", "target": "C", "into": 4, "at": "half"}], "pause": 0}, {"speaker": "teacher", "say": "Count. Four equal parts, and two of them are shaded. Two fourths.", "do": [{"do": "highlight", "target": "C.part", "at": "two"}, {"do": "show", "target": "n2", "at": "fourths"}, {"do": "write", "tex": "\\frac{1}{2}=\\frac{2}{4}", "at": "fourths"}], "pause": 0}, {"speaker": "teacher", "say": "Did the shaded part move? Did it grow?", "do": [{"do": "highlight", "target": "C.part", "at": "move"}], "pause": 0}, {"speaker": "teacher", "say": "No. The very same length. We only cut it into smaller pieces.", "do": [{"do": "highlight", "target": "C.part", "at": "same", "until": "We"}, {"do": "highlight", "target": "C.whole", "at": "pieces"}], "pause": 0.05}, {"speaker": "learner", "say": "It's like cutting a sandwich into more pieces. You still have the same sandwich!", "do": [{"do": "highlight", "target": "C.part", "at": "same"}], "pause": 0.05}, {"speaker": "teacher", "say": "Exactly. Cut every part in half once more.", "do": [{"do": "partition", "target": "C", "into": 8, "at": "half"}], "pause": 0}, {"speaker": "teacher", "say": "Eight equal parts, and four are shaded. Four eighths. Still the same shaded length.", "do": [{"do": "highlight", "target": "C.part", "at": "four"}, {"do": "show", "target": "n3", "at": "eighths"}, {"do": "write", "tex": "\\frac{1}{2}=\\frac{2}{4}=\\frac{4}{8}", "at": "eighths"}], "pause": 0}, {"speaker": "teacher", "say": "One half, two fourths, four eighths. Three names for one shaded length.", "do": [{"do": "highlight", "target": "C.part", "at": "One"}], "pause": 0.4}, {"speaker": "teacher", "say": "Look at the numbers. Every cut doubled the parts in the whole, and doubled the parts we count.", "do": [{"do": "clear"}, {"do": "write", "tex": "\\frac{1}{2}=\\frac{1\\times2}{2\\times2}=\\frac{2}{4}", "at": "Every"}], "pause": 0}, {"speaker": "teacher", "say": "The bottom doubles. The top doubles. So the amount stays put.", "do": [{"do": "write", "tex": "\\frac{2}{4}=\\frac{2\\times2}{4\\times2}=\\frac{4}{8}", "at": "bottom"}, {"do": "highlight", "target": "C.part", "at": "stays"}], "pause": 0.4}]}, {"figure": {"view": [-1.2, -3.5, 9.2, 6.8], "points": {"C": [0, 3.6], "Dp": [4, 1.2], "Z": [4, 0], "Dtop": [4, 1.2], "O": [0, -0.9], "I": [8, -0.8], "R1": [1.3, -2.6], "R2": [4, -2.6], "R3": [6.7, -2.6], "R1t": [1.3, -1.1], "R2t": [4, -1.1], "R3t": [6.7, -1.1]}, "parts": [{"id": "C", "bar": "C", "w": 8, "h": 2.4, "divisions": 8, "title": "\\text{one whole strip}", "start": true}, {"id": "ax", "axes": true, "step": 1, "every": 100, "y": false, "xrange": [0, 8], "size": "l"}, {"id": "one", "label": "1", "at": "I", "dir": "c", "size": "l", "ink": "muted"}, {"id": "drop", "seg": ["Dtop", "Z"], "ink": "gold", "dash": true, "w": 3}, {"id": "dd", "dot": "Dp", "ink": "gold", "r": 14}, {"id": "k1", "seg": ["Z", "R1t"], "ink": "blue", "w": 2}, {"id": "k2", "seg": ["Z", "R2t"], "ink": "violet", "w": 2}, {"id": "k3", "seg": ["Z", "R3t"], "ink": "warm", "w": 2}, {"id": "r1", "label": "\\frac{1}{2}", "at": "R1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "r2", "label": "\\frac{2}{4}", "at": "R2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "r3", "label": "\\frac{4}{8}", "at": "R3", "dir": "c", "size": "xl", "ink": "warm"}]}, "beats": [{"speaker": "teacher", "say": "Now the strip on a number line. Here it is again, shaded one half long.", "do": [{"do": "clear"}, {"do": "shade", "target": "C", "to": 0.5, "at": "Here"}, {"do": "highlight", "target": "C.part", "at": "half"}], "pause": 0}, {"speaker": "teacher", "say": "Underneath, a number line, from zero to one. The strip is exactly as long as the line.", "do": [{"do": "show", "target": "ax", "at": "Underneath"}, {"do": "show", "target": "one", "at": "one"}, {"do": "highlight", "target": "ax", "at": "line", "nth": 2}], "pause": 0}, {"speaker": "teacher", "say": "The end of the shaded part drops straight down onto the line.", "do": [{"do": "draw", "target": "drop", "at": "drops"}, {"do": "show", "target": "dd", "at": "drops"}, {"do": "move", "points": {"Dp": [4, 0]}, "at": "straight"}], "pause": 0}, {"speaker": "teacher", "say": "This point is one half.", "do": [{"do": "draw", "target": "k1", "at": "one"}, {"do": "show", "target": "r1", "at": "one"}, {"do": "highlight", "target": "dd", "at": "point"}], "pause": 0}, {"speaker": "teacher", "say": "Two fourths lands in the very same spot.", "do": [{"do": "draw", "target": "k2", "at": "Two"}, {"do": "show", "target": "r2", "at": "fourths"}, {"do": "highlight", "target": "dd", "at": "same"}], "pause": 0}, {"speaker": "teacher", "say": "And four eighths, the same spot again. One point, three names.", "do": [{"do": "draw", "target": "k3", "at": "four"}, {"do": "show", "target": "r3", "at": "eighths"}, {"do": "highlight", "target": "dd", "at": "One"}], "pause": 0.05}, {"speaker": "learner", "say": "So equivalent means the very same point!", "do": [{"do": "highlight", "target": "dd", "at": "point"}], "pause": 0.05}, {"speaker": "teacher", "say": "Same size of strip. Same point on the line. That is what equivalent means.", "do": [{"do": "highlight", "target": "C.part", "at": "strip", "until": "Same", "untilNth": 2}, {"do": "highlight", "target": "dd", "at": "point"}], "pause": 0}]}, {"figure": {"view": [-1.2, 1.4, 9.2, 10.0], "points": {"D": [0, 5.2], "M1": [1.55, 8.9], "M2": [3.471, 8.9], "M3": [6.066, 8.9]}, "parts": [{"id": "D", "bar": "D", "w": 8, "h": 3.0, "divisions": 3, "title": "\\text{one whole strip}", "start": true}, {"id": "m1", "label": "\\frac{2}{3}", "at": "M1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "m2", "label": "=\\frac{4}{6}", "at": "M2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "m3", "label": "=\\frac{6}{9}", "at": "M3", "dir": "c", "size": "xl", "ink": "warm"}]}, "beats": [{"speaker": "teacher", "say": "Does it work with thirds? Here is a strip cut into three equal parts, and two are shaded. Two thirds.", "do": [{"do": "clear"}, {"do": "shade", "target": "D", "to": 0.6666666667, "at": "two"}, {"do": "show", "target": "m1", "at": "thirds", "nth": 2}, {"do": "write", "tex": "\\frac{2}{3}", "at": "thirds", "nth": 2}], "pause": 0}, {"speaker": "teacher", "say": "Cut every third in half. Six parts now, and four are shaded.", "do": [{"do": "partition", "target": "D", "into": 6, "at": "half"}, {"do": "show", "target": "m2", "at": "four"}], "pause": 0}, {"speaker": "teacher", "say": "Two thirds equals four sixths. Two times two, and three times two.", "do": [{"do": "write", "tex": "\\frac{2}{3}=\\frac{2\\times2}{3\\times2}=\\frac{4}{6}", "at": "Two"}, {"do": "highlight", "target": "D.whole", "at": "equals"}], "pause": 0}, {"speaker": "teacher", "say": "The shaded part has not moved at all.", "do": [{"do": "highlight", "target": "D.whole", "at": "shaded"}], "pause": 0.05}, {"speaker": "learner", "say": "What if we cut every third into three little pieces instead of two?", "do": [{"do": "highlight", "target": "D.whole", "at": "three"}], "pause": 0.05}, {"speaker": "teacher", "say": "Try it. Nine parts, six shaded. Six ninths.", "do": [{"do": "partition", "target": "D", "into": 9, "at": "Nine"}, {"do": "show", "target": "m3", "at": "Six"}, {"do": "write", "tex": "\\frac{2}{3}=\\frac{2\\times3}{3\\times3}=\\frac{6}{9}", "at": "ninths"}], "pause": 0}, {"speaker": "teacher", "say": "Same strip, same shaded length.", "do": [{"do": "highlight", "target": "D.whole", "at": "strip"}], "pause": 0}, {"speaker": "teacher", "say": "Cut every part into as many pieces as you like. If top and bottom grow together, nothing about the amount changes.", "do": [{"do": "clear"}, {"do": "write", "tex": "\\frac{2}{3}=\\frac{4}{6}=\\frac{6}{9}", "at": "top"}], "pause": 0.4}]}, {"figure": {"view": [-2.2, 0.2, 8.8, 10.2], "points": {"Ea": [0, 8.4], "Eb": [0, 3], "Fa": [-1.2, 7.2], "Fb": [-1.2, 1.8], "G1": [4, 6.0], "G2": [4, 0.6]}, "parts": [{"id": "E", "bar": "Ea", "w": 8, "h": 2.4, "divisions": 2, "title": "\\text{one whole strip}", "start": true}, {"id": "F", "bar": "Eb", "w": 8, "h": 2.4, "divisions": 3, "title": "\\text{the same whole strip}", "start": true}, {"id": "fa", "label": "\\frac{1}{2}", "at": "Fa", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "fb", "label": "\\frac{1}{3}", "at": "Fb", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "gap", "seg": ["G1", "G2"], "ink": "warm", "dash": true, "w": 3}]}, "beats": [{"speaker": "teacher", "say": "Is every pair of fractions equivalent? Let's test one half and one third of the same strip.", "do": [{"do": "clear"}, {"do": "hide", "target": "F.title", "dur": 0.01}, {"do": "highlight", "target": ["E.whole", "F.whole"], "at": "same"}], "pause": 0}, {"speaker": "teacher", "say": "One half is shaded on the top strip. One third is shaded on the bottom.", "do": [{"do": "shade", "target": "E", "to": 0.5, "at": "One"}, {"do": "show", "target": "fa", "at": "half"}, {"do": "shade", "target": "F", "to": 0.3333333333, "at": "third"}, {"do": "show", "target": "fb", "at": "third"}], "pause": 0}, {"speaker": "teacher", "say": "Now line up the ends.", "do": [{"do": "draw", "target": "gap", "at": "line"}], "pause": 0.05}, {"speaker": "learner", "say": "They don't match. The one third stops short.", "do": [{"do": "highlight", "target": "F.part", "at": "stops"}], "pause": 0.05}, {"speaker": "teacher", "say": "Right. One half is longer than one third. Different amounts, so not equivalent.", "do": [{"do": "write", "tex": "\\frac{1}{2}\\neq\\frac{1}{3}", "at": "Different"}, {"do": "highlight", "target": "E.part", "at": "half", "until": "than"}, {"do": "highlight", "target": "F.part", "at": "third", "until": "Different"}], "pause": 0.3}, {"speaker": "teacher", "say": "Equivalent fractions have to end in exactly the same place, and they have to be parts of the same whole.", "do": [{"do": "highlight", "target": "gap", "at": "same", "until": "and"}, {"do": "highlight", "target": ["E.whole", "F.whole"], "at": "whole"}], "pause": 0.4}]}, {"figure": {"view": [-1.2, 1.4, 9.2, 10.0], "points": {"G": [0, 5.2], "P1": [1.55, 8.9], "P2": [3.461, 8.9], "P3": [5.855, 8.9]}, "parts": [{"id": "G", "bar": "G", "w": 8, "h": 3.0, "divisions": 3, "title": "\\text{one whole strip}", "start": true}, {"id": "p1", "label": "\\frac{3}{3}", "at": "P1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "p2", "label": "=\\frac{4}{4}", "at": "P2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "p3", "label": "=1", "at": "P3", "dir": "c", "size": "xl", "ink": "warm"}]}, "beats": [{"speaker": "teacher", "say": "Some fractions have a surprise inside. Here is a strip cut into three equal parts. Shade all three parts.", "do": [{"do": "clear"}, {"do": "shade", "target": "G", "to": 1, "at": "Shade"}], "pause": 0}, {"speaker": "teacher", "say": "Three thirds. Every part, so the whole strip. Three thirds is one whole.", "do": [{"do": "show", "target": "p1", "at": "Three"}, {"do": "write", "tex": "\\frac{3}{3}=1", "at": "whole"}, {"do": "highlight", "target": "G.whole", "at": "whole"}], "pause": 0}, {"speaker": "teacher", "say": "Cut it in four instead, and shade all four. Four fourths. Still the whole strip.", "do": [{"do": "partition", "target": "G", "into": 4, "at": "four"}, {"do": "show", "target": "p2", "at": "Four", "nth": 3}, {"do": "highlight", "target": "G.whole", "at": "whole"}], "pause": 0.05}, {"speaker": "learner", "say": "So three thirds and four fourths are both just one!", "do": [{"do": "show", "target": "p3", "at": "both"}, {"do": "highlight", "target": "G.whole", "at": "one"}], "pause": 0.05}, {"speaker": "teacher", "say": "When the top and bottom number match, you have all the parts.", "do": [{"do": "write", "tex": "\\frac{3}{3}=\\frac{4}{4}=1", "at": "match"}], "pause": 0}, {"speaker": "teacher", "say": "That is one whole, and one whole has many names.", "do": [{"do": "highlight", "target": "G.whole", "at": "names"}], "pause": 0}]}, {"figure": {"view": [-0.8, 1.6, 11.2, 12.0], "points": {"W1": [0, 10.8], "W2": [0, 7.2], "W3": [0, 3.6], "T1": [9.0, 10.1], "T2": [9.0, 8.3], "T3": [9.0, 6.5], "T4": [9.0, 8.3], "T5": [9.0, 4.8]}, "parts": [{"id": "W1", "bar": "W1", "w": 6, "h": 1.4, "divisions": 1, "title": "\\text{one whole}", "start": true}, {"id": "W2", "bar": "W2", "w": 6, "h": 1.4, "divisions": 1, "title": "\\text{another whole}"}, {"id": "W3", "bar": "W3", "w": 6, "h": 1.4, "divisions": 1, "title": "\\text{another whole}"}, {"id": "t1", "label": "1=\\frac{1}{1}", "at": "T1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "t2", "label": "2=\\frac{2}{1}", "at": "T2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "t3", "label": "3=\\frac{3}{1}", "at": "T3", "dir": "c", "size": "xl", "ink": "warm"}, {"id": "t5", "label": "3=\\frac{12}{4}", "at": "T3", "dir": "c", "size": "xl", "ink": "warm"}, {"id": "t4", "label": "2=\\frac{6}{3}", "at": "T4", "dir": "c", "size": "xl", "ink": "violet"}]}, "beats": [{"speaker": "teacher", "say": "Now the strangest one. Is a whole number a fraction? Here is one whole strip, cut into just one part.", "do": [{"do": "clear"}, {"do": "text", "text": "Can a whole number be a fraction?", "at": "Is"}, {"do": "highlight", "target": "W1.whole", "at": "one", "nth": 2, "until": "cut"}], "pause": 0}, {"speaker": "teacher", "say": "It is shaded. One part out of one: one over one.", "do": [{"do": "shade", "target": "W1", "to": 1, "at": "shaded"}, {"do": "show", "target": "t1", "at": "one"}, {"do": "write", "tex": "1=\\frac{1}{1}", "at": "over"}], "pause": 0}, {"speaker": "teacher", "say": "Bring in a second whole strip. Each strip is one part, the size of one whole. Two parts: two over one.", "do": [{"do": "show", "target": "W2", "at": "second"}, {"do": "shade", "target": "W2", "to": 1, "at": "Each"}, {"do": "hide", "target": "t1", "at": "Two"}, {"do": "show", "target": "t2", "at": "two"}, {"do": "write", "tex": "2=\\frac{2}{1}", "at": "over"}], "pause": 0.05}, {"speaker": "learner", "say": "Two over one? That looks like nonsense.", "do": [{"do": "highlight", "target": "W2.part", "at": "Two"}], "pause": 0.05}, {"speaker": "teacher", "say": "It says: count the parts, two of them. Each part is a whole one. Two wholes. Nothing strange at all.", "do": [{"do": "highlight", "target": "W1.part", "at": "Each", "until": "whole"}, {"do": "highlight", "target": "W2.part", "at": "whole", "until": "Two", "untilNth": 2}, {"do": "highlight", "target": ["W1.part", "W2.part"], "at": "Two", "nth": 2}], "pause": 0.3}, {"speaker": "teacher", "say": "Add a third whole strip and you have three over one.", "do": [{"do": "show", "target": "W3", "at": "third"}, {"do": "shade", "target": "W3", "to": 1, "at": "third"}, {"do": "hide", "target": "t2", "at": "three"}, {"do": "show", "target": "t3", "at": "three"}, {"do": "write", "tex": "3=\\frac{3}{1}", "at": "three"}], "pause": 0}, {"speaker": "teacher", "say": "Now cut each of the three wholes into four equal parts.", "do": [{"do": "clear"}, {"do": "partition", "target": "W1", "into": 4, "at": "cut"}, {"do": "partition", "target": "W2", "into": 4, "at": "cut"}, {"do": "partition", "target": "W3", "into": 4, "at": "cut"}, {"do": "hide", "target": "t3", "at": "cut"}], "pause": 0}, {"speaker": "teacher", "say": "Four fourths in each whole. Three wholes, four in each: three times four makes twelve fourths in all.", "do": [{"do": "show", "target": "t5", "at": "twelve"}, {"do": "write", "tex": "3=\\frac{3\\times4}{4}=\\frac{12}{4}", "at": "three"}, {"do": "highlight", "target": ["W1.part", "W2.part", "W3.part"], "at": "Four", "until": "Three"}], "pause": 0.05}, {"speaker": "learner", "say": "Same three wholes, just counted in fourths!", "do": [{"do": "highlight", "target": ["W1.part", "W2.part", "W3.part"], "at": "three"}], "pause": 0.05}, {"speaker": "teacher", "say": "Yes. And two wholes cut into thirds make six thirds.", "do": [{"do": "hide", "target": ["W3", "t5"], "at": "two"}, {"do": "partition", "target": "W1", "into": 3, "at": "thirds"}, {"do": "partition", "target": "W2", "into": 3, "at": "thirds"}, {"do": "show", "target": "t4", "at": "six"}, {"do": "write", "tex": "2=\\frac{2\\times3}{3}=\\frac{6}{3}", "at": "six"}], "pause": 0}, {"speaker": "teacher", "say": "Whole numbers have fraction names too. Same amount, different names.", "do": [{"do": "highlight", "target": ["W1.part", "W2.part"], "at": "Same"}], "pause": 0}]}, {"figure": {"view": [-1.2, -4.2, 9.2, 10.0], "points": {"C": [0, 3.6], "N1": [1.65, 7.7], "N2": [4.285, 7.7], "N3": [7.705, 7.7], "Dp": [4, 0], "Z": [4, 0], "Dtop": [4, 1.2], "O": [0, -0.9], "I": [8, -0.8], "R1": [2.0, -3.1], "R2": [4.0, -3.1], "R3": [6.0, -3.1], "R1t": [2.0, -1.2], "R2t": [4.0, -1.2], "R3t": [6.0, -1.2]}, "parts": [{"id": "C", "bar": "C", "w": 8, "h": 2.4, "divisions": 8, "title": "\\text{one whole strip}", "start": true}, {"id": "ax", "axes": true, "step": 1, "every": 100, "y": false, "xrange": [0, 8], "size": "l", "start": true}, {"id": "one", "label": "1", "at": "I", "dir": "c", "size": "l", "start": true, "ink": "muted"}, {"id": "drop", "seg": ["Dtop", "Z"], "ink": "gold", "dash": true, "w": 3, "start": true}, {"id": "dd", "dot": "Dp", "ink": "gold", "r": 14, "start": true}, {"id": "k1", "seg": ["Z", "R1t"], "ink": "blue", "w": 2}, {"id": "k2", "seg": ["Z", "R2t"], "ink": "violet", "w": 2}, {"id": "k3", "seg": ["Z", "R3t"], "ink": "warm", "w": 2}, {"id": "r1", "label": "\\frac{1}{2}", "at": "R1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "r2", "label": "\\frac{2}{4}", "at": "R2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "r3", "label": "\\frac{4}{8}", "at": "R3", "dir": "c", "size": "xl", "ink": "warm"}, {"id": "n1", "label": "\\frac{1}{2}", "at": "N1", "dir": "c", "size": "xl", "ink": "blue"}, {"id": "n2", "label": "=\\frac{2}{4}", "at": "N2", "dir": "c", "size": "xl", "ink": "violet"}, {"id": "n3", "label": "=\\frac{4}{8}", "at": "N3", "dir": "c", "size": "xl", "ink": "warm"}]}, "beats": [{"speaker": "teacher", "say": "So here is what we found. One strip, with a shaded length that never changed.", "do": [{"do": "clear"}, {"do": "shade", "target": "C", "to": 0.5, "at": "strip"}, {"do": "highlight", "target": "C.part", "at": "never"}], "pause": 0}, {"speaker": "teacher", "say": "One half, two fourths, four eighths. Three names for it.", "do": [{"do": "show", "target": "n1", "at": "One"}, {"do": "show", "target": "n2", "at": "two"}, {"do": "show", "target": "n3", "at": "four"}, {"do": "write", "tex": "\\frac{1}{2}=\\frac{2}{4}=\\frac{4}{8}", "at": "Three"}], "pause": 0}, {"speaker": "teacher", "say": "And on the number line, one point wearing all three names.", "do": [{"do": "show", "target": ["k1", "r1"], "at": "one"}, {"do": "show", "target": ["k2", "r2"], "at": "wearing"}, {"do": "show", "target": ["k3", "r3"], "at": "three"}, {"do": "highlight", "target": "dd", "at": "point"}], "pause": 0.05}, {"speaker": "learner", "say": "Different names, but the very same amount!", "do": [{"do": "highlight", "target": "dd", "at": "same"}], "pause": 0.05}, {"speaker": "teacher", "say": "That is it. Equivalent fractions are the same amount with different names.", "do": [{"do": "highlight", "target": ["C.part", "dd"], "at": "same", "until": "with"}, {"do": "highlight", "target": ["r1", "r2", "r3"], "at": "different"}], "pause": 0.6}]}], "skill": "equivalent-fractions"}
