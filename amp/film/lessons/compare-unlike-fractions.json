          { "id": "l34", "label": "\\frac{3}{4}", "at": "LB", "dir": "e", "far": 0.55, "size": "l", "ink": "warm", "start": true },
          { "id": "l68", "label": "\\frac{6}{8}", "at": "LB", "dir": "e", "far": 0.55, "size": "l", "ink": "warm" }
        ]
      },
      "beats": [
        {
          "say": "Which is greater: five eighths or three fourths of the same whole?",
          "pause": 0.35,
          "do": [
            { "do": "problem", "text": "Which is greater: $5/8$ or $3/4$ of the same whole? Enter that fraction.", "at": "Which", "id": "p1" },
            { "do": "highlight", "target": ["sh5", "g8"], "at": "eighths" },
            { "do": "highlight", "target": ["sh6", "g4"], "at": "fourths" },
            { "do": "highlight", "target": ["g8", "g4"], "at": "whole" }
          ]
        },
        {
          "say": "The numerator counts the shaded pieces. The denominator says how many equal pieces make the whole.",
          "do": [
            { "do": "highlight", "target": ["sh5", "sh6"], "at": "shaded" },
            { "do": "highlight", "target": ["g8", "g4"], "at": "equal" }
          ]
        },
        {
          "say": "Five is more than three. The pieces are different sizes, so the top numbers do not decide it.",
          "do": [
            { "do": "write", "tex": "\\cancel{\\ca{5}>\\cw{3}}", "fresh": true, "at": "Five", "id": "bad1" },
            { "do": "highlight", "target": "g8", "at": "different" },
            { "do": "highlight", "target": "g4", "at": "sizes" },
            { "do": "watch", "text": "Compare the top numbers only when the pieces are the same size. $5>3$ does not make $5/8$ greater than $3/4$.", "at": "not" }
          ]
        },
        {
          "say": "Make the pieces the same size.",
          "do": [
            { "do": "text", "text": "Make the pieces the same size.", "at": "Make", "id": "idea" },
            { "do": "highlight", "target": ["g8", "g4"], "at": "pieces" }
          ]
        },
        {
          "say": "Eight is a common denominator. Four and eight both divide eight.",
          "do": [
            { "do": "term", "word": "common denominator", "meaning": "A bottom number both fractions can use, so the pieces are the same size. Here, $8$, because $4$ and $8$ both divide $8$.", "at": "common", "id": "cd" },
            { "do": "highlight", "target": "g4", "at": "Four" },
            { "do": "highlight", "target": "g8", "at": "eight", "nth": 2 }
          ]
        },
        {
          "say": "Five eighths already counts eighths. It stays five eighths.",
          "do": [
            { "do": "highlight", "target": "sh5", "at": "already" },
            { "do": "write", "tex": "\\ca{5/8}=\\ca{5/8}", "fresh": true, "at": "stays", "id": "r58" }
          ]
        },
        {
          "say": "Cut each fourth into two eighths. The shaded length stays the same.",
          "pause": 0.25,
          "do": [
            { "do": "draw", "target": "g8b", "at": "Cut" },
            { "do": "highlight", "target": "sh6", "at": "stays" }
          ]
        },
        {
          "say": "Renaming multiplies the top and the bottom by two. Three fourths equals six eighths.",
          "do": [
            { "do": "hide", "target": "l34", "at": "six" },
            { "do": "show", "target": "l68", "at": "six" },
            { "do": "write", "tex": "\\cw{3/4}=\\cw{6/8}", "note": "\\times 2", "fresh": true, "at": "equals", "id": "r34" }
          ]
        },
        {
          "say": "Now the pieces match. Six eighths is more than five eighths, so the greater fraction is three fourths.",
          "pause": 0.3,
          "do": [
            { "do": "highlight", "target": ["g8", "g8b"], "at": "match" },
            { "do": "draw", "target": "mark", "at": "more" },
            { "do": "write", "tex": "\\cw{6/8}>\\ca{5/8}", "at": "more", "id": "cmp" },
            { "do": "answer", "tex": "\\cw{3/4}", "at": "three", "id": "ans" },
            { "do": "highlight", "target": "sh6", "at": "fourths" }
          ]
        }
      ]
    },
