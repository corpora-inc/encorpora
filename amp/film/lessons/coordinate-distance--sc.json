   "beats": [
    {
     "speaker": "teacher",
     "say": "A straight distance on a grid can be found by making a right triangle.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "A"
      },
      {
       "do": "header",
       "text": "Distance between two points",
       "at": "A"
      },
      {
       "do": "text",
       "text": "Find the straight distance",
       "at": "A"
      },
      {
       "do": "draw",
       "target": "dPulse",
       "at": "straight",
       "dur": 0.55
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Each coordinate pair gives horizontal position first, then vertical position: *A* is one, one; *B* is five, four.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "at": "Each",
       "dur": 0.15
      },
      {
       "do": "clear",
       "at": "Each"
      },
      {
       "do": "write",
       "tex": "(\\cb{x},\\cv{y})",
       "note": "\\text{horizontal, vertical}",
       "at": "Each"
      },
      {
       "do": "highlight",
       "target": "aOne",
       "at": "A"
      },
      {
       "do": "highlight",
       "target": "bOne",
       "at": "B"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Draw a horizontal side and a vertical side down to meet it. The square corner marks a right angle.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "Draw"
      },
      {
       "do": "clear",
       "at": "Draw"
      },
      {
       "do": "text",
       "text": "Make a right triangle",
       "at": "Draw"
      },
      {
       "do": "draw",
       "target": "horizontal",
       "at": "horizontal",
       "dur": 2
      },
      {
       "do": "draw",
       "target": "vertical",
       "at": "vertical",
       "dur": 2
      },
      {
       "do": "show",
       "target": "corner",
       "at": "square"
      },
      {
       "do": "highlight",
       "target": "corner",
       "at": "right"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "The sides meeting there are legs. The opposite side is the hypotenuse. Call its length *d*, the straight distance.",
     "pause": 0.2,
     "do": [
      {
       "do": "clear",
       "at": "The"
      },
      {
       "do": "text",
       "text": "Legs meet at the right angle",
       "at": "The"
      },
      {
       "do": "show",
       "target": "hPulse",
       "at": "sides"
      },
      {
       "do": "hide",
       "target": "hPulse",
       "at": "legs",
       "dur": 0.15
      },
      {
       "do": "show",
       "target": "vPulse",
       "at": "legs"
      },
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse"
       ],
       "at": "opposite"
      },
      {
       "do": "text",
       "text": "Hypotenuse: opposite that angle",
       "at": "hypotenuse"
      },
      {
       "do": "show",
       "target": "dUp",
       "at": "d"
      },
      {
       "do": "draw",
       "target": "dPulse",
       "at": "hypotenuse",
       "dur": 0.7
      },
      {
       "do": "write",
       "tex": "d=\\text{straight distance}",
       "at": "d"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Subtract the horizontal coordinates: five minus one is four.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "Subtract"
      },
      {
       "do": "clear",
       "at": "Subtract"
      },
      {
       "do": "write",
       "tex": "\\cb{5-1=4}",
       "at": "five",
       "note": "\\text{horizontal}"
      },
      {
       "do": "show",
       "target": "legFourUp",
       "at": "four"
      },
      {
       "do": "draw",
       "target": "hPulse",
       "at": "five",
       "dur": 0.55
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Vertically, four minus one is three. These differences measure separation, not distance from the origin.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "Vertically"
      },
      {
       "do": "write",
       "tex": "\\cv{4-1=3}",
       "at": "four",
       "note": "\\text{vertical}",
       "fresh": true
      },
      {
       "do": "show",
       "target": "legThreeUp",
       "at": "three"
      },
      {
       "do": "draw",
       "target": "vPulse",
       "at": "four",
       "dur": 0.55
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "By the Pythagorean theorem, the legs' squares add to the hypotenuse's square.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "By"
      },
      {
       "do": "clear",
       "at": "By"
      },
      {
       "do": "header",
       "tex": "d^2=\\cb{\\text{leg}^2}+\\cv{\\text{leg}^2}",
       "label": "Pythagorean theorem",
       "at": "By"
      },
      {
       "do": "write",
       "tex": "d^2=\\cb{4^2}+\\cv{3^2}",
       "at": "squares"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Squared means multiplied by itself. Four squared plus three squared is twenty-five.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "Squared"
      },
      {
       "do": "write",
       "tex": "d^2=\\cb{4\\times4}+\\cv{3\\times3}",
       "at": "multiplied"
      },
      {
       "do": "write",
       "tex": "d^2=25",
       "at": "twenty-five"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "The length whose square is twenty-five is its square root: five.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "The"
      },
      {
       "do": "clear",
       "at": "The"
      },
      {
       "do": "write",
       "tex": "d^2=25",
       "at": "The"
      },
      {
       "do": "write",
       "tex": "d=\\sqrt{25}=5",
       "at": "root"
      },
      {
       "do": "hide",
       "target": "dUp",
       "at": "five"
      },
      {
       "do": "show",
       "target": "fiveUp",
       "at": "five"
      },
      {
       "do": "draw",
       "target": "dPulse",
       "at": "five",
       "dur": 0.55
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "A common slip is adding four and three, but seven measures the bent path; the straight distance is the hypotenuse, five.",
     "pause": 0.2,
     "do": [
      {
       "do": "hide",
       "target": [
        "hPulse",
        "vPulse",
        "dPulse"
       ],
       "dur": 0.15,
       "at": "A"
      },
      {
       "do": "clear",
       "at": "A"
      },
      {
       "do": "write",
       "tex": "d=\\cb{4}+\\cv{3}=7",
       "at": "adding",
       "id": "slip"
      },
      {
       "do": "strike",
       "target": "slip",
       "at": "but"
      },
      {
       "do": "write",
       "tex": "d=5",
       "at": "straight"
      },
      {
       "do": "show",
       "target": "hPulse",
       "at": "four",
