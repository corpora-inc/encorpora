 "shots": [
  {
   "beats": [
    {
     "speaker": "teacher",
     "say": "A number is rational when it can be written exactly as a fraction, even if its decimal never ends.",
     "pause": 0.2,
     "do": [
      {
       "do": "header",
       "text": "Rational numbers"
      },
      {
       "do": "write",
       "tex": "0.75=\\frac{75}{100}=\\frac34",
       "id": "ending",
       "at": "fraction"
      },
      {
       "do": "show",
       "target": "ending",
       "at": "fraction"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Seventy-five hundredths equals seventy-five over one hundred, or three fourths. It is rational.",
     "pause": 0.2,
     "do": [
      {
       "do": "text",
       "text": "Seventy-five hundredths",
       "at": "Seventy-five"
      },
      {
       "do": "text",
       "text": "An exact fraction name",
       "at": "rational"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Rational means one integer divided by another, with a nonzero bottom number.",
     "pause": 0.2,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "header",
       "tex": "0.75=\\frac34",
       "label": "Rational"
      },
      {
       "do": "write",
       "tex": "\\frac{\\text{integer}}{\\text{integer}}"
      },
      {
       "do": "text",
       "text": "Bottom number ≠ 0",
       "at": "nonzero"
      },
      {
       "do": "highlight",
       "target": "endingDot",
       "at": "Rational"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Integers are the whole numbers and their negatives, including zero.",
     "pause": 0.2,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "text",
       "text": "Integers"
      },
      {
       "do": "write",
       "tex": "\\ldots,-2,-1,0,1,2,\\ldots",
       "at": "whole"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "A decimal that ends is easy: its last place names the fraction.",
     "pause": 0.2,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "0.75=\\frac{75}{100}",
       "note": "\\text{hundredths}"
      },
      {
       "do": "highlight",
       "target": "endingDot",
       "at": "ends"
      }
     ]
    }
