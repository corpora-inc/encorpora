      "beats": [
        {
          "speaker": "teacher",
          "say": "To graph a line, find two points that make its equation true.",
          "do": [
            {
              "do": "text",
              "text": "Find two points that make it true."
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Graph y plus one equals three times x minus two by placing two points on its line.",
          "pause": 0.5,
          "do": [
            {
              "do": "clear"
            },
            {
              "do": "problem",
              "text": "Graph $y + 1 = 3(x - 2)$ by placing 2 points on its line."
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "This is point-slope form: one point on the line, and the slope.",
          "do": [
            {
              "do": "clear"
            },
            {
              "do": "header",
              "tex": "y-y_1=m(x-x_1)",
              "label": "Point-slope form",
              "at": "point-slope"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "y plus one is y minus negative one, so the point is two, negative one.",
          "pause": 0.3,
          "do": [
            {
              "do": "write",
              "tex": "y+1=3(x-\\cg{2})",
              "note": "\\text{the original}",
              "fresh": true
            },
            {
              "do": "write",
              "tex": "y+1=y-(\\cg{-1})",
              "fresh": true,
              "at": "minus"
            },
            {
              "do": "show",
              "target": [
                "dP1",
                "l1"
              ],
              "at": "two"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "A common slip copies the signs as printed: negative two, one. That point is off this line.",
          "pause": 0.4,
          "do": [
            {
              "do": "write",
              "tex": "(-2,\\ 1)",
              "id": "slip",
              "note": "\\text{common slip}",
              "fresh": true,
              "at": "negative"
            },
            {
              "do": "strike",
              "target": "slip",
              "at": "off"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "The slope is three, so the step goes across one and up three.",
          "do": [
            {
              "do": "clear"
            },
            {
              "do": "write",
              "tex": "y+1=\\cw{3}(x-2)",
              "note": "\\text{the original}",
              "fresh": true
            },
            {
              "do": "write",
              "tex": "\\text{slope}=\\frac{\\cw{3}}{\\cb{1}}",
              "fresh": true,
              "at": "step"
            },
            {
              "do": "draw",
              "target": "run",
              "at": "across"
            },
            {
              "do": "show",
              "target": "lr",
              "at": "one"
            },
            {
              "do": "draw",
              "target": "rise",
              "at": "up"
            },
            {
              "do": "show",
              "target": "lh",
              "at": "three",
              "nth": 2
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "The step lands on three, two, the second point.",
          "do": [
            {
              "do": "show",
              "target": [
                "dP2",
                "l2"
              ],
              "at": "lands"
            },
            {
              "do": "write",
              "tex": "(3,\\ 2)",
              "note": "\\text{second point}",
              "fresh": true,
              "at": "three"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Draw the line through both, with its equation beside it.",
          "pause": 0.5,
          "do": [
            {
              "do": "draw",
              "target": "line",
              "at": "Draw"
            },
            {
              "do": "show",
              "target": "eq",
              "at": "Draw"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Repeat the step and it lands on four, five, on the same line.",
          "pause": 0.5,
          "do": [
            {
              "do": "draw",
              "target": "run2",
              "at": "Repeat"
            },
            {
              "do": "draw",
              "target": "rise2",
              "at": "lands"
            },
            {
              "do": "show",
              "target": [
                "dP3",
                "l3"
              ],
              "at": "four"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Check three, two in the original: both sides come to three.",
          "pause": 0.7,
          "do": [
            {
              "do": "clear"
            },
            {
              "do": "write",
              "tex": "y+1=3(x-2)",
              "note": "\\text{the original}",
              "fresh": true
            },
            {
              "do": "highlight",
              "target": "dP2",
              "at": "three"
            },
            {
              "do": "write",
              "tex": "2+1=3(3-2)",
              "fresh": true,
              "at": "both"
            },
            {
              "do": "write",
              "tex": "3=3",
              "at": "three",
              "nth": 2
            }
          ]
        }
      ]
