      {
       "do": "draw",
       "target": "run3",
       "at": "more"
      },
      {
       "do": "draw",
       "target": "rise3",
       "at": "four"
      },
      {
       "do": "show",
       "target": [
        "s3",
        "d4",
        "v4"
       ],
       "at": "eleven"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "The points stay separate. There is no term at two and a half.",
     "do": [
      {
       "do": "highlight",
       "target": "d2",
       "at": "separate"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Count the risers, not the posts.",
     "do": [
      {
       "do": "highlight",
       "target": "d4",
       "at": "posts"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Step one, from two up to five.",
     "do": [
      {
       "do": "highlight",
       "target": "rise1",
       "at": "one"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Step two, from five up to eight.",
     "do": [
      {
       "do": "highlight",
       "target": "rise2",
       "at": "two"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Step three, from eight up to eleven.",
     "do": [
      {
       "do": "highlight",
       "target": "rise3",
       "at": "three"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Three steps from term one to term four. One fewer than four.",
     "do": [
      {
       "do": "write",
       "tex": "4-1=3",
       "at": "fewer",
       "id": "count3",
       "note": "\\text{steps}"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "The amount added each step is the common difference, d.",
     "do": [
      {
       "do": "text",
       "text": "$\\cw{d}$: the common difference, added every step.",
       "at": "common",
       "id": "defD"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Term n is the first term, plus n minus one, times d.",
     "do": [
      {
       "do": "write",
       "tex": "a_n=\\cg{a_1}+\\cb{(n-1)}\\cw{d}",
       "at": "plus",
       "id": "rule"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "First term 2, common difference 3. What is term 8?",
