     ]
    },
    {
     "speaker": "teacher",
     "say": "Not eight. Count the gaps. Term 8 is seven steps from the start.",
     "do": [
      {
       "do": "highlight",
       "target": [
        "rise1",
        "rise2",
        "rise3"
       ],
       "at": "gaps"
      }
     ]
    },
    {
     "speaker": "learner",
     "say": "Seven steps. Two plus seven times three is twenty-three.",
