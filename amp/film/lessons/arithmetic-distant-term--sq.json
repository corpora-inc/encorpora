   "beats": [
    {
     "speaker": "teacher",
     "say": "An arithmetic sequence is a staircase. Start at two. Each step adds the same amount.",
     "do": [
      {
       "do": "text",
       "text": "Each step adds the same amount.",
       "at": "staircase",
       "id": "idea"
      },
      {
       "do": "show",
       "target": [
        "d1",
        "v1"
       ],
       "at": "two"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "One step right, and three up. The next term is five.",
     "do": [
      {
       "do": "draw",
       "target": "run1",
       "at": "right"
      },
      {
       "do": "draw",
       "target": "rise1",
       "at": "three"
      },
      {
       "do": "show",
       "target": [
        "s1",
        "d2",
        "v2"
       ],
       "at": "five"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "The same step again. Term three is eight.",
     "do": [
      {
       "do": "draw",
       "target": "run2",
       "at": "same"
      },
      {
       "do": "draw",
       "target": "rise2",
       "at": "three"
      },
      {
       "do": "show",
       "target": [
        "s2",
        "d3",
        "v3"
       ],
       "at": "eight"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Once more. Term four is eleven.",
