              "text": "A line passes through the points $(4,4)$ and $(7,-8)$. Which equation is an equation of this line?"
            },
            {
              "do": "show",
              "target": [
                "db",
                "lb"
              ],
              "at": "seven"
            }
          ],
          "pause": 0.4
        },
        {
          "speaker": "teacher",
          "say": "Across three and down twelve: the slope is negative twelve over three, negative four.",
          "do": [
            {
              "do": "draw",
              "target": [
                "run",
                "rl"
              ],
              "at": "Across"
            },
            {
              "do": "draw",
              "target": [
                "drop",
                "dl"
              ],
              "at": "down"
            },
            {
              "do": "clear",
              "at": "slope"
            },
            {
              "do": "write",
              "tex": "m=\\frac{-12}{3}=-4",
              "note": "\\text{slope}",
              "at": "slope",
              "fresh": true
            }
          ],
          "pause": 0.4
        },
        {
          "speaker": "teacher",
          "say": "A common slip puts the seven where the slope goes.",
          "do": [
            {
              "do": "clear",
              "at": "common"
            },
            {
              "do": "write",
              "tex": "y-4=7(x-4)",
              "id": "slip",
              "at": "common",
              "fresh": true
            },
            {
              "do": "highlight",
              "target": [
                "db",
                "lb"
              ],
              "at": "seven"
            }
          ],
          "pause": 0.4
        },
        {
          "speaker": "teacher",
          "say": "Seven is a coordinate of the point, not the slope of this line. Use negative four, with four, four.",
          "do": [
            {
              "do": "strike",
              "target": "slip",
              "at": "not"
            },
            {
              "do": "write",
              "tex": "y-4=-4(x-4)",
              "at": "Use",
              "fresh": true
            },
            {
              "do": "highlight",
              "target": [
                "da",
                "la"
              ],
              "at": "with"
            }
          ],
          "pause": 0.4
        },
        {
          "speaker": "teacher",
          "say": "Either point works: seven, negative eight gives y plus eight. Both simplify to y equals negative four x plus twenty.",
          "do": [
            {
              "do": "clear",
              "at": "Either"
            },
            {
              "do": "write",
              "tex": "y-4=-4(x-4)",
              "at": "Either",
              "fresh": true
            },
            {
              "do": "highlight",
              "target": [
                "db",
                "lb"
              ],
              "at": "seven"
            },
            {
              "do": "write",
              "tex": "y+8=-4(x-7)",
              "at": "gives",
              "fresh": true
            },
            {
              "do": "write",
              "tex": "y=-4x+20",
              "at": "Both",
              "fresh": true
            },
            {
              "do": "show",
              "target": "eq",
              "at": "twenty"
            }
          ],
          "pause": 0.4
        }
      ]
    },
