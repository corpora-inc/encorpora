        "nameR"
       ],
       "at": "twenty-four"
      }
     ],
     "pause": 0.05
    },
    {
     "speaker": "teacher",
     "say": "Exactly. Twenty-four ones is twenty-four. Twenty-four tens is two hundred forty.",
     "do": [
      {
       "do": "highlight",
       "target": "eqL",
       "at": "ones",
       "until": "Twenty-four",
       "untilNth": 3
      },
      {
       "do": "highlight",
       "target": "eqR",
       "at": "tens"
      }
     ],
     "pause": 0.5
    },
    {
     "speaker": "teacher",
     "say": "So multiply the digits you know, then say what they are: tens.",
     "do": [
