      },
      {
       "do": "show",
       "target": [
        "nameL",
        "eqL"
       ],
       "at": "six"
      },
      {
       "do": "write",
       "tex": "6\\times4=24\\text{ ones}",
       "at": "six"
      }
     ],
     "pause": 0.4
    },
    {
     "speaker": "teacher",
     "say": "On the right, the very same array, but every dot is now a ten. Six times forty.",
     "do": [
      {
       "do": "show",
       "target": "rods",
       "at": "right"
      },
      {
       "do": "show",
       "target": [
