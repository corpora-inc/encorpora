          { "id": "lD", "label": "D", "at": "LD", "dir": "c", "size": "l", "ink": "violet" }
        ]
      },
      "beats": [
        {
          "say": "Which letter marks fifteen tenths?",
          "pause": 0.25,
          "do": [
            { "do": "clear" },
            { "do": "problem", "text": "Which letter marks $\\frac{15}{10}$?", "choices": ["$A$", "$B$", "$C$", "$D$"], "at": "Which", "id": "p2" },
            { "do": "show", "target": ["dot", "dA", "dB", "dC", "dD", "lA", "lB", "lC", "lD"], "at": "letter" }
          ]
        },
        {
          "say": "Ten steps of one tenth reach one whole.",
          "do": [
            { "do": "move", "points": { "P": [1, 0.22] }, "at": "Ten" },
            { "do": "write", "tex": "10\\times\\frac{1}{10}=1", "fresh": true, "at": "reach", "id": "ten" },
            { "do": "highlight", "target": "dot", "at": "whole" }
          ]
        },
        {
          "say": "Five more steps reach fifteen tenths, which is one and five tenths.",
          "do": [
            { "do": "move", "points": { "P": [1.5, 0.22] }, "at": "Five" },
            { "do": "write", "tex": "\\frac{15}{10}=1.5", "fresh": true, "at": "fifteen", "id": "eq2" },
            { "do": "highlight", "target": ["dD", "lD"], "at": "five", "nth": 2 }
          ]
        },
        {
          "say": "The dot lands on D. Fifteen tenths is past one whole.",
          "do": [
            { "do": "answer", "tex": "D", "at": "D", "id": "ans2" },
            { "do": "highlight", "target": "lD", "at": "past" }
          ]
        }
      ]
    },
