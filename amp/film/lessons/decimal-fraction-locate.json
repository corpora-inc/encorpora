{
  "id": "decimal-fraction-locate",
  "title": "Locate a decimal or a fraction",
  "teaches": ["decimal-line-point"],
  "seed": "film",
  "shots": [
    {
      "figure": { "example": true },
      "beats": [
        {
          "say": "Which point is at nine tenths?",
          "pause": 0.3,
          "do": [
            { "do": "problem", "text": "Which point is at $\\frac{9}{10}$?", "choices": ["$C$", "$D$", "$A$", "$B$"], "at": "Which", "id": "p1" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.label.0" }], "at": "point" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.label.2" }], "at": "tenths" }
          ]
        },
        {
          "say": "Only the ends are numbered. The left end is zero. The right end is two.",
          "do": [
            { "do": "write", "tex": "\\text{left end}=0", "fresh": true, "at": "left", "id": "end0" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.label.0" }], "at": "zero" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.label.2" }], "at": "two" }
          ]
        },
        {
          "say": "Each step is one tenth. Count from the left end.",
          "do": [
            { "do": "text", "text": "Count from the left end.", "at": "Count", "id": "phrase" },
            { "do": "write", "tex": "1\\ \\text{step}=\\frac{1}{10}", "fresh": true, "at": "tenth", "id": "step" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.1" }], "at": "step" }
          ]
        },
        {
          "say": "One, two, three, four, five.",
          "do": [
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.1" }], "at": "One" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.2" }], "at": "two" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.3" }], "at": "three" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.4" }], "at": "four" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.5" }], "at": "five" }
          ]
        },
        {
          "say": "Six, seven, eight, nine. That mark is B.",
          "do": [
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.6" }], "at": "Six" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.7" }], "at": "seven" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.tick.0.8" }], "at": "eight" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.mark.1" }], "at": "nine" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.mark.1.label" }], "at": "B" }
          ]
        },
        {
          "say": "Nine tenths is zero point nine. The point there is B.",
          "do": [
            { "do": "write", "tex": "\\frac{9}{10}=0.9", "fresh": true, "at": "zero", "id": "eq1" },
            { "do": "answer", "tex": "B", "at": "B", "id": "ans1" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.mark.1.label" }], "at": "B" }
          ]
        },
        {
          "say": "Count from the left end, not from two.",
          "do": [
            { "do": "watch", "text": "Count from the left end. Do not start at the right end.", "at": "left", "id": "w1" },
            { "do": "scene", "actions": [{ "do": "highlight", "target": "line.label.2" }], "at": "two" }
          ]
        }
      ]
    },
    {
      "figure": {
        "view": [-0.15, -0.42, 2.2, 0.72],
        "points": {
          "P": [0, 0.22],
          "A": [1.1, 0.08], "LA": [1.1, 0.42],
          "B": [0.3, 0.08], "LB": [0.3, 0.42],
          "C": [0.7, 0.08], "LC": [0.7, 0.42],
          "D": [1.5, 0.08], "LD": [1.5, 0.42]
