        },
        {
          "say": "The left end is zero point three, not zero. Each step is one hundredth.",
          "do": [
            { "do": "write", "tex": "\\text{left end}=0.3", "fresh": true, "at": "left", "id": "end3" },
            { "do": "write", "tex": "1\\ \\text{step}=0.01", "fresh": true, "at": "step", "id": "st3" },
            { "do": "highlight", "target": "dot", "at": "three" }
          ]
        },
        {
          "say": "Seven hundredths past zero point three is zero point three seven.",
          "do": [
            { "do": "move", "points": { "P": [0.37, 0.02] }, "at": "Seven" },
            { "do": "write", "tex": "0.3+0.07=0.37", "fresh": true, "at": "past", "id": "eq3" },
            { "do": "highlight", "target": ["dC", "lC"], "at": "seven", "nth": 2 }
