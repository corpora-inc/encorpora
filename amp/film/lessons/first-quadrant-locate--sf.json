        {
          "speaker": "teacher",
          "say": "It always starts at zero, where the two lines cross.",
          "pause": 0.4,
          "do": [{ "do": "show", "target": "oc", "at": "zero" }, { "do": "highlight", "target": ["oc", "walker"], "at": "cross" }]
        },
        {
          "speaker": "teacher",
          "say": "Across first. We count jumps, not lines. The spaces in between. One. Two. Three.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": "axX", "at": "Across", "until": "We" },
            { "do": "draw", "target": "hx1", "at": "One", "dur": 0.5 },
            { "do": "move", "points": { "W": [1, 0], "V": [1, 0] }, "at": "One", "dur": 0.6 },
            { "do": "show", "target": "cx1", "at": "One" },
            { "do": "draw", "target": "hx2", "at": "Two", "dur": 0.5 },
            { "do": "move", "points": { "W": [2, 0], "V": [2, 0] }, "at": "Two", "dur": 0.6 },
            { "do": "show", "target": "cx2", "at": "Two" },
            { "do": "draw", "target": "hx3", "at": "Three", "dur": 0.5 },
            { "do": "move", "points": { "W": [3, 0], "V": [3, 0] }, "at": "Three", "dur": 0.6 },
            { "do": "show", "target": "cx3", "at": "Three" },
            { "do": "write", "tex": "(3,\\ ?)", "fresh": true, "at": "Three" }
