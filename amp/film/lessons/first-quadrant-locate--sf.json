          ]
        },
        {
          "speaker": "learner",
          "say": "Um. A little past the pond?",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": "pond", "at": "pond" }]
        },
        {
          "speaker": "teacher",
          "say": "A stranger could not follow that.",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": ["pond", "trunkA", "crownA", "trunkB", "crownB"], "at": "stranger" }]
        },
        {
          "speaker": "teacher",
          "say": "We need an exact address, made of numbers.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": ["xa", "xb"], "at": "exact" },
            { "do": "text", "text": "An exact address in numbers", "at": "numbers" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "So let's lay a grid of equal squares over the map.",
          "pause": 0.3,
          "do": [{ "do": "draw", "target": "grid", "at": "grid", "dur": 1.6 }]
        },
        {
          "speaker": "teacher",
          "say": "Start with one number line, along the bottom.",
          "pause": 0.2,
          "do": [{ "do": "draw", "target": "axX", "at": "number", "dur": 1.4 }]
        },
        {
          "speaker": "teacher",
          "say": "Zero, one, two, and on.",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": "axX", "at": "Zero" }]
        },
        {
          "speaker": "teacher",
          "say": "One number tells you how far along.",
          "pause": 0.4,
          "do": [{ "do": "text", "text": "One number: how far along", "at": "One" }]
        },
        {
          "speaker": "teacher",
          "say": "But one line only gets you along the bottom.",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": "axX", "at": "only" }]
        },
        {
          "speaker": "teacher",
          "say": "So stand a second number line straight up from its zero.",
          "pause": 0.4,
          "do": [
            { "do": "draw", "target": "axXY", "at": "second", "dur": 1.6 },
            { "do": "draw", "target": "axY", "at": "second", "dur": 1.6 }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Now any spot on the page can be named with two numbers.",
          "pause": 0.2,
          "do": [
            { "do": "text", "text": "Two numbers: how far across, how far up", "at": "two" },
            { "do": "highlight", "target": ["xa", "xb"], "at": "spot" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "How far across, and how far up.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": "axX", "at": "across", "until": "and" },
            { "do": "highlight", "target": "axY", "at": "up" }
          ]
        },
        {
          "speaker": "learner",
          "say": "Across and up. Show me how to get to the X!",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": ["xa", "xb"], "at": "X" }]
        },
        {
          "speaker": "teacher",
          "say": "A little marker will walk it.",
          "pause": 0.2,
          "do": [
            { "do": "clear" },
            { "do": "show", "target": "walker", "at": "marker" }
