      "beats": [
        {
          "speaker": "teacher",
          "say": "Here is a treasure map, and the X marks the spot.",
          "pause": 0.3,
          "do": [
            { "do": "header", "text": "Two numbers find any spot" },
            { "do": "highlight", "target": ["xa", "xb"], "at": "X" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Champ, tell a friend exactly where the treasure is.",
          "pause": 0.3,
          "do": [{ "do": "highlight", "target": ["xa", "xb"], "at": "exactly" }]
        },
        {
          "speaker": "learner",
          "say": "Easy! It's near the tree.",
          "pause": 0.2,
          "do": [{ "do": "highlight", "target": ["trunkA", "crownA"], "at": "tree" }]
        },
        {
          "speaker": "teacher",
          "say": "Which tree? There are two.",
          "pause": 0.3,
          "do": [
