        },
        {
          "speaker": "teacher",
          "say": "Three across. Now up. One. Two. Three. Four.",
          "pause": 0.4,
          "do": [
            { "do": "draw", "target": "hy1", "at": "One", "dur": 0.5 },
            { "do": "move", "points": { "W": [3, 1] }, "at": "One", "dur": 0.6 },
            { "do": "show", "target": "cu1", "at": "One" },
            { "do": "draw", "target": "hy2", "at": "Two", "dur": 0.5 },
            { "do": "move", "points": { "W": [3, 2] }, "at": "Two", "dur": 0.6 },
            { "do": "show", "target": "cu2", "at": "Two" },
            { "do": "draw", "target": "hy3", "at": "Three", "nth": 2, "dur": 0.5 },
            { "do": "move", "points": { "W": [3, 3] }, "at": "Three", "nth": 2, "dur": 0.6 },
            { "do": "show", "target": "cu3", "at": "Three", "nth": 2 },
            { "do": "draw", "target": "hy4", "at": "Four", "dur": 0.5 },
            { "do": "move", "points": { "W": [3, 4] }, "at": "Four", "dur": 0.6 },
            { "do": "show", "target": "cu4", "at": "Four" },
            { "do": "write", "tex": "(3,\\ 4)", "at": "Four" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Right on the X! Three across, four up.",
          "pause": 0.4,
          "do": [
            { "do": "show", "target": "lT", "at": "Right" },
            { "do": "highlight", "target": ["xa", "xb", "walker"], "at": "Right" },
            { "do": "highlight", "target": "hx", "at": "Three", "until": "four" },
            { "do": "highlight", "target": "hy", "at": "four" }
          ]
        },
        {
          "speaker": "learner",
          "say": "So the treasure is at three, four!",
          "pause": 0.3,
          "do": [{ "do": "highlight", "target": ["lT", "xa", "xb"], "at": "treasure" }]
        },
        {
          "speaker": "teacher",
          "say": "Yes. The first number is how far across. The second is how far up.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": "hx", "at": "first", "until": "second" },
            { "do": "highlight", "target": "hy", "at": "second" }
          ]
        },
        {
          "speaker": "learner",
          "say": "What if I swap them? Four across, and then up three.",
          "pause": 0.3,
          "do": [{ "do": "highlight", "target": "lT", "at": "swap" }]
        },
        {
          "speaker": "teacher",
          "say": "Try it. Start at zero again. Across four.",
          "pause": 0.2,
          "do": [
            { "do": "hide", "target": ["cx1", "cx2", "cx3", "cu1", "cu2", "cu3", "cu4"], "at": "Try" },
            { "do": "show", "target": ["walker2", "trail3"], "at": "Start" },
            { "do": "move", "points": { "W2": [4, 0], "V2": [4, 0] }, "at": "Across", "dur": 1.8 }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Then up three.",
          "pause": 0.3,
          "do": [
            { "do": "show", "target": "trail4", "at": "up" },
            { "do": "move", "points": { "W2": [4, 3] }, "at": "up", "dur": 1.5 },
            { "do": "show", "target": "lT2", "at": "three" }
          ]
        },
        {
          "speaker": "learner",
          "say": "That's just grass. No treasure!",
          "pause": 0.3,
          "do": [{ "do": "highlight", "target": ["walker2", "lT2"], "at": "grass" }]
        },
        {
          "speaker": "teacher",
          "say": "Three, four and four, three are different places. Order matters: across first, then up.",
          "pause": 0.5,
          "do": [
            { "do": "highlight", "target": ["walker", "lT"], "at": "Three" },
            { "do": "highlight", "target": ["walker2", "lT2"], "at": "four", "nth": 2 },
            { "do": "write", "tex": "(3,\\,4)\\neq(4,\\,3)", "fresh": true, "at": "different" }
          ]
        }
      ]
