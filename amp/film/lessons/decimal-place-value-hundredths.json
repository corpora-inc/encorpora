{
  "id": "decimal-place-value-hundredths",
  "title": "Decimal place value to hundredths",
  "seed": "film",
  "shots": [
    {
      "figure": {
        "points": {},
        "parts": [
          {
            "id": "b",
            "blocks": ["ones", "tenths", "hundredths"],
            "rows": [{ "id": "n", "pieces": { "ones": 1, "tenths": 1, "hundredths": 1 }, "shown": ["ones"] }],
            "point": true,
            "digits": true,
            "lines": "none",
            "focus": "n.ones.1",
            "labels": [
              { "id": "lw", "on": "n.ones.1", "tex": "1", "dir": "n", "size": "l" },
              { "id": "lt", "on": "n.ones.1.s10", "tex": "\\frac{1}{10}=0.1", "dir": "e" },
              { "id": "lh", "on": "n.ones.1.c10", "tex": "\\frac{1}{100}=0.01", "dir": "e" }
            ]
          }
        ]
      },
      "beats": [
        {
          "say": "This square is one whole.",
          "do": [{ "do": "show", "target": "lw", "at": "one" }]
        },
        {
          "say": "Cut it into ten equal strips. Each strip is one tenth: one over ten, or zero point one.",
          "do": [
            { "do": "cut", "target": "b.n.ones.1", "into": "tenths", "at": "Cut" },
            { "do": "highlight", "target": "b.n.ones.1.s10", "at": "Each" },
            { "do": "show", "target": "lt", "at": "tenth" },
            { "do": "term", "word": "tenth", "meaning": "One of $10$ equal parts of one whole: $\\frac{1}{10}$, written $0.1$.", "at": "tenth", "id": "tenth" }
          ]
        },
        {
          "say": "Cut every strip into ten equal squares. Each little square is one hundredth: one over one hundred, or zero point zero one.",
          "do": [
            { "do": "cut", "target": "b.n.ones.1", "into": "hundredths", "at": "Cut" },
            { "do": "highlight", "target": "b.n.ones.1.c10", "at": "Each" },
            { "do": "show", "target": "lh", "at": "hundredth" },
            { "do": "term", "word": "hundredth", "meaning": "One of $100$ equal parts of one whole: $\\frac{1}{100}$, written $0.01$.", "at": "hundredth", "id": "hun" }
          ]
        },
        {
          "say": "Ten little squares fill one strip. Ten hundredths make one tenth.",
          "pause": 0.45,
          "do": [
            { "do": "highlight", "target": "b.n.ones.1.s10", "at": "Ten" },
            { "do": "write", "tex": "10\\text{ hundredths}=1\\text{ tenth}", "fresh": true, "at": "Ten", "nth": 2, "id": "d10" }
          ]
        },
        {
          "say": "A hundred little squares fill the whole.",
          "do": [
            { "do": "highlight", "target": "b.n.ones.1", "at": "hundred" },
            { "do": "write", "tex": "100\\text{ hundredths}=1\\text{ whole}", "fresh": true, "at": "hundred", "id": "d100" }
          ]
        },
        {
          "say": "A chart gives each size its own place: the ones, the tenths, and the hundredths.",
          "do": [
            { "do": "zoom", "target": "b", "at": "chart" },
            { "do": "hide", "target": ["lw", "lt", "lh"], "at": "chart" },
            { "do": "show", "target": "b.n.tenths", "at": "tenths" },
            { "do": "show", "target": "b.n.hundredths", "at": "hundredths" }
          ]
        },
        {
          "say": "The digit under each pile counts the pieces. One, one, and one: one point one one.",
          "do": [
            { "do": "highlight", "target": "b.digits", "at": "digit" },
            { "do": "text", "text": "The digit counts the pieces.", "at": "counts", "id": "count" }
          ]
        },
        {
          "say": "The point sits beside the ones. The ones are just to its left.",
          "pause": 0.5,
          "do": [
            { "do": "highlight", "target": "b.point", "at": "point" },
            { "do": "text", "text": "The point sits beside the ones.", "at": "beside", "id": "pt" }
          ]
        },
        {
          "say": "The one in the tenths place is worth one tenth: zero point one. Not one whole.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": ["b.n.tenths", "b.digit.tenths"], "at": "tenths" },
            { "do": "write", "tex": "1\\text{ tenth}=0.1", "fresh": true, "at": "worth", "id": "v1" }
          ]
        },
        {
          "say": "The one in the hundredths place is worth one hundredth: zero point zero one.",
          "do": [
            { "do": "highlight", "target": ["b.n.hundredths", "b.digit.hundredths"], "at": "hundredths" },
            { "do": "write", "tex": "1\\text{ hundredth}=0.01", "fresh": true, "at": "worth", "id": "v01" }
          ]
        },
        {
          "say": "The one in the ones place is worth one. The place says what the digit is worth.",
          "pause": 0.55,
          "do": [
            { "do": "highlight", "target": ["b.n.ones", "b.digit.ones"], "at": "ones" },
            { "do": "text", "text": "The place says what the digit is worth.", "at": "place", "nth": 2, "id": "idea" }
          ]
        }
      ]
    },
