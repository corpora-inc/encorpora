          ]
        },
        {
          "say": "Nine rods are almost one whole. The value is about one, not nine, and not ninety.",
          "pause": 0.5,
          "do": [
            { "do": "highlight", "target": "b.n.tenths", "at": "Nine" },
            { "do": "text", "text": "About one, not $9$ or $90$.", "at": "about", "id": "sense" }
          ]
        }
      ]
    },
