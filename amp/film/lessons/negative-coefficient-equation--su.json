      "beats": [
        {
          "speaker": "teacher",
          "say": "To solve an equation, run its steps backward. Solve negative five x plus four equals eleven.",
          "do": [
            {
              "do": "problem",
              "text": "Solve $-5x+4={11}$"
            },
            {
              "do": "show",
              "target": [
                "leftBox",
                "leftLabel",
                "middleBox",
                "middleLabel",
                "rightBox",
                "rightLabel"
              ],
              "at": "steps"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "First x is multiplied by negative five. Then four is added.",
          "do": [
            {
              "do": "draw",
              "target": "f0",
              "at": "multiplied"
            },
            {
              "do": "show",
              "target": "fl0",
              "at": "negative"
            },
            {
              "do": "draw",
              "target": "f1",
              "at": "four"
            },
            {
              "do": "show",
              "target": "fl1",
              "at": "added"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Adding four came last, so undo it first: subtract four from both sides.",
          "do": [
            {
              "do": "draw",
              "target": "r1",
              "at": "subtract"
            },
            {
              "do": "write",
              "tex": "-5x+4-4={11}-4",
              "at": "subtract"
            },
            {
              "do": "show",
              "target": "rl1",
              "at": "four"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Negative five x equals seven.",
          "do": [
            {
              "do": "write",
              "tex": "-5x=7",
              "at": "Negative"
            },
            {
              "do": "show",
              "target": "middleValue",
              "at": "seven"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Now divide by the multiplier, negative five, sign and all.",
          "do": [
            {
              "do": "clear",
              "at": "divide"
            },
            {
              "do": "write",
              "tex": "\\frac{-5x}{-5}=\\frac{7}{-5}",
              "at": "divide"
            },
            {
              "do": "draw",
              "target": "r0",
              "at": "divide"
            },
            {
              "do": "show",
              "target": "rl0",
              "at": "negative"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "So x is negative seven fifths.",
          "do": [
            {
              "do": "answer",
              "tex": "x=-\\frac{7}{5}",
              "at": "negative"
            },
            {
              "do": "show",
              "target": "leftValue",
              "at": "negative"
            }
          ],
          "pause": 0.9
        },
        {
          "speaker": "teacher",
          "say": "Check in the original equation. A common slip drops the sign: seven fifths gives negative three, not eleven.",
          "do": [
            {
              "do": "clear",
              "at": "Check"
            },
            {
              "do": "write",
              "tex": "-5x+4={11}",
              "note": "\\text{the original}",
              "fresh": true,
              "at": "Check"
            },
            {
              "do": "write",
              "tex": "-5\\left(\\frac{7}{5}\\right)+4=-3",
              "id": "slip",
              "fresh": true,
              "at": "seven"
            },
            {
              "do": "strike",
              "target": "slip",
              "at": "not"
            }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Negative seven fifths gives back eleven.",
          "do": [
            {
              "do": "write",
              "tex": "-5\\left(-\\frac{7}{5}\\right)+4={11}",
              "fresh": true,
              "at": "Negative"
            }
          ],
          "pause": 1.0
        }
      ]
