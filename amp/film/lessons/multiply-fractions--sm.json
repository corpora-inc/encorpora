      "beats": [
        {
          "speaker": "teacher",
          "say": "What is two thirds times three fourths?",
          "pause": 0.2,
          "do": [
            { "do": "clear" },
            { "do": "problem", "text": "What is $\\frac{2}{3}\\times\\frac{3}{4}$?" }
          ]
        },
        {
          "speaker": "learner",
          "say": "Easy! Multiply the tops, multiply the bottoms. Two times three is six. Three times four is twelve. Six twelfths. See?",
          "pause": 0.2,
          "do": [
            { "do": "write", "tex": "\\frac{2\\times3}{3\\times4}", "id": "rule", "at": "tops" },
            { "do": "clear", "at": "six" },
            { "do": "write", "tex": "2\\times3=6", "fresh": true, "at": "six" },
            { "do": "write", "tex": "3\\times4=12", "fresh": true, "at": "twelve" },
            { "do": "write", "tex": "\\frac{6}{12}", "fresh": true, "at": "twelfths" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "That is right. But why does it work?",
          "pause": 0.3
        },
        {
          "speaker": "teacher",
          "say": "Let's see it, inside a square.",
          "pause": 0.3,
          "do": [
            { "do": "draw", "target": "sq", "at": "see" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Times means of. We want two thirds of three fourths. So take three fourths of the square first.",
          "pause": 0.3,
          "do": [
            { "do": "write", "tex": "\\cg{\\tfrac{2}{3}}\\text{ of }\\ca{\\tfrac{3}{4}}", "fresh": true, "at": "two" },
            { "do": "show", "target": "sqRing", "at": "square" },
            { "do": "hide", "target": "sqRing", "at": "first" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Cut the square into four equal columns. Fourths.",
          "pause": 0.2,
          "do": [
            { "do": "draw", "target": "v1", "at": "Cut" },
            { "do": "draw", "target": "v2", "at": "four" },
            { "do": "draw", "target": "v3", "at": "columns" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Shade three of the four. That is three fourths.",
          "pause": 0.3,
          "do": [
            { "do": "show", "target": "q34", "at": "Shade" },
            { "do": "show", "target": "lq34", "at": "fourths" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Now the other fraction, two thirds. Cut the whole square across into three equal rows.",
          "pause": 0.2,
          "do": [
            { "do": "show", "target": "lq23", "at": "thirds" },
            { "do": "draw", "target": "h1", "at": "Cut" },
            { "do": "draw", "target": "h2", "at": "three" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Color the top two rows gold. The gold band lies across every column.",
          "pause": 0.5,
          "do": [
            { "do": "highlight", "target": ["h1", "h2"], "at": "Color", "until": "gold" },
            { "do": "show", "target": "band", "at": "gold" },
            { "do": "highlight", "target": ["v1", "v2", "v3"], "at": "column" }
          ]
        },
        {
          "speaker": "learner",
          "say": "Whoa! The colors mix where the gold crosses the teal!",
          "pause": 0.3,
          "do": [
            { "do": "show", "target": ["ovFill", "ov"], "at": "mix" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "That mixed patch is two thirds of the three fourths. Two thirds of three fourths. That is our answer.",
          "pause": 0.4,
          "do": [
            { "do": "show", "target": "ovRing", "at": "mixed" },
            { "do": "hide", "target": "ovRing", "at": "two" },
            { "do": "show", "target": "qRing", "at": "three" },
            { "do": "hide", "target": "qRing", "at": "Two", "nth": 2 },
            { "do": "show", "target": "ovRing", "at": "answer" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "How many little pieces make the patch? Count them. One, two, three, four, five, six.",
          "pause": 0.3,
          "do": [
            { "do": "hide", "target": "ovRing" },
            { "do": "show", "target": "n1", "at": "One" },
            { "do": "show", "target": "n2", "at": "two" },
            { "do": "show", "target": "n3", "at": "three" },
            { "do": "show", "target": "n4", "at": "four" },
            { "do": "show", "target": "n5", "at": "five" },
            { "do": "show", "target": "n6", "at": "six" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Six pieces. Now count every piece in the whole square. Seven, eight, nine, ten, eleven, twelve.",
          "pause": 0.4,
          "do": [
            { "do": "show", "target": "n7", "at": "Seven" },
            { "do": "show", "target": "n8", "at": "eight" },
            { "do": "show", "target": "n9", "at": "nine" },
            { "do": "show", "target": "n10", "at": "ten" },
            { "do": "show", "target": "n11", "at": "eleven" },
            { "do": "show", "target": "n12", "at": "twelve" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Six pieces out of twelve. Six twelfths. The picture agrees with Champ.",
          "pause": 0.3,
          "do": [
            { "do": "clear" },
            { "do": "write", "tex": "\\frac{2}{3}\\times\\frac{3}{4}=\\frac{6}{12}", "fresh": true, "at": "Six" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Now look at where the six comes from. The patch is three columns wide, and two rows tall. Two rows of three.",
          "pause": 0.4,
          "do": [
            { "do": "hide", "target": ["n1", "n2", "n3", "n4", "n5", "n6", "n7", "n8", "n9", "n10", "n11", "n12", "lq34", "lq23"], "at": "Now" },
            { "do": "show", "target": "dTop", "at": "three" },
            { "do": "show", "target": "dLeft", "at": "two" },
            { "do": "write", "tex": "\\cg{2}\\times\\ca{3}=6", "note": "\\text{pieces taken}", "fresh": true, "at": "three", "nth": 2 }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Two times three. The tops, multiplied. They count the pieces we took.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": ["dTop", "dLeft"], "at": "tops" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "And the whole square? Four columns, each cut into three pieces. Three times four is twelve.",
          "pause": 0.4,
          "do": [
            { "do": "show", "target": "dBot", "at": "Four" },
            { "do": "show", "target": "dRight", "at": "three" },
            { "do": "write", "tex": "\\cg{3}\\times\\ca{4}=12", "note": "\\text{pieces in all}", "fresh": true, "at": "Three", "nth": 2 }
          ]
        },
        {
          "speaker": "teacher",
          "say": "The bottoms, multiplied. They count all the pieces.",
          "pause": 0.4,
          "do": [
            { "do": "highlight", "target": ["dBot", "dRight"], "at": "bottoms" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "So two thirds times three fourths is two times three, over three times four.",
          "pause": 0.3,
          "do": [
            { "do": "clear" },
            { "do": "write", "tex": "\\frac{\\cg{2}}{\\cg{3}}\\times\\frac{\\ca{3}}{\\ca{4}}", "fresh": true, "at": "So" },
            { "do": "write", "tex": "=\\frac{\\cg{2}\\times\\ca{3}}{\\cg{3}\\times\\ca{4}}", "fresh": true, "at": "two", "nth": 2 },
            { "do": "highlight", "target": ["dTop", "dLeft"], "at": "two", "nth": 2, "until": "over" },
            { "do": "highlight", "target": ["dBot", "dRight"], "at": "three", "nth": 3 }
          ]
        },
        {
          "speaker": "learner",
          "say": "So the top counts the pieces we took, and the bottom counts all the pieces. It is not a trick. It is the picture!",
          "pause": 0.3,
          "do": [
            { "do": "show", "target": "ovRing", "at": "top" },
            { "do": "hide", "target": "ovRing", "at": "bottom" },
            { "do": "show", "target": "sqRing", "at": "bottom" },
            { "do": "hide", "target": "sqRing", "at": "not" },
            { "do": "write", "tex": "=\\frac{6}{12}", "fresh": true, "at": "picture" }
          ]
        },
        {
          "speaker": "teacher",
          "say": "Exactly. And six out of twelve is one half. Two thirds of three fourths is one half of the whole square.",
          "pause": 0.6,
          "do": [
            { "do": "clear" },
            { "do": "show", "target": "ovRing", "at": "half" },
            { "do": "write", "tex": "\\frac{6}{12}=\\frac{1}{2}", "fresh": true, "at": "six" },
            { "do": "answer", "tex": "\\frac{1}{2}", "at": "whole" }
          ]
        }
      ]
    },
