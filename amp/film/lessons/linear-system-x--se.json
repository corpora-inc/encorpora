   "beats": [
    {
     "speaker": "teacher",
     "say": "Two unknowns at once are too many, so we make one disappear.",
     "pause": 0.5,
     "do": [
      {
       "do": "text",
       "text": "Make one unknown disappear"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Let x be one wrap’s price and y one juice’s price, in dollars.",
     "pause": 0.5,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "text",
       "text": "$\\cw{x}$: wrap price; $\\cb{y}$: juice price"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Two wraps and one juice cost eleven dollars.",
     "pause": 0.5,
     "do": [
      {
       "do": "write",
       "tex": "\\cw{2x}+\\cb{y}=11"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "One wrap and one juice cost seven dollars.",
     "pause": 0.5,
     "do": [
      {
       "do": "show",
       "target": [
        "lowWrap",
        "lowJuice",
        "totalB"
       ],
       "at": "One"
      },
      {
       "do": "write",
       "tex": "\\cw{x}+\\cb{y}=7",
       "fresh": true
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "To subtract, lay the second order under the first.",
     "pause": 0.7,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "\\begin{aligned}\\cw{2x}+\\cb{y}&=11\\\\-(\\cw{x}+\\cb{y})&=-7\\end{aligned}",
       "at": "subtract"
      },
      {
       "do": "slide",
       "target": [
        "lowWrap",
        "lowJuice",
        "totalB"
       ],
       "by": [
        0,
        0.65
       ],
       "at": "lay",
       "dur": 1.1
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Each matching wrap and juice pairs off and leaves.",
     "pause": 0.7,
     "do": [
      {
       "do": "hide",
       "target": [
        "topWrap",
        "lowWrap"
       ],
       "at": "wrap",
       "dur": 1.0
      },
      {
       "do": "hide",
       "target": [
        "topJuice",
        "lowJuice"
       ],
       "at": "juice",
       "dur": 1.0
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Eleven minus seven leaves four dollars for the one wrap left over.",
     "pause": 0.7,
     "do": [
      {
       "do": "write",
       "tex": "\\cw{x}=11-7=4",
       "at": "Eleven"
      },
      {
       "do": "hide",
       "target": [
        "totalA",
        "totalB"
       ],
       "at": "leaves",
       "dur": 0.8
      },
      {
       "do": "show",
       "target": "difference",
       "at": "four",
       "dur": 0.8
      },
      {
       "do": "slide",
       "target": "extra",
       "by": [
        1.42,
        -0.85
       ],
       "at": "wrap",
       "dur": 1.2
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "That is elimination: make one unknown disappear.",
     "pause": 0.5,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "term",
       "word": "Elimination",
       "meaning": "Make one unknown disappear."
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Put x equals four into the second equation: four plus y equals seven.",
     "pause": 0.5,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "\\cw{4}+\\cb{y}=7",
       "note": "\\text{put }x\\text{ back}"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Subtract four: y equals three.",
     "pause": 0.5,
     "do": [
      {
       "do": "write",
       "tex": "\\cb{y}=3",
       "note": "-4"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Check the first order: two times four plus three equals eleven.",
     "pause": 0.5,
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "2(\\cw{4})+\\cb{3}=11",
       "note": "\\text{first}"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Check the second: four plus three equals seven.",
     "pause": 0.5,
     "do": [
      {
       "do": "write",
       "tex": "\\cw{4}+\\cb{3}=7",
       "note": "\\text{second}",
       "fresh": true
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Both are true, so the solution is four, three.",
     "pause": 1,
     "do": [
      {
       "do": "answer",
       "tex": "(x,y)=(\\cw{4},\\cb{3})"
      }
     ]
    }
   ]
