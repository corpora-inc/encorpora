   "beats": [
    {
     "speaker": "teacher",
     "say": "Two equations about the same x and y. Is there a pair of numbers that makes both true?",
     "do": [
      {
       "do": "text",
       "text": "Which pair makes both true?",
       "at": "pair"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Two savings accounts. A starts with one dollar and adds two dollars each week.",
     "do": [
      {
       "do": "text",
       "text": "Two savings accounts"
      },
      {
       "do": "write",
       "tex": "\\cb{\\text{A: }y=2x+1}",
       "fresh": true,
       "at": "A"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Here x is weeks, and y is dollars. An ordered pair gives x first, then y.",
     "do": [
      {
       "do": "highlight",
       "target": "xt",
       "at": "weeks"
      },
      {
       "do": "highlight",
       "target": "yt",
       "at": "dollars"
      },
      {
       "do": "text",
       "text": "$x$: weeks; $y$: dollars.",
       "at": "Here"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "At zero weeks, one dollar; at one week, three dollars. Plot both and draw the line.",
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "\\cb{\\text{A: }y=2x+1}",
       "fresh": true
      },
      {
       "do": "write",
       "tex": "(0,1),\\ (1,3)",
       "fresh": true
      },
      {
       "do": "show",
       "target": "dotA0",
       "at": "zero"
      },
      {
       "do": "show",
       "target": "dotA1",
       "at": "three"
      },
      {
       "do": "draw",
       "target": "lineA",
       "at": "draw"
      },
      {
       "do": "show",
       "target": "nameA",
       "at": "line"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Every point on this line makes its equation true.",
     "do": [
      {
       "do": "text",
       "text": "On the line = true in its equation.",
       "at": "Every"
      },
      {
       "do": "show",
       "target": [
        "moving",
        "coords"
       ],
       "at": "point"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "B starts with four dollars and adds one each week: y equals x plus four.",
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "\\cb{\\text{A: }y=2x+1}",
       "fresh": true
      },
      {
       "do": "write",
       "tex": "\\cw{\\text{B: }y=x+4}",
       "fresh": true,
       "at": "y"
      },
      {
       "do": "draw",
       "target": "lineB",
       "at": "adds"
      },
      {
       "do": "show",
       "target": "nameB",
       "at": "adds"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Together, A and B form a system. A solution makes both equations true.",
     "do": [
      {
       "do": "text",
       "text": "Solution: true in both equations.",
       "at": "solution"
      }
     ]
    },
    {
     "speaker": "learner",
     "say": "One, three is on A, so it solves the system.",
     "do": [
      {
       "do": "highlight",
       "target": "coords",
       "at": "three"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Check both. A gives two times one plus one: three. B gives one plus four: five, not three.",
     "do": [
      {
       "do": "clear"
      },
      {
       "do": "write",
       "tex": "(1,3)",
       "fresh": true
      },
      {
       "do": "write",
       "tex": "\\cb{2(1)+1=3}",
       "fresh": true,
       "at": "two",
       "note": "\\text{A: true}"
      },
      {
       "do": "write",
       "tex": "\\cw{1+4=5\\ne3}",
       "fresh": true,
       "at": "five",
       "note": "\\text{B: false}"
      },
      {
       "do": "show",
       "target": [
        "dotB1",
        "b1lab"
       ],
       "at": "five"
      }
     ]
    },
    {
     "speaker": "learner",
     "say": "So it only makes A true. I'll follow A to where it crosses B: three, seven.",
     "do": [
      {
       "do": "move",
       "points": {
        "P": [
         3,
         7
        ]
       },
       "at": "follow",
       "dur": 1.7
      },
      {
       "do": "hide",
       "target": "coords",
       "at": "follow"
      },
      {
       "do": "hide",
       "target": [
        "dotA0",
        "dotA1",
        "dotB1",
        "b1lab"
       ],
       "at": "follow"
      },
      {
       "do": "draw",
       "target": [
        "down",
        "across"
       ],
       "at": "three"
      },
      {
       "do": "show",
       "target": "coords",
       "at": "three,"
      },
      {
       "do": "clear",
       "at": "three"
      },
      {
       "do": "write",
       "tex": "(3,7)",
       "fresh": true,
       "at": "three"
      },
      {
       "do": "highlight",
       "target": "coords",
       "at": "seven"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Check it. Two times three plus one is seven. Three plus four is seven. Both true.",
     "do": [
      {
       "do": "write",
       "tex": "\\cb{2(3)+1=7}",
       "fresh": true,
       "at": "Two",
       "note": "\\text{A: true}"
      },
      {
       "do": "write",
       "tex": "\\cw{3+4=7}",
       "fresh": true,
       "at": "Three",
       "nth": 2,
       "note": "\\text{B: true}"
      }
     ]
    },
    {
     "speaker": "teacher",
     "say": "Three, seven is on both lines: the intersection. It solves the system: three weeks, seven dollars each.",
     "do": [
      {
       "do": "clear",
       "at": "intersection"
      },
      {
       "do": "text",
       "text": "Intersection: a point on both lines.",
       "at": "intersection"
      },
      {
       "do": "answer",
       "tex": "(3,7)",
       "at": "solves"
      },
      {
       "do": "text",
       "text": "3 weeks; 7 dollars each.",
       "at": "weeks"
      }
     ]
    }
