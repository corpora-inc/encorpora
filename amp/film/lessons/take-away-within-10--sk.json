        ]
      },
      "beats": [
        {
          "speaker": "teacher", "say": "There are five ducks. Two fly away. How many are left?", "pause": 0.4,
          "do": [
            { "do": "problem", "text": "There are $5$ ducks. $2$ fly away. How many are left?", "id": "p1", "at": "There" },
            { "do": "highlight", "target": "d", "at": "five" }
          ]
        },
        {
          "speaker": "teacher", "say": "Start with all of them. One, two, three, four, five.", "pause": 0.3,
          "do": [
            { "do": "count", "target": "d" },
            { "do": "write", "tex": "\\ca{5}", "fresh": true, "id": "w5", "at": "five" }
          ]
