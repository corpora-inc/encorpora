        {
          "speaker": "teacher", "say": "Two fly away.", "pause": 0.5,
          "do": [{ "do": "leave", "target": ["d2", "d5"], "at": "fly" }]
        },
        {
          "speaker": "teacher", "say": "Some go away. That is take away. The sign minus writes it.", "pause": 0.3,
          "do": [
            { "do": "term", "word": "take away", "meaning": "Some go away from the group.", "at": "take" },
            { "do": "write", "tex": "\\ca{5}-\\cw{2}", "id": "w52", "at": "minus" }
          ]
        },
        {
          "speaker": "teacher", "say": "Left means the ones still here. Count what is left: one, two, three.", "pause": 0.3,
