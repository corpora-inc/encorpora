            { "do": "count", "target": "d" },
            { "do": "write", "tex": "\\ca{5}-\\cw{2}=3", "id": "w3", "at": "three" }
          ]
        },
        {
          "speaker": "learner", "say": "So the answer is two?", "pause": 0.2,
          "do": [{ "do": "watch", "text": "Count the ones that are left, not the ones that went away.", "id": "wt", "at": "two" }]
        },
        {
          "speaker": "teacher", "say": "No. Two is how many went away. Look at the pond. Three are left.", "pause": 0.4,
          "do": [
            { "do": "highlight", "target": "d", "at": "Look" },
            { "do": "answer", "tex": "3", "id": "a1", "at": "Three" }
          ]
