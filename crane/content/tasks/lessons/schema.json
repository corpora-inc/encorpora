{
  "type": "object",
  "additionalProperties": false,
  "required": ["lessons"],
  "properties": {
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "skills", "body"],
        "properties": {
          "title": {"type": "string"},
          "skills": {"type": "array", "items": {"type": "string"}},
          "body": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["t"],
              "properties": {
                "t": {"enum": ["text", "quote", "cite", "diagram", "check"]},
                "text": {"type": "string"},
                "section_id": {"type": "string"},
                "diagram_id": {"type": "string"},
                "question": {"type": "string"},
                "answer": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
