{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signals.schema.json",
  "title": "Standard hand signals (Appendix A to Subpart CC of 29 CFR 1926)",
  "description": "Generated by build/build_signals.py. name, description and caption are verbatim from the printed figure; kind, motion, crane_types, modifiers and teaching_tip are editorial.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "section_id", "source", "notes", "signals"],
  "properties": {
    "$schema": {"type": "string"},
    "title": {"type": "string"},
    "section_id": {"const": "29cfr1926.cc.appA"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "edition", "sha256", "license"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "edition": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string"}
      }
    },
    "notes": {
      "description": "Verbatim eCFR quotes that govern the use of these signals. Checked by crane/content/verify/verify.py.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "quote"],
        "properties": {
          "section_id": {"$ref": "#/$defs/section_id"},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {"$ref": "#/$defs/signal"}
    }
  },
  "$defs": {
    "section_id": {"type": "string", "pattern": "^29cfr19(26|10)\\.[0-9a-zA-Z.()]+$"},
    "signal_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "name", "description", "caption", "svg", "kind", "motion", "crane_types",
                   "modifiers", "section_id", "related_section_ids", "teaching_tip", "source"],
      "properties": {
        "signal_id": {"$ref": "#/$defs/signal_id"},
        "name": {"type": "string", "description": "Signal name as printed (bold part, plus any parenthetical before the dash)."},
        "description": {"type": "string", "description": "Instruction as printed after the dash; line breaks and double spaces collapsed to one space."},
        "caption": {"type": "string", "description": "name + ' – ' + description, as printed (en dash)."},
        "svg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "width", "height", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^svg/[a-z0-9-]+\\.svg$", "description": "Relative to signals.json."},
            "width": {"type": "integer", "description": "viewBox width in source pixels (772 ppi). All figures share this scale."},
            "height": {"type": "integer"},
            "bytes": {"type": "integer"}
          }
        },
        "kind": {"enum": ["action", "modifier"], "description": "modifier signals select a hoist or slow the action signal given with them."},
        "motion": {
          "enum": ["stop", "emergency-stop", "hoist", "lower", "boom-up", "boom-down", "swing", "telescope-in",
                   "telescope-out", "boom-up-load-down", "boom-down-load-up", "dog-everything", "travel",
                   "travel-both-tracks", "travel-one-track", "trolley-travel", "slow", "select-main-hoist",
                   "select-auxiliary-hoist"]
        },
        "crane_types": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["all", "telescoping-boom", "crawler", "tower"]},
          "description": "Editorial: equipment that has the function. The appendix itself does not restrict signals by equipment type."
        },
        "modifiers": {
          "type": "array",
          "items": {"$ref": "#/$defs/signal_id"},
          "description": "Editorial: modifier signal_ids that can accompany this action signal."
        },
        "section_id": {"const": "29cfr1926.cc.appA"},
        "related_section_ids": {"type": "array", "items": {"$ref": "#/$defs/section_id"}},
        "teaching_tip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "verbatim"],
          "properties": {
            "text": {"type": "string"},
            "verbatim": {"const": false, "description": "Plain-language aid, not regulatory text."}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "edition", "sha256", "page", "printed_page", "graphic", "cell"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "edition": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "page": {"type": "integer", "description": "1-based page in the PDF."},
            "printed_page": {"type": "integer", "description": "CFR volume page number."},
            "graphic": {"type": "string", "description": "Federal Register graphic id printed under the figure."},
            "cell": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row", "col"],
              "properties": {"row": {"type": "integer", "minimum": 1}, "col": {"type": "integer", "minimum": 1}}
            }
          }
        }
      }
    }
  }
}
