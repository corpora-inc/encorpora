      },
      {
       "do": "crane",
       "light": "base.axis",
       "at": "axis"
      },
      {
       "do": "crane",
       "light": "base.armCrane",
       "at": "ten"
      },
      {
       "do": "crane",
       "light": "base.rated",
       "at": "rating"
      }
     ]
    }
   ]
  },
  {
   "figure": {
    "crane": {
     "base": {
      "view": "plan",
