      {
       "do": "crane",
       "set": {
        "base.swing": 45
       },
       "at": "Swing",
       "dur": 2.5
      },
      {
       "do": "crane",
       "light": [
        "base.float.fl"
       ],
       "at": "corner"
      },
      {
       "do": "crane",
       "light": "base.axisDim",
       "at": "seventeen"
      }
     ]
    },
    {
     "say": "Over the front, the axis is the line through the two front floats.",
     "do": [
      {
       "do": "crane",
       "set": {
        "base.swing": 0
       },
       "at": "Over",
       "dur": 1.6
      },
      {
       "do": "crane",
       "light": "base.axis.front",
       "at": "line"
      },
      {
       "do": "crane",
       "light": "base.axisDim",
       "at": "front",
       "nth": 2
      }
     ]
    }
   ]
  }
 ]
