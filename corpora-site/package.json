    "@types/react-dom": "^19.2.0",
    "lighthouse": "12.8.2",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "chrome-launcher": "^1.2.1"
  }
